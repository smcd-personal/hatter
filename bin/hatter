#!/usr/bin/env bash
#
# hatter - drive cmux windows/groups/workspaces from remote tmux sessions.
#
#   cmux window     <-> a hat (user@host); one ssh connection, one tmux server
#   workspace group <-> a project / area within that hat
#   workspace       <-> a tmux session, named "<hat-prefix>-<subproject>"
#   tab             <-> a tmux window inside that session
#
# The hat prefix on a session name is what picks the window and the ssh
# connection, so a side project can live under your main hat as
# "dev-website-parser" and still land in the dev window.
#
# State lives in ~/.config/hatter/config.json so a reboot of the Mac or of
# any shell server can be walked back to the previous layout.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hatter"
CONFIG="$CONFIG_DIR/config.json"

export CMUX_QUIET=1

# cmux terminals export these, and the CLI treats them as the default target for
# any command without an explicit --window/--workspace. This script drives
# windows other than the one it was launched from, so drop them and rely on
# explicit flags plus focus-window instead.
#
# The workspace id is kept first, in a name of our own. As an implicit target it
# is wrong; as the answer to "which hat am I wearing right now" it is exactly
# right, and current_hat is its only reader. It is deliberately not exported: a
# mirrored pane on a shell server never sees these vars (ssh does not forward
# them, and the cmux CLI is macOS-only), so every use of it degrades to the old
# behaviour off the Mac rather than guessing.
HATTER_LAUNCH_WORKSPACE="${CMUX_WORKSPACE_ID:-}"
unset CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_TAB_ID

# Where cmux focus was before this run first changed cmux, so the run can put it
# back (see focus_save). One record per outermost hatter: a hatter started by
# another one, while that one is still running, finds these set and shares its
# record rather than restoring on its own. A leftover from a dead hatter, or a
# file another run left under a reused pid, is not trusted.
HATTER_FOCUS_KEEP=0
if [[ ! "${HATTER_FOCUS_OWNER:-}" =~ ^[0-9]+$ || -z "${HATTER_FOCUS_FILE:-}" ]] \
   || ! kill -0 "$HATTER_FOCUS_OWNER" 2>/dev/null; then
    HATTER_FOCUS_OWNER=$$
    _dir="${TMPDIR:-/tmp}"; _dir="${_dir%/}"; [[ -n "$_dir" ]] || _dir=/tmp
    HATTER_FOCUS_FILE="$_dir/hatter-focus.$$"
    # Records left by a hatter that was killed before its EXIT trap ran: only
    # this exact name, a pid that is no longer running, and a file of our own.
    for _f in "$_dir"/hatter-focus.*; do
        [[ "${_f##*/hatter-focus.}" =~ ^[0-9]+$ && -f "$_f" && -O "$_f" && ! -L "$_f" ]] || continue
        if [[ "$_f" == "$HATTER_FOCUS_FILE" ]] || ! kill -0 "${_f##*/hatter-focus.}" 2>/dev/null; then
            rm -f "$_f"
        fi
    done
    [[ ! -L "$HATTER_FOCUS_FILE" ]] || rm -f "$HATTER_FOCUS_FILE"
    unset _dir _f
fi
export HATTER_FOCUS_OWNER HATTER_FOCUS_FILE

# ---------------------------------------------------------------- utilities

die()  { echo "error: $*" >&2; exit 1; }
# The unit separator, between fields that may be empty or hold any name: tab
# is whitespace to read, which merges empty fields and trims names.
US=$'\x1f'
# tmux 3.4 escapes control characters in -F output, so a $US in a format
# arrives as the text \037. A format joins its fields with $HT, which every
# tmux passes through, and the output goes through tmux_fields before parsing.
HT=$'\t'
tmux_fields() { tr '\t' '\037'; }
info() { echo "==> $*"; }
warn() { echo "  !! $*" >&2; }

# hatter opens a lot of short ssh connections - a sync touches every hat, and
# the autosave timer repeats that on a schedule. Multiplexing them over one
# persistent connection per host turns a ~2s handshake into a few milliseconds.
# Kept inside hatter rather than in ~/.ssh/config so nothing outside it changes.
# /tmp first, and TMPDIR only as a fallback: a control socket path has a hard
# 104-byte limit, and macOS hands every process a ~50-character TMPDIR, which
# blows it. Android has no /tmp at all, and Termux's TMPDIR is long enough that
# only a short name fits under it. The limit leaves room for the directory, a
# slash, %C's 40 characters, and the ~17-character suffix ssh adds to the
# socket's name while it creates it; so at most 45 for the directory. With no
# directory that short and safe, multiplexing is skipped - hatter just runs
# slower.
#
# Each directory is per-uid and 0700; if it exists but belongs to someone
# else, it is passed over rather than trusted.
HATTER_SSH_CTL_MAX=45
HATTER_SSH_CTL=""
# Never empty: bash 3.2 calls "${SSH_OPTS[@]}" of an empty array unbound, and
# set -u turns that into an exit.
#
# Keepalives on every connection: a server that stops answering mid-command (a
# wedged box, a dropped route) would otherwise hold list or sync open until TCP
# gives up, which takes hours. Three missed 10-second probes end it.
SSH_KEEPALIVE=(-o ServerAliveInterval=10 -o ServerAliveCountMax=3)
SSH_OPTS=(-o ControlMaster=no "${SSH_KEEPALIVE[@]}")
for _ctl in "/tmp/.hatter-ssh-$(id -u)" \
            ${TMPDIR:+"${TMPDIR%/}/.hatter-ssh-$(id -u)"} \
            ${TMPDIR:+"${TMPDIR%/}/hs$(id -u)"}; do
    [[ ${#_ctl} -le $HATTER_SSH_CTL_MAX ]] || continue
    # -O follows a symlink, so a link planted by someone else pointing at a
    # directory we do own would pass it. Test the link itself, before and after.
    if [[ ! -L "$_ctl" ]] \
       && mkdir -p "$_ctl" 2>/dev/null \
       && [[ -d "$_ctl" && -O "$_ctl" && ! -L "$_ctl" ]] \
       && chmod 700 "$_ctl" 2>/dev/null; then
        HATTER_SSH_CTL="$_ctl"
        SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=$HATTER_SSH_CTL/%C" -o ControlPersist=600
                  "${SSH_KEEPALIVE[@]}")
        break
    fi
done
unset _ctl

# Single-quote a value for safe interpolation into a remote sh command.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# A remote directory. The config's default is the literal string "$HOME", which
# only means anything if the remote shell gets to expand it - single-quoting it
# like any other argument asks tmux for a directory named "$HOME". Exactly two
# forms are let through unquoted; everything else is a literal path.
sq_dir() {
    case "$1" in
        '$HOME'|'~')  printf '"$HOME"' ;;
        '$HOME/'*)    printf '"$HOME"%s' "$(sq "${1#\$HOME}")" ;;
        '~/'*)        printf '"$HOME"%s' "$(sq "${1#\~}")" ;;
        *)            sq "$1" ;;
    esac
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# cmux prints UUIDs in upper case, but nothing promises it.
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

# The autosave timer syncs from the live client once a minute, and a sync is a
# read-then-write of the whole config. Without a lock it can be reading while an
# interactive command writes, and then put the pre-change version back. mkdir is
# the atomic primitive here; a lock left behind by a killed run goes stale.
LOCK_DIR="$CONFIG_DIR/.lock"
HATTER_LOCK_HELD=0
LOCK_STALE_SECONDS=300

# BSD and GNU stat spell this differently, and a lock whose age cannot be read
# is treated as fresh - clearing a lock you cannot date is how two writers end
# up in the config at once. GNU first: GNU stat takes -f too, as "filesystem
# status", and prints a number that is not the file's mtime. BSD stat refuses
# -c outright.
lock_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

hatter_lock() {
    local tries="${1:-0}" i=0 age owner mtime
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        mtime=$(lock_mtime "$LOCK_DIR")
        age=$(( $(date +%s) - mtime ))
        if [[ "$mtime" -gt 0 && "$age" -gt "$LOCK_STALE_SECONDS" ]]; then
            owner=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo '?')
            warn "clearing a stale config lock (pid $owner, ${age}s old)"
            rm -rf "$LOCK_DIR"
            continue
        fi
        i=$((i+1))
        [[ "$i" -gt "$tries" ]] && return 1
        sleep 1
    done
    echo "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
    HATTER_LOCK_HELD=1
    return 0
}

hatter_unlock() {
    [[ "$HATTER_LOCK_HELD" == 1 ]] && rm -rf "$LOCK_DIR"
    HATTER_LOCK_HELD=0
}

# Every config write lands here, which makes this the one place that has to
# hold the lock. Commands take it in the dispatch and keep it for their whole
# run; edit mode and `autosave restore` do not, and without this the once-a-
# minute timer could sync on top of them. A failed jq leaves the config alone
# rather than truncating it.
jq_write() {
    local tmp held=0
    if [[ "$HATTER_LOCK_HELD" != 1 ]]; then
        hatter_lock 20 || die "another hatter is writing the config - try again in a moment"
        held=1
    fi
    tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
    if jq "$@" < "$CONFIG" > "$tmp"; then
        mv "$tmp" "$CONFIG"
    else
        rm -f "$tmp"
        [[ "$held" == 1 ]] && hatter_unlock
        die "config update failed - $CONFIG is unchanged"
    fi
    [[ "$held" == 1 ]] && hatter_unlock
    return 0
}

cfg() { jq -r "$@" < "$CONFIG"; }

backup_config() {
    [[ -f "$CONFIG" ]] || return 0
    cp "$CONFIG" "$CONFIG.bak"
}

# ------------------------------------------------------------------- config

seed_config() {
    mkdir -p "$CONFIG_DIR"
    if [[ ! -f "$CONFIG" ]]; then
        info "Seeding $CONFIG"
        cat > "$CONFIG" <<'JSON'
{
  "version": 3,
  "hats": {},
  "groups": {}
}
JSON
    fi
    migrate_config
}

# A group a user named Unassigned before hatter kept one of its own. Sync would
# read cmux's Unassigned as hatter's and leave this one behind, so its sessions
# move into its hat's Unassigned (an entry already there wins). A default group
# named Unassigned is cleared in any case: a workspace made on purpose does not
# go to Unassigned. A group with no hat cannot be keyed to one, so it is left
# as it is; `hatter list` shows it among the groups with no hat. Runs under the
# config lock, and not for help.
migrate_unassigned() {
    local need held=0
    # The cheap look first, without the lock: almost every run has nothing to do.
    need=$(cfg '[(.groups.Unassigned // {} | select(.managed != true and (.hat // "") != "")),
                 (.hats[]? | select(.default_group == "Unassigned"))] | length' 2>/dev/null) || return 0
    [[ "${need:-0}" -gt 0 ]] || return 0
    if [[ "$HATTER_LOCK_HELD" != 1 ]]; then
        hatter_lock 20 || return 0
        held=1
    fi
    # Read again under the lock: another hatter may have done it meanwhile.
    local hat
    hat=$(cfg '.groups.Unassigned // {} | select(.managed != true) | .hat // empty' 2>/dev/null) || hat=""
    need=$(cfg '[.hats[]? | select(.default_group == "Unassigned")] | length' 2>/dev/null) || need=0
    if [[ -n "$hat" || "${need:-0}" -gt 0 ]]; then
        [[ -z "$hat" ]] || info "Moving the group 'Unassigned' into hatter's own Unassigned group for hat '$hat'"
        backup_config
        jq_write --arg l "$hat" --arg n "$UNASSIGNED" '
            if $l == "" then . else
              .groups.Unassigned as $old
              | "\($n)@\($l)" as $k
              | ([.groups | to_entries[] | select(.key != "Unassigned" and .key != $k and .value.hat == $l)
                  | .value.sessions // {} | keys_unsorted[]]) as $elsewhere
              | .groups[$k] = (($old | del(.sessions)) + (.groups[$k] // {}) + {hat: $l, name: $n, managed: true})
              | .groups[$k].sessions = ((($old.sessions // {}) + (.groups[$k].sessions // {}))
                                        | with_entries(select(.key as $x | $elsewhere | index($x) | not)))
              | del(.groups.Unassigned)
            end
            | .hats |= map_values(if .default_group == "Unassigned" then del(.default_group) else . end)
            | '"$PRUNE_UNASSIGNED"
    fi
    [[ "$held" == 1 ]] && hatter_unlock
    return 0
}

# v1 stored host/remote_dir per group. v2 hoisted those into named entries.
# v3 renames those entries to "hats" - which hat are you wearing right now.
migrate_config() {
    local v
    v=$(cfg '.version // 1')
    [[ "$v" -ge 3 ]] && return 0

    backup_config

    if [[ "$v" -lt 2 ]]; then
        info "Migrating config to v2 (per-hat windows)"
        jq_write '
            def prefix_of: split("@")[0];
            . as $in
            | ($in.groups // {}) as $g
            | {
                version: 2,
                logins: ( $g
                          | to_entries
                          | map(select(.value.host))
                          | map({ key: (.value.host | prefix_of),
                                  value: { ssh: .value.host,
                                           remote_dir: (.value.remote_dir // "$HOME") } })
                          | from_entries ),
                groups: ( $g
                          | to_entries
                          | map({ key: .key,
                                  value: { login: (.value.host // "" | prefix_of),
                                           color: .value.color,
                                           icon: .value.icon,
                                           pinned: (.value.pinned // false),
                                           collapsed: (.value.collapsed // false),
                                           sessions: (.value.sessions // {}) } })
                          | from_entries )
              }
        '
    fi

    info "Migrating config to v3 (hats)"
    jq_write '
        { version: 3,
          hats: (.hats // .logins // {}),
          groups: ( (.groups // {})
                    | map_values(. + {hat: (.hat // .login)} | del(.login)) ) }
    '
}

# -------------------------------------------------------------- config reads

# tmux will not hold a "." or a ":" in a session name - it substitutes "_" and
# says nothing. Everything downstream (the config key, the cmux workspace title,
# every -t target) has to be the name tmux actually used, so the substitution
# happens here, once, before any of it is written down.
tmux_session_name() { printf '%s' "${1//[.:]/_}"; }

hat_exists() { [[ -n "$(cfg --arg l "$1" '.hats[$l] // empty')" ]]; }
# "-oProxyCommand=..." is a valid ssh argument and would run whatever it says.
# A destination is never an option, so anything that looks like one is refused
# rather than handed to ssh.
ssh_dest_ok() { case "$1" in -*) return 1 ;; *) return 0 ;; esac; }

hat_ssh() {
    local d
    d=$(cfg --arg l "$1" '.hats[$l].ssh // empty')
    ssh_dest_ok "$d" || die "hat '$1' has an ssh destination starting with '-' ($d)"
    printf '%s' "$d"
}
hat_dir()    { cfg --arg l "$1" '.hats[$l].remote_dir // "$HOME"'; }
hat_mosh()   { cfg --arg l "$1" '.hats[$l].mosh // false'; }
hat_names()  { cfg '.hats | keys[]?'; }

# How a hat's panes start their agents, as the tmux options hat-launch reads:
#   "launch": {"kind": "claude", "args": {"claude": "--permission-mode auto"}}
# gives @hat_default_kind and @hat_claude_args. A kind is a word; args are
# split on whitespace with no quote handling, so neither may hold a quote.
LAUNCH_KINDS="claude codex shell"
launch_kind_ok() { local k; for k in $LAUNCH_KINDS; do [[ "$1" == "$k" ]] && return 0; done; return 1; }
launch_value_ok() { [[ "$1" != *"'"* && "$1" != *$'\n'* && "$1" != *"\\"* ]]; }

# hat_set_launch <hat> <changes json>: merge {kind, args} into the hat's launch
# settings. An empty value takes that setting out.
hat_set_launch() {
    [[ "$2" != '{}' ]] || return 0
    jq_write --arg l "$1" --argjson c "$2" '
        .hats[$l].launch = ((.hats[$l].launch // {}) * $c
            | if .kind == "" then del(.kind) else . end
            | .args = ((.args // {}) | with_entries(select(.value != "")))
            | if .args == {} then del(.args) else . end)
        | if .hats[$l].launch == {} then del(.hats[$l].launch) else . end'
    info "Hat '$1' launch settings: $(cfg -c --arg l "$1" '.hats[$l].launch // {}')"
    info "Run 'hatter provision $1' to put them on the server"
}

# hat_launch_conf <user@host>: the body of that server's launch.tmux.conf.
# Every hat whose ssh destination is <host> shares its one tmux server, so they
# must agree on each option they set; one that sets nothing has no say.
hat_launch_conf() {
    local lines
    # Checked here as well as in `hat set`: the config can be edited by hand,
    # and what this prints becomes tmux.conf lines on the server.
    lines=$(cfg --arg h "$1" --arg kinds "$LAUNCH_KINDS" '
        ($kinds | split(" ")) as $ks
        | [ .hats[]? | select(.ssh == $h) | .launch // {}
            | if type != "object" then {bad: "launch is not an object"} else
              (if has("kind") then {key: "@hat_default_kind", kind: "kind", value: .kind} else empty end),
              (.args // {} | if type != "object" then {bad: "launch.args is not an object"}
                             else to_entries[] | {key: "@hat_\(.key)_args", kind: .key, value: .value} end)
              end ]
        | (.[] | select(.bad) | "@@bad \(.bad)"),
          (map(select(.bad | not)) | group_by(.key)[]
           | if (map(.value) | unique | length) > 1 then "@@conflict \(.[0].key)"
             elif ((.[0].kind == "kind" and (.[0].value | IN($ks[])))
                   or (.[0].kind != "kind" and (.[0].kind | IN($ks[])))) | not
             then "@@bad \(.[0].key): kind must be one of \($ks | join(", "))"
             elif (.[0].value | type) != "string" or (.[0].value | test("[\u0027\\\\\n]"))
             then "@@bad \(.[0].key) must be a string with no quote, backslash or newline"
             else "\(.[0].key)\t\(.[0].value)" end)') || die "cannot read the launch settings for $1 from $CONFIG"
    local key val
    while IFS=$'\t' read -r key val; do
        [[ -n "$key" ]] || continue
        case "$key" in
            "@@conflict "*)
                die "hats on $1 share a tmux server but set ${key#@@conflict } differently - make them agree (see: hatter help hat)" ;;
            "@@bad "*)
                die "launch settings for $1: ${key#@@bad } (see: hatter help hat)" ;;
        esac
        printf "set -g %s '%s'\n" "$key" "$val"
    done <<< "$lines"
}

# Each hat gets a colour, so the same hat looks the same everywhere it appears
# - the rack, and the cmux group headers under it. Eight names rather than free
# hex: a name maps to both a terminal colour and the hex cmux wants, and eight
# is as many as anyone can tell apart at a glance.
HAT_COLOURS='amber green cyan blue violet rose teal slate'
hat_colour_ansi() {
    case "$1" in
        amber) printf 179 ;; green) printf 114 ;; cyan)  printf  73 ;; blue)  printf  75 ;;
        violet) printf 140 ;; rose) printf 168 ;; teal)  printf  66 ;; slate) printf 145 ;;
        *) printf 145 ;;
    esac
}
hat_colour_hex() {
    case "$1" in
        amber) printf '#d7af5f' ;; green) printf '#87d787' ;; cyan)  printf '#5fafaf' ;;
        blue)  printf '#5fafff' ;; violet) printf '#af87d7' ;; rose) printf '#d75f87' ;;
        teal)  printf '#5f8f8f' ;; slate) printf '#afafaf' ;; *) printf '#afafaf' ;;
    esac
}

# An unassigned hat gets one from its own name, not from its position in the
# list - adding a hat must not recolour the ones already there.
hat_colour() {
    local c i
    c=$(cfg --arg l "$1" '.hats[$l].color // empty')
    if [[ -z "$c" ]]; then
        i=$(( $(printf '%s' "$1" | cksum | awk '{print $1}') % 8 ))
        c=$(printf '%s' "$HAT_COLOURS" | cut -d' ' -f$((i+1)))
    fi
    printf '%s' "$c"
}

# The hat icon in its own colour. A tiny silhouette - crown and brim - which at
# three characters is as close to a hat as a terminal gets.
hat_icon() {
    if [[ -n "${C_R:-}" ]]; then
        printf '\033[38;5;%sm/_\\\033[0m' "$(hat_colour_ansi "$(hat_colour "$1")")"
    else
        printf '/_\\'
    fi
}
hat_default_group() { cfg --arg l "$1" '.hats[$l].default_group // empty'; }

group_exists() { [[ -n "$(cfg --arg g "$1" '.groups[$g] // empty')" ]]; }
group_hat()  { cfg --arg g "$1" '.groups[$g].hat // empty'; }
# Groups and their sessions are kept in the order cmux shows them, which sync
# writes into the config (see SYNC_ORDER_JQ). jq's `keys` sorts, so every
# reader walks them with `keys_unsorted` or `to_entries` instead.
group_names()  { cfg '.groups | keys_unsorted[]?'; }
# A hat's groups, its Unassigned group first: that is where it sits in cmux.
groups_of_hat() {
    cfg --arg l "$1" '[.groups | to_entries[] | select(.value.hat == $l)]
                      | sort_by(if .value.managed then 0 else 1 end) | .[].key'
}

# The group to put a new workspace in when nothing names one: the hat's first
# real group. Unassigned holds sessions nobody placed, so a workspace made on
# purpose goes there only when the hat has no other group at all.
hat_pick_group() {
    cfg --arg l "$1" 'first((.groups | to_entries[] | select(.value.hat == $l)
                             | select(.value.managed | not) | .key),
                            (.groups | to_entries[] | select(.value.hat == $l) | .key)) // empty'
}

# Unassigned is the group hatter keeps for itself, one per hat, for every
# running session that would otherwise be in no group. Group names are config
# keys and so unique across hats, while each hat's window shows its own
# "Unassigned"; so the key carries the hat, "Unassigned@<hat>" (a hat is
# user@host, and this is the hat's Unassigned), and the entry carries the name
# cmux shows. It is marked managed, so the commands that rename or remove a
# group leave it to hatter, which removes it once it is empty.
UNASSIGNED="Unassigned"
unassigned_key() { printf '%s@%s' "$UNASSIGNED" "$1"; }
group_managed() { [[ "$(cfg --arg g "$1" '.groups[$g].managed // false')" == true ]]; }
# The name cmux shows for a group: its own key, unless it carries a name.
group_display() { cfg --arg g "$1" '.groups[$g].name // $g'; }
# The config key for a group cmux shows by <name> in <hat>'s window.
group_key_in_hat() {
    if [[ "$1" == "$UNASSIGNED" ]]; then unassigned_key "$2"; else printf '%s' "$1"; fi
}
# A name a user may not give a group of their own.
group_name_reserved() { [[ "$1" == "$UNASSIGNED" || "$1" == "$UNASSIGNED"@* ]]; }

# jq: drop every managed group that has no sessions left.
PRUNE_UNASSIGNED='.groups |= with_entries(select((.value.managed == true
                    and ((.value.sessions // {}) | length) == 0) | not))'

# Which hat owns a session: an explicit config entry wins, otherwise the
# session-name prefix decides. Two hats can each record a session of the same
# name; then the one its prefix names wins.
session_hat() {
    local session="$1" found prefix="${1%%-*}"
    found=$(cfg --arg s "$session" --arg p "$prefix" '
        [.groups | to_entries[] | select(.value.sessions[$s]) | .value.hat]
        | if index($p) then $p else .[0] // empty end')
    [[ -n "$found" ]] && { printf '%s' "$found"; return 0; }
    hat_exists "$prefix" && printf '%s' "$prefix"
    return 0
}

# session_hat_typed <session> <how to say which> [here]: session_hat for a name
# the user typed with no --hat. A bare name can be recorded by hats on several
# servers, and those are different sessions, so the first one in the config is
# a guess. The prefix still decides when it names one of them. Otherwise, with
# "here", the hat of the window this was typed in decides when it records the
# name. With nothing to go on, it dies rather than guess.
session_hat_typed() {
    local session="$1" say="$2" cur="" pick
    if [[ "${3:-}" == here && "$(cfg --arg s "$session" \
            '[.groups[] | select(.sessions[$s]?) | .hat // empty] | unique | length')" -gt 1 ]]; then
        cur=$(current_hat || true)
    fi
    pick=$(cfg --arg s "$session" --arg p "${session%%-*}" --arg c "$cur" '
        . as $cfg
        | ([.groups[] | select(.sessions[$s]?) | .hat // empty] | unique) as $hs
        | if ($hs | index($p)) then $p
          elif $c != "" and ($hs | index($c)) then $c
          elif ($hs | map($cfg.hats[.].ssh // "") | unique | length) > 1
          then "?" + ($hs | join(", "))
          else empty end')
    if [[ "$pick" == "?"* ]]; then
        die "'$session' is recorded on more than one server (hats: ${pick#?}).
  Say which: $say"
    fi
    if [[ -n "$pick" ]]; then printf '%s' "$pick"; else session_hat "$session"; fi
    return 0
}

# session_group <session> [hat]: the group that records it, among that hat's
# groups when the hat is known.
session_group() {
    cfg --arg s "$1" --arg l "${2:-}" '.groups | to_entries[]
        | select(.value.sessions[$s] and ($l == "" or .value.hat == $l)) | .key' | head -1
}

# The session a name means on a hat: the name as given if it already carries
# the hat's prefix, if the config records it under this hat, or if it is
# running on the hat's server; otherwise "<hat>-<name>". The prefix is a
# naming convention for new sessions, not a rule every session follows (rename
# and plain tmux make unprefixed ones), so an existing session is looked up
# before the prefix is added, never after.
hat_session_name() {
    local hat="$1" name="$2" host
    if [[ "$name" == "$hat"-* ]]; then printf '%s' "$name"; return 0; fi
    if [[ -n "$(session_group "$name" "$hat")" ]]; then
        printf '%s' "$name"; return 0
    fi
    host=$(hat_ssh "$hat")
    if [[ -n "$host" ]] && remote_session_exists "$host" "$name"; then
        printf '%s' "$name"; return 0
    fi
    printf '%s-%s' "$hat" "$name"
    return 0
}

# --------------------------------------------------------------- config writes

register_hat() {
    local hat="$1" ssh_dest="${2:-}" dir="${3:-}" defgroup="${4:-}"

    if [[ -z "$ssh_dest" ]]; then
        [[ -t 0 ]] || die "unknown hat '$hat' and no --ssh given (not a tty, cannot prompt)"
        echo
        echo "No shell server is mapped to the '$hat' prefix."
        read -r -p "  ssh destination (e.g. ${hat}@dev.example.com): " ssh_dest
        [[ -n "$ssh_dest" ]] || die "no ssh destination given"
    fi
    ssh_dest_ok "$ssh_dest" || die "ssh destination cannot start with '-': $ssh_dest"
    if [[ -z "$dir" ]]; then
        [[ -t 0 ]] && read -r -p "  remote working dir [\$HOME]: " dir || true
        [[ -n "$dir" ]] || dir='$HOME'
    fi

    backup_config
    jq_write --arg l "$hat" --arg s "$ssh_dest" --arg d "$dir" --arg g "$defgroup" '
        .hats[$l] = ((.hats[$l] // {}) + {ssh: $s, remote_dir: $d})
        | if $g == "" then . else .hats[$l].default_group = $g end
    '
    info "Hat '$hat' -> $ssh_dest ($dir)${defgroup:+, default group '$defgroup'}"
}

register_group() {
    local group="$1" hat="$2" managed=false
    if [[ "$group" == "$(unassigned_key "$hat")" ]]; then
        managed=true
    elif group_name_reserved "$group"; then
        die "'$UNASSIGNED' is hatter's own group, kept for workspaces in no group - pick another name"
    fi
    backup_config
    jq_write --arg g "$group" --arg l "$hat" --argjson m "$managed" --arg n "$UNASSIGNED" '
        .groups[$g] = ((.groups[$g] // {sessions: {}}) + {hat: $l})
        | .groups[$g].sessions //= {}
        | if $m then .groups[$g] += {name: $n, managed: true} else . end
    '
}

# A session is in one group at a time, so remembering it in one moves it out of
# any other, keeping what was recorded about its tabs. An Unassigned group left
# empty by the move goes with it.
remember_session() {
    local group="$1" session="$2"
    # Only the groups of the same hat: a group of another hat that happens to
    # record the same name is a different session, on a different server.
    jq_write --arg g "$group" --arg s "$session" '
        (.groups[$g].hat // null) as $h
        | (first(.groups[] | select((.hat // null) == $h) | .sessions[$s]? // empty) // {windows: []}) as $e
        | .groups |= map_values(if (.hat // null) == $h and .sessions then del(.sessions[$s]) else . end)
        | .groups[$g].sessions[$s] = $e
        | '"$PRUNE_UNASSIGNED"
}

# --------------------------------------------------------------- remote tmux

# Every command hatter sends a server reaches the account's login shell, which
# need not be sh: fish, say, reads `$(...)`, `if ... fi` and `2>&1` its own
# way. So each goes as `sh -c '<script>'`, one word the login shell only has
# to pass on, and sh runs the script. (csh and tcsh cannot hold a newline in a
# quoted word, so a multi-line script still needs a login shell other than
# those.)
# Every remote command runs with tmux as `tmux -u`: a client with no UTF-8
# locale, which is what an ssh command session can have, gets tmux's output
# with every tab and non-ASCII character turned into "_", so the fields of a
# format, and names like "✳ notes", would not read back (#109).
TMUX_U='command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }'
posix_sh() { printf 'sh -c %s' "$(sq "$TMUX_U; $*")"; }

remote_sh() {
    # -n so ssh cannot swallow the stdin of a calling loop.
    local host="$1"; shift
    ssh -n "${SSH_OPTS[@]}" -o ConnectTimeout=10 "$host" "$(posix_sh "$*")"
}

remote_sh_stdin() {
    local host="$1"; shift
    ssh "${SSH_OPTS[@]}" -o ConnectTimeout=10 "$host" "$(posix_sh "$*")"
}

remote_session_exists() {
    remote_sh "$1" "tmux has-session -t $(sq "=$2")" >/dev/null 2>&1
}

remote_sessions() {
    remote_sh "$1" "tmux list-sessions -F '#S' 2>/dev/null || true"
}

# Every session the config records on a server, across all the hats that share
# its ssh destination: the server keeps one list per account, not per hat.
host_recorded_sessions() {
    cfg --arg h "$1" '
        [.hats | to_entries[] | select(.value.ssh == $h) | .key] as $hats
        | .groups[] | select(.hat as $x | $hats | index($x))
        | .sessions | keys_unsorted[]?'
}

# A remote sh fragment that sets $list to the server's tmux sessions, one per
# line, or $lerr to why it could not tell. A server with no tmux running has no
# sessions; tmux missing, or a socket it cannot use, is an error, so that a
# broken tmux is never read as "nothing is running".
REMOTE_LIST_SH='list="" lerr=""
if ! command -v tmux >/dev/null 2>&1; then
    lerr="tmux is not installed"
elif ! list=$(tmux list-sessions -F "#{session_name}" 2>&1); then
    case "$list" in
        *"no server running"*|*"error connecting to"*"No such file or directory"*) ;;
        *) lerr=$(printf "%s\n" "$list" | head -n 1) ;;
    esac
    list=""
fi'

# hat_live_sessions <host>: the tmux sessions running there, one per line.
# Returns 1 when the server cannot be reached and 2 when it answers but its
# tmux cannot be read (the reason goes to stderr). Neither is the same as a
# server with no sessions, and callers must not treat them as one.
hat_live_sessions() {
    local out
    out=$(ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$1" "$(posix_sh "$REMOTE_LIST_SH"'
        if [ -n "$lerr" ]; then printf "@@hatter-err %s\n" "$lerr"
        else [ -z "$list" ] || printf "%s\n" "$list"; echo @@hatter-ok; fi')" 2>/dev/null) || true
    if grep -q '^@@hatter-err ' <<<"$out"; then
        sed -n 's/^@@hatter-err //p' <<<"$out" | head -n 1 >&2
        return 2
    fi
    grep -qx '@@hatter-ok' <<<"$out" || return 1
    grep -vx '@@hatter-ok' <<<"$out" || true
    return 0
}

# Where a session stands, worded once for sync, list and the rack:
#   session_place <session> <live> <shown> <grouped>
# <live> is the server's running sessions, <shown> the titles cmux shows in the
# hat's window and <grouped> those of them in a group. Either is "?" when cmux
# could not be read, and then nothing is claimed about it. Prints one of:
#   not running | running | running, in no cmux group | running, not in cmux
session_place() {
    grep -qxF -- "$1" <<<"$2" || { echo "not running"; return 0; }
    if [[ "$3" == "?" ]]; then echo running
    elif ! grep -qxF -- "$1" <<<"$3"; then echo "running, not in cmux"
    elif [[ "$4" == "?" ]] || grep -qxF -- "$1" <<<"$4"; then echo running
    else echo "running, in no cmux group"; fi
}

# hat_unrecorded <hat> <live sessions>: the running sessions that no hat on
# this hat's server records, and that belong to this hat. Several hats can share
# one server; a session goes to the hat its name is prefixed with, and one with
# no such prefix goes to the first of them by name, so each is shown once.
# The drag healer's own short-lived hop sessions (heal_hop_window) are no one's.
hat_unrecorded() {
    cfg --arg l "$1" --arg live "$2" '
        .hats[$l].ssh as $h
        | ([.hats | to_entries[] | select(.value.ssh == $h) | .key] | sort) as $hats
        | ([.groups[] | select(.hat as $x | $hats | index($x)) | .sessions | keys_unsorted[]?]) as $rec
        | $live | split("\n")[]
        | select(. != "" and (. as $s | $rec | index($s) | not))
        | select(startswith("hatter-hop-") | not)
        | select((split("-")[0]) as $p
                 | if ($hats | index($p)) then $p == $l else $hats[0] == $l end)'
}

# Tell a server what the config records, and drop its registry entries for tabs
# that have closed. hat-restore rebuilds tmux at boot from that registry and
# never sees this config, so without this a sync changes nothing about what a
# reboot brings back. Only call it while the server's tmux is up: the prune
# measures the registry against the windows that exist right now.
tell_server_sessions() {
    # Read the list first: a failed read piped straight through would hand the
    # server an empty list, and an empty list means "bring nothing back".
    local host="$1" list
    list=$(host_recorded_sessions "$host") || return 1
    printf '%s\n' "$list" | remote_sh_stdin "$host" '
        d="${XDG_STATE_HOME:-$HOME/.local/state}/hatter"
        mkdir -p "$d" && cat > "$d/sessions.tmp" && mv "$d/sessions.tmp" "$d/sessions" || exit 1
        h="$HOME/.local/bin/hat-restore"
        if [ -x "$h" ]; then "$h" --prune >/dev/null 2>&1; fi
        exit 0'
}

# A session's tabs in tmux index order, as {id, name, cwd[, pinned]}. The
# window id is only for lining the tabs up with cmux, and never stored.
# Every session on a server and every window in them, in one round trip:
#   S<tab>session
#   W<tab>session<tab>window id<tab>name<tab>cwd<tab>pinned
# Each S line also carries which tmux server it came from (its pid and start
# time), so sync can tell a session that ended from one a restart lost.
remote_tmux_state() {
    local sfmt=$'S\t#S\t#{pid}.#{start_time}'
    local wfmt=$'W\t#{session_name}\t#{window_id}\t#{window_name}\t#{pane_current_path}\t#{@hatter-pinned}'
    remote_sh "$1" "tmux list-sessions -F $(sq "$sfmt") 2>/dev/null || true
        tmux list-windows -a -F $(sq "$wfmt") 2>/dev/null || true"
}

remote_windows_json() {
    local host="$1" session="$2"
    local fmt=$'#{window_id}\t#{window_name}\t#{pane_current_path}\t#{@hatter-pinned}'
    remote_sh "$host" \
        "tmux list-windows -t $(sq "=$session") -F $(sq "$fmt") 2>/dev/null || true" \
    | jq -R -s 'split("\n") | map(select(length>0) | split("\t")
        | {id: .[0], name: (.[1] // ""), cwd: (.[2] // null)}
          + (if .[3] == "1" then {pinned: true} else {} end))'
}

# A pinned tab is one hatter keeps: restore creates it first, and brings it
# back if it was closed. cmux cannot pin a mirrored tmux pane, so the pin is
# hatter's own. It is held twice: as the tmux window option @hatter-pinned,
# which follows the window through a rename or a move, and as "pinned": true
# in the config, which survives tmux-resurrect - that brings windows back after
# a reboot but not their user options. Either one counts.
PIN_OPT='@hatter-pinned'

# A remote command that creates a window and, when <pinned> is true, pins it.
# <create> must be a tmux new-session/new-window call that takes -P -F.
pinned_create() {
    local create="$1" pinned="$2"
    if [[ "$pinned" == "true" ]]; then
        printf 'w=$(%s -P -F %s) && tmux set-option -w -t "$w" %s 1' \
            "$create" "'#{window_id}'" "$PIN_OPT"
    else
        printf '%s' "$create"
    fi
}

# Bring back any pinned tab missing from a running session, and re-pin a live
# tab of the same name that lost its option. Tabs are matched by name, which
# is why only a named tab can be pinned.
ensure_pinned_tabs() {
    local host="$1" session="$2" dir="$3" windows="$4" live name cwd
    [[ "$(jq '[.[] | select(.pinned)] | length' <<<"$windows")" -gt 0 ]] || return 0
    live=$(remote_sh "$host" \
        "tmux list-windows -t $(sq "=$session") -F '#{window_id}	#{window_name}' 2>/dev/null || true")
    while IFS=$'\x1f' read -r name cwd; do
        [[ -z "$name" ]] && continue
        local wid
        wid=$(AWK_N="$name" awk -F'\t' '($2 "") == (ENVIRON["AWK_N"] "") {print $1; exit}' <<<"$live")
        if [[ -n "$wid" ]]; then
            remote_sh "$host" "tmux set-option -w -t $(sq "$wid") $PIN_OPT 1" >/dev/null 2>&1 || true
            continue
        fi
        [[ -z "$cwd" || "$cwd" == "null" ]] && cwd="$dir"
        info "Reopening pinned tab '$name' in '$session' on $host"
        remote_sh "$host" "$(pinned_create \
            "tmux new-window -d -t $(sq "=$session") -n $(sq "$name") -c $(sq_dir "$cwd")" true)" >/dev/null
    done < <(jq -r '.[] | select(.pinned) | [.name, (.cwd // "")] | join("\u001f")' <<<"$windows")
}

ensure_remote_session() {
    # ensure_remote_session <host> <session> <default-dir> [windows-json]
    local host="$1" session="$2" dir="$3" windows="${4:-[]}"

    if remote_session_exists "$host" "$session"; then
        ensure_pinned_tabs "$host" "$session" "$dir" "$windows"
        return 0
    fi

    # Pinned tabs first, each group keeping its recorded order.
    windows=$(jq '[.[] | select(.pinned)] + [.[] | select(.pinned | not)]' <<<"$windows")
    local n
    n=$(jq 'length' <<<"$windows")

    if [[ "$n" -eq 0 ]]; then
        info "Creating tmux session '$session' on $host"
        remote_sh "$host" "tmux new-session -d -s $(sq "$session") -c $(sq_dir "$dir")"
        return 0
    fi

    info "Recreating tmux session '$session' on $host ($n windows)"
    # Fields are split on \x1f, not a tab: tab is IFS whitespace, so read
    # would fold an empty tab name into the next field.
    local first=1 name cwd pinned cmd nameopt
    while IFS=$'\x1f' read -r name cwd pinned; do
        [[ -z "${cwd:-}" || "$cwd" == "null" ]] && cwd="$dir"
        nameopt=""
        [[ -n "${name:-}" ]] && nameopt="-n $(sq "$name")"
        if [[ $first -eq 1 ]]; then
            cmd="tmux new-session -d -s $(sq "$session") $nameopt -c $(sq_dir "$cwd")"
            first=0
        else
            cmd="tmux new-window -d -t $(sq "=$session") $nameopt -c $(sq_dir "$cwd")"
        fi
        remote_sh "$host" "$(pinned_create "$cmd" "$pinned")" >/dev/null
    done < <(jq -r '.[] | [(.name // ""), (.cwd // ""), (.pinned // false | tostring)] | join("\u001f")' <<<"$windows")
}

# ----------------------------------------------------------- cmux primitives

# cmux is macOS-only, and the commands that never drive it no longer demand it.
# The two entry points that read from it answer "no windows" when it is absent,
# so `hat status` on a Linux or WSL client reports the server side and leaves
# the window column empty instead of printing "command not found" per hat.
have_cmux() { command -v cmux >/dev/null 2>&1; }

# Being installed is not the same as being reachable. The CLI talks to the cmux
# app over a unix socket, and when the app is down - or the socket has gone
# stale, which it does on its own - every call exits non-zero with an empty
# stdout and "Socket not found" on stderr. Empty stdout is indistinguishable
# from an honest "this window holds nothing", so without this probe a whole run
# reports "no window open" for every hat, leaves the config untouched, and
# still exits 0. Probe once; the commands that drive cmux fail loudly instead.
#
# A running cmux can also refuse the socket. Its default access mode,
# cmuxOnly, only answers processes started inside cmux, so a launchd job such
# as the autosave timer is turned away with "Access denied". That needs a
# different fix from a dead app, so the probe keeps what cmux said.
CMUX_ALIVE=""
CMUX_PROBE_ERR=""
cmux_alive() {
    if [[ -z "$CMUX_ALIVE" ]]; then
        if have_cmux && CMUX_PROBE_ERR=$(cmux list-windows --json 2>&1 >/dev/null); then
            CMUX_ALIVE=yes
        else
            CMUX_ALIVE=no
        fi
    fi
    [[ "$CMUX_ALIVE" == yes ]]
}

# Sorts a failed probe by what cmux said, because each answer needs a
# different fix and only one of them is "start the app":
#   gone    nothing answered: no reply, a missing socket, a refused connection
#   denied  cmuxOnly mode turned away a process started outside cmux
#   auth    password mode, and the CLI sent no password or the wrong one
#   other   cmux answered with something not listed here
cmux_refusal() {
    local err
    err=$(printf '%s' "$CMUX_PROBE_ERR" | tr '[:upper:]' '[:lower:]')
    case "$err" in
        *authenticat*|*password*) echo auth ;;
        *"access denied"*) echo denied ;;
        ""|*"socket not found"*|*"connection refused"*|*"no such file"*) echo gone ;;
        *) echo other ;;
    esac
}

# What cmux said, indented to sit inside a die message
cmux_probe_err_quoted() { printf '%s\n' "${CMUX_PROBE_ERR:-(no reply)}" | sed 's/^/    /'; }

# One line for a warning, e.g. "cmux is not answering"
cmux_refusal_summary() {
    case "$(cmux_refusal)" in
        gone)   echo "cmux is not answering" ;;
        denied) echo "cmux refused its control socket to a process started outside cmux" ;;
        auth)   echo "cmux refused the control socket password" ;;
        *)      echo "cmux returned an error: $(printf '%s' "$CMUX_PROBE_ERR" | head -n 1)" ;;
    esac
}

# <what> names the command for the error message, e.g. require_cmux sync
require_cmux() {
    cmux_alive && return 0
    have_cmux || die "the cmux CLI is not on PATH, and '$1' needs it"
    case "$(cmux_refusal)" in
        denied)
            die "cmux refused its control socket: only processes started inside cmux
  may use it, and this one was not (a launchd job, or another terminal).
  Nothing was changed. Give the socket a password - the cmux CLI reads the
  saved one by itself - in Settings > Automation, or in ~/.config/cmux/cmux.json:
    \"automation\": { \"socketControlMode\": \"password\", \"socketPassword\": \"<secret>\" }
  then run 'cmux reload-config' and 'hatter $1' again." ;;
        auth)
            die "cmux is running but refused the control socket password:
$(cmux_probe_err_quoted)
  Nothing was changed. Restarting cmux will not fix this. The CLI sends the
  password saved in ~/.config/cmux/cmux.json; check that
    \"automation\": { \"socketPassword\": \"<secret>\" }
  is there and matches Settings > Automation, then run 'cmux reload-config',
  confirm with 'cmux list-windows --json', and run 'hatter $1' again." ;;
        gone)
            die "cmux is not answering on its control socket, so the live layout cannot be
  read:
$(cmux_probe_err_quoted)
  Nothing was changed. Start or restart the cmux app, confirm with
    cmux list-windows --json
  and run 'hatter $1' again." ;;
    esac
    die "cmux answered its control socket with an error, so the live layout
  cannot be read:
$(cmux_probe_err_quoted)
  Nothing was changed. Fix what cmux reports, confirm with
    cmux list-windows --json
  and run 'hatter $1' again."
}

# Refs like workspace:3 are window-scoped and collide across windows, so every
# id this script stores or passes around is a UUID.
cmux_json() { have_cmux || return 1; cmux --id-format both "$@" --json; }

# ------------------------------------------- focus: leave it where it was found
#
# Some cmux commands act on the focused window and take no target:
# `workspace-group create` and `ssh-tmux`. So hatter focuses a hat's window
# before them, and `new-window` focuses the window it opens. Left there, a run
# pulls the user out of whatever they were doing, often mid-keystroke, and
# worst when the timer or an agent is the one running hatter.
#
# So every change to cmux goes through cmux_change. Before the run's first
# change that can move focus it records the focused window, that window's
# selected workspace and the focused pane; the EXIT trap (success, failure or
# interrupt) puts all three back. A run that only reads cmux, or only restyles
# and renames, never records, so it costs nothing. `hatter new --focus` is the
# one way to stay where a command went.
#
# The record is a file, not a variable: most changes happen inside $( ), and a
# variable set there never reaches the shell whose EXIT trap restores it.

# cmux_change <cmux args...> - any cmux command that changes something
cmux_change() {
    case "$1 ${2:-}" in
        # These leave focus where it is. Anything not listed may move it, so a
        # new verb is covered until someone shows it does not.
        "workspace-group set-color"|"workspace-group set-icon"|"workspace-group pin"|\
        "workspace-group collapse"|"workspace-group rename"|"workspace-group add"|\
        "rename-workspace "*|"reorder-workspace "*) ;;
        *) focus_save ;;
    esac
    cmux "$@"
}

# What has focus now, as "<window>|<workspace>|<pane>|<surface>"; fails when
# cmux cannot say. One call: identify reports all four.
focus_now() {
    have_cmux || return 1
    cmux --id-format both identify --no-caller --json 2>/dev/null \
        | jq -er '.focused | select(.window_id != null)
                  | [.window_id, (.workspace_id // ""), (.pane_id // ""), (.surface_id // "")]
                  | join("|")' 2>/dev/null
}

# Record focus, once per run. A failed look is recorded as "-" so that the run
# does not ask again before every change. noclobber, so a file planted at the
# path is never written through.
focus_save() {
    [[ -n "$HATTER_FOCUS_FILE" && ! -e "$HATTER_FOCUS_FILE" ]] || return 0
    local now
    now=$(focus_now) || now="-"
    ( set -C; printf '%s\n' "$now" > "$HATTER_FOCUS_FILE" ) 2>/dev/null || true
    return 0
}

# Put focus back as focus_save found it, and forget the record, so that a later
# change records afresh. Nothing is sent when focus never moved. A workspace
# the run closed is gone, and then the window is as close as it gets.
#
# Only the outermost hatter restores, and only in its own shell, never in a
# subshell: `( cmd_sync )` sets the EXIT trap inside the subshell, and $$ there
# is still the parent's. BASH_SUBSHELL, unlike BASHPID, is in bash 3.2.
focus_restore() {
    local f="$HATTER_FOCUS_FILE" saved="" win="" ws="" pane="" surface="" now
    [[ "$BASH_SUBSHELL" == 0 && "$HATTER_FOCUS_OWNER" == "$$" ]] || return 0
    [[ -n "$f" && -f "$f" && -O "$f" && ! -L "$f" ]] || return 0
    IFS= read -r saved < "$f" || true
    rm -f "$f"
    [[ "$HATTER_FOCUS_KEEP" != 1 ]] || return 0
    IFS='|' read -r win ws pane surface <<<"$saved" || true
    [[ -n "$win" && "$win" != - ]] || return 0
    now=$(focus_now) || now=""
    [[ "$now" != "$saved" ]] || return 0
    cmux focus-window --window "$win" >/dev/null 2>&1 || return 0
    [[ -n "$ws" ]] || return 0
    cmux select-workspace --workspace "$ws" --window "$win" >/dev/null 2>&1 || return 0
    [[ -n "$pane" ]] || return 0
    cmux focus-pane --pane "$pane" --workspace "$ws" --window "$win" >/dev/null 2>&1 || true
    # The pane's selected tab, if it is still there.
    [[ -n "$surface" ]] || return 0
    cmux focus-panel --panel "$surface" --workspace "$ws" --window "$win" >/dev/null 2>&1 || true
    return 0
}

# The one EXIT trap: put focus back, then let go of the config lock. Anything
# that sets its own EXIT trap must call this from it. set -e is off in here, and
# the run's own exit status is kept: a failed restore must not turn a success
# into a failure, or the other way round.
hatter_on_exit() {
    local rc="${1:-0}"
    set +e
    # --focus asks to stay where a run went, which only means anything when it
    # got there: a run that failed goes back.
    [[ "$rc" == 0 ]] || HATTER_FOCUS_KEEP=0
    focus_restore
    hatter_unlock
    exit "$rc"
}

cmux_pane_map() {
    cmux rpc remote.tmux.pane_surfaces \
        "$(jq -nc --arg h "$1" --arg s "$2" '{host: $h, session: $s}')" 2>/dev/null
}

# The tmux window ids of a mirrored workspace, one per line, in the order cmux
# shows its tabs. cmux keeps the order it first mirrored them in and does not
# follow a later tmux reorder, so this - not the window index - is the order
# the user sees. Prints nothing when cmux cannot say; callers keep tmux order.
#
# A fifth argument names a file already holding the remote.tmux.pane_surfaces
# answer, so sync can fetch those for every session at once; empty means cmux
# could not say.
cmux_tab_order() {
    local win="$1" wref="$2" host="$3" session="$4" mapfile="${5:-}" map panes
    if [[ -n "$mapfile" ]]; then
        map=$(cat "$mapfile" 2>/dev/null || true)
        [[ -n "$map" ]] || return 0
    else
        map=$(cmux_pane_map "$host" "$session") || return 0
    fi
    panes=$(workspace_panes_json "$wref" "$win" 2>/dev/null) || return 0
    jq -rn --argjson m "$map" --argjson p "$panes" '
        ([$m.panes[]? | {key: .surface_id, value: .window_id}] | from_entries) as $w
        | [$p.panes[]?.surface_ids[]? | $w[.] // empty]
        | reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end)
        | .[]' 2>/dev/null || true
}

# A snapshot of cmux's windows, for a command that only reads them. Each cmux
# call costs a noticeable fraction of a second, and find_hat_window asks every
# window for its lists once per hat, so sync takes one snapshot - the whole tree
# in one call, plus each window's groups - and answers from it. Anything that
# changes cmux must not run while one is held.
CMUX_SNAP=0
CMUX_SNAP_TREE=""
CMUX_SNAP_IDS=()
CMUX_SNAP_WS=()
CMUX_SNAP_TITLES=()
CMUX_SNAP_GROUPS=()
CMUX_SNAP_GNAMES=()

cmux_snapshot_drop() {
    CMUX_SNAP=0; CMUX_SNAP_TREE=""
    CMUX_SNAP_IDS=(); CMUX_SNAP_WS=(); CMUX_SNAP_TITLES=(); CMUX_SNAP_GROUPS=(); CMUX_SNAP_GNAMES=()
}

cmux_snapshot() {
    local w ws groups
    cmux_snapshot_drop
    CMUX_SNAP_TREE=$(cmux_json tree --all 2>/dev/null) || { CMUX_SNAP_TREE=""; return 0; }
    # The tree has no groups, so ask each window for those - all at once.
    local tmp i=0 ids
    ids=$(jq -r '.windows[]?.id' <<<"$CMUX_SNAP_TREE")
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-snap.XXXXXX")
    for w in $ids; do
        cmux_json workspace-group list --window "$w" > "$tmp/$i" 2>/dev/null &
        i=$((i + 1))
    done
    wait
    i=0
    for w in $ids; do
        ws=$(jq -c --arg w "$w" \
            '{workspaces: [.windows[] | select(.id == $w) | .workspaces[]? | {id, title}]}' <<<"$CMUX_SNAP_TREE")
        # A window whose groups could not be read is kept as "", not as a
        # window with no groups: window_groups_json then fails, as a live read
        # would, so no caller mistakes it for an empty window.
        groups=$(cat "$tmp/$i")
        jq -e '.groups | type == "array"' <<<"$groups" >/dev/null 2>&1 || groups=""
        i=$((i + 1))
        CMUX_SNAP_IDS+=("$w")
        CMUX_SNAP_WS+=("$ws")
        CMUX_SNAP_TITLES+=("$(jq -r '.workspaces[].title // empty' <<<"$ws")")
        CMUX_SNAP_GROUPS+=("$groups")
        CMUX_SNAP_GNAMES+=("$( [[ -z "$groups" ]] || jq -r '.groups[]?.name' <<<"$groups")")
    done
    rm -rf "$tmp"
    CMUX_SNAP=1
}

# snap_index <window> -> its index in the snapshot; non-zero when there is none
snap_index() {
    local i
    [[ "$CMUX_SNAP" == 1 ]] || return 1
    for ((i = 0; i < ${#CMUX_SNAP_IDS[@]}; i++)); do
        [[ "${CMUX_SNAP_IDS[$i]}" == "$1" ]] && { printf '%s' "$i"; return 0; }
    done
    return 1
}

window_ws_json() {
    local i
    if i=$(snap_index "$1"); then printf '%s\n' "${CMUX_SNAP_WS[$i]}"; return 0; fi
    cmux_json workspace list --window "$1"
}

window_groups_json() {
    local i
    if i=$(snap_index "$1"); then
        [[ -n "${CMUX_SNAP_GROUPS[$i]}" ]] || return 1
        printf '%s\n' "${CMUX_SNAP_GROUPS[$i]}"; return 0
    fi
    cmux_json workspace-group list --window "$1"
}

# workspace_panes_json <workspace> <window> -> cmux list-panes JSON
workspace_panes_json() {
    if [[ "$CMUX_SNAP" == 1 ]]; then
        jq -c --arg ws "$1" '{panes: [.windows[].workspaces[]? | select(.id == $ws) | .panes[]?]}' \
            <<<"$CMUX_SNAP_TREE"
        return 0
    fi
    cmux_json list-panes --workspace "$1" --window "$2"
}

window_ids() {
    if [[ "$CMUX_SNAP" == 1 ]]; then
        [[ ${#CMUX_SNAP_IDS[@]} -eq 0 ]] || printf '%s\n' "${CMUX_SNAP_IDS[@]}"
        return 0
    fi
    have_cmux || return 0
    cmux list-windows --json | jq -r '.[].id'
}

groups_in_window() {
    local i
    if i=$(snap_index "$1"); then
        [[ -z "${CMUX_SNAP_GNAMES[$i]}" ]] || printf '%s\n' "${CMUX_SNAP_GNAMES[$i]}"
        return 0
    fi
    window_groups_json "$1" 2>/dev/null | jq -r '.groups[]?.name'
}

group_ref_in_window() {
    # A failed read is "not found", never an exit: set -e and pipefail would
    # otherwise end the caller here without a word.
    cmux_json workspace-group list --window "$1" 2>/dev/null \
        | jq -r --arg n "$2" '.groups[]? | select(.name == $n) | .id' 2>/dev/null | head -1 || true
}

titles_in_window() {
    local i
    if i=$(snap_index "$1"); then
        [[ -z "${CMUX_SNAP_TITLES[$i]}" ]] || printf '%s\n' "${CMUX_SNAP_TITLES[$i]}"
        return 0
    fi
    window_ws_json "$1" 2>/dev/null | jq -r '.workspaces[]?.title // empty'
}

# window_titles <window> [grouped]: the workspace titles cmux shows in a
# window, or only those in one of its groups; "?" when cmux could not say,
# which session_place reads as unknown rather than as "none".
window_titles() {
    local ws gs
    ws=$(window_ws_json "$1" 2>/dev/null) || { echo "?"; return 0; }
    if [[ "${2:-}" != grouped ]]; then
        jq -r '.workspaces[]?.title // empty' <<<"$ws" 2>/dev/null || echo "?"
        return 0
    fi
    gs=$(window_groups_json "$1" 2>/dev/null) || { echo "?"; return 0; }
    jq -r --argjson ws "$ws" '
        ($ws.workspaces | map({key: .id, value: (.title // "")}) | from_entries) as $t
        | .groups[]?.member_workspace_ids[]? | $t[.] // empty' <<<"$gs" 2>/dev/null || echo "?"
}

workspace_ref_by_title() {
    # workspace_ref_by_title <title> [window]  - window omitted means any window
    local title="$1" win="${2:-}" w id
    if [[ -n "$win" ]]; then
        cmux_json workspace list --window "$win" 2>/dev/null \
            | jq -r --arg t "$title" '.workspaces[]? | select(.title == $t) | .id' | head -1
        return 0
    fi
    for w in $(window_ids); do
        id=$(cmux_json workspace list --window "$w" 2>/dev/null \
             | jq -r --arg t "$title" '.workspaces[]? | select(.title == $t) | .id' | head -1)
        [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
    done
    return 0
}

# A cmux window has no name of its own (`cmux rename-window` actually renames
# the selected workspace), so a hat's window has to be identified by what is
# inside it. Group names are not unique across windows, so score each window:
# a workspace whose title is one of this hat's sessions, or which carries the
# hat prefix, is much stronger evidence than a matching group name.
find_hat_window() {
    local hat="$1" w t

    # One awk scores every window: hundreds of greps, one per title per window,
    # were most of the time a sync spent finding its windows. Ties go to the
    # first window, as cmux lists them.
    {
        cfg --arg l "$hat" '
            .groups | to_entries[] | select(.value.hat == $l) | .value.sessions | keys_unsorted[]?' \
            | sed 's/^/want	/'
        # By the name cmux shows. Every window has an Unassigned, so it is no
        # evidence either way.
        cfg --arg l "$hat" '.groups | to_entries[]
            | select(.value.hat == $l and (.value.managed | not)) | .key' | sed 's/^/mine	/'
        for w in $(window_ids); do
            printf 'win\t%s\n' "$w"
            while IFS= read -r t; do
                [[ -z "$t" ]] || printf 'title\t%s\t%s\n' "$w" "$t"
            done <<<"$(titles_in_window "$w")"
            while IFS= read -r t; do
                # Not "-n && printf": a window with no groups would end the
                # loop, and the function, on a failed test.
                [[ -z "$t" ]] || printf 'group\t%s\t%s\n' "$w" "$t"
            done <<<"$(groups_in_window "$w")"
        done
    } | AWK_HAT="$hat" awk -F '\t' '
        BEGIN { hat = ENVIRON["AWK_HAT"] "" }
        $1 == "want"  { want[$2] = 1; next }
        $1 == "mine"  { mine[$2] = 1; next }
        $1 == "win"   { order[++n] = $2; score[$2] = 0; next }
        $1 == "title" { if (index($3, hat "-") == 1) score[$2] += 5
                        if ($3 in want) score[$2] += 10; next }
        $1 == "group" { if ($3 in mine) score[$2] += 1; next }
        END { best = ""; bs = 0
              for (i = 1; i <= n; i++) if (score[order[i]] > bs) { bs = score[order[i]]; best = order[i] }
              printf "%s", best }'
}

# "Which hat am I wearing right now", answered from the launch context: find the
# window holding the workspace this hatter was started in, then map that window
# back to a hat. Empty when hatter was not started inside a cmux terminal, when
# it is running on a shell server, or when cmux is not answering - callers treat
# that as "no default given" and carry on, never as an error. Probed once; the
# answer cannot change while a run is in flight.
#
# Every hat's find_hat_window reads every window, so read live this was
# hats x windows cmux calls - most of the rack's startup. It works from a cmux
# snapshot instead: the caller's if one is held (sync), otherwise one of its
# own, dropped again before returning so that a caller which goes on to change
# cmux never reads a stale layout.
CURRENT_HAT_CACHE=""
current_hat() {
    if [[ -n "$CURRENT_HAT_CACHE" ]]; then
        [[ "$CURRENT_HAT_CACHE" == "-" ]] && return 1
        printf '%s' "$CURRENT_HAT_CACHE"
        return 0
    fi
    CURRENT_HAT_CACHE="-"

    [[ -n "$HATTER_LAUNCH_WORKSPACE" ]] || return 1
    cmux_alive || return 1

    local took=0 hat
    if [[ "$CMUX_SNAP" != 1 ]]; then
        cmux_snapshot
        took=1
    fi
    hat=$(current_hat_find) || hat=""
    [[ "$took" == 1 ]] && cmux_snapshot_drop
    [[ -n "$hat" ]] || return 1
    CURRENT_HAT_CACHE="$hat"
    printf '%s' "$hat"
}

# The search itself, for current_hat: no caching, no snapshot handling.
current_hat_find() {
    local w mine="" hat
    for w in $(window_ids); do
        if window_ws_json "$w" 2>/dev/null \
             | jq -e --arg id "$HATTER_LAUNCH_WORKSPACE" \
                   '.workspaces[]? | select(.id == $id)' >/dev/null 2>&1; then
            mine="$w"
            break
        fi
    done
    [[ -n "$mine" ]] || return 1

    while IFS= read -r hat; do
        [[ -z "$hat" ]] && continue
        if [[ "$(find_hat_window "$hat")" == "$mine" ]]; then
            printf '%s' "$hat"
            return 0
        fi
    done < <(hat_names)
    return 1
}

# Set by ensure_hat_window when it opens a window: the placeholder workspace
# cmux seeds a new window with, to be closed once a real one has landed.
NEW_WINDOW_STRAY=""

ensure_hat_window() {
    # ensure_hat_window <hat> -> prints window id, and focuses it
    local hat="$1" w
    w=$(find_hat_window "$hat")

    if [[ -z "$w" ]]; then
        local before after
        before=$(window_ids)
        info "Opening a new cmux window for hat '$hat'" >&2
        cmux_change new-window >/dev/null
        sleep 0.6
        after=$(window_ids)
        w=$(comm -13 <(sort <<<"$before") <(sort <<<"$after") | head -1)
        [[ -n "$w" ]] || die "could not determine the new window's id"

        # Do not record the placeholder's id here - a brand-new window has not
        # necessarily titled it yet. Just note that we opened this window.
        NEW_WINDOW_STRAY="$w"
    fi

    cmux_change focus-window --window "$w" >/dev/null 2>&1 || true
    printf '%s' "$w"
}

ensure_cmux_group() {
    # ensure_cmux_group <group> <window> -> prints group ref. <group> is the
    # config key; cmux knows the group by the name it shows.
    local name win="$2" ref
    name=$(group_display "$1")
    ref=$(group_ref_in_window "$win" "$name")
    if [[ -z "$ref" ]]; then
        local err=""
        info "Creating workspace group '$name'" >&2
        err=$(cmux_group_create "$win" "$name" 2>&1 >/dev/null) || true
        sleep 0.4
        ref=$(group_ref_in_window "$win" "$name")
    fi
    [[ -n "$ref" ]] || die "could not create or find workspace group: $name${err:+
  cmux said: $err}"
    group_managed "$1" && cmux_group_to_top "$ref" "$win"
    printf '%s' "$ref"
}

# --- group changes in cmux. Every change hatter makes to cmux's groups goes
# through these, so there is one place to see, and to change, how. Each sends
# its command through cmux_change, whose list says which verbs leave focus
# alone: add, rename and the styling do; create, move and ungroup are not
# on it, so they record focus first and the run puts it back.

# cmux_group_create <window> <name> [workspace ids, comma-separated]
# With workspaces, the group is made from them and cmux places it in their
# window, so the window is not focused. Without, cmux makes an anchor-only
# group in the focused window. The idempotency key makes two hatters creating
# the same group at once - the rack holds no lock - get one group. It changes
# every minute, so a group removed and needed again later is made anew.
cmux_group_create() {
    local win="$1" name="$2" from="${3:-}" key
    key="hatter:$win:$name:$(( $(date +%s) / 60 ))"
    if [[ -n "$from" ]]; then
        cmux_change workspace-group create --name "$name" --from "$from" --idempotency-key "$key" >/dev/null
    else
        cmux_change focus-window --window "$win" >/dev/null 2>&1 || true
        cmux_change workspace-group create --name "$name" --idempotency-key "$key" >/dev/null
    fi
}
cmux_group_add()    { cmux_change workspace-group add --group "$1" --workspace "$2" >/dev/null 2>&1; }
cmux_group_move()   { cmux_change workspace-group move "$1" --to-index "$2" >/dev/null 2>&1; }
cmux_group_rename() { cmux_change workspace-group rename "$1" --name "$2" >/dev/null 2>&1; }
# cmux_group_style <ref> color|icon|pin|collapse [value]
cmux_group_style() {
    case "$2" in
        color)    cmux_change workspace-group set-color "$1" --hex "$3" ;;
        icon)     cmux_change workspace-group set-icon "$1" --symbol "$3" ;;
        pin)      cmux_change workspace-group pin "$1" ;;
        collapse) cmux_change workspace-group collapse "$1" ;;
    esac >/dev/null 2>&1
}
# Only ever for a group with no running session in it. The flag removes the
# anchor cmux made for an anchor-only group; a group with members is never
# dissolved without it, so nothing in it is set loose.
cmux_group_remove() {
    local ref="$1" members="$2"
    cmux_change workspace-group ungroup "$ref" --remove-generated-anchor >/dev/null 2>&1 && return 0
    [[ "$members" == 0 ]] && cmux_change workspace-group ungroup "$ref" >/dev/null 2>&1
}

# cmux_group_to_top <group ref> <window> [groups json]: Unassigned sits at the
# top of its hat's window, below any group pinned there. cmux's help gives
# `workspace-group move --to-index` and lists groups by index; hatter takes the
# list to be in sidebar order. A group already in place is left alone. If cmux
# does not move it, that is said once and not tried again until the window's
# groups change, rather than on every autosave tick.
cmux_group_to_top() {
    local ref="$1" win="$2" groups="${3:-}" order at want marker
    [[ -n "$groups" ]] || groups=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || return 0
    order=$(jq -r '[.groups[]?.id] | join(",")' <<<"$groups" 2>/dev/null) || return 0
    IFS=' ' read -r at want < <(jq -r --arg r "$ref" '
        [.groups[]? | .id] as $ids
        | [($ids | index($r)), ([.groups[]? | select(.id != $r and (.is_pinned // false))] | length)]
        | map(tostring) | join(" ")' <<<"$groups" 2>/dev/null) || return 0
    [[ "$at" != null && "$at" != "$want" ]] || return 0
    marker="${XDG_STATE_HOME:-$HOME/.local/state}/hatter/unassigned-top.${win//[^A-Za-z0-9_-]/_}"
    [[ "$(cat "$marker" 2>/dev/null)" == "$order" ]] && return 0
    cmux_group_move "$ref" "$want" || true
    groups=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || groups='{}'
    if [[ "$(jq -r --arg r "$ref" '[.groups[]?.id] | index($r) | tostring' <<<"$groups")" == "$want" ]]; then
        rm -f "$marker"
    else
        mkdir -p "${marker%/*}" 2>/dev/null && printf '%s\n' "$order" > "$marker" 2>/dev/null || true
        warn "cmux did not move group '$UNASSIGNED' to the top of the window; leaving it where it is"
    fi
    return 0
}

mirror_hat() {
    # mirror_hat <hat> <window> - mirrors into the (focused) target window
    local hat="$1" win="$2" host
    host=$(hat_ssh "$hat")
    cmux_change focus-window --window "$win" >/dev/null 2>&1 || true
    info "Mirroring $host into the '$hat' window"
    cmux_change ssh-tmux "$host" --no-focus >/dev/null
}

wait_for_workspace() {
    # wait_for_workspace <title> <window> [tries] -> prints ref
    local title="$1" win="$2" tries="${3:-40}" ref="" i
    for ((i = 0; i < tries; i++)); do
        ref=$(workspace_ref_by_title "$title" "$win")
        [[ -n "$ref" ]] && break
        # the mirror may have landed in another window; pull it over
        ref=$(workspace_ref_by_title "$title")
        if [[ -n "$ref" ]]; then
            cmux_change move-workspace-to-window --workspace "$ref" --window "$win" >/dev/null 2>&1 || true
            sleep 0.3
            ref=$(workspace_ref_by_title "$title" "$win")
            [[ -n "$ref" ]] && break
        fi
        sleep 0.25
    done
    printf '%s' "$ref"
}

discard_stray_workspace() {
    # Close the untouched "~" placeholder a freshly opened window came with, now
    # that the window has something real in it. Only ever runs for a window this
    # script opened, and only while more than one workspace is present.
    local win="$1" count id
    [[ "$NEW_WINDOW_STRAY" == "$win" ]] || return 0
    count=$(cmux_json workspace list --window "$win" 2>/dev/null | jq '.workspaces | length')
    if [[ "${count:-0}" -gt 1 ]]; then
        while IFS= read -r id; do
            [[ -z "$id" ]] && continue
            cmux_change close-workspace --workspace "$id" >/dev/null 2>&1 || true
        done < <(cmux_json workspace list --window "$win" 2>/dev/null \
                 | jq -r '.workspaces[]? | select(.title == "~") | .id')
    fi
    NEW_WINDOW_STRAY=""
}

apply_group_style() {
    local group="$1" ref="$2" color icon pinned collapsed hat
    color=$(cfg --arg g "$group" '.groups[$g].color // empty')
    # A group with a colour of its own keeps it; one without inherits its hat's,
    # so the sidebar shows at a glance which hat a group belongs to.
    if [[ -z "$color" || "$color" == "null" ]]; then
        hat=$(group_hat "$group")
        [[ -n "$hat" ]] && color=$(hat_colour_hex "$(hat_colour "$hat")")
    fi
    icon=$(cfg --arg g "$group" '.groups[$g].icon // empty')
    pinned=$(cfg --arg g "$group" '.groups[$g].pinned // false')
    collapsed=$(cfg --arg g "$group" '.groups[$g].collapsed // false')

    [[ -n "$color" && "$color" != "null" ]] && \
        cmux_group_style "$ref" color "$color" || true
    [[ -n "$icon" && "$icon" != "null" ]] && \
        cmux_group_style "$ref" icon "$icon" || true
    [[ "$pinned" == "true" ]] && cmux_group_style "$ref" pin || true
    [[ "$collapsed" == "true" ]] && cmux_group_style "$ref" collapse || true
    return 0
}

# ------------------------------------------------------------ provisioning

# provision_host <user@host> [launch conf]: the second argument is the body of
# the server's launch.tmux.conf (see hat_launch_conf); empty clears it.
provision_host() {
    local host="$1" launch="${2:-}"
    info "Provisioning tmux persistence on $host"
    remote_sh_stdin "$host" "bash -s -- $(sq "$launch")" <<'REMOTE_EOF'
set -euo pipefail

CONF="$HOME/.tmux.conf"
touch "$CONF"

# The options hat-launch reads, sourced by the managed block below. Written
# whole every time, so a setting taken out of the config goes from here too.
# "@@keep" leaves the file as it is: provisioned by user@host, with no hat in
# the config for that destination to say what it should hold.
LAUNCH_CONF="$HOME/.local/state/hatter/launch.tmux.conf"   # the path the managed block sources
mkdir -p "$(dirname "$LAUNCH_CONF")"
touch "$LAUNCH_CONF"
if [ "${1:-}" != "@@keep" ]; then
    { [ -z "${1:-}" ] || printf '%s\n' "$1"; } > "$LAUNCH_CONF.new"
    mv "$LAUNCH_CONF.new" "$LAUNCH_CONF"
fi

if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "installing tpm"
    git clone -q https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
else
    echo "tpm already installed"
fi

# Replace any previous managed block rather than skipping it, so re-provisioning
# actually rolls out changes.
# Strip any previous managed block, including ones written under the old
# new-agent name, rather than skipping - re-provisioning must roll out changes.
if grep -qE '^# >>> (hatter|muxmux|new-agent) managed' "$CONF"; then
    echo "refreshing managed block in $CONF"
    awk '
        /^# >>> (hatter|muxmux|new-agent) managed/ { skip = 1 }
        !skip                               { print }
        /^# <<< (hatter|muxmux|new-agent) managed/ { skip = 0 }
    ' "$CONF" > "$CONF.new"
    mv "$CONF.new" "$CONF"
else
    echo "adding managed block to $CONF"
fi

cat >> "$CONF" <<'BLOCK'

# >>> hatter managed >>>
# Session state survives a reboot of this shell server. hat-restore rebuilds
# it at boot from hatter's registry, agents resumed; resurrect snapshots are
# kept as a fallback, restored by hand (prefix + ctrl-r). continuum does not
# restore on its own: it would race hat-restore on every server start, and
# what it brings back are plain shells, colliding with the registry rebuild.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-nvim 'session'
set -g @continuum-restore 'off'
set -g @continuum-save-interval '15'

# The options hat-launch reads (@hat_default_kind, @hat_<kind>_args), from the
# hat's `launch` settings in hatter's config. Provision rewrites this file, so
# a fresh server starts agents the same way as one where they were set by hand.
source-file -q "$HOME/.local/state/hatter/launch.tmux.conf"

# Logging out must not destroy a tab by accident. Every pane runs its login
# shell inside a loop, so `exit` and stray ctrl-D just hand back a fresh prompt.
#
# There are two deliberate ways out, both server-side:
#   `bye`      kills the pane (see ~/.local/bin/bye)
#   `exit 99`  the sentinel status the loop breaks on
#
# 99 rather than 1 on purpose: bare `exit` returns the *last command's* status,
# so a sentinel of 1 would close the tab every time you typed `exit` after a
# failed command. 99 is effectively never returned by accident.
#
# This replaced `remain-on-exit on` + a `pane-died` respawn hook, which raced
# with tmux's own pane teardown and only fired about two times in three.
#
# The loop is hat-launch's (see ~/.local/bin/hat-launch), which also records
# the window in the registry hat-restore rebuilds from, shells included; a
# window that never recorded itself did not come back after a reboot. Without
# hat-launch the bare loop still runs, so a pane can never fail to start.
set -g default-command 'h="$HOME/.local/bin/hat-launch"; [ -x "$h" ] && exec "$h"; while true; do "$SHELL" -l; [ $? -eq 99 ] && break; sleep 0.3; done'
set -g remain-on-exit off
set-hook -gu pane-died

# The registry follows its windows (see ~/.local/bin/hat-registry): whenever a
# window closes or moves, or a session is renamed, it re-reads where every
# window is. Index 42 of each hook, so one of your own at [0] stays. Only hooks
# every supported tmux has: `move-window -r` fires none of them, and is caught
# by hat-save every 15 minutes and by `hatter sync` instead.
set-hook -g 'window-unlinked[42]' "run-shell -b '$HOME/.local/bin/hat-registry refresh'"
set-hook -g 'window-linked[42]' "run-shell -b '$HOME/.local/bin/hat-registry refresh'"
set-hook -g 'session-renamed[42]' "run-shell -b '$HOME/.local/bin/hat-registry refresh'"

# One session, several screens - a desktop and a phone, say. A window takes the
# size of whichever client used it last, rather than shrinking to the smallest
# one attached, and each window is sized by the clients looking at it rather
# than by every client on the session. `mouse` is left alone: it changes how
# text selection works on the desktop.
set -g window-size latest
setw -g aggressive-resize on

# A window made with no client attached - every window a restore makes - takes
# default-size, which is 80x24 unless set, and a control-mode client such as
# cmux does not size every window it shows. hat-save records the size the
# client really uses; start from it. Before tpm, so resurrect's restore gets it.
run-shell 'f="${XDG_STATE_HOME:-$HOME/.local/state}/hatter/window-size"; s=$(cat "$f" 2>/dev/null); case "$s" in [1-9]*x[1-9]*) tmux set -g default-size "$s" ;; esac; true'

# Keep `run tpm` last.
run '~/.tmux/plugins/tpm/tpm'
# <<< hatter managed <<<
BLOCK

# The deliberate way to close a tab from the server side. Panes never die on
# their own now, so something has to be able to end one on purpose.
mkdir -p "$HOME/.local/bin"
cat > "$HOME/.local/bin/bye" <<'BYE'
#!/bin/sh
# bye - close this tab, pane, or session for real.
#
# Panes run their login shell in a loop so `exit` and ctrl-D hand back a fresh
# prompt instead of destroying the tab. This is the way out on purpose.
#
#   bye            close this pane (and the tab, if it was the only pane)
#   bye window     close the whole tmux window
#   bye session    close the whole session, and with it the cmux workspace
#
# Equivalent without this script: `exit 99`.
set -u
case "${1:-pane}" in
    -h|--help)
        sed -n '3,11p' "$0" | sed 's/^#\{1,\} \{0,1\}//'
        exit 0
        ;;
esac
if [ -z "${TMUX:-}" ]; then
    echo "bye: not inside tmux - plain 'exit' already works here" >&2
    exit 1
fi

# Every target is explicit. Without -t, tmux does not close the pane the
# command was typed in: it closes the session's *current* pane, which is a
# different one whenever another tab is the one tmux considers current - so
# `bye` in one tab would shut a different tab. $TMUX_PANE is set per pane by
# tmux itself, and resolves to this pane's window and session too.
if [ -z "${TMUX_PANE:-}" ]; then
    echo "bye: TMUX_PANE is not set - refusing to guess which pane to close" >&2
    echo "bye: use 'exit 99', or tmux kill-pane -t <pane>" >&2
    exit 1
fi
case "${1:-pane}" in
    pane)       exec tmux kill-pane    -t "$TMUX_PANE" ;;
    window|tab) exec tmux kill-window  -t "$TMUX_PANE" ;;
    session)    exec tmux kill-session -t "$TMUX_PANE" ;;
    *) echo "bye: unknown target '$1' (pane|window|session)" >&2; exit 2 ;;
esac
BYE
chmod +x "$HOME/.local/bin/bye"

# Receives Claude Code logins pushed from the client. The client is the only
# place a login is ever entered; this just installs what it is handed.
cat > "$HOME/.local/bin/hat-creds" <<'HATCREDS'
#!/usr/bin/env python3
"""hat-creds - receive Claude Code credentials pushed from the hatter client.

The client holds every login (in the macOS Keychain, via cswap) and pushes one
here over ssh; nothing is ever stored on this server that the client did not
put here on purpose.

    hat-creds install     read a `cswap export` envelope on stdin, install it
    hat-creds status      print what is installed now, as JSON
    hat-creds clear       remove the installed credential

Claude Code reads the credential when a session starts, so an already-running
session keeps the account it started with. New sessions pick up the new one.
"""
import json
import os
import sys
import time

HOME = os.path.expanduser("~")
CRED = os.path.join(HOME, ".claude", ".credentials.json")
CONF = os.path.join(HOME, ".claude.json")


def die(msg):
    sys.stderr.write("hat-creds: %s\n" % msg)
    raise SystemExit(1)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def write_private(path, text):
    """Write 0600 from creation - never expose a token at the umask default."""
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d, 0o700)
    tmp = "%s.hat-creds.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.replace(tmp, path)
    os.chmod(path, 0o600)


def install():
    try:
        envelope = json.load(sys.stdin)
    except ValueError as e:
        die("stdin is not a valid cswap export: %s" % e)
    if not isinstance(envelope, dict):
        die("export envelope must be a JSON object")
    if envelope.get("version") != 1:
        die("unsupported export version: %r" % envelope.get("version"))
    if envelope.get("encrypted") is True:
        die("encrypted exports are not supported - decrypt before piping")
    accounts = envelope.get("accounts")
    if not isinstance(accounts, list) or len(accounts) != 1:
        die("expected exactly one account in the export, got %s"
            % (len(accounts) if isinstance(accounts, list) else "none"))

    acct = accounts[0]
    email = acct.get("email") or "(unknown)"
    creds = acct.get("credentials")

    if isinstance(creds, str):
        # An API-key account: the credential is the raw sk-ant-api… string.
        write_private(CRED, creds.strip() + "\n")
        kind = "api_key"
    elif isinstance(creds, dict):
        # Merge rather than replace: mcpOAuth and trustedDeviceToken belong to
        # THIS machine (MCP server logins, device trust) and are not in the
        # export. Overwriting the file wholesale would silently log the server
        # out of every MCP server it had authorised.
        existing = read_json(CRED)
        merged = existing if isinstance(existing, dict) else {}
        merged.update(creds)
        write_private(CRED, json.dumps(merged, indent=2) + "\n")
        kind = "oauth"
    else:
        die("credentials for %s are neither an object nor an API key" % email)

    # ~/.claude.json carries the account identity Claude Code displays. Merge
    # oauthAccount in and leave the rest of the file (projects, history,
    # onboarding state) exactly as it was.
    oauth_account = (acct.get("config") or {}).get("oauthAccount")
    if isinstance(oauth_account, dict):
        conf = read_json(CONF)
        if conf is None and os.path.exists(CONF):
            # The file is there but unreadable or not JSON. Rewriting it would
            # throw away every project, history entry and onboarding flag it
            # holds, so leave it: the credential itself is already installed and
            # only the displayed account name is affected.
            sys.stderr.write("hat-creds: %s exists but could not be parsed - "
                             "leaving it alone\n" % CONF)
        else:
            if not isinstance(conf, dict):
                conf = {}
            conf["oauthAccount"] = oauth_account
            write_private(CONF, json.dumps(conf, indent=2) + "\n")

    print("installed %s (%s) as %s" % (email, kind, CRED))


def status():
    out = {"host": os.uname().nodename, "user": os.environ.get("USER", ""),
           "kind": "none", "email": None, "organizationName": None,
           "expiresAt": None, "expiresInSeconds": None, "expired": None,
           "hasRefreshToken": None}
    raw = read_text(CRED)
    if raw is None:
        print(json.dumps(out))
        return
    stripped = raw.strip()
    if stripped.startswith("sk-ant-api"):
        out["kind"] = "api_key"
    else:
        try:
            obj = json.loads(stripped)
        except ValueError:
            out["kind"] = "unreadable"
            print(json.dumps(out))
            return
        oauth = obj.get("claudeAiOauth")
        if isinstance(oauth, dict):
            out["kind"] = "oauth"
            # An expired access token is routine: Claude Code trades the
            # refresh token for a new one on its own. Only a credential with
            # no refresh token actually needs pushing again.
            out["hasRefreshToken"] = bool(oauth.get("refreshToken"))
            exp = oauth.get("expiresAt")
            if isinstance(exp, (int, float)):
                # Claude Code stores expiry in milliseconds.
                out["expiresAt"] = exp
                out["expiresInSeconds"] = int(exp / 1000.0 - time.time())
                out["expired"] = out["expiresInSeconds"] <= 0
        else:
            out["kind"] = "unknown"

    conf = read_json(CONF) or {}
    acct = conf.get("oauthAccount")
    if isinstance(acct, dict):
        out["email"] = acct.get("emailAddress")
        out["organizationName"] = acct.get("organizationName")
    print(json.dumps(out))


def clear():
    removed = []
    for path in (CRED,):
        try:
            os.unlink(path)
            removed.append(path)
        except OSError:
            pass
    conf = read_json(CONF)
    if isinstance(conf, dict) and "oauthAccount" in conf:
        del conf["oauthAccount"]
        write_private(CONF, json.dumps(conf, indent=2) + "\n")
        removed.append("%s:oauthAccount" % CONF)
    print("cleared: %s" % (", ".join(removed) if removed else "nothing to clear"))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return
    if cmd == "install":
        install()
    elif cmd == "status":
        status()
    elif cmd == "clear":
        clear()
    else:
        die("unknown command %r (install|status|clear)" % cmd)


if __name__ == "__main__":
    main()
HATCREDS
chmod +x "$HOME/.local/bin/hat-creds"

# ---------------------------------------------------------------------------
# Boot-time recovery, server-side.
#
# `hatter restore` runs from the Mac and additionally re-mirrors into cmux. This
# is the half that needs no Mac at all: the server rebuilds its own tmux and
# resumes its own agents at boot, so the sessions are already standing by the
# time anything connects.
#
# It works because a pane declares what it is at birth instead of being guessed
# at afterwards. tmux-resurrect cannot do this job - its default process list
# brings panes back as bare shells - and `claude --continue` cannot tell
# concurrent conversations apart when a dozen panes share one directory.

cat > "$HOME/.local/bin/hat-registry" <<'HATREGISTRY'
#!/usr/bin/env bash
# hat-registry - the pane registry: what each tmux window was running, for
# hat-restore to rebuild after a reboot. The one writer of $PANES.
#
#   hat-registry put <pane> <kind> <session-id> <state> <cwd> [pid] [source]
#   hat-registry adopt <entry file> <window id>   file an entry under the
#                                   window hat-restore just built for it
#   hat-registry refresh            follow this server's windows (tmux hooks)
#   hat-registry prune [--dry-run]  refresh, settle entries from before this
#                                   server started, record any window that
#                                   has no entry as a shell, age out history
#
# An entry is filed under its window's tmux id and the server's (pid and start
# time), and follows the window when windows close, move or renumber. Keyed by
# window index, as it once was, an entry stayed at its index and was handed to
# whichever window moved into it. The session, index and name are kept as
# hints for a rebuild, and refreshed from tmux. A Claude session id is in at
# most one entry: a later record for it, from any window, replaces the older.
#
# An agent's entry is not lost when its tab goes: before one is deleted or
# written over by another conversation, it is filed under $PANES/closed by
# session id. That is history for `hatter find`, never restored, and goes
# after HISTORY_DAYS.
#
# Never fails, and only prune writes to stdout: hat-record runs this from a
# Claude Code hook, and tmux from its own hooks.
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hatter"
PANES="$STATE/panes"
RESTORING="$STATE/restoring"
HISTORY_DAYS=90
US=$'\x1f'
# tmux 3.4 escapes control characters in -F output, so formats join their
# fields with a tab, turned into $US before anything reads them. And a client
# with no UTF-8 locale, which is what tmux's own hooks and a server started at
# boot have, gets even a tab back as "_": -u tells tmux the client is UTF-8.
HT=$'\t'
command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }
command -v tmux >/dev/null 2>&1 || exit 0
command -v jq   >/dev/null 2>&1 || exit 0
mkdir -p "$PANES" 2>/dev/null || exit 0

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9_.@-' '_'; }

# One writer at a time: each command reads the registry, works out a plan and
# carries it out, and another writing in between would be overwritten by it.
# A lock left by a writer that died is taken over; one still held after 10
# seconds by a live writer is not waited for (nothing is done).
lock() {
    local i=0 owner
    while ! mkdir "$PANES/.lock" 2>/dev/null; do
        i=$((i+1))
        if [ "$i" -ge 100 ]; then
            owner=$(cat "$PANES/.lock/pid" 2>/dev/null) || owner=""
            if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then return 1; fi
            rm -f "$PANES/.lock/pid"; rmdir "$PANES/.lock" 2>/dev/null; i=0
            continue
        fi
        sleep 0.1
    done
    echo $$ > "$PANES/.lock/pid"
    trap 'rm -f "$PANES/.lock/pid"; rmdir "$PANES/.lock" 2>/dev/null' EXIT
}

# hat-restore is rebuilding: entries from before this server started may
# still be waiting for their windows, so nothing may take them for gone.
restoring() {
    local p
    p=$(cat "$RESTORING" 2>/dev/null) || return 1
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# Every entry, as one array, each with the file it came from in ._file. A file
# that is not a JSON object (cut short, say) is left out rather than taking
# the whole registry with it; with none readable at all this fails.
entries() {
    set -- "$PANES"/*.json
    [ -e "$1" ] || { echo '[]'; return 0; }
    jq -c -n '[inputs | objects | . + {_file: input_filename}]' "$@" 2>/dev/null && return 0
    local f
    for f in "$@"; do
        jq -c --arg f "$f" 'objects | . + {_file: $f}' "$f" 2>/dev/null
    done | jq -c -s '.'
}

# Every window on this server, with its first pane.
live() {
    local raw
    raw=$(tmux list-panes -a -F "#{window_id}$HT#{session_name}$HT#{window_index}$HT#{window_name}$HT#{pid}.#{start_time}$HT#{pane_id}$HT#{pane_current_path}$HT#{pane_index}" 2>/dev/null | tr '\t' '\037') || raw=""
    [ -n "$raw" ] || { echo '[]'; return 0; }
    printf '%s\n' "$raw" | jq -c -Rn '[inputs | split("\u001f") | select(length >= 8)
                 | {id: .[0], session: .[1], window: (.[2] | tonumber), name: .[3],
                    server: .[4], pane: .[5], cwd: .[6], pane_index: (.[7] | tonumber)}]
                | group_by(.id) | map(min_by(.pane_index) | del(.pane_index))' 2>/dev/null || echo '[]'
}

# keep_closed <entry file> <new session id>: before an entry is deleted or
# written over, file the conversation it names under closed/, unless it is
# the one taking its place; and a session live again is history no longer.
keep_closed() {
    local f="$1" new="${2:-}" old
    if [ -f "$f" ]; then
        old=$(jq -r '.session_id // ""' "$f" 2>/dev/null) || old=""
        if [ -n "$old" ] && [ "$old" != "$new" ]; then
            mkdir -p "$PANES/closed" 2>/dev/null || true
            jq --arg t "$(now)" '. + {closed: $t}' "$f" > "$PANES/closed/.tmp.$$" 2>/dev/null \
              && mv "$PANES/closed/.tmp.$$" "$PANES/closed/$(slug "$old").json" 2>/dev/null
            rm -f "$PANES/closed/.tmp.$$" 2>/dev/null
        fi
    fi
    [ -z "$new" ] || rm -f "$PANES/closed/$(slug "$new").json" 2>/dev/null
    return 0
}

write() {  # write <file> <json>
    [ -n "$2" ] || return 1
    printf '%s\n' "$2" > "$1.tmp.$$" 2>/dev/null && mv "$1.tmp.$$" "$1" 2>/dev/null
    rm -f "$1.tmp.$$" 2>/dev/null
}

# Carry out a plan, one step a line, fields joined by $US:
#   put   <file> <entry>             write a whole entry
#   merge <from> <to> <fields>       the entry in <from> as it is now, with
#                                    <fields> set, written to <to>
#   rm    <file> <keep 1|0> [label]  forget it, keeping its conversation as
#                                    history when <keep> is 1
# Writes go first, and a file just written is never removed. Every path is
# checked to be a registry file before anything is done with it.
apply() {
    local op a b c written="" plan
    plan=$(cat)
    while IFS="$US" read -r op a b c; do
        case "$a" in "$PANES"/*.json) ;; *) continue ;; esac
        case "$op" in
            put)   keep_closed "$a" "$(printf '%s' "$b" | jq -r '.session_id // ""' 2>/dev/null)"
                   write "$a" "$b" && written="$written$US$a$US" ;;
            merge) case "$b" in "$PANES"/*.json) ;; *) continue ;; esac
                   [ -f "$a" ] || continue
                   write "$b" "$(jq -c --argjson m "$c" '. + $m' "$a" 2>/dev/null)" || continue
                   written="$written$US$b$US"
                   [ "$a" = "$b" ] || rm -f "$a" ;;
        esac
    done <<EOF
$plan
EOF
    while IFS="$US" read -r op a b c; do
        [ "$op" = rm ] || continue
        case "$a" in "$PANES"/*.json) ;; *) continue ;; esac
        case "$written" in *"$US$a$US"*) continue ;; esac
        # Moved aside first, so a hook writing to this file meanwhile keeps
        # its entry, which a copy-then-delete would remove.
        mv -f "$a" "$PANES/.rm.$$" 2>/dev/null || continue
        [ "$b" = 1 ] && keep_closed "$PANES/.rm.$$" ""
        rm -f "$PANES/.rm.$$"
    done <<EOF
$plan
EOF
    return 0
}

# The jq every plan shares: the file an entry for a window lives in.
JQ_DEFS='def slug: gsub("[^A-Za-z0-9_.@-]"; "_");
def keyfile($dir): "\($dir)/\(.server | slug)-\(.id | slug).json";
def clean: del(._file);'

cmd_put() {
    local pane="${1:-}" kind="${2:-shell}" sid="${3:-}" state="${4:-live}" cwd="${5:-$PWD}" pid="${6:-}" src="${7:-}"
    [ -n "$pane" ] || return 0
    local meta s w n wid srv mates rest=0 all
    meta=$(tmux display-message -p -t "$pane" \
        "#{session_name}$HT#{window_index}$HT#{window_name}$HT#{window_id}$HT#{pid}.#{start_time}" 2>/dev/null | tr '\t' '\037') || return 0
    IFS="$US" read -r s w n wid srv <<EOF
$meta
EOF
    [ -n "$s" ] && [ -n "$wid" ] && [ -n "$srv" ] || return 0
    case "$w" in ''|*[!0-9]*) return 0 ;; esac
    mates=$(tmux list-panes -t "$wid" -F '#{pane_id}' 2>/dev/null | tr '\n' ' ') || mates=""
    restoring && rest=1
    lock || return 0
    all=$(entries) || return 0
    printf '%s' "$all" | jq -r --arg dir "$PANES" --arg s "$s" --arg w "$w" --arg n "$n" --arg wid "$wid" \
            --arg srv "$srv" --arg pane "$pane" --arg c "$cwd" --arg k "$kind" --arg i "$sid" \
            --arg st "$state" --arg p "$pid" --arg src "$src" --arg t "$(now)" \
            --arg mates " $mates" --arg rest "$rest" "$JQ_DEFS"'
        ({server: $srv, id: $wid} | keyfile($dir)) as $f
        | (map(select(._file == $f)) | first) as $mine
        # A shell starting in a split of a window whose agent still runs in
        # another of its panes is not what the window is: leave its entry be.
        | if $k == "shell" and $i == "" and $mine != null and ($mine.session_id // "") != ""
             and ($mine.pane // "") != $pane and ($mates | contains(" \($mine.pane // "-") "))
          then empty
          else
            ({session: $s, window: ($w | tonumber), name: $n, cwd: $c, kind: $k,
              session_id: $i, state: $st, recorded: $t, window_id: $wid, server: $srv, pane: $pane}
             + (if $p != "" then {pid: $p} else {} end)
             + (if $src != "" then {source: $src} else {} end)) as $new
            | "put\u001f\($f)\u001f\($new | tojson)",
              (.[] | select(._file != $f)
               # Another entry holding this session id: this record has it
               # now. One on this server keeps its window, as a shell.
               | if $i != "" and .session_id == $i then
                   (if .server == $srv
                    then "merge\u001f\(._file)\u001f\(._file)\u001f\({kind: "shell", session_id: "", state: "live"} | tojson)"
                    else "rm\u001f\(._file)\u001f0" end)
                 # This window filed by its index under an older server: what
                 # it held before. Not while hat-restore is rebuilding, when
                 # it may be an entry still waiting for its own window.
                 elif $rest == "0" and .server != $srv and .session == $s and .window == ($w | tonumber)
                 then "rm\u001f\(._file)\u001f1"
                 else empty end)
          end' 2>/dev/null | apply
}

cmd_adopt() {
    local f="${1:-}" wid="${2:-}" meta srv w pane to
    case "$f" in "$PANES"/*.json) ;; *) return 0 ;; esac
    [ -n "$wid" ] || return 0
    meta=$(tmux display-message -p -t "$wid" "#{pid}.#{start_time}$HT#{window_index}$HT#{pane_id}" 2>/dev/null | tr '\t' '\037') || return 0
    IFS="$US" read -r srv w pane <<EOF
$meta
EOF
    [ -n "$srv" ] || return 0
    lock || return 0
    to="$PANES/$(slug "$srv")-$(slug "$wid").json"
    # The window's own pane may have recorded itself already: that is newer.
    if [ -e "$to" ] && [ "$to" != "$f" ]; then
        printf 'rm%s%s%s0\n' "$US" "$f" "$US" | apply
        return 0
    fi
    printf 'merge%s%s%s%s%s%s\n' "$US" "$f" "$US" "$to" "$US" \
        "$(jq -cn --arg wid "$wid" --arg srv "$srv" --arg w "$w" --arg p "$pane" \
             '{window_id: $wid, server: $srv, window: ($w | tonumber), pane: $p}')" | apply
}

# This server's entries follow their windows: a window that is gone takes its
# entry with it, and one that moved, or whose session was renamed, carries its
# new place. Entries from before this server started are left to `prune` and
# to hat-restore, which may still be rebuilding them.
cmd_refresh() {
    local l all
    l=$(live)
    [ "$l" != "[]" ] || return 0
    lock || return 0
    all=$(entries) || return 0
    printf '%s' "$all" | jq -r --argjson live "$l" "$JQ_DEFS"'
        ($live[0].server) as $srv
        | ($live | map({key: .id, value: .}) | from_entries) as $by
        | .[] | select(.server == $srv)
        | $by[.window_id // ""] as $w
        | if $w == null then "rm\u001f\(._file)\u001f1"
          elif .session == $w.session and .window == $w.window and .name == $w.name then empty
          else "merge\u001f\(._file)\u001f\(._file)\u001f\({session: $w.session, window: $w.window, name: $w.name} | tojson)"
          end' 2>/dev/null | apply
}

# refresh, and more: an entry from before this server started is matched to a
# window by its session and index, the only guess there is, and refiled under
# that window or forgotten; two entries for one window keep the one recorded
# on it, else the latest; a session id held twice keeps its latest record; and
# a window with no entry is recorded as the shell it is.
#
# At boot the registry is the only truth there is, and tmux is empty because
# of whatever is being recovered from; so with no windows, or while
# hat-restore is still rebuilding, nothing is touched.
cmd_prune() {
    local dry=0 l all plan op a b c
    [ "${1:-}" = --dry-run ] && dry=1
    l=$(live)
    if [ "$l" = "[]" ]; then
        echo "hat-registry: tmux has no windows - refusing to prune"
        return 0
    fi
    if restoring; then
        echo "hat-registry: hat-restore is rebuilding - not pruning until it is done"
        return 0
    fi
    lock || { echo "hat-registry: another writer holds the registry - not pruning"; return 0; }
    all=$(entries) || { echo "hat-registry: could not read the registry - nothing changed"; return 0; }
    plan=$(printf '%s' "$all" | jq -r --argjson live "$l" --arg dir "$PANES" --arg t "$(now)" "$JQ_DEFS"'
        ($live[0].server) as $srv
        | ($live | map({key: .id, value: .}) | from_entries) as $by
        | ($live | map({key: "\(.session)\u001f\(.window)", value: .}) | from_entries) as $at
        | map(. as $e
              | (if .server == $srv then $by[.window_id // ""] else $at["\(.session)\u001f\(.window)"] end) as $w
              | {e: $e, w: $w, mine: (.server == $srv), at: (.recorded // ""),
                 to: (if $w then ($w | keyfile($dir)) else null end)})
        | (map(select(.w == null) | {e, why: "its window is gone"})) as $gone
        | (map(select(.w != null)) | group_by(.to)) as $per
        | ($per | map(sort_by(.mine, .at) | last)) as $one
        | ($per | map(sort_by(.mine, .at) | .[:-1][] | {e, why: "another entry has its window"})) as $twice
        | ($one | map(select((.e.session_id // "") != "")) | group_by(.e.session_id)
                | map(sort_by(.at, .mine) | .[:-1][])) as $dupes
        | ($dupes | map(.e._file)) as $dupf
        | ($one | map(select(.e._file as $x | $dupf | index([$x]) | not))) as $kept
        | ($kept | map(.w.id)) as $held
        | ($kept | map(.e.session_id // "" | select(. != ""))) as $ids
        | [ (($gone + $twice) | .[]
             | (.e.session_id // "") as $sid
             | (if $sid != "" and ($ids | index([$sid]) | not) then 1 else 0 end) as $keep
             | "rm\u001f\(.e._file)\u001f\($keep)\u001f\(.why): \(.e.session // ""):\(.e.window // "") (\(.e.name // ""))"),
            ($dupes[] | "rm\u001f\(.e._file)\u001f0\u001fa later record has its session id: \(.e.session // ""):\(.e.window // "")"),
            ($kept[] | . as $k
             | {session: $k.w.session, window: $k.w.window, name: $k.w.name,
                window_id: $k.w.id, server: $k.w.server} as $m
             | select($k.to != $k.e._file or ($k.e | clean) != (($k.e | clean) + $m))
             | "merge\u001f\($k.e._file)\u001f\($k.to)\u001f\($m | tojson)"),
            ($live[] | select(.id as $x | $held | index([$x]) | not)
             | {session, window, name, cwd, kind: "shell", session_id: "", state: "live",
                recorded: $t, window_id: .id, server, pane, source: "prune"} as $n
             | "put\u001f\({server, id} | keyfile($dir))\u001f\($n | tojson)") ]
        | .[]' 2>/dev/null) || { echo "hat-registry: could not work out a plan - nothing changed"; return 0; }
    local gone=0 added=0
    while IFS="$US" read -r op a b c; do
        case "$op" in
            rm)  gone=$((gone+1))
                 [ "$dry" = 1 ] && printf '  would forget: %s\n' "$c" ;;
            put) added=$((added+1))
                 [ "$dry" = 1 ] && printf '  would record as a shell: %s\n' \
                     "$(printf '%s' "$b" | jq -r '"\(.session):\(.window) (\(.name))"' 2>/dev/null)" ;;
        esac
    done <<EOF
$plan
EOF
    if [ "$dry" != 1 ]; then
        printf '%s\n' "$plan" | apply
        # History is for finding old conversations, not for restoring them,
        # so it has an age limit rather than a size one. The case keeps the
        # delete inside hatter's own state directory whatever PANES is.
        if [ -d "$PANES/closed" ]; then
            case "$PANES" in
                */hatter/panes) find "$PANES/closed" -maxdepth 1 -name '*.json' -mtime +"$((HISTORY_DAYS - 1))" -exec rm -f {} + 2>/dev/null ;;
            esac
        fi
    fi
    echo "hat-registry: forgot $gone entry(ies), recorded $added window(s) as shells"
}

case "${1:-}" in
    put)     shift; cmd_put "$@" ;;
    adopt)   shift; cmd_adopt "$@" ;;
    refresh) cmd_refresh ;;
    prune)   shift; cmd_prune "$@" ;;
    *)       echo "usage: hat-registry put|adopt|refresh|prune" >&2 ;;
esac
exit 0
HATREGISTRY
chmod +x "$HOME/.local/bin/hat-registry"

# Written beside it and moved into place: every pane runs hat-launch for as long
# as it is open, and bash reads a script as it goes, so one rewritten in place
# would have running copies resume at their old offset in the new text.
cat > "$HOME/.local/bin/hat-launch.new" <<'HATLAUNCH'
#!/usr/bin/env bash
# hat-launch - the command every pane runs.
#
# A pane declares what it is at birth instead of being guessed at afterwards.
# The launcher picks the kind, mints the agent's session id BEFORE starting it,
# and records the pane in a registry that outlives a reboot. "Which conversation
# was in this tab" then becomes something the tab wrote down, not something
# anything has to infer from hundreds of transcripts in one project directory.
#
#   hat-launch                        the hat's default kind
#   hat-launch --kind claude|codex|shell
#   hat-launch --resume claude <session-id>
#
# tmux options it reads: @hat_default_kind (the kind above) and
# @hat_<kind>_args (extra arguments for every launch of that kind).
#
# Two contracts inherited from the default-command this replaces, both
# load-bearing:
#   - the login shell runs in a loop, so `exit` and stray ctrl-D hand back a
#     fresh prompt instead of destroying the tab
#   - `exit 99` is the sentinel that actually closes it (99 and not 1 because
#     bare `exit` returns the last command's status)
set -uo pipefail


kind="" sid=""
while [ $# -gt 0 ]; do
    case "$1" in
        --kind)   kind="${2:-}"; shift 2 || shift ;;
        --resume) kind="${2:-claude}"; sid="${3:-}"; shift 3 || shift $# ;;
        *) shift ;;
    esac
done

# A hat chooses its own default through a tmux option; absent that it is a
# plain shell, which is exactly what panes did before this existed.
if [ -z "$kind" ] && [ -n "${TMUX:-}" ]; then
    kind=$(tmux show-options -gv @hat_default_kind 2>/dev/null) || kind=""
fi
[ -n "$kind" ] || kind=shell

# At boot tmux is started by systemd, so a pane inherits none of the login
# profile - and with it not CLAUDE_CONFIG_DIR, which moves where Claude Code
# keeps its transcripts. Without it `claude --resume` looks in ~/.claude and
# reports "No conversation found" for every session there is. The variables
# that decide where an agent lives are taken from a login shell instead.
#
# The shell asked is the account's own, from passwd: the boot unit pins
# SHELL=/bin/bash, and a zsh user's profile is not one bash reads. A profile
# that blocks gets 10 seconds, and anything it prints is skipped by reading
# only what follows the marker.
#
# A plain shell is a login shell itself and needs none of this; it is what
# most panes run, so it does not wait on a profile twice.
envf=""
if [ "$kind" != shell ]; then
    login_shell=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
    [ -x "${login_shell:-}" ] || login_shell="${SHELL:-/bin/bash}"
    # Read via a file, not a pipe: a profile that leaves a background child
    # holding the pipe open would keep the read loop waiting past the timeout.
    to=""; command -v timeout >/dev/null 2>&1 && to="timeout -k 2 10"
    envf=$(mktemp 2>/dev/null) || envf=""
fi
if [ -n "$envf" ]; then
    $to "$login_shell" -lc 'printf "HATENV\0"; env -0' </dev/null >"$envf" 2>/dev/null
    seen=0
    while IFS= read -r -d '' kv; do
        case "$kv" in *HATENV) seen=1; continue ;; esac
        [ "$seen" = 1 ] || continue
        case "$kv" in
            PATH=*|CLAUDE_CONFIG_DIR=*|CODEX_HOME=*) export "$kv" ;;
        esac
    done < "$envf"
    rm -f "$envf"
fi

# Extra arguments for every launch of this kind, new or resumed, from a tmux
# option such as `set -g @hat_claude_args '--permission-mode auto'`. A restored
# agent then starts the way a hand-started one would. The value is split on
# whitespace with no quote handling, so each argument must be a single word.
extra=()
if [ -n "${TMUX:-}" ]; then
    read -r -a extra <<< "$(tmux show-options -gv "@hat_${kind}_args" 2>/dev/null)" || extra=()
fi

# How Claude Code names a project dir after a path: /a/.b -> -a--b
mangle() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

# record <kind> <session id> <pid>: this pane's window, in the registry (see
# hat-registry). Never write stdout from here: nothing downstream expects it,
# and the hook sibling of this script shares the rule for a harder reason.
record() {
    [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
    "$HOME/.local/bin/hat-registry" put "$TMUX_PANE" "$1" "${2:-}" live "$PWD" "${3:-}" >/dev/null 2>&1
    return 0
}

run_agent() {
    local bin="$HOME/.local/bin/$kind"
    command -v "$kind" >/dev/null 2>&1 && bin="$(command -v "$kind")"
    [ -x "$bin" ] || { printf 'hat-launch: %s is not installed - falling back to a shell\n' "$kind" >&2; return 1; }

    case "$kind" in
        claude)
            if [ -n "$sid" ]; then
                # A resume that cannot work must not cost the id: the shell
                # this pane falls back to would otherwise overwrite the entry,
                # and the next restore would have nothing left to resume.
                local cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}" t dir proj start rc
                for t in "$cfg"/projects/*/"$sid".jsonl; do break; done
                if [ ! -e "$t" ]; then
                    printf 'hat-launch: no transcript for %s under %s/projects - not resuming; its registry entry is kept\n' "$sid" "$cfg" >&2
                    keep=1
                    return 1
                fi
                # `--resume` only searches the project dir named after the
                # current directory. If the transcript sits under another one,
                # move to the directory that name stands for. It is not
                # necessarily where the session started (a session can be moved
                # into a worktree), so pick it from every cwd the transcript
                # recorded.
                proj=${t%/*}; proj=${proj##*/}
                if [ "$(mangle "$PWD")" != "$proj" ]; then
                    while IFS= read -r dir; do
                        if [ "$(mangle "$dir")" = "$proj" ] && [ -d "$dir" ]; then
                            cd "$dir" 2>/dev/null && break
                        fi
                    done < <(grep -ao '"cwd":"[^"]*"' "$t" 2>/dev/null | cut -d'"' -f4 | sort -u)
                fi
                record claude "$sid" "$$"
                start=$(date +%s)
                "$bin" ${extra[@]+"${extra[@]}"} --resume "$sid"; rc=$?
                # A resume that dies at once ("No conversation found") never
                # ran: keep the id rather than record the shell over it.
                if [ "$rc" != 0 ] && [ $(( $(date +%s) - start )) -lt 15 ]; then
                    printf 'hat-launch: resuming %s failed at once (exit %s) - its registry entry is kept\n' "$sid" "$rc" >&2
                    keep=1
                fi
            else
                # Minting the id here is the whole point: it is known before the
                # agent starts, so a reboot never has to work out which session
                # this pane held.
                sid=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
                record claude "$sid" "$$"
                "$bin" ${extra[@]+"${extra[@]}"} --session-id "$sid"
            fi ;;
        *)
            record "$kind" "${sid:-}" "$$"
            "$bin" ${extra[@]+"${extra[@]}"} ;;
    esac
}

keep=0
[ "$kind" != shell ] && { run_agent || true; }

# Whatever happened above, the pane ends up here: a login shell in the loop the
# tab's survival depends on.
[ "$keep" = 1 ] || record shell "" "$$"
while :; do
    "${SHELL:-/bin/bash}" -l
    [ $? -eq 99 ] && break
    sleep 0.3
done
HATLAUNCH
chmod +x "$HOME/.local/bin/hat-launch.new"
mv -f "$HOME/.local/bin/hat-launch.new" "$HOME/.local/bin/hat-launch"

cat > "$HOME/.local/bin/hat-record" <<'HATRECORD'
#!/usr/bin/env bash
# hat-record - Claude Code SessionStart/SessionEnd hook.
#
# hat-launch records the panes it starts itself. This records every OTHER way a
# session begins: `claude` typed at a prompt, `claude --resume` picked from the
# list, a session forked. Without it the registry would quietly miss exactly the
# sessions that were started by hand, which are most of them.
#
# Two rules, both inherited from the hooks already on this box and both
# load-bearing:
#   - never write stdout: it is the hook JSON channel
#   - never exit non-zero: a failing hook breaks the session
set -uo pipefail

payload=$(cat 2>/dev/null) || payload=""

# No tmux is a silent no-op: claude runs outside tmux on some servers, and a
# hook that assumed $TMUX_PANE would break every session on that box.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0
command -v jq   >/dev/null 2>&1 || exit 0

sid=$(printf '%s' "$payload" | jq -r '.session_id // ""' 2>/dev/null) || sid=""
cwd=$(printf '%s' "$payload" | jq -r '.cwd // ""' 2>/dev/null) || cwd=""
ev=$(printf '%s' "$payload"  | jq -r '.hook_event_name // ""' 2>/dev/null) || ev=""
[ -n "$sid" ] || exit 0
[ -n "$cwd" ] || cwd="$PWD"

# SessionEnd keeps the entry and marks it ended: a tab whose agent exited before
# the power went out should come back as the shell it was, not as a resumed
# conversation nobody asked for.
state=live
[ "$ev" = SessionEnd ] && state=ended

"$HOME/.local/bin/hat-registry" put "$TMUX_PANE" claude "$sid" "$state" "$cwd" >/dev/null 2>&1
exit 0
HATRECORD
chmod +x "$HOME/.local/bin/hat-record"

cat > "$HOME/.local/bin/hat-restore" <<'HATRESTORE'
#!/usr/bin/env bash
# hat-restore - rebuild tmux from the durable registry, with the agents resumed.
#
# This is the half of restore that does not need the Mac. hatter restore drives
# the same rebuild from the client and additionally re-mirrors into cmux; this
# one runs on the server at boot, so the sessions are already standing by the
# time anything connects.
#
#   hat-restore            rebuild whatever is missing, print what it did
#   hat-restore --boot     the same, quietly, for the systemd unit
#   hat-restore --dry-run  print the tmux commands without running them
#   hat-restore --no-agents  rebuild the panes as plain shells
#   hat-restore --backfill   record the agents running RIGHT NOW
#   hat-restore --prune      forget entries whose tmux window is gone
#   hat-restore --no-prune   with --backfill, keep the orphans
#
# An agent's entry is not lost when its tab goes: hat-registry files it under
# $PANES/closed by session id first. That is history for `hatter find`, never
# restored here.
#
# --backfill exists because the hook only fires when a session starts. On a box
# that was already running agents when hatter arrived, the registry would stay
# empty until every one of them happened to restart - and the first reboot would
# restore nothing. `claude agents --json` knows each agent's pid, cwd and
# session id but not its pane, so each pid is walked up its parent chain until
# it lands on a tmux pane. That is the same join bin/unfleet does.
#
# Entries follow their windows as tmux reports them (see hat-registry), but an
# entry from before this server started, or from an older registry keyed by
# window index, is only a guess until something settles it. --prune does (see
# `hat-registry prune`), and --backfill runs it afterwards by default.
#
# The registry knows every tab this box has run, not which ones the client still
# wants. `hatter sync` writes that down in $STATE/sessions, and a rebuild skips
# any session not on it, so a workspace closed on the client stays closed even
# if its tmux session outlived it. No list - a client that has never synced -
# rebuilds everything, as before.
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hatter"
PANES="$STATE/panes"
KEEP="$STATE/sessions"
LAUNCH="$HOME/.local/bin/hat-launch"
REG="$HOME/.local/bin/hat-registry"
# Formats join fields with a tab: tmux 3.4 escapes \x1f in -F output, and
# with no UTF-8 locale (a server started at boot has none) even a tab comes
# back as "_" unless the client says it is UTF-8 (-u).
command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }

dry=0 quiet=0 agents=1 backfill=0 prune=0 no_prune=0
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        --boot) quiet=1 ;;
        --no-agents) agents=0 ;;
        --backfill) backfill=1 ;;
        --prune) prune=1 ;;
        --no-prune) no_prune=1 ;;
    esac
done
say() { [ "$quiet" = 1 ] || printf '%s\n' "$*"; }

slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9_.@-' '_'; }

do_backfill() {
    command -v tmux >/dev/null 2>&1 || { say "hat-restore: no tmux"; return 0; }
    command -v jq   >/dev/null 2>&1 || { say "hat-restore: no jq"; return 0; }
    mkdir -p "$PANES" 2>/dev/null || true

    local claude_bin
    claude_bin=$(command -v claude 2>/dev/null) || claude_bin="$HOME/.local/bin/claude"
    [ -x "$claude_bin" ] || { say "hat-restore: no claude binary"; return 0; }
    # Asked outside a login shell, `claude agents --json` answers [] rather than
    # failing, so the query goes through one. A backfill that silently found
    # nothing would look exactly like a box with no agents on it. Anything the
    # profile prints would break the JSON, so only what follows HATJSON is read.

    # pane_pid -> session/window/name/cwd
    local panes
    # Tab-joined, then turned into \x1f: tmux 3.4 escapes \x1f in -F output.
    local ht=$'\t'
    panes=$(tmux list-panes -a -F "#{pane_pid}$ht#{session_name}$ht#{window_index}$ht#{window_name}$ht#{pane_current_path}$ht#{pane_id}" 2>/dev/null | tr '\t' '\037') || panes=""
    [ -n "$panes" ] || { say "hat-restore: no tmux panes"; return 0; }

    local n=0 miss=0 pid cwd sid owner line ppid hops f
    while IFS=$'\x1f' read -r pid cwd sid; do
        [ -n "$sid" ] || continue

        # Walk up the parent chain: the agent is a grandchild of the pane's
        # shell, and how many levels deep depends on how it was started.
        owner=""; ppid="$pid"; hops=0
        while [ -n "$ppid" ] && [ "$ppid" != 1 ] && [ "$hops" -lt 12 ]; do
            line=$(printf '%s\n' "$panes" | awk -v p="$ppid" -F'\037' '$1==p {print; exit}')
            [ -n "$line" ] && { owner="$line"; break; }
            ppid=$(awk '{print $4}' "/proc/$ppid/stat" 2>/dev/null)
            hops=$((hops+1))
        done
        [ -n "$owner" ] || { miss=$((miss+1)); continue; }

        local _pp s w nm pcwd pane
        IFS=$'\x1f' read -r _pp s w nm pcwd pane <<EOT
$owner
EOT
        [ -n "$cwd" ] || cwd="$pcwd"
        if [ "$dry" = 1 ]; then
            printf '  would record: %s:%s (%s) -> %s\n' "$s" "$w" "${nm:-unnamed}" "$sid"
        else
            "$REG" put "$pane" claude "$sid" live "$cwd" "$pid" backfill >/dev/null 2>&1
        fi
        n=$((n+1))
    done <<EOT
$("${SHELL:-/bin/bash}" -lc "printf '\\nHATJSON\\n'; $(printf '%q' "$claude_bin") agents --json" 2>/dev/null | sed '1,/^HATJSON$/d' | jq -r '.[]? | select((.sessionId // "") != "") | [(.pid|tostring), (.cwd // ""), .sessionId] | map(. // "" | tostring) | join("\u001f")' 2>/dev/null)
EOT

    say "hat-restore: backfilled $n agent(s); $miss not traceable to a tmux pane"
    return 0
}

do_prune() {
    if [ "$dry" = 1 ]; then "$REG" prune --dry-run; else "$REG" prune; fi
}

if [ "$backfill" = 1 ]; then
    do_backfill
    [ "$no_prune" = 1 ] || do_prune
    exit 0
fi

if [ "$prune" = 1 ]; then
    do_prune
    exit 0
fi

command -v tmux >/dev/null 2>&1 || { say "hat-restore: no tmux"; exit 0; }
command -v jq   >/dev/null 2>&1 || { say "hat-restore: no jq"; exit 0; }
[ -d "$PANES" ] || { say "hat-restore: nothing recorded in $PANES"; exit 0; }

# One line per window, ordered so that the lowest window of each session comes
# first - the session has to be created by its own first window. A session id
# held by more than one entry, which an older registry allowed, resumes only in
# the latest; the others come back as shells.
entries=$(jq -n '[inputs | objects | . + {_file: input_filename}]' "$PANES"/*.json 2>/dev/null \
    | jq -r 'map(select(.session != null))
             | (map(select((.session_id // "") != "")) | group_by(.session_id)
                | map(sort_by(.recorded // "") | .[:-1][] | ._file)) as $dup
             | map(._file as $f | if ($dup | index([$f])) then .kind = "shell" | .session_id = "" else . end)
             | sort_by(.session, .window)
             | .[] | [.session, (.window|tostring), .name, .cwd,
                      (.kind // "shell"), (.session_id // ""), (.state // "live"),
                      (.window_id // ""), (.server // ""), ._file]
             | map(. // "" | tostring) | join("\u001f")' 2>/dev/null) || entries=""
[ -n "$entries" ] || { say "hat-restore: no usable entries"; exit 0; }

# The server as it stands: an entry recorded on it whose window is still there
# is already standing, wherever that window has moved.
ht=$'\t'
cur=$(tmux list-windows -a -F "#{pid}.#{start_time}$ht#{window_id}" 2>/dev/null) || cur=""
server=$(printf '%s\n' "$cur" | head -n 1 | cut -f 1)

# While this rebuilds, entries from before the server started are waiting for
# their windows: hat-registry neither prunes them nor takes their index.
if [ "$dry" = 0 ]; then
    echo $$ > "$STATE/restoring" 2>/dev/null || true
    trap 'rm -f "$STATE/restoring"' EXIT
fi

# rekey <entry file> <window id>: file the entry under the window just made
# for it, so it follows that window from now on.
rekey() { [ -n "$2" ] && "$REG" adopt "$1" "$2" >/dev/null 2>&1; return 0; }

run() {
    if [ "$dry" = 1 ]; then printf '  would: %s\n' "$*"; else "$@"; fi
}

# Sessions this run has created. A dry run executes nothing, so without this
# every window of a session reports itself as a new-session and the preview
# describes a rebuild that would never happen that way.
seen=""
have_session() {
    case " $seen " in *" $1 "*) return 0 ;; esac
    tmux has-session -t "=$1" 2>/dev/null
}

made=0 skipped=0 unwanted=0 built=""
while IFS=$'\x1f' read -r s w n cwd kind sid state wid srv file; do
    [ -n "$s" ] || continue
    if [ -n "$server" ] && [ "$srv" = "$server" ] \
       && printf '%s\n' "$cur" | grep -qxF -- "$server$ht$wid"; then
        skipped=$((skipped+1))
        continue
    fi
    if [ -f "$KEEP" ] && ! grep -qxF -- "$s" "$KEEP"; then
        [ "$dry" = 1 ] && printf '  would leave closed: %s:%s  (not in the client config)\n' "$s" "$w"
        unwanted=$((unwanted+1))
        continue
    fi
    [ -d "$cwd" ] || cwd="$HOME"

    # A pane whose agent had already exited comes back as the shell it was.
    cmd="$LAUNCH --kind shell"
    if [ "$agents" = 1 ] && [ "$kind" != shell ] && [ "$state" = live ] && [ -n "$sid" ]; then
        cmd="$LAUNCH --resume $kind $sid"
    elif [ "$agents" = 1 ] && [ "$kind" != shell ] && [ "$state" = live ]; then
        cmd="$LAUNCH --kind $kind"
    fi

    if ! have_session "$s"; then
        say "  session $s  (window $w: ${n:-unnamed})"
        if [ "$dry" = 1 ]; then
            run tmux new-session -d -s "$s" -n "${n:-shell}" -c "$cwd" "$cmd"
        else
            nw=$(tmux new-session -d -s "$s" -n "${n:-shell}" -c "$cwd" -P -F '#{window_id}' "$cmd")
            built="$built $nw"
            rekey "$file" "$nw"
        fi
        seen="$seen $s"
        made=$((made+1))
        continue
    fi

    # The session exists. Only add a window that is not already there, so a
    # rerun - or a run after someone rebuilt half of it by hand - is harmless.
    # An index this run has itself just filled is another entry's stale hint
    # meeting this one: both are windows to rebuild, so this one goes after.
    target="=$s:$w"
    if [ "$dry" = 0 ]; then
        occupant=$(tmux list-windows -t "=$s" -F "#{window_index}$ht#{window_id}" 2>/dev/null \
                   | awk -F '\t' -v w="$w" '$1 == w { print $2 }' | head -n 1)
        if [ -n "$occupant" ]; then
            case " $built " in
                *" $occupant "*) target="=$s:" ;;
                *) skipped=$((skipped+1)); continue ;;
            esac
        fi
    fi
    say "  window $s:$w  (${n:-unnamed})"
    if [ "$dry" = 1 ]; then
        run tmux new-window -d -t "$target" -n "${n:-shell}" -c "$cwd" "$cmd"
    else
        nw=$(tmux new-window -d -t "$target" -n "${n:-shell}" -c "$cwd" -P -F '#{window_id}' "$cmd")
        built="$built $nw"
        rekey "$file" "$nw"
    fi
    made=$((made+1))
done <<< "$entries"

say "hat-restore: $made created, $skipped already present, $unwanted left closed"
exit 0
HATRESTORE
chmod +x "$HOME/.local/bin/hat-restore"

cat > "$HOME/.local/bin/hat-resize" <<'HATRESIZE'
#!/usr/bin/env bash
# hat-resize - bring windows stuck at 80x24 up to the size the client uses.
#
#   hat-resize                     every session
#   hat-resize <session>           one session
#   hat-resize [<session>] --size 180x57   a size other than the recorded one
#
# A window no client has sized stays at tmux's 80x24, and a control-mode client
# such as cmux does not size every window it shows. The size comes from the
# record hat-save keeps. Each window is resized by its id: resize-window with no
# target acts on the session's current window, which under a control-mode
# client is not the window you are in.
#
# tmux then holds each window at that size (window-size manual), even when the
# client resizes. To let one follow the client again:
#   tmux set-window-option -u -t <window> window-size
# No UTF-8 locale here at boot: without -u, tmux turns every non-ASCII
# character in a name into "_" (#109).
command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }
set -u

session="" size=""
while [ $# -gt 0 ]; do
    case "$1" in
        --size) size="${2:-}"; shift 2 || { echo "hat-resize: --size needs WxH" >&2; exit 2; } ;;
        -*)     echo "hat-resize: unknown option: $1" >&2; exit 2 ;;
        *)      session="$1"; shift ;;
    esac
done

if [ -z "$size" ]; then
    size=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/hatter/window-size" 2>/dev/null) || size=""
    [ -n "$size" ] || { echo "hat-resize: no window size recorded yet - pass --size WxH" >&2; exit 1; }
fi
case "$size" in
    [1-9]*x[1-9]*) ;;
    *) echo "hat-resize: not a size: '$size' (want WxH, e.g. 180x57)" >&2; exit 2 ;;
esac
w=${size%x*} h=${size#*x}
case "$w$h" in *[!0-9]*) echo "hat-resize: not a size: '$size'" >&2; exit 2 ;; esac

if [ -n "$session" ]; then
    windows=$(tmux list-windows -t "=$session" -F '#{window_id} #{window_width}x#{window_height}' 2>/dev/null) \
        || { echo "hat-resize: no session '$session'" >&2; exit 1; }
else
    windows=$(tmux list-windows -a -F '#{window_id} #{window_width}x#{window_height}' 2>/dev/null) \
        || { echo "hat-resize: no tmux server" >&2; exit 1; }
fi

n=0
for id in $(printf '%s\n' "$windows" | awk '$2 == "80x24" {print $1}'); do
    tmux resize-window -t "$id" -x "$w" -y "$h" && n=$((n + 1))
done
echo "hat-resize: $n window(s) resized to $size"
HATRESIZE
chmod +x "$HOME/.local/bin/hat-resize"

# The hook catches a session started by hand - `claude` typed at a prompt -
# which is most of them. It goes in as its OWN entry appended to the arrays, so
# an existing hook pipeline on this box is never touched, and running it twice
# is a no-op.
#
# It goes in the settings file Claude Code actually reads. A login profile that
# exports CLAUDE_CONFIG_DIR moves that file out of ~/.claude, and a hook wired
# into the old one never fires: the registry is then fed by --backfill alone
# and drifts out of step with the tabs.
claude_cfg=$("${SHELL:-/bin/bash}" -lc 'printf "HATCFG<%s>" "${CLAUDE_CONFIG_DIR:-}"' </dev/null 2>/dev/null) || claude_cfg=""
case "$claude_cfg" in
    *"HATCFG<"*) claude_cfg=${claude_cfg##*HATCFG<}; claude_cfg=${claude_cfg%%>*} ;;
    *) claude_cfg="" ;;
esac
[ -n "$claude_cfg" ] || claude_cfg="$HOME/.claude"
claude_settings="$claude_cfg/settings.json"
if [ -f "$claude_settings" ] && command -v jq >/dev/null 2>&1; then
    [ -e "$claude_settings.hatter.bak" ] || cp "$claude_settings" "$claude_settings.hatter.bak"
    if jq --arg c "$HOME/.local/bin/hat-record" '
            def add(ev):
              .hooks[ev] = ((.hooks[ev] // [])
                + (if [(.hooks[ev] // [])[]?.hooks[]?.command] | any(. == $c)
                   then [] else [{hooks:[{type:"command",command:$c}]}] end));
            add("SessionStart") | add("SessionEnd")
       ' "$claude_settings" > "$claude_settings.hatter.new"; then
        # Written through, not moved over: a symlinked settings.json stays one.
        if ! cat "$claude_settings.hatter.new" > "$claude_settings"; then
            cp "$claude_settings.hatter.bak" "$claude_settings" 2>/dev/null || true
            rm -f "$claude_settings.hatter.new"
            echo "WARNING: could not write $claude_settings - restored from settings.json.hatter.bak" >&2
        else
            rm -f "$claude_settings.hatter.new"
            echo "hat-record wired into SessionStart/SessionEnd in $claude_settings (backup: settings.json.hatter.bak)"
        fi
    else
        rm -f "$claude_settings.hatter.new"
        echo "WARNING: could not update $claude_settings - left unchanged" >&2
    fi
else
    echo "no $claude_settings (or no jq) - skipping the session hook"
fi

# A systemd user unit only fires at boot with lingering on, which is also what
# keeps the tmux server alive across logout. Say so rather than installing a
# unit that will never run.
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/systemd/user"
    cat > "$HOME/.config/systemd/user/hatter-restore.service" <<'HATUNIT'
[Unit]
Description=hatter: rebuild tmux sessions and resume agents after a reboot
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/hat-restore --boot
# The agents need the user's own PATH and login environment, not systemd's.
Environment=SHELL=/bin/bash

[Install]
WantedBy=default.target
HATUNIT
    systemctl --user daemon-reload
    if systemctl --user enable hatter-restore.service >/dev/null 2>&1; then
        echo "hatter-restore.service enabled (runs at boot)"
    else
        echo "WARNING: could not enable hatter-restore.service" >&2
    fi
    if command -v loginctl >/dev/null 2>&1; then
        case "$(loginctl show-user "$(id -un)" --property=Linger 2>/dev/null)" in
            Linger=yes) : ;;
            *) echo "NOTE: lingering is off - the boot unit will not run until:"
               echo "        sudo loginctl enable-linger $(id -un)" ;;
        esac
    fi
else
    echo "no systemd --user here - hook up hat-restore at boot by hand; nothing restores tmux after a reboot until then"
fi

# tmux-continuum saves from a status-line interpolation, and a control-mode
# client - which is what cmux attaches with - never draws one, so its autosave
# never fires. Measured stale by weeks on every hat. A timer calls the same save
# script directly, independent of whether anything is drawing.
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1 \
   && [ -x "$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh" ]; then
    cat > "$HOME/.local/bin/hat-save" <<'HATSAVE'
#!/usr/bin/env bash
# hat-save - one tmux-resurrect snapshot, for the systemd timer.
#
# save.sh writes a snapshot and points `last` at it even when there is nothing
# to save: with no tmux server it writes an empty file, and restoring from that
# brings back no sessions at all - just when a restore is needed. So this only
# saves while there are sessions, and if the snapshot still comes out empty
# (the server died mid-save) it points `last` back at the one before.
#
# It also records the window size the client really uses, which .tmux.conf
# reads at server start: a restore makes its windows with no client attached,
# and without it they come back at tmux's 80x24.
# No UTF-8 locale here at boot: without -u, tmux turns every non-ASCII
# character in a name into "_" (#109).
command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }
set -u

save="$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh"
[ -x "$save" ] || { echo "hat-save: no tmux-resurrect"; exit 0; }
command -v tmux >/dev/null 2>&1 || { echo "hat-save: no tmux"; exit 0; }

# The registry follows its windows on tmux's hooks; `move-window -r` and the
# like fire none, so it is brought up to date here too.
"$HOME/.local/bin/hat-registry" refresh >/dev/null 2>&1 || true

sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null) || sessions=""
if [ -z "$sessions" ]; then
    echo "hat-save: no tmux sessions - keeping the last snapshot"
    exit 0
fi

# The commonest window size that no default explains. A window no client has
# sized sits at 80x24 or at the current default-size, so neither counts; when
# nothing else is left, the record stands. It is applied here too, so windows
# made on this server from now on start at it.
state="${XDG_STATE_HOME:-$HOME/.local/state}/hatter"
def=$(tmux show-option -gv default-size 2>/dev/null) || def=""
size=$(tmux list-windows -a -F '#{window_width}x#{window_height}' 2>/dev/null \
    | grep -vxF -e 80x24 -e "${def:-80x24}" | sort | uniq -c | sort -rn | awk 'NR == 1 {print $2}')
if [ -n "$size" ] && mkdir -p "$state" \
   && printf '%s\n' "$size" > "$state/window-size.tmp" && mv "$state/window-size.tmp" "$state/window-size"; then
    tmux set-option -g default-size "$size" 2>/dev/null || true
fi

# Where resurrect keeps its snapshots, resolved the way resurrect does.
dir=$(tmux show-option -gqv @resurrect-dir 2>/dev/null) || dir=""
if [ -z "$dir" ]; then
    if [ -d "$HOME/.tmux/resurrect" ]; then
        dir="$HOME/.tmux/resurrect"
    else
        dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    fi
fi
dir="${dir//\$HOME/$HOME}"
dir="${dir//\~/$HOME}"

# resurrect writes a pane's scrollback to pane_contents/pane-<session>:<w>.<p>.
# A / in the session name makes that a path into a folder resurrect never
# creates, so the write fails and the scrollback is lost. Make the folder. Its
# own clean-up, a plain `rm dir/*`, never empties a folder, so also delete
# this pane's old file in save and restore: a pane with nothing on screen
# must not get the last one's scrollback back. A `..` could reach outside
# pane_contents, so those panes are left alone.
case "$dir" in
    /*) tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null \
        | while IFS= read -r id; do
            case "$id" in */*) ;; *) continue ;; esac
            case "$id" in *..*) continue ;; esac
            f="$dir/save/pane_contents/pane-$id"
            mkdir -p "${f%/*}" && rm -f -- "$f" "$dir/restore/pane_contents/pane-$id"
        done ;;
esac

prev=$(readlink "$dir/last" 2>/dev/null) || prev=""
"$save" quiet || exit $?
now=$(readlink "$dir/last" 2>/dev/null) || now=""
case "$now" in
    "")  exit 0 ;;
    /*)  snap="$now" ;;
    *)   snap="$dir/$now" ;;
esac
if [ -n "$prev" ] && [ "$now" != "$prev" ] && [ ! -s "$snap" ]; then
    ln -sfn "$prev" "$dir/last"
    echo "hat-save: snapshot came out empty - last still points at $prev"
fi
exit 0
HATSAVE
    chmod +x "$HOME/.local/bin/hat-save"
    cat > "$HOME/.config/systemd/user/hatter-resurrect-save.service" <<'SAVESVC'
[Unit]
Description=hatter: tmux-resurrect snapshot (continuum cannot save under a control-mode client)

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hat-save
SAVESVC
    cat > "$HOME/.config/systemd/user/hatter-resurrect-save.timer" <<'SAVETIMER'
[Unit]
Description=hatter: snapshot tmux every 15 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
SAVETIMER
    systemctl --user daemon-reload
    if systemctl --user enable --now hatter-resurrect-save.timer >/dev/null 2>&1; then
        echo "resurrect save timer enabled (every 15 min)"
    else
        echo "WARNING: could not enable the resurrect save timer" >&2
    fi
fi

# ~/.local/bin is only on PATH for a login shell if the shell's profile adds it.
# Ubuntu's ~/.profile does, but only when the directory already existed at login,
# and zsh never reads ~/.profile at all. Make it deterministic.
ensure_path_in() {
    f="$1"
    [ -e "$f" ] || touch "$f"
    # An earlier release wrote this block under the old name; relabel it in
    # place rather than appending a second, identical one.
    if grep -qF 'muxmux: ~/.local/bin on PATH' "$f" 2>/dev/null; then
        sed 's/^# muxmux: ~\/.local\/bin on PATH/# hatter: ~\/.local\/bin on PATH/' \
            "$f" > "$f.hatter.tmp" && mv "$f.hatter.tmp" "$f"
        echo "relabelled the PATH block in $f"
    fi
    grep -qF 'hatter: ~/.local/bin on PATH' "$f" 2>/dev/null && return 0
    cat >> "$f" <<'PATHBLOCK'

# hatter: ~/.local/bin on PATH (for `bye`)
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH
PATHBLOCK
    echo "added ~/.local/bin to PATH in $f"
}

case "$(basename "${SHELL:-/bin/sh}")" in
    zsh)  ensure_path_in "$HOME/.zprofile" ;;
    bash) ensure_path_in "$HOME/.profile" ;;
    *)    ensure_path_in "$HOME/.profile" ;;
esac

# zsh has a builtin `bye`, a synonym for `exit`, and builtins win over PATH.
# Left alone, `bye` is a plain `exit 0`: the pane loop hands back a fresh
# prompt and ~/.local/bin/bye never runs. Disable the builtin in every
# interactive zsh, which is where `bye` gets typed.
if [ "$(basename "${SHELL:-/bin/sh}")" = zsh ]; then
    [ -e "$HOME/.zshrc" ] || touch "$HOME/.zshrc"
    if ! grep -qF 'hatter: zsh builtin bye off' "$HOME/.zshrc"; then
        cat >> "$HOME/.zshrc" <<'ZSHBYE'

# hatter: zsh builtin bye off (it is `exit`; use ~/.local/bin/bye)
disable bye 2>/dev/null
ZSHBYE
        echo "disabled zsh's builtin bye in ~/.zshrc"
    fi
fi

# tpm reads the @plugin options off the running tmux server, so the config has
# to be sourced before install_plugins can see what to fetch.
tmux source-file "$CONF" >/dev/null 2>&1 || true
"$HOME/.tmux/plugins/tpm/bin/install_plugins" || true
tmux source-file "$CONF" >/dev/null 2>&1 || true

for p in tmux-resurrect tmux-continuum; do
    if [ -d "$HOME/.tmux/plugins/$p" ]; then
        echo "ok: $p"
    else
        echo "WARNING: $p did not install" >&2
    fi
done

# Apply to the already-running server too, not just future ones. A long-lived
# server can hold a pane-died hook that reads as set but never fires, so clear
# it before setting it rather than assuming the value is live.
if tmux has-session 2>/dev/null; then
    tmux set -g default-command 'h="$HOME/.local/bin/hat-launch"; [ -x "$h" ] && exec "$h"; while true; do "$SHELL" -l; [ $? -eq 99 ] && break; sleep 0.3; done'
    tmux set -g remain-on-exit off
    tmux set-hook -gu pane-died 2>/dev/null || true
    tmux set -g window-size latest 2>/dev/null || true
    tmux setw -g aggressive-resize on 2>/dev/null || true
    echo "applied to the running tmux server"
    # A launch option set on this server by hand but not in the config is gone
    # at the next server start. Say so, rather than unset what someone chose.
    for o in $(tmux show-options -g 2>/dev/null | awk '$1 ~ /^@hat_/ { print $1 }'); do
        grep -q "^set -g $o " "$LAUNCH_CONF" \
            || echo "NOTE: $o is set on the running server (by hand, or by an earlier provision) but not in hatter's config, so a fresh server will not have it. Record it with \`hatter hat set\`, or clear it: tmux set -gu $o"
    done
fi

# Prove it actually works rather than trusting show-options: a shell that exits
# must come back with a usable prompt, in a throwaway session.
tmux kill-session -t '=hatter-selftest' 2>/dev/null || true
# hat-launch is asked for a shell: a hat whose panes default to an agent would
# otherwise have these keys typed into its prompt.
tmux new-session -d -s hatter-selftest -x 80 -y 24 "$HOME/.local/bin/hat-launch --kind shell"
sleep 1
tmux send-keys -t '=hatter-selftest:0' 'exit' Enter
sleep 2
if ! tmux has-session -t '=hatter-selftest' 2>/dev/null; then
    echo "SELFTEST FAILED: session died when its shell exited" >&2
else
    tmux send-keys -t '=hatter-selftest:0' 'echo selftest-ok-$((6*7))' Enter
    sleep 1
    if tmux capture-pane -p -t '=hatter-selftest:0' | grep -q 'selftest-ok-42'; then
        echo "selftest ok: exiting a shell hands back a working prompt"
    else
        echo "SELFTEST FAILED: shell did not come back usable after exit" >&2
    fi
fi
tmux kill-session -t '=hatter-selftest' 2>/dev/null || true

# ...and that the deliberate exits really do close it.
tmux kill-session -t '=hatter-selftest2' 2>/dev/null || true
tmux new-session -d -s hatter-selftest2 -x 80 -y 24 "$HOME/.local/bin/hat-launch --kind shell"
sleep 1
tmux send-keys -t '=hatter-selftest2:0' 'exit 99' Enter
sleep 2
if tmux has-session -t '=hatter-selftest2' 2>/dev/null; then
    echo "SELFTEST FAILED: 'exit 99' did not close the session" >&2
    tmux kill-session -t '=hatter-selftest2' 2>/dev/null || true
else
    echo "selftest ok: 'exit 99' closes the tab"
fi

# `bye` has to resolve to the script in an interactive login shell, which is
# what panes run. Being on PATH is not enough: a builtin, alias or function of
# the same name wins, and `command -v` reports those too. An rc file may print
# to the terminal as it starts (a color escape, a greeting), so only what
# follows the marker is read.
bye_resolves=$("${SHELL:-/bin/sh}" -lic 'printf "HATBYE<%s>" "$(command -v bye)"' 2>/dev/null </dev/null) || true
case "$bye_resolves" in
    *"HATBYE<"*) bye_resolves=${bye_resolves##*HATBYE<}; bye_resolves=${bye_resolves%%>*} ;;
    *) bye_resolves="" ;;
esac
if [ "$bye_resolves" = "$HOME/.local/bin/bye" ]; then
    echo "selftest ok: 'bye' resolves to ~/.local/bin/bye in a login shell"
else
    echo "SELFTEST FAILED: 'bye' resolves to '${bye_resolves:-nothing}', not ~/.local/bin/bye" >&2
fi

# The boot-recovery pieces: each must run, and hat-restore must be able to read
# its own registry. A dry run touches nothing.
if "$HOME/.local/bin/hat-restore" --dry-run >/dev/null 2>&1; then
    echo "selftest ok: 'hat-restore' runs"
else
    echo "SELFTEST FAILED: 'hat-restore' did not run" >&2
fi
if "$HOME/.local/bin/hat-registry" refresh >/dev/null 2>&1; then
    echo "selftest ok: 'hat-registry' runs"
else
    echo "SELFTEST FAILED: 'hat-registry' must never exit non-zero" >&2
fi
if printf '{}' | "$HOME/.local/bin/hat-record" >/dev/null 2>&1; then
    echo "selftest ok: 'hat-record' is a silent no-op outside tmux"
else
    echo "SELFTEST FAILED: 'hat-record' must never exit non-zero" >&2
fi
if systemctl --user is-enabled hatter-restore.service >/dev/null 2>&1; then
    echo "selftest ok: boot restore is enabled"
else
    echo "NOTE: boot restore is not enabled on this host"
fi

# A box that was already running agents when hatter arrived would otherwise sit
# with an empty registry until every one of them happened to restart, and the
# first reboot would restore nothing. Record them now.
if "$HOME/.local/bin/hat-restore" --backfill 2>&1 | tail -1; then :; fi

# hat-creds only has to run; it is driven over ssh with an explicit path.
if python3 "$HOME/.local/bin/hat-creds" status >/dev/null 2>&1; then
    echo "selftest ok: 'hat-creds' runs (credential push is available)"
else
    echo "SELFTEST FAILED: 'hat-creds' did not run - is python3 installed?" >&2
fi

echo "provisioned: $(tmux -V)"
REMOTE_EOF
}

# -------------------------------------------------------------- subcommands

cmd_new() {
    local session="${1:-}" group="" hat="" ssh_dest="" dir=""
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --group) group="$2"; shift 2 ;;
            --hat) hat="$2"; shift 2 ;;
            --ssh|--host) ssh_dest="$2"; shift 2 ;;
            --dir) dir="$2"; shift 2 ;;
            # Land on the new workspace, rather than going back to where this
            # was run from.
            --focus|--go) HATTER_FOCUS_KEEP=1; shift ;;
            *) die "unknown flag: $1" ;;
        esac
    done
    [[ -n "$session" ]] || usage_exit
    local given="$session"
    session=$(tmux_session_name "$session")
    [[ "$session" == "$given" ]] || \
        warn "tmux cannot hold '.' or ':' in a session name - using '$session'"

    # Work out the hat, most specific source first: an explicit --hat, then an
    # existing record for this session, then the group it is going into, then
    # the session name's own prefix.
    if [[ -n "$hat" ]]; then
        hat_exists "$hat" || register_hat "$hat" "$ssh_dest" "$dir"
    else
        hat=$(session_hat_typed "$session" "hatter new $session --hat <hat>" here) || exit 1
    fi

    if [[ -z "$hat" && -n "$group" ]] && group_exists "$group"; then
        hat=$(group_hat "$group")
    fi

    if [[ -z "$hat" ]]; then
        hat="${session%%-*}"
        if [[ "$hat" == "$session" ]]; then
            # No prefix to read. If this hatter was started inside a cmux
            # window, that window names the hat - which is the whole point of
            # typing a bare name while wearing one.
            hat=$(current_hat || true)
            [[ -n "$hat" ]] && info "no hat given - taking '$hat' from this window"
        fi
        if [[ -z "$hat" || "$hat" == "$session" ]]; then
            die "cannot tell which hat '$session' belongs to.
  Either name it <hat>-<subproject>, or pass --hat <hat>.
  Known hats: $(hat_names | tr '\n' ' ')"
        fi
        hat_exists "$hat" || register_hat "$hat" "$ssh_dest" "$dir"
    elif [[ -n "$ssh_dest" ]]; then
        register_hat "$hat" "$ssh_dest" "$dir"
    fi

    # Now that the hat is known, a bare name can take its prefix - unless it
    # names a session the hat already has, which is then reattached.
    session=$(hat_session_name "$hat" "$session")

    # Work out the group. A session Unassigned holds is one nobody placed;
    # creating or attaching it on purpose places it, so with no --group it
    # moves to the hat's default or first real group, when the hat has one.
    if [[ -z "$group" ]]; then
        group=$(session_group "$session" "$hat") || true
        if [[ -n "$group" ]] && group_managed "$group"; then
            local placed_in
            placed_in=$(hat_default_group "$hat")
            [[ -n "$placed_in" ]] || placed_in=$(hat_pick_group "$hat")
            if [[ -n "$placed_in" && "$placed_in" != "$group" ]] && ! group_name_reserved "$placed_in"; then
                info "Moving '$session' out of $UNASSIGNED into group '$placed_in'"
                group="$placed_in"
            fi
        fi
    fi
    if [[ -z "$group" ]]; then
        group=$(hat_default_group "$hat")
    fi
    if [[ -z "$group" ]]; then
        group=$(hat_pick_group "$hat")
    fi
    if [[ -z "$group" ]]; then
        [[ -t 0 ]] || die "no group for '$session' and no --group given"
        read -r -p "  workspace group for $session: " group
        [[ -n "$group" ]] || die "no group given"
    fi
    group_exists "$group" || register_group "$group" "$hat"

    local host d
    host=$(hat_ssh "$hat"); d=$(hat_dir "$hat")
    [[ -n "$host" ]] || die "hat '$hat' has no ssh destination"

    ensure_remote_session "$host" "$session" "$d"
    seen_now "$host" "$session"
    local had_un=0
    group_exists "$(unassigned_key "$hat")" && had_un=1
    remember_session "$group" "$session"

    local win gref wref
    win=$(ensure_hat_window "$hat")
    gref=$(ensure_cmux_group "$group" "$win")
    mirror_hat "$hat" "$win"

    wref=$(wait_for_workspace "$session" "$win")
    if [[ -z "$wref" ]]; then
        warn "tmux session '$session' is running on $host, but cmux has not mirrored it"
        warn "the session and the config entry are both fine - retry with: hatter new $session"
        die "no cmux workspace appeared for '$session'"
    fi

    cmux_group_add "$gref" "$wref" || die "cmux would not put '$session' into group '$(group_display "$group")'"
    apply_group_style "$group" "$gref"
    [[ "$had_un" == 0 ]] || drop_unassigned_now "$hat" "$win"
    discard_stray_workspace "$win"
    # Without --focus the run ends back where it started, so selecting the new
    # workspace would only flash it.
    if [[ "$HATTER_FOCUS_KEEP" == 1 ]]; then
        cmux_change workspace select --workspace "$wref" >/dev/null 2>&1 || \
            cmux_change select-workspace --workspace "$wref" --window "$win" >/dev/null
    fi

    echo
    echo "  Hat:        $hat  ($host)"
    echo "  Window:     $win"
    echo "  Group:      $group"
    echo "  tmux:       $session"
    echo "  Workspace:  $wref"
}

hat_status_row() {
    local hat="$1" dest probe err reach tmuxv resurrect sessions win
    dest=$(hat_ssh "$hat")

    err=$(mktemp)
    if probe=$(ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$dest" "$(posix_sh '
        printf "%s|" "$(tmux -V 2>/dev/null | awk "{print \$2}")"
        if [ -d "$HOME/.tmux/plugins/tmux-resurrect" ] \
           && [ -d "$HOME/.tmux/plugins/tmux-continuum" ]; then
            printf "yes|"
        else
            printf "no|"
        fi
        printf "%s" "$(tmux list-sessions 2>/dev/null | wc -l | tr -d " ")"
    ')" 2>"$err"); then
        reach="up"
        IFS='|' read -r tmuxv resurrect sessions <<<"$probe"
        [[ -n "$tmuxv" ]] || { tmuxv="-"; resurrect="-"; }
    else
        # say *why* it is down - "no DNS" on a server you have not built yet is
        # a very different problem from "auth"
        case "$(cat "$err")" in
            *"Could not resolve hostname"*) reach="no DNS" ;;
            *"Connection refused"*)         reach="refused" ;;
            *"Permission denied"*)          reach="auth" ;;
            *"timed out"*|*"Timeout"*)      reach="timeout" ;;
            *"Host key verification"*)      reach="hostkey" ;;
            *)                              reach="down" ;;
        esac
        tmuxv="-"; resurrect="-"; sessions="-"
    fi
    rm -f "$err"

    win=$(find_hat_window "$hat")
    [[ -n "$win" ]] && win="${win:0:8}" || win="-"

    printf '%-10s  %-24s  %-8s  %-5s  %-8s  %-4s  %s\n' \
        "$hat" "$dest" "$reach" "${tmuxv:--}" "${resurrect:--}" "${sessions:--}" "$win"
}

cmd_tab() {
    # --hat says whose workspace, for a name hats on several servers record.
    local want="" args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hat) [[ $# -ge 2 && -n "$2" ]] || die "usage: hatter tab <session> [tab-name] [--hat <hat>]"
                   want="$2"; shift 2 ;;
            # Everything after -- is a name, even one that starts with -.
            --) shift; args+=("$@"); break ;;
            -*) die "unknown flag: $1  (try: hatter help tab)" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}
    case "${1:-}" in
        pin|unpin) [[ $# -eq 3 ]] && { cmd_tab_pin "$1" "$2" "$3" "$want"; return; } ;;
    esac
    # Add a tab back to a workspace: in the mirror a tab IS a tmux window, so
    # creating one on the server makes it appear - no re-mirror needed.
    local session="${1:-}" name="${2:-}"
    [[ -n "$session" ]] || die "usage: hatter tab <session> [tab-name] [--hat <hat>]"
    tab_target "$session" "$want"
    local nameopt=""
    [[ -n "$name" ]] && nameopt="-n $(sq "$name")"
    remote_sh "$TAB_HOST" "tmux new-window -t $(sq "=$TAB_SESSION") $nameopt -c $(sq_dir "$(hat_dir "$TAB_HAT")")"
    info "Added a tab to '$TAB_SESSION' on $TAB_HOST${name:+ (named '$name')}"
}

# hatter tab pin|unpin <session> <tab> [--hat <hat>]   - <tab> is a window
# index or name
cmd_tab_pin() {
    local action="$1" tab="$3" line wid idx name
    tab_target "$2" "${4:-}"
    line=$(remote_sh "$TAB_HOST" \
        "tmux list-windows -t $(sq "=$TAB_SESSION") -F '#{window_id}$HT#{window_index}$HT#{window_name}' 2>/dev/null" \
        | tmux_fields | AWK_T="$tab" awk -F'\037' '
            # Reads to the end: exiting early would break the pipe into tr.
            BEGIN {t = ENVIRON["AWK_T"] ""}
            ($2 "")==t && !i {i=$0}
            ($3 "")==t && !n {n=$0}
            END {if (i) print i; else if (n) print n}')
    [[ -n "$line" ]] || die "no tab '$tab' in '$TAB_SESSION' - give its index or its name"
    IFS=$'\x1f' read -r wid idx name <<<"$line"
    if [[ "$action" == pin ]]; then
        [[ -n "$name" ]] || die "tab $idx has no name, and a pinned tab is matched by name when it is
  brought back. Name it first:  tmux rename-window -t '=$TAB_SESSION:$idx' <name>"
        remote_sh "$TAB_HOST" "tmux set-option -w -t $(sq "$wid") $PIN_OPT 1"
    else
        remote_sh "$TAB_HOST" "tmux set-option -wu -t $(sq "$wid") $PIN_OPT"
    fi

    if [[ -z "$TAB_GROUP" ]]; then
        warn "'$TAB_SESSION' is not in any group, so restore does not know it; the pin is on tmux only"
    else
        # The config is the half of the pin that survives a reboot, so it is
        # written now rather than at the next sync.
        backup_config
        jq_write --arg g "$TAB_GROUP" --arg s "$TAB_SESSION" --arg n "$name" \
                 --argjson p "$([[ "$action" == pin ]] && echo true || echo false)" '
            .groups[$g].sessions[$s].windows |= ((. // [])
                | if any(.[]; .name == $n) then . else . + [{name: $n, cwd: null}] end
                | map(if .name == $n then (if $p then .pinned = true else del(.pinned) end) else . end))'
    fi
    if [[ "$action" == pin ]]; then info "Pinned tab '$name' in '$TAB_SESSION'"
    else info "Unpinned tab '${name:-$idx}' in '$TAB_SESSION'"; fi
}

# tab_target <session> [hat]: resolve a workspace name the way `hatter tab`
# takes it, on <hat> when given. Sets TAB_SESSION, TAB_GROUP (empty when no
# group records it), TAB_HAT and TAB_HOST, and dies unless the session is
# running.
tab_target() {
    local session="$1" want="${2:-}"

    # A hat is not a workspace. Catch the confusion explicitly rather than
    # failing later with advice that cannot help.
    if hat_exists "$session"; then
        local listing
        listing=$(cfg --arg l "$session" '
            .groups | to_entries[] | select(.value.hat == $l)
            | .key as $g | .value.sessions | keys_unsorted[]? | "  \($g) / \(.)"')
        die "'$session' is a hat, not a workspace - tabs live inside workspaces.
${listing:+
Workspaces under the '$session' hat:
$listing
}
  hatter tab <workspace> [tab-name] [--hat <hat>]"
    fi

    # The hat first, then its group: two hats may each record the name.
    local group="" hat host
    if [[ -n "$want" ]]; then
        hat_exists "$want" || die "unknown hat: $want"
        hat="$want"
        session=$(hat_session_name "$hat" "$session")
    else
        hat=$(session_hat_typed "$session" "hatter tab $session --hat <hat>" here) || exit 1
    fi
    [[ -z "$hat" ]] || group=$(session_group "$session" "$hat")

    if [[ -z "$hat" ]]; then
        # A bare workspace name typed inside a cmux window: try this hat's
        # prefix before giving up. Only an existing workspace counts - `tab`
        # adds to one, so a guess that names nothing is no better than failing.
        # The name as given is tried before the prefixed one, since a running
        # session need not carry the prefix.
        local cur="" found=""
        cur=$(current_hat || true)
        [[ -n "$cur" ]] && found=$(hat_session_name "$cur" "$session")
        if [[ -n "$found" && ( "$found" == "$session" || -n "$(session_group "$found" "$cur")" ) ]]; then
            session="$found"
            group=$(session_group "$session" "$cur")
            hat="$cur"
            info "taking '$session' from this window"
        fi
    fi

    if [[ -z "$hat" ]]; then
        die "no workspace named '$session', and its name has no hat prefix.
  See what exists with:  hatter list
  Known hats: $(hat_names | tr '\n' ' ')"
    fi

    host=$(hat_ssh "$hat")

    if ! remote_session_exists "$host" "$session"; then
        if [[ -n "$group" ]]; then
            # recorded in the config, so restore genuinely is the right fix
            die "workspace '$session' is recorded but not running on $host.
  hatter restore $hat"
        fi
        die "no workspace '$session' on $host (hat: $hat).
  Create it with:  hatter $session
  Or list what exists:  hatter list"
    fi

    TAB_SESSION="$session" TAB_GROUP="$group" TAB_HAT="$hat" TAB_HOST="$host"
}

# --------------------------------------------------------------- dragged tabs
#
# Dragging a tab from one mirrored workspace to another moves only cmux's tab:
# cmux never tells tmux, so the window stays in its old session. The dragged
# tab has nothing behind it and stays blank, and the old workspace no longer
# shows the window at all, though it keeps running. cmux gives the dragged tab
# a new surface id, while the old session's pane map still names the old id,
# which is now in no workspace.
#
# So a dragged tab is a terminal surface its own session does not map (an
# orphan), and the window it came from is one none of whose mapped surfaces are
# left in cmux (hidden). They pair by the tab's title, which is the window's
# name, or "tmux window" for a window with none - and only when the title picks
# out one orphan and one hidden window. Anything less certain is left alone:
# not every unmapped tab is dragged, since a mirrored workspace can also hold a
# local shell, titled "Terminal" or by whatever runs in it.
#
# The plan reads one JSON object on stdin:
#   workspaces  [{id, title, surfaces: [{id, title, type}]}]  the hat's window
#   surfaces    [id]                  every surface cmux has, in any window
#   maps        {session: [{surface_id, window_id}]}   mirrored sessions only
#   windows     [{session, id, name}]                  tmux on the hat's server
# and prints a line per finding, tab separated:
#   move    surface workspace to-session from-session window-id name
#   orphan  surface workspace session title       (nothing to pair it with)
DRAG_PLAN_JQ='
  .surfaces as $all
  | (.windows | map({key: .id, value: .}) | from_entries) as $win
  | .maps as $maps
  | [.workspaces[] | select(.title != null and $maps[.title] != null)
      | .id as $ws | .title as $s | [$maps[$s][].surface_id] as $m
      | .surfaces[]? | select(.type == "terminal")
      | select(.id as $x | $m | index([$x]) | not)
      | {surface: .id, ws: $ws, session: $s, title: (.title // "")}] as $orphans
  | [$maps | to_entries[] | .key as $s
      | (.value | map(select(.window_id != null)) | group_by(.window_id))[]
      | select(all(.[]; .surface_id as $x | $all | index([$x]) | not))
      | .[0].window_id as $w
      | select($win[$w].session == $s)
      | {session: $s, window: $w, name: ($win[$w].name // "")}] as $hidden
  | (.sessions // []) as $sessions
  | [.workspaces[] | .title as $t
      | select($t != null and $maps[$t] == null and ($sessions | index([$t]) | not))
      | .id as $ws
      | .surfaces[]? | select(.type == "terminal")
      | select(.id as $x | [$maps[][].surface_id] | index([$x]) | not)
      | {surface: .id, ws: $ws, wstitle: $t, title: (.title // "")}] as $locals
  | def named($t; $not):
      [$hidden[] | select(.session != $not
                          and (if .name == "" then "tmux window" else .name end) == $t)];
    def twins($t; $among): [$among[] | select(.title == $t)] | length;
    ($orphans[] as $o
     | named($o.title; $o.session) as $named
     | (if ($named | length) == 1 and twins($o.title; $orphans) == 1 then $named[0] else null end) as $h
     | if $h == null then ["orphan", $o.surface, $o.ws, $o.session, $o.title]
       else ["move", $o.surface, $o.ws, $o.session, $h.session, $h.window, $h.name] end),
    ($locals[] as $o
     | named($o.title; null) as $named
     | select(($named | length) == 1 and twins($o.title; $orphans + $locals) == 1)
     | $named[0] as $h
     | ["local", $o.surface, $o.ws, $o.wstitle, $h.session, $h.window, $h.name])
  | map(. // "" | tostring) | join("\u001f")'

drag_plan() { jq -r "$DRAG_PLAN_JQ"; }

# The plan's input for one hat's window, from a cmux tree and the server's
# remote_tmux_state. Only sessions cmux says it mirrors get a map: an empty map
# would make every tab in the workspace look dragged.
drag_facts() {
    local win="$1" host="$2" tree="$3" state="$4" tmp k=0 title maps
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-drag.XXXXXX")
    while IFS= read -r title; do
        [[ -n "$title" ]] || continue
        AWK_S="$title" awk -F '\t' '$1 == "S" && ($2 "") == (ENVIRON["AWK_S"] "") { f = 1 } END { exit !f }' <<<"$state" || continue
        printf '%s' "$title" > "$tmp/t.$k"
        ( cmux_pane_map "$host" "$title" > "$tmp/m.$k" || true ) &
        k=$((k + 1))
        [[ $((k % 8)) -ne 0 ]] || wait
    done < <(jq -r --arg w "$win" '.windows[]? | select(.id == $w) | .workspaces[]?.title // empty' <<<"$tree")
    wait
    maps=$(for ((k = k - 1; k >= 0; k--)); do
        jq -c --arg s "$(cat "$tmp/t.$k")" '
            select(.mirrored == true and ((.panes // []) | length) > 0)
            | {($s): [.panes[] | {surface_id, window_id}]}' "$tmp/m.$k" 2>/dev/null || true
    done | jq -s 'add // {}')
    rm -rf "$tmp"
    printf '%s' "$tree" | jq --arg w "$win" --argjson m "$maps" --arg st "$state" '. as $t | {
        workspaces: [$t.windows[]? | select(.id == $w) | .workspaces[]?
            | {id, title, surfaces: [.panes[]?.surfaces[]? | {id, title, type}]}],
        surfaces: [$t.windows[]?.workspaces[]?.panes[]?.surfaces[]?.id],
        maps: $m,
        sessions: [$st | split("\n")[] | select(startswith("S\t")) | split("\t")[1]],
        windows: [$st | split("\n")[] | select(startswith("W\t")) | split("\t")
            | {session: .[1], id: .[2], name: (.[3] // "")}]}'
}

# Cheap first look, so the timer only asks for pane maps when something is off:
# does any mirrored workspace show fewer terminal tabs than its session has
# windows? A drag always leaves its source workspace one short. A local shell
# in a workspace, or a window split into panes, only ever adds tabs.
drag_suspect() {
    local win="$1" tree="$2" state="$3"
    printf '%s' "$tree" | jq -e --arg w "$win" --arg st "$state" '
        . as $t
        | ([$st | split("\n")[] | select(startswith("W\t")) | split("\t")[1]]
            | group_by(.) | map({key: .[0], value: length}) | from_entries) as $n
        | any($t.windows[]? | select(.id == $w) | .workspaces[]?;
              $n[.title] != null
              and $n[.title] > ([.panes[]?.surfaces[]? | select(.type == "terminal")] | length))' \
        >/dev/null 2>&1
}

# Sessions heal_dragged_tabs moved a tab into, one per line.
HEAL_MOVED=""

# heal_dragged_tabs [hat] [report|once] [workspace surface]
# Put every dragged tab's tmux window where the tab was dropped, then close the
# blank tab: cmux draws the moved window as a new tab of its own. Every hat when
# none is named. With "report", says which blank tabs it could not pair or left
# alone, and why; with "once", only says each left-alone tab once (see
# drag_refuse). Afterwards HEAL_MOVED and HEAL_REFUSED say what it did.
#
# A workspace and surface come from cmux's own drop event (see the watcher):
# only the window holding that workspace is looked at, and only that surface
# is moved. A workspace no longer in any window means there is nothing to do.
heal_dragged_tabs() {
    local only="${1:-}" report="${2:-}" onlyws="${3:-}" onlysf="${4:-}" onlywin="" hat w tree seen="" i tmp
    local hats=() wins=() hosts=()
    HEAL_MOVED=""
    HEAL_REFUSED=""
    cmux_alive || return 0
    cmux_snapshot
    tree="$CMUX_SNAP_TREE"
    if [[ -n "$onlyws" ]]; then
        onlywin=$(jq -r --arg ws "$(upper "$onlyws")" '
            first(.windows[]? | select(any(.workspaces[]?; (.id | ascii_upcase) == $ws)) | .id) // empty' \
            <<<"$tree" 2>/dev/null || true)
        [[ -n "$onlywin" ]] || { cmux_snapshot_drop; return 0; }
    fi
    while IFS= read -r hat; do
        [[ -n "$hat" ]] || continue
        [[ -z "$only" || "$hat" == "$only" ]] || continue
        w=$(find_hat_window "$hat") || continue
        [[ -n "$w" ]] || continue
        [[ -z "$onlywin" || "$(upper "$w")" == "$(upper "$onlywin")" ]] || continue
        # Hats sharing a server share its window; one look is enough.
        grep -qxF "$w" <<<"$seen" && continue
        seen+="$w"$'\n'
        hats+=("$hat"); wins+=("$w"); hosts+=("$(hat_ssh "$hat")")
    done < <(hat_names)
    cmux_snapshot_drop
    [[ -n "$tree" && ${#hats[@]} -gt 0 ]] || return 0
    # Every server at once, as sync does.
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-heal.XXXXXX") || return 0
    for ((i = 0; i < ${#hats[@]}; i++)); do
        remote_tmux_state "${hosts[$i]}" > "$tmp/$i" 2>/dev/null &
    done
    wait
    for ((i = 0; i < ${#hats[@]}; i++)); do
        heal_hat_drags "${hosts[$i]}" "${wins[$i]}" "$tree" "$(cat "$tmp/$i")" "$report" "$onlysf" || true
    done
    rm -rf "$tmp"
    return 0
}

heal_hat_drags() {
    local host="$1" win="$2" tree="$3" state="$4" report="$5" onlysf="${6:-}" first second
    [[ -n "$state" ]] || return 0
    drag_suspect "$win" "$tree" "$state" || return 0

    first=$(drag_facts "$win" "$host" "$tree" "$state" | drag_plan) || {
        [[ "$report" != report ]] || warn "could not work out which tabs were dragged on $host"
        return 0
    }
    grep -qE '^(move|local)' <<<"$first" || { drag_report "$report" "$first"; return 0; }

    if [[ -n "$onlysf" ]]; then
        # cmux has just said this surface was dropped here, so the drag is
        # over: no second look, but nothing moves except that tab.
        second=$(AWK_S="$(upper "$onlysf")" awk -F '\037' '($1 == "move" || $1 == "local") && toupper($2) == ENVIRON["AWK_S"]' <<<"$first")
        [[ -n "$second" ]] || return 0
    else
        # A tab mid-drag, or a mirror mid-reconnect, can look like this for a
        # moment. Act only on what is still true a little later.
        sleep 2
        tree=$(cmux_json tree --all 2>/dev/null) || return 0
        state=$(remote_tmux_state "$host" 2>/dev/null || true)
        [[ -n "$state" ]] || return 0
        second=$(drag_facts "$win" "$host" "$tree" "$state" | drag_plan) || return 0
        drag_report "$report" "$second"
    fi

    local moved=0 kind orphan ws to from wid name screen rc why errf
    errf=$(mktemp "${TMPDIR:-/tmp}/hatter-screen.XXXXXX") || return 0
    while IFS=$'\x1f' read -r kind orphan ws to from wid name; do
        [[ "$kind" == move || "$kind" == local ]] || continue
        grep -qxF "$(printf '%s\037%s\037%s\037%s\037%s\037%s\037%s' "$kind" "$orphan" "$ws" "$to" "$from" "$wid" "$name")" \
            <<<"$first" || continue
        # A dragged tab has nothing behind it, so it shows nothing. One that
        # shows anything is something else, whatever its title says - and one
        # cmux cannot read is not known to be blank.
        # The screen is stdout alone: a notice cmux prints on stderr must not
        # read as text on a blank tab. stderr is only the reason for a failure.
        rc=0
        screen=$(cmux read-screen --surface "$orphan" --workspace "$ws" --window "$win" \
            </dev/null 2>"$errf") || rc=$?
        [[ "$rc" == 0 ]] || screen=$(cat "$errf" 2>/dev/null; printf '%s' "$screen")
        if [[ "$kind" == local ]]; then
            heal_local_drop "$host" "$win" "$orphan" "$ws" "$to" "$from" "$wid" "$name" "$rc" "$screen" "$report" \
                "$(AWK_S="$from" awk -F '\t' '$1 == "W" && ($2 "") == (ENVIRON["AWK_S"] "")' <<<"$state" | wc -l | tr -d ' ')"
            continue
        fi
        why=$(drag_not_blank "$rc" "$screen")
        if [[ -n "$why" ]]; then
            # A tab showing text is not a dragged tab, so it is not recorded as
            # one: repair goes on to fix the workspace its own way.
            local held=held
            [[ "$rc" != 0 ]] || held=""
            drag_refuse "$report" "$held" "$host" "$orphan" "$to" "$from" "$wid" "$name" \
                "it is not plainly blank: $why"
            continue
        fi
        # Moving a session's last window ends the session. The drag asked for
        # that, but it is too much to do unasked.
        if [[ "$(AWK_S="$from" awk -F '\t' '$1 == "W" && ($2 "") == (ENVIRON["AWK_S"] "")' <<<"$state" | wc -l | tr -d ' ')" -le 1 ]]; then
            drag_refuse "$report" held "$host" "$orphan" "$to" "$from" "$wid" "$name" \
                "it is the last tab of '$from'"
            continue
        fi
        heal_move "$host" "$win" "$orphan" "$ws" "$to" "$from" "$wid" "$name" && moved=1
    done <<<"$second"
    rm -f "$errf"

    # The server's pane registry is keyed on windows that have just changed
    # session.
    [[ "$moved" == 0 ]] || remote_sh "$host" \
        'h="$HOME/.local/bin/hat-restore"; [ -x "$h" ] && "$h" --backfill' >/dev/null 2>&1 || true
    return 0
}

# drag_not_blank <read-screen status> <read-screen output>
# Empty when the tab is plainly blank; otherwise why it is not, short enough
# for one log line.
#
# A dragged tab is the tmux window's own container surface, which cmux stopped
# routing to a terminal when it mirrored the window's panes into it. Carried to
# another workspace it has no terminal at all, so cmux refuses to read it with
# surface_unavailable. A local shell always has a terminal behind it, so that
# refusal is as blank as a tab gets; any other failure is not known to be.
drag_not_blank() {
    local rc="$1" screen="$2" line
    if [[ "$rc" != 0 ]]; then
        grep -q 'surface_unavailable' <<<"$screen" && return 0
        line=$(printf '%s\n' "$screen" | grep -m 1 '[^[:space:]]' || true)
        printf 'cmux could not read it (exit %s%s)' "$rc" "${line:+: ${line:0:80}}"
        return 0
    fi
    line=$(printf '%s\n' "$screen" | grep -m 1 '[^[:space:]]' || true)
    [[ -z "$line" ]] || printf 'it shows "%s"' "${line:0:80}"
    return 0
}

# Dragged tabs the healer paired but left alone, one per line, the fields
# split by $US:
#   orphan  to-session  from-session  window-id
# Only those still likely to be real drags (see drag_refuse's "held"). repair
# reads it so it never re-mirrors over one: re-mirroring drops the blank tab,
# and with it the only record of where it was dropped.
HEAL_REFUSED=""

# drag_refuse <report> <held> <host> <orphan> <to> <from> <window-id> <name> <reason>
# "held" records the pair in HEAL_REFUSED; empty means the reason itself shows
# it is no drag. With report "report", always says so. With "once" (the
# autosave timer), says so the first time for each blank tab, so a stuck drag
# reaches the log without filling it every minute.
drag_refuse() {
    local report="$1" held="$2" host="$3" orphan="$4" to="$5" from="$6" wid="$7" name="$8" reason="$9" seen
    [[ -z "$held" ]] || HEAL_REFUSED+="$orphan$US$to$US$from$US$wid"$'\n'
    case "$report" in
        report) ;;
        once)
            seen="$AUTOSAVE_DIR/drag-refused"
            grep -qxF "$orphan" "$seen" 2>/dev/null && return 0
            mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || true
            # Surface ids are never reused; the last few are all worth keeping.
            { tail -n 99 "$seen" 2>/dev/null; echo "$orphan"; } > "$seen.tmp" 2>/dev/null \
                && mv "$seen.tmp" "$seen" 2>/dev/null || true ;;
        *) return 0 ;;
    esac
    # The reason quotes the tab's screen, which may hold escape sequences.
    reason=$(printf '%s' "$reason" | tr -d '[:cntrl:]')
    warn "the tab '${name:-tmux window}' dragged into '$to' was left alone: $reason.
  Its window is still in '$from'. Move it with:
    ssh $host \"tmux move-window -s '=$from:$wid' -t '=$to:'\""
    return 0
}

drag_report() {
    local report="$1" plan="$2" kind orphan ws session title
    [[ "$report" == report ]] || return 0
    while IFS=$'\x1f' read -r kind orphan ws session title; do
        [[ "$kind" == orphan ]] || continue
        warn "the tab '$title' in '$session' has no tmux window of its own, and none was clearly its window"
    done <<<"$plan"
    return 0
}

heal_move() {
    local host="$1" win="$2" orphan="$3" ws="$4" to="$5" from="$6" wid="$7" name="$8" i map
    local label="${name:-$wid}"
    remote_sh "$host" "tmux move-window -d -s $(sq "=$from:$wid") -t $(sq "=$to:")" >/dev/null 2>&1 || {
        warn "could not move tab '$label' from '$from' to '$to' on $host"
        return 1
    }
    # Close the blank tab only once cmux shows the window in its new place, and
    # only while no session maps it: a mapped tab's close kills its window.
    for ((i = 0; i < 20; i++)); do
        map=$(cmux_pane_map "$host" "$to" </dev/null || true)
        [[ -n "$map" ]] || map='{}'
        if jq -e --arg w "$wid" --arg o "$orphan" '
                any(.panes[]?; .window_id == $w) and all(.panes[]?; .surface_id != $o)' \
                <<<"$map" >/dev/null 2>&1; then
            heal_close_blank "$win" "$orphan" "$ws" \
                || warn "moved tab '$label' into '$to', but could not close its blank copy${HEAL_CLOSE_ERR:+: $HEAL_CLOSE_ERR}"
            info "Moved tab '$label' into '$to': it was dragged there in cmux, but tmux had kept it in '$from'"
            HEAL_MOVED+="$to"$'\n'
            return 0
        fi
        sleep 0.25
    done
    warn "moved tab '$label' into '$to', but cmux has not shown it there yet"
    HEAL_MOVED+="$to"$'\n'
    return 0
}

# heal_close_blank <cmux-window> <orphan> <workspace> <to> <label>
# Close a dragged tab's blank copy. cmux can refuse: it will not close a pinned
# tab, and it can take the dropped tab, which has no terminal at all, for one
# with a live process. So a refused close is retried unpinned and forced. The
# force is safe only because heal_move closes a tab no session maps: there is
# no tmux window behind it to kill. A close still refused fails, with what cmux
# said in HEAL_CLOSE_ERR.
HEAL_CLOSE_ERR=""
heal_close_blank() {
    local win="$1" orphan="$2" ws="$3" err
    HEAL_CLOSE_ERR=""
    cmux_change close-surface --surface "$orphan" --workspace "$ws" --window "$win" </dev/null >/dev/null 2>&1 \
        && return 0
    # Unpinning a tab that is not pinned does nothing, and says OK either way.
    cmux_change tab-action --action unpin --tab "$orphan" --workspace "$ws" --window "$win" </dev/null >/dev/null 2>&1 || true
    err=$(cmux_change close-surface --force --surface "$orphan" --workspace "$ws" --window "$win" </dev/null 2>&1 >/dev/null) \
        && return 0
    HEAL_CLOSE_ERR=$(printf '%s\n' "$err" | grep -m 1 '[^[:space:]]' | tr -d '[:cntrl:]' | cut -c 1-120 || true)
    return 1
}

# heal_local_drop <host> <cmux-window> <orphan> <workspace> <workspace-title>
#                 <from-session> <window-id> <name> <read-screen status>
#                 <read-screen output> <report> <windows in from-session>
# A tab dropped into a workspace that is not a tmux session (a local one) has no
# session to move its window into. Its window is still in <from-session>, and
# that workspace no longer shows it. cmux draws a window as a new tab when it
# enters a mirrored session, so the window hops out to a session of its own and
# straight back (heal_hop_window), and only then does the blank tab go: a hop
# that fails leaves the drop as it was, for the next pass to find.
#
# Only a tab cmux has no terminal for counts: an empty screen is not enough
# here, because the close may be forced, and a quiet local shell would die.
heal_local_drop() {
    local host="$1" win="$2" orphan="$3" ws="$4" wstitle="$5" from="$6" wid="$7" name="$8"
    local rc="$9" screen="${10}" report="${11}" nwin="${12:-0}" label line i map before=""
    label="${name:-tmux window}"
    if [[ "$rc" == 0 ]] || ! grep -q 'surface_unavailable' <<<"$screen"; then
        line=$(printf '%s\n' "$screen" | grep -m 1 '[^[:space:]]' | tr -d '[:cntrl:]' || true)
        drag_local_refuse "$report" "$orphan" "$label" "$wstitle" "$from" "$wid" \
            "cmux shows a terminal behind it${line:+ (\"${line:0:80}\")}"
        return 0
    fi
    # Moving a session's last window out ends the session.
    if [[ "$nwin" -le 1 ]]; then
        drag_local_refuse "$report" "$orphan" "$label" "$wstitle" "$from" "$wid" \
            "it is the last tab of '$from'"
        return 0
    fi
    # One hop per dropped tab: a hop cmux did not draw would not draw the next
    # time either, and each one moves the window.
    local tried="$AUTOSAVE_DIR/drag-hopped"
    if grep -qxF "$orphan" "$tried" 2>/dev/null; then
        drag_local_refuse "$report" "$orphan" "$label" "$wstitle" "$from" "$wid" \
            "a hop did not make cmux show it in '$from'"
        return 0
    fi
    before=$(cmux_pane_map "$host" "$from" </dev/null 2>/dev/null \
        | jq -r --arg w "$wid" '[.panes[]? | select(.window_id == $w) | .surface_id] | first // empty' 2>/dev/null || true)
    heal_hop_window "$host" "$from" "$wid" || return 0
    # Close the blank tab once cmux shows the window under a tab of its own.
    for ((i = 0; i < 20; i++)); do
        map=$(cmux_pane_map "$host" "$from" </dev/null 2>/dev/null || true)
        [[ -n "$map" ]] || map='{}'
        if jq -e --arg w "$wid" --arg b "$before" --arg o "$orphan" '
                any(.panes[]?; .window_id == $w and .surface_id != $b and .surface_id != $o)' \
                <<<"$map" >/dev/null 2>&1; then
            heal_close_blank "$win" "$orphan" "$ws" \
                || warn "'$label' shows in '$from' again, but the blank tab in '$wstitle' would not close${HEAL_CLOSE_ERR:+: $HEAL_CLOSE_ERR}"
            info "Showed tab '$label' in '$from' again: it was dropped into '$wstitle', which is not a tmux session"
            HEAL_MOVED+="$from"$'\n'
            return 0
        fi
        sleep 0.25
    done
    mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || true
    { tail -n 99 "$tried" 2>/dev/null; echo "$orphan"; } > "$tried.tmp" 2>/dev/null \
        && mv "$tried.tmp" "$tried" 2>/dev/null || true
    warn "hopped '$label' through a session of its own, but cmux has not shown it in '$from' yet; the blank tab in '$wstitle' is left"
    return 0
}

# heal_hop_window <host> <session> <window-id>
# Move a window out of its session to a new one of its own and straight back,
# so a mirroring cmux sees it arrive and draws it as a new tab. It goes back to
# the index it had, and is the session's current window again if it was. The
# hop session is killed only once the window is out of it again: killing it
# with the window inside would end the window. Fails, having said why, when the
# window did not make the round trip.
heal_hop_window() {
    local host="$1" session="$2" wid="$3" out hop
    hop="hatter-hop-${wid#@}-$$"
    out=$(remote_sh "$host" "h=$(sq "$hop") f=$(sq "$session") w=$(sq "$wid")"'
        # Where it was, so it comes back to the same place, active if it was.
        at=$(tmux display-message -p -t "=$f:$w" "#{window_index} #{window_active}" 2>/dev/null) \
            || { echo "@@hop-none"; exit 0; }
        idx=${at% *} act=${at#* }
        tmux new-session -d -s "$h" -c "$HOME" || { echo "@@hop-none"; exit 0; }
        if tmux move-window -d -s "=$f:$w" -t "=$h:"; then
            sleep 1
            # Its index may have been taken meanwhile: then it goes last.
            tmux move-window -d -s "=$h:$w" -t "=$f:$idx" 2>/dev/null \
                || tmux move-window -d -s "=$h:$w" -t "=$f:" \
                || { echo "@@hop-stuck"; exit 0; }
            [ "$act" != 1 ] || tmux select-window -t "=$f:$w" 2>/dev/null || true
            r=@@hop-ok
        else r=@@hop-none; fi
        tmux list-windows -t "=$h" -F "#{window_id}" 2>/dev/null | grep -qxF "$w" || tmux kill-session -t "=$h"
        echo "$r"' </dev/null 2>/dev/null || true)
    case "$out" in
        *@@hop-ok*) return 0 ;;
        *@@hop-stuck*)
            warn "window $wid of '$session' is now in the temporary session '$hop' on $host. Put it back with:
    ssh $host \"tmux move-window -s '=$hop:$wid' -t '=$session:' && tmux kill-session -t '=$hop'\""
            return 1 ;;
        *)  warn "could not hop window $wid of '$session' on $host; nothing was moved"
            return 1 ;;
    esac
}

# drag_local_refuse <report> <orphan> <label> <workspace-title> <from-session> <window-id> <reason>
# Says why a tab dropped into a local workspace was left alone, as drag_refuse
# does: always with "report", once per tab with "once".
drag_local_refuse() {
    local report="$1" orphan="$2" label="$3" wstitle="$4" from="$5" wid="$6" reason="$7" seen
    case "$report" in
        report) ;;
        once)
            seen="$AUTOSAVE_DIR/drag-refused"
            grep -qxF "$orphan" "$seen" 2>/dev/null && return 0
            mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || true
            { tail -n 99 "$seen" 2>/dev/null; echo "$orphan"; } > "$seen.tmp" 2>/dev/null \
                && mv "$seen.tmp" "$seen" 2>/dev/null || true ;;
        *) return 0 ;;
    esac
    warn "the tab '$label' dropped into '$wstitle' was left alone: $reason.
  If it was dragged there from '$from', close it, and show the window there again with:
    hatter repair $(sq "$from")"
    return 0
}

# A tab dragged from one cmux workspace to another can come up blank. The tmux
# window is fine - alive, and capture-pane shows every line - but cmux has
# stopped painting it, and nothing on the tmux side helps: cmux reasserts its
# own idea of the window over resize-window, select-window and refresh-client.
# Mirroring the host again rebuilds cmux's view, but the workspace comes back
# new: outside its group, at the end of the sidebar. So repair records where it
# was, detaches it, re-mirrors, and puts it back.
# Bring tmux windows stuck at 80x24 up to the size the client uses, by running
# hat-resize on the server. Takes a hat (every session on it) or a session.
cmd_resize() {
    local target="$1" hat session="" host
    shift
    if hat_exists "$target"; then
        hat="$target"
    else
        session=$(tmux_session_name "$target")
        hat=$(session_hat_typed "$session" "run it from that hat's window, or hatter resize <hat>" here) || exit 1
        [[ -n "$hat" ]] || die "'$target' is neither a hat nor a session hatter can place.
  Known hats: $(hat_names | tr '\n' ' ')"
    fi
    host=$(hat_ssh "$hat")
    [[ -n "$host" ]] || die "hat '$hat' has no ssh destination"
    local cmd='h="$HOME/.local/bin/hat-resize"; [ -x "$h" ] || { echo "hat-resize is not installed - run: hatter provision '"$(sq "$hat")"'" >&2; exit 1; }; "$h"'
    [[ -n "$session" ]] && cmd+=" $(sq "$session")"
    local a
    for a in "$@"; do cmd+=" $(sq "$a")"; done
    remote_sh "$host" "$cmd"
}

# remirror_session <hat> <host> <session> [cmux-window]
# Detach a session's workspace from cmux and mirror it again, back in its group
# and place, so cmux rebuilds its view from tmux: every window gets a tab. Dies
# when it cannot, saying how to get the session back. With a window, only that
# one is looked in: another hat's window can hold a session of the same name.
remirror_session() {
    local hat="$1" host="$2" session="$3" win="" ws="" w
    # Where it is now: its window, its group, and its neighbour in that group.
    for w in ${4:-$(window_ids)}; do
        ws=$(workspace_ref_by_title "$session" "$w")
        if [[ -n "$ws" ]]; then win="$w"; break; fi
    done
    [[ -n "$ws" ]] || die "'$session' is not open in cmux. 'hatter restore $hat' opens it."

    local groups gid="" gname="" after="" before=""
    groups=$(cmux_json workspace-group list --window "$win" 2>/dev/null || echo '{"groups":[]}')
    # Outside any group the place is the sidebar itself: remember its predecessor.
    local prev
    prev=$(cmux_json workspace list --window "$win" 2>/dev/null | jq -r --arg ws "$ws" '
        [.workspaces[]?.id] as $m | ($m | index($ws)) as $i
        | if $i != null and $i > 0 then $m[$i - 1] else empty end' 2>/dev/null || true)
    gid=$(jq -r --arg ws "$ws" '.groups[]? | select((.member_workspace_ids // []) | index($ws)) | .id' <<<"$groups" | head -1)
    if [[ -n "$gid" ]]; then
        gname=$(jq -r --arg g "$gid" '.groups[] | select(.id == $g) | .name // empty' <<<"$groups")
        after=$(jq -r --arg g "$gid" --arg ws "$ws" '
            .groups[] | select(.id == $g) | .member_workspace_ids as $m
            | ($m | index($ws)) as $i | if $i > 0 then $m[$i - 1] else empty end' <<<"$groups")
        before=$(jq -r --arg g "$gid" --arg ws "$ws" '
            .groups[] | select(.id == $g) | .member_workspace_ids as $m
            | ($m | index($ws)) as $i | $m[$i + 1] // empty' <<<"$groups")
    fi

    info "Detaching '$session' from cmux (its tmux session keeps running)"
    # cmux asks before closing a workspace with anything running in it. For a
    # mirrored one a close only detaches: the tmux session runs on.
    local err
    err=$(cmux_change close-workspace --force --workspace "$ws" --window "$win" 2>&1 >/dev/null) \
        || die "cmux would not close the workspace - nothing was changed${err:+: $(printf '%s\n' "$err" | grep -m 1 '[^[:space:]]')}"
    # Wait until it is really gone, or the wait below could take the old one
    # for the re-mirrored one.
    local i
    for ((i = 0; i < 20; i++)); do
        [[ -z "$(workspace_ref_by_title "$session" "$win")" ]] && break
        sleep 0.25
    done
    [[ -z "$(workspace_ref_by_title "$session" "$win")" ]] \
        || die "cmux still shows '$session' after closing it - nothing was re-mirrored"

    # From here the workspace is closed, so every way out says how to get it back.
    local back="The session is safe on $host. Bring it back with:
    cmux ssh-tmux $host"
    mirror_hat "$hat" "$win" || die "re-mirroring failed. $back"
    local new
    new=$(wait_for_workspace "$session" "$win")
    [[ -n "$new" ]] || die "'$session' did not come back into cmux. $back"

    if [[ -n "$gname" ]]; then
        local gref
        gref=$(group_ref_in_window "$win" "$gname")
        if [[ -z "$gref" ]]; then
            # It was the group's only member, and closing it took the group too.
            gref=$(ensure_cmux_group "$gname" "$win")
        fi
        if ! cmux_group_add "$gref" "$new"; then
            warn "could not put '$session' back in group '$gname'"
            gname=""
        fi
        if group_exists "$gname"; then apply_group_style "$gname" "$gref"; fi
        if [[ -z "$gname" ]]; then :
        elif [[ -n "$after" ]]; then
            cmux_change reorder-workspace --workspace "$new" --after "$after" --window "$win" >/dev/null 2>&1 \
                || warn "could not move '$session' back to its old place"
        elif [[ -n "$before" ]]; then
            cmux_change reorder-workspace --workspace "$new" --before "$before" --window "$win" >/dev/null 2>&1 \
                || warn "could not move '$session' back to its old place"
        fi
        [[ -z "$gname" ]] || info "Back in '$gname', where it was"
    elif [[ -n "$prev" ]]; then
        cmux_change reorder-workspace --workspace "$new" --after "$prev" --window "$win" >/dev/null 2>&1 \
            || warn "could not move '$session' back to its old place"
    fi

    # Record the result: the config, and the server's pane registry, whose
    # entries are keyed on windows a drag has just moved.
    ( cmd_sync ) >/dev/null 2>&1 || warn "sync did not finish - run 'hatter sync'"
    remote_sh "$host" 'h="$HOME/.local/bin/hat-restore"; [ -x "$h" ] && "$h" --backfill' \
        >/dev/null 2>&1 || true
}

cmd_repair() {
    local session="" want="" hat host lines
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hat) [[ $# -ge 2 && -n "$2" ]] || die "usage: hatter repair <session> [--hat <hat>]"
                   want="$2"; shift 2 ;;
            -*) die "unknown flag: $1  (try: hatter help repair)" ;;
            *)  [[ -z "$session" ]] || die "usage: hatter repair <session> [--hat <hat>]"
                session="$1"; shift ;;
        esac
    done
    [[ -n "$session" ]] || die "usage: hatter repair <session> [--hat <hat>]"
    require_cmux repair
    session=$(tmux_session_name "$session")
    if [[ -n "$want" ]]; then
        hat_exists "$want" || die "unknown hat: $want"
        hat="$want"
    else
        hat=$(session_hat_typed "$session" "hatter repair $session --hat <hat>" here) || exit 1
    fi
    [[ -n "$hat" ]] || die "cannot tell which hat '$session' belongs to.
  Known hats: $(hat_names | tr '\n' ' ')"
    host=$(hat_ssh "$hat")

    # A tab dragged here is blank because tmux never moved its window. Moving
    # the window fixes that, and nothing needs re-mirroring.
    heal_dragged_tabs "$hat" report
    if grep -qxF "$session" <<<"$HEAL_MOVED"; then
        ( cmd_sync ) >/dev/null 2>&1 || warn "sync did not finish - run 'hatter sync'"
        info "Repaired '$session'"
        return 0
    fi
    # A dragged tab it left alone is still the fault, and re-mirroring would
    # drop the blank tab and leave its window showing nowhere.
    if AWK_S="$session" awk -F '\037' 'BEGIN { s = ENVIRON["AWK_S"] "" } ($2 "") == s || ($3 "") == s { f = 1 } END { exit !f }' <<<"$HEAL_REFUSED"; then
        die "'$session' was not re-mirrored: a tab dragged there or from there is the fault.
  Move its window as shown above, and it appears in cmux at once."
    fi

    # Only a fault in cmux's view is ours to fix. A session that is gone, or
    # empty on the server too, would come back exactly as it is.
    remote_session_exists "$host" "$session" \
        || die "'$session' is not running on $host, so there is nothing to repair.
  'hatter restore' re-creates it."
    lines=$(remote_sh "$host" "tmux list-windows -t $(sq "=$session") -F '#{window_index}' |
        while read -r w; do tmux capture-pane -p -t $(sq "=$session"):\"\$w\"; done |
        grep -cv '^[[:space:]]*\$'" 2>/dev/null || true)
    [[ "${lines:-0}" -gt 0 ]] || die "'$session' is blank on $host as well, so this is not cmux.
  Look at it with: ssh -t $host tmux attach -t $(sq "=$session")"
    info "'$session' has content on $host - the fault is in cmux's view of it"

    remirror_session "$hat" "$host" "$session"
    info "Repaired '$session'"
}

# The attach half of a client: put this terminal inside one workspace. No cmux,
# no window bookkeeping and no config writes, so it runs from any bash that has
# ssh - a Linux box, WSL, a phone's ssh app via a jump host. `-A` attaches when
# the session exists and creates it when it does not, so the one command is
# always right, and tmux keeps the state either way.
#
# Plain ssh, not SSH_OPTS: an interactive login that happens to become the
# ControlMaster holds the socket for every short-lived hatter call after it,
# and those would then die with the terminal.
# attach_session <hat> <session> [window]: a window index selects that tab first.
attach_session() {
    local hat="$1" session="$2" window="${3:-}" dest dir cmd
    [[ -t 0 && -t 1 ]] || die "attach needs a terminal - '$session' is on hat '$hat'"
    dest=$(hat_ssh "$hat")
    [[ -n "$dest" ]] || die "hat '$hat' has no ssh destination"
    dir=$(hat_dir "$hat")
    cmd="tmux new-session -A -s $(sq "$session") -c $(sq_dir "$dir")"
    [[ ! "$window" =~ ^[0-9]+$ ]] || \
        cmd="tmux select-window -t $(sq "=$session:$window") 2>/dev/null; $cmd"
    # mosh survives a phone sleeping, roaming and changing networks, where ssh
    # drops. It runs the command itself rather than through a shell, so the
    # shell that expands "$HOME" is asked for by name.
    if [[ "$(hat_mosh "$hat")" == true ]]; then
        if command -v mosh >/dev/null 2>&1; then
            exec mosh "$dest" -- sh -c "$cmd"
        fi
        warn "hat '$hat' asks for mosh, which is not installed here - using ssh"
    fi
    exec ssh -t "$dest" "$(posix_sh "$cmd")"
}

# The workspaces a hat has: those the config records, plus any running on its
# server that were never recorded. One per line, unique, recorded ones first in
# the order cmux shows them.
hat_workspaces() {
    local hat="$1" dest
    # Each stage can end non-zero without meaning anything (the last session
    # listed belongs to another hat; the server is unreachable), and pipefail
    # would turn that into a silent exit, so the group ends in an explicit 0.
    {
        cfg --arg l "$hat" '
            .groups[] | select(.hat == $l) | .sessions | keys_unsorted[]?'
        dest=$(hat_ssh "$hat")
        if [[ -n "$dest" ]]; then
            { remote_sessions "$dest" 2>/dev/null || true; } \
                | while IFS= read -r s; do
                      if [[ "$(session_hat "$s")" == "$hat" ]]; then
                          printf '%s\n' "$s"
                      fi
                  done
        fi
        return 0
    } | sed '/^$/d' | awk '!seen[$0]++'
    return 0
}

# A numbered menu on stderr. Prints the choice; an empty answer, Esc or end of
# input picks nothing and returns non-zero.
pick_one() {
    local prompt="$1" a i=1
    shift
    local -a opts=("$@")
    for a in "${opts[@]}"; do printf '  %2d) %s\n' "$i" "$a" >&2; i=$((i+1)); done
    while true; do
        ask_line "${prompt%: }" || return 1
        a="$EDIT_REPLY"
        [[ -n "$a" ]] || return 1
        if [[ "$a" =~ ^[1-9][0-9]*$ ]] && [[ "$a" -ge 1 && "$a" -le ${#opts[@]} ]]; then
            printf '%s' "${opts[$((a-1))]}"
            return 0
        fi
        echo "  pick a number from 1 to ${#opts[@]}" >&2
    done
}

# With no argument: the hat first, then the workspace. On a phone, a number
# beats typing a session name on a soft keyboard.
cmd_attach_pick() {
    [[ -t 0 && -t 1 ]] || { usage_cmd attach; exit 1; }
    local -a hats=()
    local hat
    while IFS= read -r hat; do [[ -n "$hat" ]] && hats+=("$hat"); done < <(hat_names)
    [[ ${#hats[@]} -gt 0 ]] || die "no hats yet. Add one:
    hatter hat add <name> --ssh you@shell.example.com"
    if [[ ${#hats[@]} -eq 1 ]]; then
        hat="${hats[0]}"
    else
        hat=$(pick_one "hat: " "${hats[@]}") || exit 0
    fi
    cmd_attach "$hat"
}

cmd_attach() {
    local target="$1" hat session
    target=$(tmux_session_name "$target")

    # A recorded session, or one whose prefix names a hat.
    if ! hat_exists "$target"; then
        hat=$(session_hat_typed "$target" "hatter attach <hat>, and pick it there" here) || exit 1
        [[ -n "$hat" ]] || die "'$target' is neither a hat nor a workspace of one.
  Known hats: $(hat_names | tr '\n' ' ')"
        attach_session "$hat" "$target"
    fi

    # A hat: pick one of its workspaces.
    hat="$target"
    local list n
    list=$(hat_workspaces "$hat")
    n=$(printf '%s' "$list" | grep -c '' || true)

    if [[ "$n" -eq 1 ]]; then
        attach_session "$hat" "$list"
    fi
    if [[ ! -t 0 ]]; then
        [[ "$n" -eq 0 ]] && die "hat '$hat' has no workspaces yet. Name one to create it:
    hatter attach $hat-<name>"
        die "hat '$hat' has $n workspaces - name one:
$(printf '%s\n' "$list" | sed 's/^/    /')"
    fi

    # At a terminal, a new workspace is one more choice, so a hat with none
    # is a starting point rather than a dead end.
    local -a choices=()
    if [[ "$n" -gt 0 ]]; then
        while IFS= read -r session; do choices+=("$session"); done <<<"$list"
    fi
    choices+=("+ new workspace")
    session=$(pick_one "workspace on '$hat': " "${choices[@]}") || exit 0
    if [[ "$session" == "+ new workspace" ]]; then
        local name
        ask_line "name (becomes $hat-<name>), Esc to cancel" || exit 0
        name="$EDIT_REPLY"
        [[ -n "$name" ]] || exit 0
        session=$(hat_session_name "$hat" "$(tmux_session_name "$name")")
    fi
    attach_session "$hat" "$session"
}

# --------------------------------------------------------------------- find

# `hatter find` sends this to every hat over ssh and runs it there with bash,
# so a hat needs nothing installed beyond what provision already put there (jq,
# tmux, the pane registry). It searches the Claude sessions of that account:
# by default those running in a tmux window the registry knows, and with --all
# also the closed ones whose transcript changed in the last N days.
#
# A running session is matched on what it is doing now: its title, its last
# prompt, its window name, and the last 10k characters of conversation. Only
# user and assistant text counts there; the raw tail of a transcript is mostly
# tool output and request blobs, which would crowd the conversation out. A
# closed session is matched anywhere in its transcript, since the point of
# --all is to find old work.
#
# Prints one line per match, fields separated by \037 (a tab would let read
# collapse the empty fields of a closed session):
#   score state mtime session window window_id session_id cwd window_name title snippet
# A closed session's session, window and window_name are where it last ran,
# from the registry's history (empty when it has none); window_id is empty.
# score is 2 when every term is in the title, prompt or window name, 1 when
# some are only in the conversation, 0 when only in a closed session's older
# history. A line "@@hatter-err <why>" means the hat could not be searched,
# and "@@hatter-ok" ends every run that got going, so a hat that printed
# neither was not reached.
# read, not $(cat <<...): bash 3.2 misparses a case inside a command
# substitution.
read -r -d '' FIND_SH <<'HATFIND' || true
#!/usr/bin/env bash
# hat-find [--all] [--days N] <term>...
set -uo pipefail
# Run as `bash -s`, so posix_sh's tmux -u wrapper does not reach it (#109).
command -v tmux >/dev/null 2>&1 && tmux() { command tmux -u "$@"; }
trap 'echo @@hatter-ok' EXIT

all=0 days=7
while [ $# -gt 0 ]; do
    case "$1" in
        --all)  all=1; shift ;;
        --days) days="${2:-7}"; shift 2 ;;
        --)     shift; break ;;
        *)      break ;;
    esac
done
case "$days" in ''|*[!0-9]*) days=7 ;; esac
[ $# -gt 0 ] || exit 0
command -v jq >/dev/null 2>&1 || { echo "@@hatter-err jq is not installed"; exit 0; }

# Terms reach awk through the environment: -v would expand backslashes in them.
HF_TERMS=$(printf '%s\037' "$@")
export HF_TERMS

# Where the transcripts are. A login profile may move them with
# CLAUDE_CONFIG_DIR, and ssh runs this without one, so ask the account's own
# login shell, as hat-launch does, giving a slow profile 10 seconds.
cfg="${CLAUDE_CONFIG_DIR:-}"
if [ -z "$cfg" ]; then
    login_shell=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
    [ -x "${login_shell:-}" ] || login_shell="${SHELL:-/bin/bash}"
    to=""; command -v timeout >/dev/null 2>&1 && to="timeout -k 2 10"
    cfg=$($to "$login_shell" -lc 'printf "HATCFG<%s>" "${CLAUDE_CONFIG_DIR:-}"' </dev/null 2>/dev/null) || cfg=""
    case "$cfg" in
        *"HATCFG<"*) cfg=${cfg##*HATCFG<}; cfg=${cfg%%>*} ;;
        *) cfg="" ;;
    esac
fi
[ -n "$cfg" ] || cfg="$HOME/.claude"
proj="$cfg/projects"
[ -d "$proj" ] || exit 0

PANES="${XDG_STATE_HOME:-$HOME/.local/state}/hatter/panes"

clean() { tr '\t\n\r\037' '    '; }

# The last value of a field on lines of one type, e.g. the title Claude gave
# the conversation. Such lines are rewritten as it goes, so the last one wins.
last_of() {
    grep -F "\"type\":\"$2\"" "$1" 2>/dev/null | tail -n 1 \
        | jq -j --arg k "$3" '.[$k] // empty' 2>/dev/null | clean
}

# The last 10k characters of what was said, from the transcript's last 3 MB.
# A cut line at the start of that is skipped by fromjson?.
convo() {
    tail -c 3000000 "$1" 2>/dev/null | jq -rR '
        fromjson? | select(.type == "user" or .type == "assistant")
        | select((.isMeta // false) | not) | select((.isSidechain // false) | not)
        | .message.content
        | if type == "string" then .
          elif type == "array" then [.[]? | select(.type == "text") | .text] | join(" ")
          else empty end
        | select(length > 0)' 2>/dev/null | clean | tail -c 10000
}

mtime_of() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

# score <head> <text> <closed>: prints "<score>\t<snippet>", or nothing when a
# term is missing. A closed session has already matched every term somewhere in
# its transcript, so for it a miss here still scores 0.
score() {
    printf '%s\037%s' "$1" "$2" | HF_CLOSED="$3" awk -v RS='\001' '
        BEGIN { n = split(ENVIRON["HF_TERMS"], t, "\037") }
        {
            split($0, f, "\037"); head = tolower(f[1]); text = f[2]; low = tolower(text)
            inhead = 1; ok = 1
            for (i = 1; i <= n; i++) {
                if (t[i] == "") continue
                w = tolower(t[i])
                if (!index(head, w)) { inhead = 0; if (!index(low, w)) ok = 0 }
            }
        }
        END {
            if (inhead) { printf "2\t\n"; exit }
            if (!ok) { if (ENVIRON["HF_CLOSED"] == 1) printf "0\t\n"; exit }
            # The last mention of the first term found in the text: the
            # nearest thing to what the session is doing now.
            for (i = 1; i <= n; i++) {
                w = tolower(t[i]); if (w == "") continue
                p = 0; s = low
                while ((k = index(s, w)) > 0) { p += k; s = substr(s, k + 1) }
                if (p) break
            }
            from = p > 60 ? p - 60 : 1
            snip = substr(text, from, 160)
            gsub(/  +/, " ", snip)
            printf "1\t%s%s\n", (from > 1 ? "..." : ""), snip
        }'
}

# One session: <state> <session> <window> <window_id> <sid> <cwd> <name> <file>
emit() {
    local title prompt text r
    title=$(last_of "$8" custom-title customTitle)
    [ -n "$title" ] || title=$(last_of "$8" ai-title aiTitle)
    prompt=$(last_of "$8" last-prompt lastPrompt)
    text=$(convo "$8")
    r=$(score "$title $prompt $7" "$text" "$([ "$1" = closed ] && echo 1 || echo 0)")
    [ -n "$r" ] || return 0
    printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
        "${r%%	*}" "$1" "$(mtime_of "$8")" "$2" "$3" "$4" "$5" \
        "$(printf '%s' "$6" | clean)" "$(printf '%s' "$7" | clean)" \
        "${title:-$prompt}" "${r#*	}"
}

transcript() {
    local t
    for t in "$proj"/*/"$1".jsonl; do [ -f "$t" ] && { printf '%s' "$t"; return 0; }; done
    return 1
}

# Running sessions: registry entries whose tmux window is still there.
live_ids=""
windows=$(tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{pid}.#{start_time}' 2>/dev/null) || windows=""
if [ -n "$windows" ] && [ -d "$PANES" ]; then
    for p in "$PANES"/*.json; do
        [ -f "$p" ] || continue
        # \037-joined, not @tsv, which would escape a backslash in a name.
        IFS=$'\037' read -r kind s w sid cwd name ewid esrv <<EOF
$(jq -j '[.kind // "", .session // "", (.window // "" | tostring), .session_id // "", .cwd // "", .name // "", .window_id // "", .server // ""] | join("\u001f")' "$p" 2>/dev/null)
EOF
        [ "${kind:-}" = claude ] && [ -n "${sid:-}" ] || continue
        # Recorded on this server: its window by id, where it is now. From
        # before (an older registry, or a server since restarted): by session
        # and index, the only guess there is.
        line=$(printf '%s\n' "$windows" | HF_I="${ewid:-}" HF_V="${esrv:-}" \
            awk -F '\t' 'ENVIRON["HF_I"] != "" && $3 == ENVIRON["HF_I"] && $4 == ENVIRON["HF_V"] { print; exit }')
        # An entry of this server whose window is gone is a closed tab, never
        # whichever window now sits at its index.
        cursrv=$(printf '%s\n' "$windows" | head -n 1 | cut -f 4)
        if [ -z "$line" ] && { [ -z "${esrv:-}" ] || [ "$esrv" != "$cursrv" ]; }; then
            line=$(printf '%s\n' "$windows" | HF_S="$s" HF_W="$w" \
                awk -F '\t' '$1 == ENVIRON["HF_S"] && $2 == ENVIRON["HF_W"] { print; exit }')
        fi
        [ -n "$line" ] || continue
        IFS=$'\t' read -r s w wid _ <<EOF
$line
EOF
        t=$(transcript "$sid") || continue
        live_ids="$live_ids $sid "
        emit live "$s" "$w" "$wid" "$sid" "$cwd" "$name" "$t"
    done
fi

[ "$all" = 1 ] || exit 0

# Closed sessions. Only <project>/<id>.jsonl: subagent transcripts sit deeper,
# under <project>/<id>/subagents/, and are not sessions of their own. Each term
# narrows the list with one grep over the files left.
list=$(find "$proj" -mindepth 2 -maxdepth 2 -name '*.jsonl' -mtime -"$days" 2>/dev/null)
for term in "$@"; do
    [ -n "$list" ] || break
    list=$(printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 grep -l -i -F -e "$term" -- 2>/dev/null)
done
[ -n "$list" ] || exit 0
while IFS= read -r t; do
    sid=$(basename "$t" .jsonl)
    case "$live_ids" in *" $sid "*) continue ;; esac
    # Where it last ran, if the registry kept its tab when the tab closed.
    hs="" hw="" hn="" cwd=""
    h="$PANES/closed/$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_.@-' '_').json"
    if [ -f "$h" ]; then
        IFS=$'\037' read -r hs hw hn cwd <<EOH
$(jq -j '[.session // "", (.window // "" | tostring), .name // "", .cwd // ""] | join("\u001f")' "$h" 2>/dev/null)
EOH
    fi
    [ -n "$cwd" ] || cwd=$(grep -m 1 -F '"cwd":' "$t" 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null)
    emit closed "$hs" "$hw" "" "$sid" "$cwd" "$hn" "$t"
done <<EOF
$list
EOF
exit 0
HATFIND

# find_age <epoch> -> "5m", "3h", "2d"
find_age() {
    local d=$(( $(date +%s) - $1 ))
    if   (( d < 3600 ));  then printf '%dm' $(( d / 60 ))
    elif (( d < 86400 )); then printf '%dh' $(( d / 3600 ))
    else printf '%dd' $(( d / 86400 )); fi
}

# Put a running session's tab in front: its hat's window, its workspace, the
# tab for its tmux window. Fails when cmux does not show the session.
find_focus() {
    local hat="$1" dest="$2" session="$3" wid="$4" win wref surface
    cmux_alive || return 1
    win=$(find_hat_window "$hat")
    [[ -n "$win" ]] || return 1
    wref=$(workspace_ref_by_title "$session" "$win")
    [[ -n "$wref" ]] || return 1
    surface=$(cmux_pane_map "$dest" "$session" | jq -r --arg w "$wid" \
        '.panes[]? | select(.window_id == $w) | .surface_id' 2>/dev/null | head -n 1) || surface=""
    HATTER_FOCUS_KEEP=1
    cmux_change focus-window --window "$win" >/dev/null 2>&1 || return 1
    cmux_change select-workspace --workspace "$wref" --window "$win" >/dev/null 2>&1 || return 1
    [[ -z "$surface" ]] || \
        cmux_change focus-panel --panel "$surface" --workspace "$wref" --window "$win" >/dev/null 2>&1 || true
    return 0
}

# find_default_workspace <hat> <last session> <cwd> <workspaces>: where a
# closed session should go back to. The workspace it last ran in, when that is
# still one of the hat's; otherwise the first workspace with a recorded tab in
# its directory; otherwise nothing.
find_default_workspace() {
    local hat="$1" last="$2" cwd="$3" list="$4" ws
    if [[ -n "$last" ]] && grep -qxF -- "$last" <<<"$list"; then
        printf '%s' "$last"; return 0
    fi
    [[ -n "$cwd" ]] || return 0
    while IFS= read -r ws; do
        [[ -n "$ws" ]] && grep -qxF -- "$ws" <<<"$list" && { printf '%s' "$ws"; return 0; }
    done < <(cfg --arg l "$hat" --arg c "$cwd" '
        .groups[] | select(.hat == $l) | .sessions | to_entries[]
        | select([.value.windows[]?.cwd] | index($c)) | .key')
    return 0
}

# find_resume <hat> <dest> <session> <tab name> <cwd> <session id>: open a tab in
# <session> that resumes the conversation through hat-launch, starting the
# session if it is not running. hat-launch records the pane, so the session is
# live to `find` and comes back at boot, and it starts claude with the hat's
# @hat_claude_args like any other pane. Prints the new tmux window's
# "<index>\037<id>".
find_resume() {
    local hat="$1" dest="$2" session="$3" name="$4" cwd="$5" sid="$6" launch create out
    # $HOME is left for the server's shell to expand.
    launch="\"\$HOME/.local/bin/hat-launch\" --resume claude $(sq "$sid")"
    if remote_session_exists "$dest" "$session"; then
        create="tmux new-window -d -P -F '#{window_index}$HT#{window_id}' -t $(sq "=$session:")"
    else
        create="tmux new-session -d -P -F '#{window_index}$HT#{window_id}' -s $(sq "$session")"
    fi
    out=$(remote_sh "$dest" "[ -x \"\$HOME/.local/bin/hat-launch\" ] || { echo @@no-launch; exit 0; }
        cd $(sq_dir "$cwd") 2>/dev/null || cd
        $create -n $(sq "${name:-claude}") -c \"\$PWD\" $(sq "$launch")") || return 1
    out=$(printf '%s' "$out" | tmux_fields)
    if [[ "$out" == @@no-launch ]]; then
        warn "hat '$hat' has no hat-launch - run: hatter provision $hat"
        return 1
    fi
    [[ "$out" == *$'\037'* ]] || return 1
    printf '%s' "$out"
}

# Picking a closed session from `find`: ask which workspace to resume it in,
# with the one it came from offered first, then open it there and go to it.
find_resume_pick() {
    local hat="$1" dest="$2" sid="$3" cwd="$4" last="$5" name="$6"
    local list def session a i=1 out window wid
    local -a choices=()
    list=$(hat_workspaces "$hat")
    def=$(find_default_workspace "$hat" "$last" "$cwd" "$list")
    echo
    echo "  Resume it in which workspace on '$hat'?"
    if [[ -n "$list" ]]; then
        while IFS= read -r a; do choices+=("$a"); done <<<"$list"
    fi
    choices+=("+ new workspace")
    for a in "${choices[@]}"; do
        printf '  %2d) %s%s\n' "$i" "$a" "$( [[ "$a" == "$def" ]] && printf '   %s<- where it last ran%s' "$C_DIM" "$C_R")" >&2
        i=$((i + 1))
    done
    while true; do
        if [[ -n "$def" ]]; then
            ask_line "workspace (Enter for $def), Esc to cancel" || return 0
        else
            ask_line "workspace (1-${#choices[@]}), Esc to cancel" || return 0
        fi
        a="$EDIT_REPLY"
        if [[ -z "$a" ]]; then
            [[ -n "$def" ]] || return 0
            session="$def"; break
        fi
        if [[ "$a" =~ ^[1-9][0-9]*$ && "$a" -ge 1 && "$a" -le ${#choices[@]} ]]; then
            session="${choices[$((a - 1))]}"; break
        fi
        echo "  pick a number from 1 to ${#choices[@]}" >&2
    done
    if [[ "$session" == "+ new workspace" ]]; then
        ask_line "name (becomes $hat-<name>), Esc to cancel" || return 0
        [[ -n "$EDIT_REPLY" ]] || return 0
        session=$(hat_session_name "$hat" "$(tmux_session_name "$EDIT_REPLY")")
    fi

    out=$(find_resume "$hat" "$dest" "$session" "$name" "$cwd" "$sid") \
        || die "could not open a tab in '$session' on $dest"
    IFS=$'\037' read -r window wid <<<"$out"
    info "Resuming it in '$session', tab $window"

    if ! have_cmux; then
        attach_session "$hat" "$session" "$window"
    fi
    # A workspace cmux does not show yet is mirrored, and recorded, by new.
    local win
    win=$(find_hat_window "$hat")
    if [[ -z "$win" || -z "$(workspace_ref_by_title "$session" "$win")" ]]; then
        "$0" new "$session" --hat "$hat" </dev/tty || warn "could not bring '$session' into cmux: hatter new $session --focus"
    fi
    # The new tab takes a moment to show up in the mirror: wait for cmux to map
    # its window before going to it, or only the workspace would be selected.
    for i in 1 2 3 4 5 6 7 8; do
        cmux_pane_map "$dest" "$session" \
            | jq -e --arg w "$wid" '[.panes[]? | select(.window_id == $w)] | length > 0' >/dev/null 2>&1 && break
        sleep 0.5
    done
    find_focus "$hat" "$dest" "$session" "$wid" && return 0
    warn "cmux does not show '$session' yet - open it with: hatter new $session --focus"
    return 0
}

cmd_find() {
    local all=0 days=7 only="" limit=20 a
    local -a terms=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)  all=1; shift ;;
            --days) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--days needs a number of days"
                    all=1; days="$2"; shift 2 ;;
            --limit) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--limit needs a number (0 for all)"
                    limit="$2"; shift 2 ;;
            --hat)  [[ -n "${2:-}" ]] || die "--hat needs a hat name"
                    hat_exists "$2" || die "no hat named '$2'"
                    only="$2"; shift 2 ;;
            --)     shift; terms+=("$@"); break ;;
            -*)     die "unknown option: $1  (try: hatter help find)" ;;
            *)      terms+=("$1"); shift ;;
        esac
    done
    [[ ${#terms[@]} -gt 0 ]] || { usage_cmd find; exit 1; }
    colour_setup

    # One search per ssh destination: hats that share an account share its
    # transcripts and its tmux server.
    local -a dests=() hats_of=()
    local hat dest i found
    while IFS= read -r hat; do
        [[ -n "$hat" ]] || continue
        [[ -z "$only" || "$hat" == "$only" ]] || continue
        dest=$(hat_ssh "$hat")
        [[ -n "$dest" ]] || continue
        found=""
        for ((i = 0; i < ${#dests[@]}; i++)); do
            [[ "${dests[$i]}" == "$dest" ]] && { found=$i; break; }
        done
        if [[ -n "$found" ]]; then
            hats_of[$found]="${hats_of[$found]} $hat"
        else
            dests+=("$dest"); hats_of+=("$hat")
        fi
    done < <(hat_names)
    [[ ${#dests[@]} -gt 0 ]] || die "no hats to search"

    local args="exec bash -s --"
    [[ "$all" == 1 ]] && args+=" --all --days $days"
    args+=" --"
    for a in "${terms[@]}"; do args+=" $(sq "$a")"; done

    local tmp
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-find.XXXXXX")
    info "Searching $( [[ "$all" == 1 ]] && echo "live and closed (last ${days}d)" || echo live ) Claude sessions on ${#dests[@]} hat(s)..." >&2
    for ((i = 0; i < ${#dests[@]}; i++)); do
        printf '%s\n' "$FIND_SH" | ssh "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 \
            "${dests[$i]}" "$(posix_sh "$args")" > "$tmp/$i" 2>/dev/null &
    done
    wait

    # Each match, prefixed with the hat it belongs to and its destination's index.
    local line score state mtime session window wid sid cwd name title snip owner h
    for ((i = 0; i < ${#dests[@]}; i++)); do
        if ! grep -qx '@@hatter-ok' "$tmp/$i"; then
            warn "could not reach ${hats_of[$i]# } (${dests[$i]}) - not searched"
            continue
        fi
        while IFS= read -r line; do
            case "$line" in
                "@@hatter-err "*) warn "${hats_of[$i]# }: ${line#@@hatter-err }"; continue ;;
                ""|@@hatter-ok) continue ;;
            esac
            IFS=$'\037' read -r score state mtime session window wid sid cwd name title snip <<<"$line"
            # A session belongs to the hat that records it or whose prefix it
            # carries; otherwise to the first hat on that account.
            owner=""
            if [[ -n "$session" ]]; then
                h=$(session_hat "$session" 2>/dev/null || true)
                [[ " ${hats_of[$i]} " == *" $h "* ]] && owner="$h"
            fi
            [[ -n "$owner" ]] || { owner="${hats_of[$i]# }"; owner="${owner%% *}"; }
            printf '%s\037%s\037%s\n' "$owner" "$i" "$line"
        done < "$tmp/$i"
    done > "$tmp/all"

    # Best first: every term in the title, then live before closed, then newest.
    sort -t $'\037' -k3,3nr -k4,4r -k5,5nr "$tmp/all" > "$tmp/sorted"
    local n total
    total=$(grep -c '' "$tmp/sorted" || true)
    n=$total
    if [[ "$limit" -gt 0 && "$n" -gt "$limit" ]]; then
        n=$limit
        head -n "$n" "$tmp/sorted" > "$tmp/top" && mv "$tmp/top" "$tmp/sorted"
    fi
    if [[ "$n" -eq 0 ]]; then
        rm -rf "$tmp"
        echo "  no session matches: ${terms[*]}" >&2
        exit 1
    fi

    local -a rows=()
    local k=0 di where
    while IFS= read -r line; do
        rows+=("$line"); k=$((k + 1))
        IFS=$'\037' read -r owner di score state mtime session window wid sid cwd name title snip <<<"$line"
        if [[ "$state" == live ]]; then
            where="$session:$window${name:+ ($name)}"
        else
            where="${C_DIM}closed${C_R}${session:+  last in $session${name:+ ($name)}}  $(edit_short_path "$cwd" 2>/dev/null || printf '%s' "$cwd")"
        fi
        printf '  %2d) %s%s%s  %s  %s%s ago%s\n' "$k" "$C_B" "$owner" "$C_R" "$where" "$C_DIM" "$(find_age "$mtime")" "$C_R"
        printf '      %s\n' "$(edit_trunc "${title:-(untitled)}" 100)"
        [[ -z "$snip" ]] || printf '      %s%s%s\n' "$C_DIM" "$(edit_trunc "$snip" 100)" "$C_R"
    done < "$tmp/sorted"
    rm -rf "$tmp"
    [[ "$total" -le "$n" ]] || \
        printf '  %s... and %d more: add a term to narrow it, or --limit 0 for all%s\n' "$C_DIM" $((total - n)) "$C_R"

    [[ -t 0 && -t 1 ]] || return 0
    local pick
    while true; do
        ask_line "open which (1-$n), Esc to skip" || return 0
        pick="$EDIT_REPLY"
        [[ -n "$pick" ]] || return 0
        [[ "$pick" =~ ^[1-9][0-9]*$ && "$pick" -ge 1 && "$pick" -le "$n" ]] && break
        echo "  pick a number from 1 to $n" >&2
    done
    IFS=$'\037' read -r owner di score state mtime session window wid sid cwd name title snip <<<"${rows[$((pick - 1))]}"
    dest="${dests[$di]}"

    if [[ "$state" != live ]]; then
        find_resume_pick "$owner" "$dest" "$sid" "$cwd" "$session" "$name"
        return 0
    fi
    if have_cmux; then
        find_focus "$owner" "$dest" "$session" "$wid" && return 0
        warn "cmux does not show '$session' - open it with: hatter new $session --focus"
        return 0
    fi
    attach_session "$owner" "$session" "$window"
}

# The Termux widget lists the scripts under ~/.shortcuts as home-screen buttons.
# One per hat, which opens the workspace picker, and one per recorded
# workspace. A workspace is named "<hat> <rest of its name>": a space sorts
# before anything else, so each hat's workspaces come straight after it.
#
# The directory is hatter's own, but only files carrying the marker are
# removed, so a script of your own put there survives a rewrite.
SHORTCUT_MARK='# hatter shortcut - rewritten by `hatter shortcuts`; edits are lost.'

shortcut_write() {
    # shortcut_write <dir> <file name> <attach target> <hatter> <bash>
    local f="$1/${2//\//_}"
    printf '#!%s\n%s\nexec %s attach %s\n' "$5" "$SHORTCUT_MARK" "$(sq "$4")" "$(sq "$3")" > "$f"
    chmod 700 "$f"
}

cmd_shortcuts() {
    local dir="$HOME/.shortcuts/hatter"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir) [[ -n "${2:-}" ]] || die "--dir needs a path"; dir="$2"; shift 2 ;;
            *) die "unknown argument: $1" ;;
        esac
    done

    local self bash_bin
    self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
    bash_bin=$(command -v bash) || die "bash is not on PATH"

    mkdir -p "$dir"
    local f
    for f in "$dir"/*; do
        [[ -f "$f" ]] || continue
        [[ "$(sed -n 2p "$f" 2>/dev/null)" == "$SHORTCUT_MARK" ]] && rm -f "$f"
    done

    local hat session n=0
    while IFS= read -r hat; do
        [[ -n "$hat" ]] || continue
        shortcut_write "$dir" "$hat" "$hat" "$self" "$bash_bin"
        n=$((n+1))
        while IFS= read -r session; do
            [[ -n "$session" ]] || continue
            shortcut_write "$dir" "$hat ${session#"$hat"-}" "$session" "$self" "$bash_bin"
            n=$((n+1))
        done < <(cfg --arg l "$hat" '[.groups[] | select(.hat == $l) | .sessions | keys_unsorted[]?] | unique[]')
    done < <(hat_names)
    info "Wrote $n shortcuts to $dir"
    return 0
}

# A new machine's ssh key cannot log in to a server that only takes keys, so
# it cannot authorise itself. This machine already gets in, so it carries the
# key there. The key travels on stdin rather than in the command line, which
# keeps it out of quoting and out of the remote process list.
#
# Keys are compared on type and blob only, so the same key with a different
# comment is not added twice.
key_valid() {
    # One line, and ssh-keygen agrees it is a public key.
    [[ "$1" != *$'\n'* ]] || return 1
    printf '%s\n' "$1" | ssh-keygen -l -f /dev/stdin >/dev/null 2>&1
}

key_add_to() {
    # key_add_to <hat> <key> -> prints added | present; non-zero if unreachable
    local dest script
    dest=$(hat_ssh "$1")
    [[ -n "$dest" ]] || return 1
    # Run under sh whatever the login shell is: `set -- $k` needs word splitting.
    script='IFS= read -r k || exit 3
umask 077
mkdir -p ~/.ssh && touch ~/.ssh/authorized_keys || exit 4
set -f
set -- $k
if awk -v t="$1" -v b="$2" '\''{ sub(/\r$/, "") } $1 == t && $2 == b { f = 1 } END { exit !f }'\'' ~/.ssh/authorized_keys; then
    echo present
else
    # A file saved without a final newline would swallow the new key into its last line.
    if [ -s ~/.ssh/authorized_keys ] && [ -n "$(tail -c 1 ~/.ssh/authorized_keys)" ]; then echo >> ~/.ssh/authorized_keys; fi
    printf "%s\n" "$k" >> ~/.ssh/authorized_keys && echo added
fi'
    # BatchMode: a hat that refuses this machine's key is "unreachable", not a
    # password prompt fighting the key for stdin.
    printf '%s\n' "$2" | ssh "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=10 "$dest" "$(posix_sh "$script")"
}

cmd_key() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        add) ;;
        *) usage_cmd key; exit 1 ;;
    esac

    local src="${1:-}" key all=0 hat
    shift || true
    [[ -n "$src" ]] || { usage_cmd key; exit 1; }
    if [[ -f "$src" ]]; then
        key=$(cat "$src")
    else
        key="$src"
    fi
    # Trailing newline or CR from a file or a Windows clipboard.
    key="${key%$'\n'}"; key="${key%$'\r'}"
    key_valid "$key" || die "that is not one ssh public key (expected e.g. 'ssh-ed25519 AAAA... name')"

    local -a hats=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=1 ;;
            -*) die "unknown flag: $1" ;;
            *) hat_exists "$1" || die "unknown hat: $1"; hats+=("$1") ;;
        esac
        shift
    done
    if [[ $all -eq 1 ]]; then
        hats=()
        while IFS= read -r hat; do [[ -n "$hat" ]] && hats+=("$hat"); done < <(hat_names)
    fi
    [[ ${#hats[@]} -gt 0 ]] || die "name the hats to add the key to, or pass --all"

    local fp result failed=0
    fp=$(printf '%s\n' "$key" | ssh-keygen -l -f /dev/stdin 2>/dev/null | awk '{print $2}')
    info "Adding $fp"
    for hat in "${hats[@]}"; do
        if result=$(key_add_to "$hat" "$key" 2>/dev/null) && [[ -n "$result" ]]; then
            printf '  %-12s %s\n' "$hat" "$result"
        else
            printf '  %-12s unreachable - not added\n' "$hat"
            failed=1
        fi
    done
    return $failed
}

# A remote sh fragment that ends tmux session $s and makes sure a reboot does
# not bring it back. Prints "killed" or "not running", or "@@hatter-err <why>".
#
# A tmux-resurrect snapshot still holds the session, and it is restored by
# hand, or when the server starts on a host provisioned before continuum's
# auto-restore was turned off. So a fresh one is taken
# once it is gone (hat-save, when provisioned), and then the session is taken
# out of whatever snapshot `last` points at. The second step is what covers
# the last session on a server: hat-save keeps the old snapshot when nothing
# is running, rather than save an empty one. The snapshot directory is read
# before the kill, while the server that knows @resurrect-dir is still up.
REMOTE_END_SH="$REMOTE_LIST_SH"'
[ -z "$lerr" ] || { printf "@@hatter-err %s\n" "$lerr"; exit 0; }
dir=$(tmux show-option -gqv @resurrect-dir 2>/dev/null) || dir=""
if [ -z "$dir" ]; then
    if [ -d "$HOME/.tmux/resurrect" ]; then dir="$HOME/.tmux/resurrect"
    else dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"; fi
fi
case "$dir" in "\$HOME"*) dir="$HOME${dir#\$HOME}" ;; "~"*) dir="$HOME${dir#\~}" ;; esac
if printf "%s\n" "$list" | grep -qxF -- "$s"; then
    if ! e=$(tmux kill-session -t "=$s" 2>&1); then
        printf "@@hatter-err could not end it: %s\n" "$(printf "%s\n" "$e" | head -n 1)"; exit 0
    fi
    echo killed
    [ -x "$HOME/.local/bin/hat-save" ] && "$HOME/.local/bin/hat-save" >/dev/null 2>&1
else
    echo "not running"
fi
f=$(readlink "$dir/last" 2>/dev/null) || f=""
case "$f" in "") exit 0 ;; /*) ;; *) f="$dir/$f" ;; esac
strip() { S="$s" awk -F "\t" "!((\$1 == \"pane\" || \$1 == \"window\" || \$1 == \"grouped_session\") && (\$2 \"\") == (ENVIRON[\"S\"] \"\"))" "$1"; }
if [ -s "$f" ] && [ "$(strip "$f" | wc -l)" -ne "$(wc -l < "$f")" ]; then
    new="tmux_resurrect_$(date +%Y%m%dT%H%M%S)-hatter-rm.txt"
    strip "$f" > "$dir/$new.tmp" && mv "$dir/$new.tmp" "$dir/$new" && ln -sfn "$new" "$dir/last"
fi
exit 0'

# remote_end_session <host> <session>: prints "killed" or "not running".
# Returns 1 when the server cannot be reached, 2 when its tmux cannot be read
# or would not end the session (the reason goes to stderr).
remote_end_session() {
    local out
    out=$(remote_sh "$1" "s=$(sq "$2"); $REMOTE_END_SH" 2>/dev/null) || return 1
    if grep -q '^@@hatter-err ' <<<"$out"; then
        sed -n 's/^@@hatter-err //p' <<<"$out" | head -n 1 >&2
        return 2
    fi
    case "$out" in killed|'not running') printf '%s\n' "$out" ;; *) return 1 ;; esac
}

# forget_session <session> <hat>: drop a session from every group that records
# it on <hat>'s server. Hats that share an ssh destination share its tmux, so
# there the name is one session; a hat on another server that records the same
# name has a session of its own, and keeps its entry.
forget_session() {
    backup_config
    jq_write --arg s "$1" --arg l "$2" '
        (.hats[$l].ssh // "") as $h
        | [.hats | to_entries[] | select(.key == $l or ($h != "" and .value.ssh == $h)) | .key] as $same
        | .groups |= map_values(if .sessions and ((.hat // "") as $x | $same | index($x))
                                then del(.sessions[$s]) else . end)
        | '"$PRUNE_UNASSIGNED"
}

# The deliberate way to close a workspace. Sync keeps a session that is still
# running even when cmux no longer shows it, so forgetting one has to be asked
# for. By default the tmux session is ended too, and kept out of what the
# server brings back after a reboot; --keep-running forgets the config entry
# and leaves the server exactly as it is. See: hatter help rm.
cmd_rm() {
    local session="" keep=0 want="" usage="usage: hatter rm <session> [--hat <hat>] [--keep-running]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --keep-running) keep=1; shift ;;
            --hat) [[ $# -ge 2 && -n "$2" ]] || die "$usage"
                   want="$2"; shift 2 ;;
            -*) die "unknown flag: $1  (try: hatter help rm)" ;;
            *)  [[ -z "$session" ]] || die "$usage"
                session="$1"; shift ;;
        esac
    done
    [[ -n "$session" ]] || die "$usage"

    # Which hat. A session no group records can still be ended: its prefix
    # names the hat. A name need not carry a prefix, and hats on two servers
    # can each record it: those are two sessions, and which one to end is not
    # a guess to make, not even from the window it was typed in.
    local group="" hat host
    if [[ -n "$want" ]]; then
        hat_exists "$want" || die "unknown hat: $want"
        hat="$want"
    else
        hat=$(session_hat_typed "$session" "hatter rm $session --hat <hat>") || exit 1
    fi
    [[ -z "$hat" ]] || group=$(session_group "$session" "$hat")
    if [[ -z "$group" ]]; then
        [[ "$keep" == 0 ]] || die "no recorded session named '$session'${want:+ on hat '$want'}, so nothing to forget"
        [[ -n "$hat" ]] || die "no recorded session named '$session', and no hat is called '${session%%-*}'"
    fi
    host=$(hat_ssh "$hat")

    # Its window, found while the config still records the session.
    local unwin=""
    if [[ -n "$group" && "$group" == "$(unassigned_key "$hat")" ]] && cmux_alive; then
        unwin=$(find_hat_window "$hat" 2>/dev/null) || unwin=""
    fi

    if [[ "$keep" == 1 ]]; then
        forget_session "$session" "$hat"
        drop_unassigned_now "$hat" "$unwin"
        info "Forgot '$session' (group '$group'); the server was not touched"
        echo "  If it is running it goes on running, and tmux-resurrect may bring it back"
        echo "  after a reboot. While it runs, the next sync records it again: in its group"
        echo "  while cmux shows it in one, otherwise in its hat's Unassigned group."
        return 0
    fi

    local result="" rc=0 why errf
    [[ -n "$host" ]] || die "hat '$hat' has no ssh destination; nothing changed (--keep-running forgets the entry only)"
    errf=$(mktemp "${TMPDIR:-/tmp}/hatter-rm.XXXXXX")
    result=$(remote_end_session "$host" "$session" 2>"$errf") || rc=$?
    why=$(head -n 1 "$errf"); rm -f "$errf"
    case "$rc" in
        0) ;;
        2) die "tmux on $host could not end '$session': ${why:-no reason given}
  Nothing was changed in the config. --keep-running forgets the entry only." ;;
        *) die "could not reach $host to end '$session'; nothing changed.
  --keep-running forgets the entry and leaves the server alone." ;;
    esac
    if [[ -n "$group" ]] && ! ( forget_session "$session" "$hat" ); then
        [[ "$result" == killed ]] || die "could not drop '$session' from the config"
        die "killed '$session' on $host, but could not drop it from the config.
  Finish with: hatter rm $session --keep-running"
    fi
    case "$result:${group:+recorded}" in
        killed:recorded) info "Killed tmux session '$session' on $host and forgot it (group '$group')" ;;
        killed:)         info "Killed tmux session '$session' on $host (it was in no group)" ;;
        *:recorded)      info "Forgot '$session' (group '$group'); it was not running on $host" ;;
        *)               die "'$session' is neither recorded nor running on $host" ;;
    esac
    drop_unassigned_now "$hat" "$unwin"
    # Tell the server now, or hat-restore brings it back after a reboot before
    # the next sync has.
    tell_server_sessions "$host" 2>/dev/null \
        || warn "$host: could not tell the server what to bring back after a reboot"
    return 0
}

cmd_rename() {
    # Rename a session everywhere at once: on the server, in cmux, in the config.
    local old="" new="" want="" usage="usage: hatter rename <old-session> <new-session> [--hat <hat>]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hat) [[ $# -ge 2 && -n "$2" ]] || die "$usage"
                   want="$2"; shift 2 ;;
            -*) die "unknown flag: $1  (try: hatter help rename)" ;;
            *)  if [[ -z "$old" ]]; then old="$1"
                elif [[ -z "$new" ]]; then new="$1"
                else die "$usage"; fi
                shift ;;
        esac
    done
    [[ -n "$old" && -n "$new" ]] || die "$usage"
    local given="$new"
    new=$(tmux_session_name "$new")
    [[ "$new" == "$given" ]] || \
        warn "tmux cannot hold '.' or ':' in a session name - using '$new'"

    local group hat host
    if [[ -n "$want" ]]; then
        hat_exists "$want" || die "unknown hat: $want"
        hat="$want"
    else
        hat=$(session_hat_typed "$old" "hatter rename $old $new --hat <hat>" here) || exit 1
    fi
    group=$(session_group "$old" "$hat")
    [[ -n "$group" ]] || die "no recorded session named '$old'${want:+ on hat '$want'} (see: hatter list)"
    host=$(hat_ssh "$hat")

    if remote_session_exists "$host" "$new"; then
        die "a tmux session named '$new' already exists on $host"
    fi

    if remote_session_exists "$host" "$old"; then
        info "tmux rename-session '$old' -> '$new' on $host"
        remote_sh "$host" "tmux rename-session -t $(sq "=$old") $(sq "$new")"
    else
        warn "'$old' is not running on $host; renaming the config entry only"
    fi

    backup_config
    jq_write --arg g "$group" --arg o "$old" --arg n "$new" '
        .groups[$g].sessions[$n] = .groups[$g].sessions[$o]
        | del(.groups[$g].sessions[$o])
    '

    # The mirror follows the tmux rename, but nudge the workspace title in case
    # this hat is not currently mirrored.
    local wref
    wref=$(workspace_ref_by_title "$new")
    [[ -z "$wref" ]] && wref=$(workspace_ref_by_title "$old")
    if [[ -n "$wref" ]]; then
        cmux_change rename-workspace --workspace "$wref" "$new" >/dev/null 2>&1 || true
    fi

    info "Renamed '$old' -> '$new' (hat: $hat, group: $group)"
}

cmd_backup() {
    # sync, then commit and push the config as a plain git repo. Deliberately
    # nothing product-specific: any git remote reachable over ssh will do.
    local msg="${1:-}"

    command -v git >/dev/null 2>&1 || die "git is not installed"
    if [[ ! -d "$CONFIG_DIR/.git" ]]; then
        die "$CONFIG_DIR is not a git repo.
  Set one up with:
    cd $CONFIG_DIR && git init -b main
    git remote add origin <user@host>:git/dotfiles.git"
    fi

    # A backup is still worth taking while cmux is down - the config on disk is
    # the thing being preserved - but say plainly that it was not re-synced.
    if cmux_alive; then
        cmd_sync
    else
        warn "$(cmux_refusal_summary); committing the config as it stands, unsynced"
    fi
    backup_commit_push "$msg"
}

backup_self() { printf '%s/%s' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")"; }
backup_script_stale() {
    local self
    self=$(backup_self)
    ! cmp -s "$self" "$CONFIG_DIR/bin/$(basename "$self")"
}

# The half of a backup after the sync: commit and push. Holds the config lock
# while it commits, so the autosave timer cannot write halfway through.
backup_commit_push() {
    local msg="${1:-}" held=0
    if [[ "$HATTER_LOCK_HELD" != 1 ]]; then
        hatter_lock 20 || die "another hatter is writing the config - try again in a moment"
        held=1
    fi

    # The config alone is only half the state - it is useless without the tool
    # that reads it. Keeping a copy of the script in the same repo means one
    # clone restores both after a Mac rebuild.
    mkdir -p "$CONFIG_DIR/bin"
    local self
    self=$(backup_self)
    if backup_script_stale; then
        cp "$self" "$CONFIG_DIR/bin/$(basename "$self")"
        chmod +x "$CONFIG_DIR/bin/$(basename "$self")"
    fi

    # --porcelain covers untracked files too; diff --quiet alone would miss a
    # brand-new bin/hatter and quietly skip the commit.
    if [[ -z "$(git -C "$CONFIG_DIR" status --porcelain)" ]]; then
        info "No config changes to back up"
    else
        [[ -n "$msg" ]] || msg="hatter config $(date '+%Y-%m-%d %H:%M')"
        git -C "$CONFIG_DIR" add -A
        git -C "$CONFIG_DIR" -c commit.gpgsign=false commit -q -m "$msg"
        info "Committed: $msg"
    fi

    if git -C "$CONFIG_DIR" remote get-url origin >/dev/null 2>&1; then
        if git -C "$CONFIG_DIR" push -q origin HEAD 2>&1; then
            info "Pushed to $(git -C "$CONFIG_DIR" remote get-url origin)"
        else
            warn "push failed - the remote may be unreachable; the commit is safe locally"
        fi
    else
        warn "no 'origin' remote set; committed locally only"
    fi
    [[ "$held" == 1 ]] && hatter_unlock
    return 0
}

# After a sync, the next thing worth doing is usually getting it off this
# machine. So an interactive sync asks, defaulting to yes, unless the config
# says never. The answer lives in the config rather than beside it, so "never"
# holds on every machine it is cloned to.
backup_ask_wanted() {
    [[ -t 0 && -t 1 ]] || return 1
    [[ -d "$CONFIG_DIR/.git" ]] && command -v git >/dev/null 2>&1 || return 1
    [[ "$(cfg '.prefs.backup_after_sync // "ask"')" != never ]] || return 1
    backup_pending
}

# Anything a backup would change: uncommitted edits, a newer copy of this
# script, or commits the remote does not have yet.
backup_pending() {
    [[ -n "$(git -C "$CONFIG_DIR" status --porcelain 2>/dev/null)" ]] && return 0
    backup_script_stale && return 0
    local ahead
    ahead=$(git -C "$CONFIG_DIR" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
    [[ "$ahead" -gt 0 ]]
}

backup_never_ask() {
    jq_write '.prefs.backup_after_sync = "never"'
    info "Will not ask again. Turn it back on with: hatter sync --ask-backup"
}

# The plain-terminal version. The rack asks with a single key instead.
backup_offer() {
    backup_ask_wanted || return 0
    local a
    printf 'Back up the config to git now? [Y]es / [n]o / ne[v]er ask: '
    IFS= read -r a || { echo; return 0; }
    case "$a" in
        ""|y|Y|yes|YES|Yes) backup_commit_push ;;
        v|V|never|NEVER|Never) backup_never_ask ;;
        *) info "Not backed up" ;;
    esac
    return 0
}

# The autosave timer's own backup, so the config leaves the machine without
# anyone remembering to. It pushes when the config has drifted a long way from
# the pushed copy, or when anything at all has sat unpushed for a week. "The
# pushed copy" is the upstream tracking ref, which a successful push moves; its
# commit date stands in for when it was pushed, since a backup commits and
# pushes together.
AUTO_BACKUP_PCT=10         # push once more than this share of lines changed
AUTO_BACKUP_DAYS=7         # push anything pending once the last push is this old
AUTO_BACKUP_RETRY=3600     # after a failed push, wait this long before the next

# How far the config has drifted from the pushed copy, as a whole percentage:
# lines added plus lines removed, over the lines in the pushed copy. A config
# the remote has never seen is 100.
backup_drift_pct() {
    local base changed
    base=$(git -C "$CONFIG_DIR" show '@{u}:config.json' 2>/dev/null | wc -l | tr -d ' ') || base=0
    [[ "$base" -gt 0 ]] || { echo 100; return 0; }
    changed=$(git -C "$CONFIG_DIR" diff --numstat '@{u}' -- config.json 2>/dev/null \
        | awk '{ n += $1 + $2 } END { print n + 0 }')
    echo $(( changed * 100 / base ))
}

# Prints why a backup is due and returns 0, or returns 1 when it is not.
backup_auto_due() {
    [[ -d "$CONFIG_DIR/.git" ]] && command -v git >/dev/null 2>&1 || return 1
    [[ "$(cfg '.prefs.auto_backup // "on"')" != off ]] || return 1
    git -C "$CONFIG_DIR" remote get-url origin >/dev/null 2>&1 || return 1
    backup_pending || return 1

    local pct pushed age
    pct=$(backup_drift_pct)
    if [[ "$pct" -gt "$AUTO_BACKUP_PCT" ]]; then
        printf '%s%% of the config changed\n' "$pct"
        return 0
    fi
    pushed=$(git -C "$CONFIG_DIR" log -1 --format=%ct '@{u}' 2>/dev/null) || pushed=0
    age=$(( $(date +%s) - ${pushed:-0} ))
    if [[ "$age" -ge $(( AUTO_BACKUP_DAYS * 86400 )) ]]; then
        printf 'last push %s days ago\n' "$(( age / 86400 ))"
        return 0
    fi
    return 1
}

# Commit and push if due. Never prompts: ssh runs in batch mode with a connect
# timeout, so a remote that wants a password, or is down, cannot hang the
# timer. A failed push waits AUTO_BACKUP_RETRY before the next try, and is
# logged once per run of failures rather than once a minute. The state file
# holds: ok|failed, epoch, time, reason or error.
backup_auto() {
    local reason st now prev when out err
    reason=$(backup_auto_due) || return 0
    st="$AUTOSAVE_DIR/backup-state"
    now=$(date +%s)
    prev=$(sed -n 1p "$st" 2>/dev/null) || prev=""
    if [[ "$prev" == failed ]]; then
        when=$(sed -n 2p "$st" 2>/dev/null) || when=0
        [[ "$when" =~ ^[0-9]+$ ]] || when=0
        [[ $(( now - when )) -ge "$AUTO_BACKUP_RETRY" ]] || return 0
    fi

    out=$(
        export GIT_TERMINAL_PROMPT=0
        export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=2"
        backup_commit_push "hatter auto backup: $reason" 2>&1
    ) || true

    # Whatever backup_commit_push said, the upstream is the judge: anything
    # still pending means the push did not land.
    if backup_pending; then
        err=$(printf '%s\n' "$out" | grep -v '^==> ' | sed 's/^  !! //' | sed '/^$/d' | tail -n 1)
        [[ -n "$err" ]] || err="push failed with no message"
        [[ "$prev" == failed ]] || warn "auto backup failed, retrying hourly: $err"
        printf 'failed\n%s\n%s\n%s\n' "$now" "$(date '+%Y-%m-%d %H:%M:%S')" "$err" > "$st" 2>/dev/null || true
        return 0
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') autosave: backed up ($reason)"
    printf 'ok\n%s\n%s\n%s\n' "$now" "$(date '+%Y-%m-%d %H:%M:%S')" "$reason" > "$st" 2>/dev/null || true
    return 0
}

cmd_hat() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|"")
            cfg '.hats | to_entries[]
                 | "\(.key)\t-> \(.value.ssh)  [\(.value.remote_dir)]"
                   + (if .value.default_group then "  default group: \(.value.default_group)" else "" end)
                   + (if .value.mosh then "  mosh" else "" end)
                   + (if .value.launch.kind then "  launches \(.value.launch.kind)" else "" end)'
            ;;
        add|set)
            local name="${1:-}" ssh_dest="" dir="" defgroup="" mosh="" launch='{}' k v
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --ssh|--host) ssh_dest="$2"; shift 2 ;;
                    --dir) dir="$2"; shift 2 ;;
                    --group) defgroup="$2"; shift 2 ;;
                    --mosh) mosh=true; shift ;;
                    --no-mosh) mosh=false; shift ;;
                    --kind)
                        [[ $# -ge 2 ]] || die "--kind needs one of: $LAUNCH_KINDS (or '' to clear)"
                        [[ -z "$2" ]] || launch_kind_ok "$2" || die "--kind: '$2' is not one of: $LAUNCH_KINDS"
                        launch=$(jq -c --arg v "$2" '.kind = $v' <<< "$launch"); shift 2 ;;
                    --args)
                        [[ $# -ge 2 && "$2" == *=* ]] || die "--args takes <kind>=<arguments>, as in --args claude='--permission-mode auto'"
                        k="${2%%=*}" v="${2#*=}"
                        launch_kind_ok "$k" || die "--args: '$k' is not one of: $LAUNCH_KINDS"
                        launch_value_ok "$v" || die "--args: the arguments may not hold a quote, a backslash or a newline"
                        launch=$(jq -c --arg k "$k" --arg v "$v" '.args[$k] = $v' <<< "$launch"); shift 2 ;;
                    *) die "unknown flag: $1" ;;
                esac
            done
            [[ -n "$name" ]] || die "usage: hatter hat add <hat> --ssh user@host [--dir /path] [--group <name>] [--mosh] [--kind <kind>] [--args <kind>=<args>]"
            # Before anything is written: a default group may not be hatter's own.
            [[ -n "$defgroup" ]] && group_name_reserved "$defgroup" && \
                die "'$UNASSIGNED' is hatter's own group, kept for workspaces in no group - pick another default group"
            # Only the transport or the launch settings changing: no need to
            # ask for the rest again.
            if [[ ( -n "$mosh" || "$launch" != '{}' ) && -z "$ssh_dest$dir$defgroup" ]] \
               && hat_exists "$name"; then
                if [[ -n "$mosh" ]]; then
                    jq_write --arg l "$name" --argjson m "$mosh" '.hats[$l].mosh = $m'
                    info "Hat '$name' attaches with $([[ "$mosh" == true ]] && echo mosh || echo ssh)"
                fi
                hat_set_launch "$name" "$launch"
                return 0
            fi
            register_hat "$name" "$ssh_dest" "$dir" "$defgroup"
            if [[ -n "$mosh" ]]; then
                jq_write --arg l "$name" --argjson m "$mosh" '.hats[$l].mosh = $m'
            fi
            hat_set_launch "$name" "$launch"
            if [[ -n "$defgroup" ]]; then
                group_exists "$defgroup" || register_group "$defgroup" "$name"
            fi
            ;;
        status)
            printf '%-10s  %-24s  %-8s  %-5s  %-8s  %-4s  %s\n' \
                HAT DESTINATION STATUS TMUX RESURRECT SESS WINDOW
            # Each row finds its hat's window, which reads every window: one
            # snapshot for the table rather than one pass of cmux per hat.
            local hat
            cmux_snapshot
            while IFS= read -r hat; do
                [[ -z "$hat" ]] && continue
                hat_status_row "$hat"
            done < <(hat_names)
            cmux_snapshot_drop
            ;;
        rename|mv)
            local old="${1:-}" new="${2:-}"
            [[ -n "$old" && -n "$new" ]] || die "usage: hatter hat rename <old> <new>"
            hat_exists "$old" || die "unknown hat: $old"
            hat_exists "$new" && die "hat '$new' already exists"

            local host
            host=$(hat_ssh "$old")

            # The prefix is load-bearing, so any session carrying the old one has
            # to be renamed on the server too. That renames the cmux workspace.
            local session
            while IFS= read -r session; do
                [[ -z "$session" ]] && continue
                [[ "$session" == "$old"-* ]] || continue
                local renamed="${new}-${session#"$old"-}"
                if remote_session_exists "$host" "$session"; then
                    info "tmux rename-session '$session' -> '$renamed'"
                    remote_sh "$host" \
                        "tmux rename-session -t $(sq "=$session") $(sq "$renamed")"
                fi
                jq_write --arg o "$session" --arg n "$renamed" '
                    .groups |= map_values(
                        if .sessions[$o]
                        then .sessions[$n] = .sessions[$o] | del(.sessions[$o])
                        else . end)
                '
            done < <(cfg --arg l "$old" '
                .groups | to_entries[] | select(.value.hat == $l) | .value.sessions | keys_unsorted[]?')

            backup_config
            jq_write --arg o "$old" --arg n "$new" --arg u "$UNASSIGNED" '
                .hats[$n] = .hats[$o]
                | del(.hats[$o])
                | .groups |= map_values(if .hat == $o then .hat = $n else . end)
                | .groups |= with_entries(if .key == "\($u)@\($o)" then .key = "\($u)@\($n)" else . end)
            '
            info "Renamed hat '$old' -> '$new'"
            ;;
        rm|remove)
            local name="${1:-}"
            [[ -n "$name" ]] || die "usage: hatter hat rm <prefix>"
            backup_config
            jq_write --arg l "$name" 'del(.hats[$l])'
            info "Removed hat '$name' from config"
            ;;
        *) die "unknown hat subcommand: $sub" ;;
    esac
}

cmd_group() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|"")
            cfg '.groups | to_entries[]
                 | if .value.managed
                   then "\(.value.name // .key)\t[hat: \(.value.hat), hatter'"'"'s own; key \(.key)]  \(.value.sessions | keys_unsorted | join(", "))"
                   else "\(.key)\t[hat: \(.value.hat)]  \(.value.sessions | keys_unsorted | join(", "))" end'
            ;;
        add|set)
            local name="${1:-}" hat=""
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --hat|--login|--prefix) hat="$2"; shift 2 ;;
                    *) die "unknown flag: $1" ;;
                esac
            done
            [[ -n "$name" ]] || die "usage: hatter group add <Name> --hat <prefix>"
            group_name_reserved "$name" && \
                die "'$UNASSIGNED' is hatter's own group, kept for workspaces in no group - pick another name"
            if [[ -z "$hat" ]]; then
                [[ -t 0 ]] || die "--hat is required"
                read -r -p "  hat prefix for '$name': " hat
            fi
            hat_exists "$hat" || register_hat "$hat" "" ""
            register_group "$name" "$hat"
            local win gref
            win=$(ensure_hat_window "$hat")
            gref=$(ensure_cmux_group "$name" "$win")
            apply_group_style "$name" "$gref"
            info "Group '$name' ready in window $win ($gref)"
            ;;
        rename|mv)
            local old_name="${1:-}" new_name="${2:-}"
            [[ -n "$old_name" && -n "$new_name" ]] || \
                die "usage: hatter group rename <old> <new>"
            group_exists "$old_name" || die "unknown group: $old_name"
            group_exists "$new_name" && die "a group named '$new_name' already exists"
            group_managed "$old_name" && \
                die "'$old_name' is hatter's own group and keeps its name. Move its workspaces
  into a real group instead: hatter new <session> --group <name>"
            group_name_reserved "$new_name" && \
                die "'$UNASSIGNED' is hatter's own group, kept for workspaces in no group - pick another name"

            local hat win gref
            hat=$(group_hat "$old_name")
            win=$(find_hat_window "$hat")
            if [[ -n "$win" ]]; then
                gref=$(group_ref_in_window "$win" "$old_name")
                [[ -n "$gref" ]] && \
                    cmux_group_rename "$gref" "$new_name" || true
            fi

            backup_config
            jq_write --arg o "$old_name" --arg n "$new_name" '
                .groups[$n] = .groups[$o]
                | del(.groups[$o])
                | .hats |= map_values(
                    if .default_group == $o then .default_group = $n else . end)
            '
            info "Renamed group '$old_name' -> '$new_name'"
            ;;
        rm|remove)
            local name="${1:-}"
            [[ -n "$name" ]] || die "usage: hatter group rm <Name>"
            group_managed "$name" && \
                die "'$name' is hatter's own group: hatter removes it once it is empty.
  Move its workspaces into a real group (hatter new <session> --group <name>),
  or end them (hatter rm <session>)."
            backup_config
            jq_write --arg g "$name" 'del(.groups[$g])'
            info "Removed '$name' from config (cmux group left untouched)"
            ;;
        *) die "unknown group subcommand: $sub" ;;
    esac
}

# settle_ungrouped <hat> <window> <live sessions> [windows] [groups] [workspaces]
#
# No session runs outside a group. A running session of <hat> that no group
# records is recorded in the hat's Unassigned group; then every workspace cmux
# shows loose in the hat's window goes into the group the config records it
# in, Unassigned or a real one; and Unassigned is removed once it is empty,
# from the config and cmux both. It changes cmux, so no snapshot may be held.
#
# The JSON arguments are what the caller has already read: the session -> tabs
# map sync builds from tmux, and the window's groups and workspaces. Any left
# empty is read here; "-" for the groups means the caller could not read them,
# and then cmux is not touched at all. In steady state, with all three given,
# it makes no cmux call and no extra ssh call.
settle_ungrouped() {
    local hat="$1" win="$2" live="$3" wjson="${4:-}" groups_json="${5:-}" ws_json="${6:-}"
    local key host s windows entries='{}' fresh un
    [[ -n "$live" ]] || return 0
    key=$(unassigned_key "$hat")
    host=$(hat_ssh "$hat")

    # 1. The config. The caller's list may be minutes old (the rack's is), so
    # anything about to be recorded is checked against the server once more.
    un=$(hat_unrecorded "$hat" "$live")
    if [[ -n "$un" ]]; then
        if fresh=$(hat_live_sessions "$host" 2>/dev/null); then
            live="$fresh"
            un=$(hat_unrecorded "$hat" "$live")
        else
            un=""
        fi
    fi
    while IFS= read -r s; do
        [[ -z "$s" ]] && continue
        if [[ -n "$wjson" ]]; then
            windows=$(jq -c --arg s "$s" '[.[$s][]? | del(.id)]' <<<"$wjson")
        else
            windows=$(remote_windows_json "$host" "$s" 2>/dev/null | jq -c 'map(del(.id))' 2>/dev/null) \
                || windows='[]'
        fi
        entries=$(jq -c --arg s "$s" --argjson w "${windows:-[]}" '.[$s] = {windows: $w}' <<<"$entries")
        echo "  $hat / $UNASSIGNED / $s  (running, was in no group)"
    done <<<"$un"
    if [[ "$entries" != '{}' ]]; then
        group_exists "$key" || register_group "$key" "$hat"
        # Checked again inside the write: a session some group of the hat has
        # recorded since (another hatter, say) stays where it was put.
        jq_write --arg g "$key" --arg l "$hat" --argjson e "$entries" '
            ([.groups | to_entries[] | select(.key != $g and .value.hat == $l)
              | .value.sessions // {} | keys_unsorted[]]) as $taken
            | .groups[$g].sessions += ($e | with_entries(select(.key as $s | $taken | index($s) | not)))
            | '"$PRUNE_UNASSIGNED"
    fi
    if group_exists "$key" && [[ "$(cfg --arg g "$key" '.groups[$g].sessions | length')" == 0 ]]; then
        jq_write "$PRUNE_UNASSIGNED"
    fi

    [[ -n "$win" && "$groups_json" != "-" ]] || return 0
    [[ -n "$groups_json" ]] || groups_json=$(window_groups_json "$win" 2>/dev/null) || return 0
    [[ -n "$ws_json" ]] || ws_json=$(window_ws_json "$win" 2>/dev/null) || return 0

    # 2. cmux: each loose workspace of a running session goes into the group
    # the config records it in. "<workspace id>\x1f<group key>" per line.
    local placed g ids name ref changed=0 done_n
    placed=$(jq -r --argjson g "$groups_json" --arg live "$live" \
                   --argjson rec "$(cfg -c --arg l "$hat" '[.groups | to_entries[] | select(.value.hat == $l)
                                        | .key as $k | .value.sessions | keys_unsorted[]? | {key: ., value: $k}] | from_entries')" '
        ([$g.groups[]?.member_workspace_ids[]?]) as $in
        | ($live | split("\n")) as $l
        | .workspaces[]?
        | select((.id as $i | $in | index($i) | not) and (.title as $t | $l | index($t)) and $rec[.title] != null)
        | [.id, $rec[.title]] | join("\u001f")' <<<"$ws_json")
    while IFS= read -r g; do
        [[ -z "$g" ]] && continue
        ids=$(AWK_G="$g" awk -F '\037' '($2 "") == (ENVIRON["AWK_G"] "") { print $1 }' <<<"$placed")
        name=$(group_display "$g")
        ref=$(jq -r --arg n "$name" 'first(.groups[]? | select(.name == $n) | .id) // empty' <<<"$groups_json")
        changed=1 done_n=0
        if [[ -z "$ref" ]]; then
            # What the caller read may be seconds old, and another hatter may
            # have made the group since: look again right before making one.
            groups_json=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || continue
            ref=$(jq -r --arg n "$name" 'first(.groups[]? | select(.name == $n) | .id) // empty' <<<"$groups_json")
        fi
        if [[ -z "$ref" ]]; then
            info "Creating workspace group '$name' in $hat's window"
            if cmux_group_create "$win" "$name" "$(paste -sd , - <<<"$ids")" 2>/dev/null; then
                groups_json=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || groups_json='{}'
                ref=$(jq -r --arg n "$name" 'first(.groups[]? | select(.name == $n) | .id) // empty' <<<"$groups_json")
                [[ -n "$ref" ]] && done_n=$(wc -l <<<"$ids" | tr -d ' ')
            fi
            [[ -n "$ref" ]] || warn "could not create group '$name' in $hat's window"
        else
            while IFS= read -r s; do
                if cmux_group_add "$ref" "$s"; then done_n=$((done_n + 1))
                else warn "could not put a workspace into group '$name'"; fi
            done <<<"$ids"
        fi
        [[ "$done_n" == 0 ]] || echo "  $hat / $name: put back $done_n loose workspace(s)"
        [[ -n "$ref" ]] && apply_group_style "$g" "$ref"
    done < <(awk -F '\037' '!seen[$2]++ { print $2 }' <<<"$placed")

    # 3. Unassigned in cmux, from a fresh look whenever anything moved.
    if [[ "$changed" == 1 ]]; then
        groups_json=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || return 0
        ws_json=$(cmux_json workspace list --window "$win" 2>/dev/null) || return 0
    fi
    ref=$(jq -r --arg n "$UNASSIGNED" 'first(.groups[]? | select(.name == $n) | .id) // empty' <<<"$groups_json")
    [[ -n "$ref" ]] || return 0
    if group_exists "$key"; then
        cmux_group_to_top "$ref" "$win" "$groups_json"
        return 0
    fi
    cmux_drop_unassigned "$hat" "$win" "$live"
    return 0
}

# cmux_drop_unassigned <hat> <window> <live sessions>: the config has no
# Unassigned for <hat>, so take it out of cmux as well, unless a running
# session is still in it, which is the next sync's to record. Read right
# before, so nothing moved in since is set loose.
cmux_drop_unassigned() {
    local hat="$1" win="$2" live="$3" ref now ws_json busy members
    now=$(cmux_json workspace-group list --window "$win" 2>/dev/null) || return 0
    ref=$(jq -r --arg n "$UNASSIGNED" 'first(.groups[]? | select(.name == $n) | .id) // empty' <<<"$now")
    [[ -n "$ref" ]] || return 0
    ws_json=$(cmux_json workspace list --window "$win" 2>/dev/null) || return 0
    IFS=' ' read -r members busy < <(jq -r --argjson ws "$ws_json" --arg r "$ref" --arg live "$live" '
        ($live | split("\n")) as $l
        | ($ws.workspaces | map({key: .id, value: (.title // "")}) | from_entries) as $t
        | [.groups[]? | select(.id == $r) | .member_workspace_ids[]?] as $m
        | [($m | length), ([$m[] | $t[.] // "" | select(. as $x | $l | index($x))] | length)]
        | map(tostring) | join(" ")' <<<"$now" 2>/dev/null) || return 0
    [[ "$busy" == 0 ]] || return 0
    # A group cmux will not remove - one holding a workspace that is not a
    # session, say - is tried once and then left until its members change,
    # rather than on every autosave tick.
    local marker sig
    marker="${XDG_STATE_HOME:-$HOME/.local/state}/hatter/unassigned-rm.${win//[^A-Za-z0-9_-]/_}"
    sig="$ref:$(jq -r --arg r "$ref" '[.groups[]? | select(.id == $r) | .member_workspace_ids[]?] | join(",")' <<<"$now")"
    [[ "$(cat "$marker" 2>/dev/null)" == "$sig" ]] && return 0
    info "Removing the empty '$UNASSIGNED' group from $hat's window"
    if cmux_group_remove "$ref" "$members"; then
        rm -f "$marker"
    else
        mkdir -p "${marker%/*}" 2>/dev/null && printf '%s\n' "$sig" > "$marker" 2>/dev/null || true
        warn "cmux would not remove the group '$UNASSIGNED' from $hat's window (it holds a workspace"
        warn "that is not a hatter session); leaving it until what is in it changes"
    fi
    return 0
}

# drop_unassigned_now <hat> <window>: a command has just taken the last session
# out of <hat>'s Unassigned, which went from the config with it. Take it out of
# cmux now too, rather than leave the next sync to find it. The caller finds
# the window before the config changes: with the session gone from it, another
# hat's window can look as much like this hat's. Best effort: a failure here
# leaves that to sync and never fails the command.
drop_unassigned_now() {
    local hat="$1" win="$2" live
    [[ -n "$win" ]] || return 0
    ! group_exists "$(unassigned_key "$hat")" || return 0
    cmux_alive || return 0
    live=$(hat_live_sessions "$(hat_ssh "$hat")" 2>/dev/null) || return 0
    ( cmux_drop_unassigned "$hat" "$win" "$live" ) || true
    return 0
}

# Which sessions have run on each server, and on which tmux server instance:
# "<instance>\t<session>" per line, in the state dir, not the config. A
# recorded session that is not running is evidence of a close only if it ran
# on the instance running now. One that ran only on an earlier instance was
# lost to a restart, or is still waiting for the restore.
seen_file() {
    printf '%s/hatter/seen.%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "${1//[^A-Za-z0-9_.@-]/_}"
}
# seen_record <host> <instance> <sessions>: they ran on <instance>. While the
# instance is the same, what ran on it before is kept, so a session sync holds
# back keeps its evidence for a later pass; a new instance starts afresh.
# Entries for sessions the config no longer records, and that are not running,
# have nothing left to decide and go.
seen_record() {
    local host="$1" inst="$2" sessions="$3" f tmp keep
    [[ -n "$inst" ]] || return 0
    f=$(seen_file "$host")
    mkdir -p "${f%/*}" 2>/dev/null || return 0
    keep=$( { cfg '.groups[].sessions // {} | keys_unsorted[]'; printf '%s\n' "$sessions"; } | sort -u)
    tmp="$f.$$"
    { { awk -F '\t' -v i="$inst" '$1 == i { print $2 }' "$f" 2>/dev/null || true
        printf '%s\n' "$sessions"; } \
        | awk 'NF && !s[$0]++' | grep -xF -- "$keep" \
        | awk -v i="$inst" '{ print i "\t" $0 }' > "$tmp" && mv -f "$tmp" "$f"; } \
        2>/dev/null || rm -f "$tmp"
    return 0
}
# seen_ended <host> <instance> <session>: it ran on this very instance, so its
# end was a close, not a restart. With nothing to go on (an old tmux, a first
# pass with no record yet) it proves nothing, and sync falls back to counting.
seen_ended() {
    local f
    [[ -z "$2" ]] && return 0
    f=$(seen_file "$1")
    [[ -e "$f" ]] || return 0
    grep -qxF -- "$2"$'\t'"$3" "$f" 2>/dev/null
}
# seen_now <host> <session>: record a session just made, so that one which
# ends before the next sync is known to have run here. Best effort.
seen_now() {
    local inst
    inst=$(remote_sh "$1" "tmux display-message -p -t $(sq "=$2") '#{pid}.#{start_time}' 2>/dev/null || true" \
               2>/dev/null) || return 0
    [[ "$inst" == . ]] && inst=""
    ( seen_record "$1" "$inst" "$2" ) || true
    return 0
}

cmd_sync() {
    # A dead socket makes every hat look empty; refuse rather than report a
    # no-op as success.
    require_cmux sync
    local try
    for try in 1 2 3; do
        sync_once && return 0
        [[ "$try" == 3 ]] || info "Another hatter changed the config while syncing - reading it again"
    done
    die "the config kept changing while syncing - run 'hatter sync' again"
}

# The patch sync builds holds each window's groups in the order cmux shows
# them, and each group's sessions likewise. This puts the config's groups in
# that order: the synced ones first, as the patch has them, then the rest (a hat
# with no window, a group cmux no longer shows) in the order they already had.
# Readers only ever list one hat's groups at a time, so how hats interleave
# does not matter.
SYNC_ORDER_JQ='
    ($p | keys_unsorted) as $order
    | .groups |= (to_entries as $e
        | [$order[] as $k | $e[] | select(.key == $k)]
          + [$e[] | select(.key as $k | $order | index($k) | not)]
        | from_entries)'

# One pass of sync. Reading cmux and the servers is the slow part, so it runs
# without the config lock, with the servers and cmux asked all at once; the lock
# is taken once, at the end, for a single write. Returns 1, having written
# nothing, if another command wrote the config in the meantime - its change is
# newer than what this pass read.
sync_once() {
    local stamp tmp
    stamp=$(cksum < "$CONFIG")
    # sync only reads cmux, so one look at every window serves the whole run.
    cmux_snapshot
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-sync.XXXXXX")

    # Iterate hats, not windows. A group belongs to exactly one hat and so lives
    # in exactly one window; scanning every window would let a same-named group
    # in some other window overwrite the real one.
    local hats=() wins=() hosts=() hat i n reached=""
    while IFS= read -r hat; do
        [[ -z "$hat" ]] && continue
        hats+=("$hat")
        wins+=("$(find_hat_window "$hat")")
        hosts+=("$(hat_ssh "$hat")")
    done < <(hat_names)
    n=${#hats[@]}

    # Every server at once: its sessions, and every session's windows.
    for ((i = 0; i < n; i++)); do
        [[ -n "${wins[$i]}" && -n "${hosts[$i]}" ]] || continue
        remote_tmux_state "${hosts[$i]}" > "$tmp/ssh.$i" 2>/dev/null &
    done
    wait

    # Then every mirrored session's pane map at once, eight at a time.
    local groups_json ws_json wref title live jobs=0
    for ((i = 0; i < n; i++)); do
        [[ -s "$tmp/ssh.$i" ]] || continue
        live=$(awk -F '\t' '$1 == "S" { print $2 }' "$tmp/ssh.$i")
        groups_json=$(window_groups_json "${wins[$i]}" 2>/dev/null || echo '{"groups":[]}')
        ws_json=$(window_ws_json "${wins[$i]}" 2>/dev/null || echo '{"workspaces":[]}')
        while IFS=$'\x1f' read -r wref title; do
            [[ -z "$wref" || -z "$title" ]] && continue
            grep -qxF "$title" <<<"$live" || continue
            ( cmux_pane_map "${hosts[$i]}" "$title" > "$tmp/map.${wref//[^A-Za-z0-9_-]/_}" || true ) &
            jobs=$((jobs + 1))
            [[ $((jobs % 8)) -ne 0 ]] || wait
        done < <(jq -r --argjson ws "$ws_json" '
            ($ws.workspaces | map({key: .id, value: (.title // "")}) | from_entries) as $t
            | .groups[]?.member_workspace_ids[]? | [., ($t[.] // "")] | map(. // "" | tostring) | join("\u001f")' <<<"$groups_json")
    done
    wait

    # Work out the new config, all in memory, saying what was found.
    local patch='{}' adopt="" w host gname gkey order recorded owner wjson seen ukey
    local lives=() wjsons=() gjsons=() wsjsons=() insts=() inst
    for ((i = 0; i < n; i++)); do
        hat="${hats[$i]}" w="${wins[$i]}" host="${hosts[$i]}"
        lives[$i]="" wjsons[$i]="" gjsons[$i]="" wsjsons[$i]=""
        if [[ -z "$w" ]]; then
            echo "  $hat: no window open, leaving its config untouched"
            continue
        fi
        live=""
        [[ -s "$tmp/ssh.$i" ]] && live=$(awk -F '\t' '$1 == "S" { print $2 }' "$tmp/ssh.$i")
        if [[ -z "$live" ]]; then
            echo "  $hat: $host unreachable or idle, leaving its config untouched"
            continue
        fi
        reached+="$host"$'\n'
        lives[$i]="$live"
        inst=$(awk -F '\t' '$1 == "S" { print $3; exit }' "$tmp/ssh.$i")
        [[ "$inst" == . ]] && inst=""          # a tmux that knows neither
        insts[$i]="$inst"
        seen=""
        # Session -> its windows, in tmux order.
        wjson=$(jq -R -s '
            split("\n") | map(select(startswith("W\t")) | split("\t")
                | {s: .[1], w: ({id: .[2], name: (.[3] // ""), cwd: (.[4] // null)}
                                + (if .[5] == "1" then {pinned: true} else {} end))})
            | reduce .[] as $x ({}; .[$x.s] += [$x.w])' < "$tmp/ssh.$i")

        # A read that failed is unknown, not empty: no group is found there,
        # which changes nothing, nothing is said about where a session is, and
        # settling is told not to touch cmux for this hat ("-"), so it cannot
        # make a second Unassigned.
        local gread=1 wread=1 cmux_read=1
        groups_json=$(window_groups_json "$w" 2>/dev/null) || { groups_json='{"groups":[]}'; gread=0; }
        ws_json=$(window_ws_json "$w" 2>/dev/null) || { ws_json='{"workspaces":[]}'; wread=0; }
        [[ "$gread" == 1 && "$wread" == 1 ]] || cmux_read=0
        if [[ "$cmux_read" == 1 ]]; then
            wjsons[$i]="$wjson" gjsons[$i]="$groups_json" wsjsons[$i]="$ws_json"
        else
            wjsons[$i]="$wjson" gjsons[$i]="-" wsjsons[$i]=""
            warn "$hat: could not read the window's groups from cmux; its layout is left as it is"
        fi

        while IFS= read -r gname; do
            [[ -z "$gname" ]] && continue
            # cmux shows a group by name; the config keys it. Only Unassigned
            # differs: each hat's window has its own.
            gkey=$(group_key_in_hat "$gname" "$hat")

            # A group of the same name owned by a different hat is a name
            # clash, not this hat's group - leave it alone. A group adopted
            # earlier in this pass counts as owned, though not yet written.
            owner=""
            if group_exists "$gkey"; then
                owner=$(group_hat "$gkey")
            else
                owner=$(AWK_G="$gkey" awk -F '\037' '($1 "") == (ENVIRON["AWK_G"] "") { print $2; exit }' <<<"$adopt")
                if [[ -z "$owner" ]]; then
                    # Unassigned is the hat's own group, recorded again (as
                    # managed) rather than taken in: an emptied one goes with
                    # the prune and the settle below, so it is not announced.
                    [[ "$gname" == "$UNASSIGNED" ]] \
                        || info "Adopting group '$gname' under hat '$hat'"
                    adopt+="$gkey$US$hat"$'\n'
                    owner="$hat"
                fi
            fi
            if [[ -n "$owner" && "$owner" != "$hat" ]]; then
                warn "group '$gname' is in $hat's window but config says hat '$owner'; skipping"
                continue
            fi

            local color icon pinned collapsed
            # One jq for all four. The separator is not whitespace, so read keeps
            # an empty colour or icon as an empty field.
            IFS=$'\x1f' read -r color icon pinned collapsed < <(jq -r --arg n "$gname" '
                first(.groups[] | select(.name==$n))
                | [.custom_color // "", .icon_symbol // "",
                   (.is_pinned // false | tostring), (.is_collapsed // false | tostring)]
                | join("\u001f")' <<<"$groups_json") || true

            local fresh='{}' windows
            while IFS= read -r wref; do
                [[ -z "$wref" ]] && continue
                title=$(jq -r --arg r "$wref" '.workspaces[] | select(.id==$r) | .title' <<<"$ws_json")
                [[ -z "$title" || "$title" == "null" ]] && continue
                grep -qxF "$title" <<<"$live" || continue

                windows=$(jq -c --arg s "$title" '.[$s] // []' <<<"$wjson")
                order=$(cmux_tab_order "$w" "$wref" "$host" "$title" \
                            "$tmp/map.${wref//[^A-Za-z0-9_-]/_}" | jq -R . | jq -sc .)
                recorded=$(cfg --arg g "$gkey" --arg s "$title" '.groups[$g].sessions[$s].windows // []')
                # Order as cmux shows it, ties and strays in tmux order. A tab
                # the config has pinned stays pinned; a pinned tab that has
                # been closed stays recorded, at the front, so restore can
                # bring it back.
                windows=$(jq -c --argjson o "${order:-[]}" --argjson rec "$recorded" '
                    ([$rec[] | select(.pinned) | .name]) as $pins
                    | to_entries
                    | sort_by((.value.id as $i | $o | index($i)) // 1e9, .key)
                    | map(.value | del(.id)
                          | if (.name != "" and (.name as $n | $pins | index($n)))
                            then .pinned = true else . end)
                    | . as $live
                    | [$rec[] | select(.pinned and (.name as $n | [$live[].name] | index($n) | not))]
                      + $live' <<<"$windows")
                fresh=$(jq --arg s "$title" --argjson wj "$windows" '.[$s] = {windows: $wj}' <<<"$fresh")
                seen+="$title"$'\n'
                echo "  $hat / $gname / $title  ($(jq 'length' <<<"$windows") tabs)"
            done < <(jq -r --arg n "$gname" '.groups[] | select(.name==$n) | .member_workspace_ids[]?' <<<"$groups_json")

            patch=$(jq -c --arg g "$gkey" --arg c "$color" --arg i "$icon" \
                          --argjson p "${pinned:-false}" --argjson co "${collapsed:-false}" \
                          --argjson s "$fresh" '
                .[$g] = {color: (if $c == "" then null else $c end),
                         icon: (if $i == "" then null else $i end),
                         pinned: $p, collapsed: $co, sessions: $s}' <<<"$patch")
        done < <(jq -r '.groups[]?.name' <<<"$groups_json")

        # The recorded sessions cmux did not show in any of this hat's groups.
        # Not being in cmux is not being gone: closing a mirrored workspace only
        # detaches it, and its session runs on. One still running keeps its
        # entry; only one gone from the server as well is dropped. A group cmux
        # does not show at all is not rewritten, so its entries stay as they were.
        #
        # A server part-way through coming back from a reboot runs only some of
        # its sessions, and dropping the rest would forget them for good. So when
        # none of the hat's recorded sessions is running, or more than half of
        # them would go at once, nothing is dropped this pass.
        # Unassigned is rebuilt like any group this pass rewrites, even when
        # cmux does not show it: a session cmux now shows in another group
        # leaves it, and one no longer running is dropped, as anywhere else.
        ukey=$(unassigned_key "$hat")
        if [[ "$cmux_read" == 1 ]] && group_exists "$ukey" \
           && ! jq -e --arg g "$ukey" 'has($g)' <<<"$patch" >/dev/null; then
            patch=$(jq -c --arg g "$ukey" --argjson cur "$(cfg -c --arg g "$ukey" '.groups[$g]')" '
                .[$g] = {color: $cur.color, icon: $cur.icon, pinned: ($cur.pinned // false),
                         collapsed: ($cur.collapsed // false), sessions: {}}' <<<"$patch")
        fi

        local rg rs rn shown grouped place total=0 running=0 drops=0 hold=0 unseen=""
        shown=$(jq -r '.workspaces[]?.title // empty' <<<"$ws_json")
        grouped=$(jq -r --argjson ws "$ws_json" '
            ($ws.workspaces | map({key: .id, value: (.title // "")}) | from_entries) as $t
            | .groups[]?.member_workspace_ids[]? | $t[.] // empty' <<<"$groups_json")
        [[ "$wread" == 1 ]] || shown="?"
        [[ "$gread" == 1 ]] || grouped="?"
        while IFS=$'\x1f' read -r rg rs; do
            [[ -z "$rs" ]] && continue
            total=$((total + 1))
            grep -qxF -- "$rs" <<<"$live" && running=$((running + 1))
            grep -qxF -- "$rs" <<<"$seen" && continue
            unseen+="$rg"$'\x1f'"$rs"$'\n'
            if ! grep -qxF -- "$rs" <<<"$live" && jq -e --arg g "$rg" 'has($g)' <<<"$patch" >/dev/null \
               && seen_ended "$host" "$inst" "$rs"; then
                drops=$((drops + 1))
            fi
        done < <(cfg --arg l "$hat" '
            .groups | to_entries[] | select(.value.hat == $l)
            | .key as $g | .value.sessions | keys_unsorted[]? | [$g, .] | map(. // "" | tostring) | join("\u001f")')
        if [[ "$drops" -gt 0 ]] && { [[ "$running" == 0 ]] || [[ $((drops * 2)) -gt "$total" ]]; }; then
            hold=1
            echo "  $hat: $drops of its $total recorded sessions are not running - too many to be"
            echo "    closed on purpose (a server still coming back?), so none is dropped this pass."
            echo "    To forget one that is gone for good: hatter rm <session>"
        fi
        while IFS=$'\x1f' read -r rg rs; do
            [[ -z "$rs" ]] && continue
            place=$(session_place "$rs" "$live" "$shown" "$grouped")
            rn=$(group_display "$rg")
            jq -e --arg g "$rg" 'has($g)' <<<"$patch" >/dev/null || {
                [[ "$place" == "not running" ]] || echo "  $hat / $rn / $rs  kept ($place)"
                continue
            }
            if [[ "$place" == "not running" ]] && ! seen_ended "$host" "$inst" "$rs"; then
                place="not running, and never ran on this tmux server: restarted?"
            elif [[ "$place" == "not running" && "$hold" == 0 ]]; then
                echo "  $hat / $rn / $rs  dropped (not running)"
                continue
            fi
            echo "  $hat / $rn / $rs  kept ($place)"
            patch=$(jq -c --arg g "$rg" --arg s "$rs" \
                          --argjson e "$(cfg -c --arg g "$rg" --arg s "$rs" '.groups[$g].sessions[$s]')" \
                          '.[$g].sessions[$s] = $e' <<<"$patch")
        done <<<"$unseen"

    done
    rm -rf "$tmp"
    cmux_snapshot_drop

    # Write it, once. A command that already holds the lock (backup, repair)
    # is the only writer, so there is nothing to wait for or compare.
    local held=0
    if [[ "$HATTER_LOCK_HELD" != 1 ]]; then
        hatter_lock 20 || die "another hatter is writing the config - try again in a moment"
        held=1
        # Usually already set, but sync also runs in a subshell, which does
        # not inherit the trap.
        trap 'hatter_on_exit $?' EXIT
    fi
    if [[ "$(cksum < "$CONFIG")" != "$stamp" ]]; then
        if [[ "$held" == 1 ]]; then hatter_unlock; fi
        return 1
    fi
    backup_config
    while IFS=$'\x1f' read -r gname hat; do
        [[ -n "$gname" ]] && register_group "$gname" "$hat"
    done <<<"$adopt"
    jq_write --argjson p "$patch" '
        reduce ($p | to_entries[]) as $e (.;
            .groups[$e.key].color       = $e.value.color
            | .groups[$e.key].icon      = $e.value.icon
            | .groups[$e.key].pinned    = $e.value.pinned
            | .groups[$e.key].collapsed = $e.value.collapsed
            | .groups[$e.key].sessions  = $e.value.sessions)
        | '"$PRUNE_UNASSIGNED"' | '"$SYNC_ORDER_JQ"
    # What ran where, for the next pass: only once this pass's decisions are
    # written, and under the lock, so a retried or failed pass cannot erase the
    # evidence it judged by, and an older look never overwrites a newer one.
    for ((i = 0; i < n; i++)); do
        [[ -n "${insts[$i]:-}" ]] && seen_record "${hosts[$i]}" "${insts[$i]}" "${lives[$i]}"
    done
    if [[ "$held" == 1 ]]; then hatter_unlock; fi

    # Now that the config holds what this pass found, every running session in
    # no group goes into its hat's Unassigned, and an empty Unassigned goes.
    for ((i = 0; i < n; i++)); do
        [[ -n "${lives[$i]}" ]] || continue
        settle_ungrouped "${hats[$i]}" "${wins[$i]}" "${lives[$i]}" \
            "${wjsons[$i]}" "${gjsons[$i]}" "${wsjsons[$i]}"
    done

    # Once per server, after every hat on it is recorded and the config holds
    # it - and all at once.
    local h
    while IFS= read -r h; do
        [[ -z "$h" ]] && continue
        ( tell_server_sessions "$h" \
            || warn "$h: could not tell the server what to bring back after a reboot" ) &
    done < <(printf '%s' "$reached" | sort -u)
    wait

    info "Config synced: $CONFIG"
}

# What is actually missing for a hat, one line per finding:
#   "<session>\x1fno tmux session"   recorded, but not running on the server
#   "<session>\x1fnot mirrored"      running, but no workspace in the hat's window
#   "\x1fno window"                  the hat has no cmux window at all
# Empty output means there is nothing to rebuild. Anything unreachable is
# reported as unknown rather than guessed at, because "missing" would then mean
# "recreate everything", which is the opposite of what the caller asked for.
hat_missing() {
    local hat="$1" host live win titles group session
    host=$(hat_ssh "$hat")
    [[ -n "$host" ]] || { printf '\037no ssh destination\n'; return 0; }

    if ! ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$host" "$(posix_sh true)" 2>/dev/null; then
        printf '\037unreachable\n'
        return 0
    fi
    live=$(remote_sessions "$host" 2>/dev/null || true)
    local tabs
    tabs=$(remote_sh "$host" "tmux list-windows -a -F '#{session_name}	#{window_name}' 2>/dev/null || true" 2>/dev/null || true)

    win=$(find_hat_window "$hat")
    titles=""
    [[ -n "$win" ]] && titles=$(titles_in_window "$win")
    [[ -z "$win" ]] && printf '\037no window\n'

    while IFS= read -r group; do
        [[ -z "$group" ]] && continue
        while IFS= read -r session; do
            [[ -z "$session" ]] && continue
            if ! grep -qxF "$session" <<<"$live"; then
                printf '%s\037no tmux session\n' "$session"
                continue
            fi
            local pin
            while IFS= read -r pin; do
                [[ -z "$pin" ]] && continue
                grep -qxF "$session"$'\t'"$pin" <<<"$tabs" \
                    || printf '%s\037pinned tab %s closed\n' "$session" "$pin"
            done < <(cfg --arg g "$group" --arg s "$session" \
                        '.groups[$g].sessions[$s].windows[]? | select(.pinned) | .name')
            if [[ -n "$win" ]] && ! grep -qxF "$session" <<<"$titles"; then
                printf '%s\037not mirrored\n' "$session"
            fi
        done < <(cfg --arg g "$group" '.groups[$g].sessions | keys_unsorted[]?')
    done < <(groups_of_hat "$hat")
}

cmd_restore() {
    require_cmux restore
    local hats only_missing=0

    local args=() a
    for a in "$@"; do
        case "$a" in
            --missing|--only-missing) only_missing=1 ;;
            *) args+=("$a") ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}

    if [[ $# -gt 0 ]]; then
        local tok resolved=() l
        for tok in "$@"; do
            if hat_exists "$tok"; then
                resolved+=("$tok")
            elif group_exists "$tok"; then
                resolved+=("$(group_hat "$tok")")
            else
                warn "unknown hat or group: $tok"
            fi
        done
        [[ ${#resolved[@]} -gt 0 ]] || die "nothing to restore"
        hats=$(printf '%s\n' "${resolved[@]}" | sort -u)
    else
        hats=$(hat_names)
    fi

    local hat
    while IFS= read -r hat; do
        [[ -z "$hat" ]] && continue
        local host dir
        host=$(hat_ssh "$hat"); dir=$(hat_dir "$hat")
        [[ -n "$host" ]] || { warn "hat '$hat' has no ssh destination"; continue; }

        local want
        want=$(cfg --arg l "$hat" '
            [ .groups[] | select(.hat == $l) | .sessions | keys_unsorted[]? ] | length')
        if [[ "${want:-0}" -eq 0 ]]; then
            echo "  $hat: nothing recorded, skipping"
            continue
        fi

        # --missing is the safe default from the rack: a hat that is already
        # whole is left completely alone - no window opened, no re-mirror, no
        # restyle. A hat with even one gap gets the full pass below, because
        # bringing a recreated session back always needs the mirror anyway.
        if [[ "$only_missing" == 1 ]]; then
            local gaps
            gaps=$(hat_missing "$hat")
            if [[ -z "$gaps" ]]; then
                echo "  $hat: nothing missing, leaving it alone"
                continue
            fi
            local line what why
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                what="${line%%"$US"*}"; why="${line#*"$US"}"
                echo "  $hat: ${what:-(hat)} - $why"
            done <<<"$gaps"
        fi

        # Probe before opening a window, so an unreachable hat does not leave an
        # empty one behind, and never let one bad hat abort the whole restore.
        if ! ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$host" "$(posix_sh true)" 2>/dev/null; then
            warn "$hat: $host unreachable, skipping"
            continue
        fi

        info "Restoring hat '$hat' ($host)"

        # 1. make sure every recorded session exists on the server
        local group session windows
        while IFS= read -r group; do
            [[ -z "$group" ]] && continue
            while IFS= read -r session; do
                [[ -z "$session" ]] && continue
                windows=$(cfg --arg g "$group" --arg s "$session" '.groups[$g].sessions[$s].windows // []')
                ensure_remote_session "$host" "$session" "$dir" "$windows"
            done < <(cfg --arg g "$group" '.groups[$g].sessions | keys_unsorted[]?')
        done < <(groups_of_hat "$hat")

        # 2. one window, one mirror pass
        local win
        win=$(ensure_hat_window "$hat")
        mirror_hat "$hat" "$win"

        # 3. put the workspaces back in their groups, in their recorded order,
        # restyle. cmux mirrors sessions in tmux's order, so each one is moved
        # to follow the one recorded before it.
        local gref wref prev
        while IFS= read -r group; do
            [[ -z "$group" ]] && continue
            # An empty Unassigned is not created; settling below removes it.
            if group_managed "$group" \
               && [[ "$(cfg --arg g "$group" '.groups[$g].sessions | length')" == 0 ]]; then
                continue
            fi
            gref=$(ensure_cmux_group "$group" "$win")
            prev=""
            while IFS= read -r session; do
                [[ -z "$session" ]] && continue
                wref=$(wait_for_workspace "$session" "$win" 20)
                if [[ -z "$wref" ]]; then
                    warn "no workspace appeared for '$session'"
                    continue
                fi
                if ! cmux_group_add "$gref" "$wref"; then
                    warn "could not put '$session' into group '$(group_display "$group")'"
                    continue
                fi
                if [[ -n "$prev" ]]; then
                    cmux_change reorder-workspace --workspace "$wref" --after "$prev" --window "$win" >/dev/null 2>&1 \
                        || warn "could not put '$session' in its recorded place"
                fi
                prev="$wref"
                echo "  ok  $hat / $(group_display "$group") / $session -> $wref"
            done < <(cfg --arg g "$group" '.groups[$g].sessions | keys_unsorted[]?')
            apply_group_style "$group" "$gref"
        done < <(groups_of_hat "$hat")

        # 4. the mirror brings every session on the server, recorded or not:
        # the ones no group records go into Unassigned rather than run loose.
        local live
        live=$(hat_live_sessions "$host") || live=""
        settle_ungrouped "$hat" "$win" "$live"
        discard_stray_workspace "$win"
    done <<<"$hats"

    info "Restore complete"
}

cmd_provision() {
    local token="${1:-}"
    [[ -n "$token" ]] || die "usage: hatter provision <hat|user@host>"
    local host
    if [[ "$token" == *@* ]]; then
        host="$token"
    elif hat_exists "$token"; then
        host=$(hat_ssh "$token")
    elif group_exists "$token"; then
        host=$(hat_ssh "$(group_hat "$token")")
    else
        die "unknown hat or group: $token"
    fi
    local launch="@@keep"
    if [[ -n "$(cfg --arg h "$host" '.hats[]? | select(.ssh == $h) | .ssh' | head -n 1)" ]]; then
        launch=$(hat_launch_conf "$host") || exit 1
    fi
    provision_host "$host" "$launch"
}

cmd_list() {
    echo "config: $CONFIG"
    echo
    # Live state, so that neither a recorded session cmux has stopped showing
    # nor a running one no group records can hide: every server at once, and
    # one look at cmux, which list only reads.
    local hats=() hat group i n tmp
    while IFS= read -r hat; do
        [[ -n "$hat" ]] && hats+=("$hat")
    done < <(hat_names)
    n=${#hats[@]}
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hatter-list.XXXXXX")
    for ((i = 0; i < n; i++)); do
        ( hat_live_sessions "$(hat_ssh "${hats[$i]}")" > "$tmp/$i" 2>"$tmp/$i.err" \
            || mv "$tmp/$i" "$tmp/$i.failed" ) &
    done
    wait
    local cmux_up=0
    if cmux_alive; then cmux_up=1; cmux_snapshot; fi

    local reached live win shown grouped dg sess desc mark un why
    for ((i = 0; i < n; i++)); do
        hat="${hats[$i]}"
        reached=0 live="" win="" shown="?" grouped="" why=""
        if [[ -f "$tmp/$i" ]]; then
            reached=1; live=$(cat "$tmp/$i")
        else
            why=$(head -n 1 "$tmp/$i.err" 2>/dev/null) || why=""
            why="  (live state unknown: ${why:-server not reached})"
        fi
        if [[ "$cmux_up" == 1 ]]; then
            win=$(find_hat_window "$hat")
            shown="" grouped=""
            if [[ -n "$win" ]]; then
                shown=$(window_titles "$win"); grouped=$(window_titles "$win" grouped)
            fi
        fi
        dg=$(hat_default_group "$hat")
        printf 'window "%s"  ->  %s  [%s]%s%s\n' "$hat" "$(hat_ssh "$hat")" "$(hat_dir "$hat")" \
            "${dg:+  (default group: $dg)}" "$why"
        while IFS= read -r group; do
            [[ -z "$group" ]] && continue
            if group_managed "$group"; then
                printf '  group %s  (hatter'"'"'s own: workspaces in no group)\n' "$(group_display "$group")"
            else
                printf '  group %s\n' "$group"
            fi
            while IFS=$'\x1f' read -r sess desc; do
                [[ -z "$sess" ]] && continue
                mark=""
                if [[ "$reached" == 1 ]]; then
                    mark=$(session_place "$sess" "$live" "$shown" "$grouped")
                    if [[ "$mark" == running ]]; then mark=""; else mark="  - $mark"; fi
                fi
                printf '    %s  (%s)%s\n' "$sess" "$desc" "$mark"
            done < <(cfg --arg g "$group" '.groups[$g].sessions | to_entries[]
                | ([.value.windows[]? | select(.pinned) | .name] | join(", ")) as $p
                | [.key, "\(.value.windows | length) tabs\(if $p == "" then "" else "; pinned: \($p)" end)"]
                | map(. // "" | tostring) | join("\u001f")')
        done < <(groups_of_hat "$hat")
        if [[ "$reached" == 1 ]]; then
            un=$(hat_unrecorded "$hat" "$live")
            if [[ -n "$un" ]]; then
                echo "  running, in no group (not recorded)"
                sed 's/^/    /' <<<"$un"
            fi
        fi
        echo
    done
    rm -rf "$tmp"

    local orphans
    orphans=$(cfg '.groups | to_entries[] | select((.value.hat // "") == "") | .key')
    [[ -n "$orphans" ]] && { echo "groups with no hat:"; sed 's/^/  /' <<<"$orphans"; echo; }

    echo "live cmux windows:"
    local w
    for w in $(window_ids); do
        printf '  %s\n' "$w"
        groups_in_window "$w" | sed 's/^/    /'
    done
    cmux_snapshot_drop
}

# ---------------------------------------------------------------- autosave
#
# Two separate safety nets, on purpose:
#
#   autosave   plain copies of config.json under ~/.config/hatter/autosave.
#              Every hatter run leaves one, and a launchd timer takes one a
#              minute so that renames done inside cmux are caught too. At most
#              one is *kept* per 8-hour window, and at most 8 windows, so the
#              directory holds roughly the last two and a half days and never
#              grows. Snapshots never touch git.
#
#   backup     `hatter backup` - a real git commit, pushed to the dotfiles
#              remote, kept forever. That is the deliberate checkpoint; the
#              timer also takes one when the config has drifted or sat
#              unpushed for a week (backup_auto, `hatter help autosave`).
#
# Autosaves are for "undo the last hour", backups are for "what did this look
# like last month".

AUTOSAVE_DIR="$CONFIG_DIR/autosave"
AUTOSAVE_WINDOW=28800      # 8 hours, in seconds
AUTOSAVE_KEEP=8            # windows retained -> ~64 hours of history
AUTOSAVE_PLIST="$HOME/Library/LaunchAgents/org.hatter.autosave.plist"
AUTOSAVE_LABEL="org.hatter.autosave"
WATCH_PLIST="$HOME/Library/LaunchAgents/org.hatter.watch.plist"
WATCH_LABEL="org.hatter.watch"

# ------------------------------------------------------------------ watcher
#
# The timer looks once a minute. The watcher follows cmux's own event stream
# (`cmux events`), so a dragged tab is healed as soon as it is dropped and a
# layout change is synced a second later. The timer stays: renames and group
# changes send no event, and it covers any time the watcher was down.
#
# What a drag looks like on the stream (cmux 0.64): the tab's surface closes
# in its old workspace with origin "detach", and the same surface id is created
# in the new one with origin "detach_attach". Nothing else sends that origin.

WATCH_QUIET=1        # seconds with no event before acting on what came in
WATCH_MAX_WAIT=5     # but never hold an action longer than this

# One cmux event in, at most one line out:
#   full                    the stream (re)connected; anything may have happened
#   heal<TAB>workspace<TAB>surface   a tab was dropped into that workspace
#                           (drop events carry no window id)
#   closed<TAB>title<TAB>user|lost   a workspace closed; the layout changed too.
#                           Its title is the tmux session it mirrored.
#   sync                    the layout changed
# and "eof" once the stream ends. Heartbeats are asked for and dropped here:
# they keep a stream whose reader has gone from outliving it for long.
#
# A close is "user" or "lost" (#117). The event is the same either way: its
# tabs close with origin "workspace_teardown", then the workspace. What differs
# is what came before. A person closes the workspace they are on, so it was
# selected, or lost the selection to the next one in the same instant. cmux
# tearing a mirror down when its connection drops closes one nobody was on.
# So the jq keeps which workspaces are selected, from workspace.selected and
# its previous_workspace_id, starting from $seed (each window's selection when
# the stream opened). A close by a script, or from the sidebar of a workspace
# not selected, reads as "lost" too: watch_closed brings such a workspace back
# only once in a while, so closing it again keeps it closed.
WATCH_JQ='def at: (.occurred_at // "" | tostring | sub("[.][0-9]+"; "") | (try fromdateiso8601 catch null));
  (foreach (inputs | fromjson? | objects) as $e
    ({sel: ([$seed[] | {(.): true}] | add // {}), at: {}, out: null};
     .out = null
     | if $e.type == "ack" then .out = "full"
       elif $e.type != "event" then .
       elif $e.name == "workspace.selected" then
         ($e.payload.workspace_id? // $e.workspace_id // null) as $w
         | ($e.payload.previous_workspace_id? // null) as $p
         | ($e | at) as $t
         | (if $p != null then .sel[$p] = false | .at[$p] = $t else . end)
         | (if $w != null then .sel[$w] = true | .at[$w] = $t else . end)
       elif $e.name == "surface.created" and $e.payload.origin? == "detach_attach"
         then .out = "heal\t\($e.workspace_id // "")\t\($e.surface_id // $e.payload.surface_id? // "")"
       elif $e.name == "workspace.closed" then
         ($e.workspace_id // $e.payload.workspace_id? // "") as $w
         | ($e | at) as $t
         | (if .sel[$w] == true or (.at[$w] != null and $t != null and ($t - .at[$w]) <= 3)
            then "user" else "lost" end) as $k
         | .sel[$w] = false
         | .out = "closed\t\(($e.payload | objects | .title) // "" | tostring | gsub("[\t\n\r]"; " "))\t\($k)"
       elif (($e.name // "") | tostring | test("^(workspace[.](created|closed|reordered)|surface[.](created|closed))$"))
         then .out = "sync"
       else . end;
     .out | select(. != null))), "eof"'

# Each window's selected workspace, as a JSON array, for WATCH_JQ's $seed.
# Unreadable is none: every close is then taken for cmux's own until a
# selection is seen, and the reattach gap bounds what that can do.
watch_seed() {
    local seed
    seed=$(cmux_json list-windows 2>/dev/null \
        | jq -c '[.[]? | .selected_workspace_id // empty]' 2>/dev/null) || seed=""
    [[ "$seed" == "["* ]] || seed='[]'
    printf '%s' "$seed"
}

watch_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') watch: $*"; }

# HATTER_WATCH_DRY prints what the watcher would do instead of healing or
# syncing; the tests drive the event handling with it. The close check below
# only reads and notifies, so it runs either way.
watch_heal() {
    if [[ -n "${HATTER_WATCH_DRY:-}" ]]; then echo "heal ${1:-all}${2:+ $2}"; return 0; fi
    autosave_heal watch "${1:-}" "${2:-}"
}
watch_sync() {
    if [[ -n "${HATTER_WATCH_DRY:-}" ]]; then echo "sync"; return 0; fi
    autosave_sync watch
}

# Installing hatter replaces the file. A watcher that keeps running would keep
# running the old code, so it stands down and launchd starts the new one.
watch_updated() {
    [[ -n "$WATCH_SELF" ]] || return 1
    [[ "$(lock_mtime "$WATCH_SELF")" != "$WATCH_SELF_MTIME" ]]
}

WATCH_SELF=""
WATCH_SELF_MTIME=""

# A session name as a word the user can paste after `hatter new`.
watch_word() {
    case "$1" in
        *[!A-Za-z0-9_@%+=,./-]*) sq "$1" ;;
        *) printf '%s' "$1" ;;
    esac
}

# A macOS notification, where there is one to post. Never fails the watcher.
watch_notify() {
    command -v osascript >/dev/null 2>&1 || return 0
    osascript -e 'on run argv' \
        -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
        -e 'end run' "$1" "$2" >/dev/null 2>&1 </dev/null || true
    return 0
}

# watch_closed <title TAB user|lost lines>: the workspaces cmux closed while
# their tmux sessions still run. cmux can close a mirrored workspace by itself:
# when the ssh connection under its tmux mirror drops (after the Mac sleeps,
# tmux can drop a control client that fell too far behind), cmux takes the
# session for ended and tears the workspace down (#117). The session runs on,
# detached. So each closed title that is a recorded session, still running on
# its server and shown in no cmux window, is either brought back or reported:
#
#   - a "lost" close (see WATCH_JQ) is reattached, as `hatter new` would, into
#     the group the config has it in. Only once per session in WATCH_REATTACH_GAP
#     seconds: a lost close can also be someone closing it from a script, or
#     from the sidebar without selecting it, and then closing it again keeps
#     it closed.
#   - a "user" close, or a lost one inside that gap, is logged and posted as
#     one notification, saying how to bring it back.
#
# watch_act calls this only once the config lock is free, so a hatter command
# that closes a workspace has finished first: repair has re-opened it, rm and
# rename have changed the record. Unknown is never "still running": a server
# that does not answer, or a cmux whose windows cannot be read, says nothing.
WATCH_REATTACH_GAP=1800
watch_closed() {
    local s kind hat host tree shown pairs="" prev="" ok=0 live="" said="" n=0 cmd="" back="" lives=""
    tree=$(cmux_json tree --all 2>/dev/null) || return 0
    [[ "$(jq -r '.windows | type' <<<"$tree" 2>/dev/null)" == array ]] || return 0
    shown=$(jq -r '.windows[].workspaces[]?.title // empty' <<<"$tree")
    while IFS=$'\t' read -r s kind; do
        [[ -n "$s" ]] || continue
        [[ "$(cfg --arg s "$s" 'any(.groups[]?; .sessions[$s]? != null)')" == true ]] || continue
        if grep -qxF -- "$s" <<<"$shown"; then continue; fi
        hat=$(session_hat "$s")
        [[ -n "$hat" ]] || continue
        host=$(hat_ssh "$hat" 2>/dev/null) || continue
        [[ -n "$host" ]] || continue
        pairs+="$host"$'\t'"$s"$'\t'"${kind:-user}"$'\t'"$hat"$'\n'
    done < <(printf '%s\n' "$1" | awk -F '\t' '
        # One line per title, in first-seen order; a person closing it wins.
        $1 == "" { next }
        !($1 in k) { o[++n] = $1; k[$1] = $2 }
        $2 == "user" { k[$1] = "user" }
        END { for (i = 1; i <= n; i++) print o[i] "\t" k[o[i]] }')
    # One look per server, however many of its workspaces closed at once.
    while IFS=$'\t' read -r host s kind hat; do
        [[ -n "$s" ]] || continue
        if [[ "$host" != "$prev" ]]; then
            prev=$host; ok=1
            live=$(hat_live_sessions "$host" 2>/dev/null) || ok=0
        fi
        [[ "$ok" == 1 ]] || continue
        grep -qxF -- "$s" <<<"$live" || continue
        if [[ "$kind" == lost ]] && ! watch_reattached_lately "$s"; then
            back+="$hat"$'\t'"$s"$'\n'
            lives+=$(printf '%s\n' "$live" | AWK_H="$host" awk '{ print ENVIRON["AWK_H"] "\t" $0 }')$'\n'
            continue
        fi
        cmd="hatter new $(watch_word "$s")"
        watch_log "'$s' closed in cmux while its tmux session still runs; $cmd brings it back"
        said+="${said:+, }$s"; n=$((n + 1))
    done < <(printf '%s' "$pairs" | sort -t $'\t' -s -k1,1)
    # Those that did not come back are reported like any other.
    if [[ -n "$back" ]]; then
        while IFS= read -r s; do
            [[ -n "$s" ]] || continue
            cmd="hatter new $(watch_word "$s")"
            watch_log "'$s' closed in cmux while its tmux session still runs; $cmd brings it back"
            said+="${said:+, }$s"; n=$((n + 1))
        done < <(watch_reattach "$back" "$lives")
    fi
    if [[ "$n" == 1 ]]; then
        watch_notify "hatter" "'$said' closed in cmux, but its tmux session still runs. Bring it back: $cmd"
    elif [[ "$n" -gt 1 ]]; then
        watch_notify "hatter" "$n workspaces closed in cmux while their tmux sessions still run: $said. Bring them back: hatter restore --missing"
    fi
    return 0
}

# watch_reattached_lately <session>: the watcher brought it back less than
# WATCH_REATTACH_GAP seconds ago. The record is "<epoch> TAB <session>" lines.
watch_reattached_lately() {
    local now
    now=$(date +%s)
    AWK_S="$1" AWK_T=$((now - WATCH_REATTACH_GAP)) awk -F '\t' '
        ($2 "") == (ENVIRON["AWK_S"] "") && $1 + 0 > ENVIRON["AWK_T"] + 0 { f = 1 } END { exit !f }' \
        "$AUTOSAVE_DIR/reattached" 2>/dev/null
}

# watch_reattach <hat TAB session lines> <host TAB live-session lines>
# Mirror running sessions cmux tore down back into their hats' windows and
# the groups the config has them in, as `hatter new` does, under the config
# lock so the timer's sync cannot read cmux half-way. Mirroring a host brings
# back every session of it that no workspace shows, including ones a person
# closed: each such mirror that was not there when the lock was taken, and was
# not asked back, is detached again (a close, which for a mirror leaves the
# session running). Focus goes back where it was.
# Prints the sessions that are not back, one per line, for the caller to
# report; what it logs goes to stderr, which the watch log takes as well.
watch_reattach() {
    local list="$1" lives="$2" hat s group rc f err out="" before after id title want="" h
    f="$AUTOSAVE_DIR/reattached"
    mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || true
    if [[ -z "${HATTER_WATCH_DRY:-}" ]]; then
        if ! hatter_lock 20; then
            watch_log "another hatter command is running; not reattaching now" >&2
            printf '%s' "$list" | cut -f 2
            return 0
        fi
        # What cmux shows now, with the lock held: nothing a person opens
        # from here on can be taken for something the mirror brought back.
        before=$(cmux_json tree --all 2>/dev/null || true)
        [[ -n "$before" ]] || before='{}'
    fi
    while IFS=$'\t' read -r hat s; do
        [[ -n "$s" ]] || continue
        # The gap is what keeps a close by hand from being undone twice. With
        # no record of this reattach there is no gap, so no reattach either.
        if ! { { tail -n 199 "$f" 2>/dev/null; printf '%s\t%s\n' "$(date +%s)" "$s"; } > "$f.tmp" \
                && mv "$f.tmp" "$f"; } 2>/dev/null; then
            watch_log "cannot record reattaching '$s' in $AUTOSAVE_DIR; not reattaching it" >&2
            out+="$s"$'\n'; continue
        fi
        group=$(session_group "$s" "$hat" 2>/dev/null) || group=""
        want+="$s"$'\n'
        if [[ -n "${HATTER_WATCH_DRY:-}" ]]; then
            echo "reattach $s${group:+ into $group}" >&2
            [[ "${HATTER_WATCH_REATTACH_RC:-0}" == 0 ]] || out+="$s"$'\n'
            continue
        fi
        rc=0
        err=$( ( cmd_new "$s" --hat "$hat" ${group:+--group "$group"} ) 2>&1 >/dev/null </dev/null ) || rc=$?
        if [[ "$rc" == 0 ]]; then
            watch_log "'$s' was closed by cmux, not by anyone, while its tmux session still runs; reattached it. To keep it closed, close it again" >&2
        else
            err=$(printf '%s\n' "$err" | grep -m 1 '^error:' | cut -c 1-160 || true)
            watch_log "'$s' was closed by cmux while its tmux session still runs, and reattaching it failed${err:+: ${err#error: }}" >&2
            out+="$s"$'\n'
        fi
    done <<<"$list"
    if [[ -z "${HATTER_WATCH_DRY:-}" ]]; then
        # What the mirror brought back besides: new workspaces that cmux says
        # mirror a live session of these hosts, and that nobody asked back. A
        # local workspace of the same name is not one.
        after=$(cmux_json tree --all 2>/dev/null || true)
        [[ -n "$after" ]] || after='{}'
        while IFS=$'\t' read -r id title; do
            [[ -n "$id" ]] || continue
            grep -qxF -- "$title" <<<"$want" && continue
            while IFS= read -r h; do
                [[ -n "$h" ]] || continue
                cmux_pane_map "$h" "$title" </dev/null 2>/dev/null | jq -e '.mirrored == true' >/dev/null 2>&1 || continue
                cmux_change close-workspace --force --workspace "$id" >/dev/null 2>&1 \
                    && watch_log "detached '$title' again: reattaching its host brought it back too" >&2
                break
            done < <(AWK_T="$title" awk -F '\t' '($2 "") == (ENVIRON["AWK_T"] "") { print $1 }' <<<"$lives" | awk '!seen[$0]++')
        done < <(jq -r --argjson b "$before" '
            [$b.windows[]?.workspaces[]?.id] as $had
            | .windows[]?.workspaces[]? | select(.id as $x | $had | index([$x]) | not)
            | [.id, (.title // "")] | @tsv' <<<"$after" 2>/dev/null || true)
        hatter_unlock
        focus_restore
    fi
    printf '%s' "$out"
    return 0
}

# Act on what watch_stream collected (its heals, heal_all, closes and sync),
# and clear what was done. Heal first, so the sync records where the tabs were
# dropped. The closes are checked under the same wait as the sync, and before
# it.
#
# A hatter command holding the config lock is usually changing cmux, and a
# sync that reads cmux mid-change can write that half-way layout back after
# the command ends. So the sync waits, and runs at the first quiet second
# after the lock goes. A lock old enough to be stale does not hold it up.
watch_act() {
    local w sf mtime
    if [[ "$heal_all" == 1 ]]; then
        watch_heal
    elif [[ -n "$heals" ]]; then
        while IFS=$'\t' read -r w sf; do
            [[ -z "$w" ]] || watch_heal "$w" "$sf"
        done < <(printf '%s' "$heals" | sort -u)
    fi
    heals=""; heal_all=0
    [[ "$sync" == 1 ]] || return 0
    if [[ -d "$LOCK_DIR" ]]; then
        mtime=$(lock_mtime "$LOCK_DIR")
        [[ "$mtime" -gt 0 && $(( $(date +%s) - mtime )) -gt "$LOCK_STALE_SECONDS" ]] || return 0
    fi
    [[ -z "$closes" ]] || watch_closed "$closes"
    closes=""
    watch_sync
    sync=0
    return 0
}

# One connection to the stream. Returns 0 when the stream ended, 3 when hatter
# was updated underneath it.
watch_stream() {
    local dir fifo line kind w sf heals="" heal_all=0 closes="" sync=0 since=0 now fails=0 last=0 rc=0
    dir=$(mktemp -d "${TMPDIR:-/tmp}/hatter-watch.XXXXXX") || return 0
    WATCH_DIR=$dir
    fifo="$dir/events"
    mkfifo "$fifo" || { watch_cleanup; return 0; }
    cmux events --category workspace --category surface \
            --cursor-file "$AUTOSAVE_DIR/watch.seq" 2>"$dir/err" </dev/null \
        | jq -nR --unbuffered -r --argjson seed "$(watch_seed)" "$WATCH_JQ" > "$fifo" &
    exec 3<"$fifo"
    while :; do
        if IFS= read -r -t "$WATCH_QUIET" line <&3; then
            fails=0
            case "$line" in
                full) heal_all=1; sync=1 ;;
                heal$'\t'*)
                    IFS=$'\t' read -r kind w sf <<<"$line"
                    if [[ -n "$w" && -n "$sf" ]]; then heals+="$w"$'\t'"$sf"$'\n'; else heal_all=1; fi
                    sync=1 ;;
                closed$'\t'*)
                    closes+="${line#closed?}"$'\n'
                    sync=1 ;;
                sync) sync=1 ;;
                eof) break ;;
            esac
            now=$(date +%s)
            [[ "$since" != 0 ]] || since=$now
            # A steady trickle of events must not hold an action forever.
            [[ $((now - since)) -lt $WATCH_MAX_WAIT ]] && continue
        else
            # bash 3.2 answers a timeout and the end of the stream alike.
            # Timeouts take a second each, so several failures inside one
            # second mean the stream is gone even without its "eof".
            now=$(date +%s)
            if [[ "$now" == "$last" ]]; then fails=$((fails + 1)); else fails=1; fi
            last=$now
            [[ "$fails" -lt 3 ]] || break
        fi
        # A quiet moment: act on what came in. The fifo stays out of the
        # commands it runs (an ssh master left running would hold it open).
        watch_act 3<&-
        since=0
        if watch_updated; then rc=3; break; fi
    done
    # What came in just before the stream ended is still owed.
    [[ "$rc" != 0 ]] || watch_act 3<&-
    WATCH_STREAM_ERR=$(grep -m 1 '[^[:space:]]' "$dir/err" 2>/dev/null || true)
    watch_cleanup
    return "$rc"
}
WATCH_STREAM_ERR=""
WATCH_DIR=""

# Ends the stream and removes its fifo. Also the TERM/INT trap, so a watcher
# that is killed does not leave cmux events and jq running behind it: they are
# its direct children, and nothing else it starts is (the heal and the sync
# run in subshells).
watch_cleanup() {
    exec 3<&- 2>/dev/null || true
    pkill -P $$ 2>/dev/null || true
    if [[ -n "$WATCH_DIR" ]]; then
        rm -f "$WATCH_DIR/events" "$WATCH_DIR/err"
        rmdir "$WATCH_DIR" 2>/dev/null || true
    fi
    WATCH_DIR=""
    return 0
}

# What `hatter autosave watch` runs, and what launchd keeps running. Never
# returns on its own except to pick up a new hatter, or once the stream ends
# under HATTER_WATCH_ONCE (the tests).
watch_run() {
    local backoff=5 said="" said_stream="" msg rc started
    if ! have_cmux; then
        # launchd would restart it at once; once a minute is plenty.
        watch_log "the cmux CLI is not on PATH; the watcher needs it"
        [[ -n "${HATTER_WATCH_ONCE:-}" ]] || sleep 60
        return 0
    fi
    mkdir -p "$AUTOSAVE_DIR"
    trap 'watch_cleanup; exit 143' TERM
    trap 'watch_cleanup; exit 130' INT
    WATCH_SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
    WATCH_SELF_MTIME=$(lock_mtime "$WATCH_SELF")
    watch_log "following cmux events"
    while :; do
        CMUX_ALIVE=""
        if ! cmux_alive; then
            # Said once per reason, not once per retry.
            msg="$(cmux_refusal_summary); retrying"
            [[ "$msg" == "$said" ]] || watch_log "$msg"
            said=$msg
            [[ -z "${HATTER_WATCH_ONCE:-}" ]] || return 0
            sleep "$backoff"
            backoff=$((backoff * 2)); [[ "$backoff" -le 60 ]] || backoff=60
            if watch_updated; then watch_log "hatter was updated; restarting"; return 0; fi
            continue
        fi
        [[ -z "$said" ]] || watch_log "cmux is answering again"
        said=""
        started=$(date +%s)
        rc=0; watch_stream || rc=$?
        if [[ "$rc" == 3 ]]; then watch_log "hatter was updated; restarting"; return 0; fi
        [[ -z "${HATTER_WATCH_ONCE:-}" ]] || return 0
        if [[ $(( $(date +%s) - started )) -ge 30 ]]; then
            # It ran a while, so this is a fresh failure: say it, retry soon.
            backoff=5; said_stream=""
        fi
        # A stream that keeps failing at once (a cmux without events, a
        # refusal only the stream gets) backs off and is said once.
        msg="the event stream ended${WATCH_STREAM_ERR:+: $WATCH_STREAM_ERR}"
        [[ "$msg" == "$said_stream" ]] || watch_log "$msg"
        said_stream=$msg
        sleep "$backoff"
        backoff=$((backoff * 2)); [[ "$backoff" -le 60 ]] || backoff=60
        if watch_updated; then watch_log "hatter was updated; restarting"; return 0; fi
    done
}

# BSD date takes -r for an epoch, GNU date takes -d @.
autosave_stamp() {
    date -u -r "$1" +%Y%m%dT%H%M%SZ 2>/dev/null || date -u -d "@$1" +%Y%m%dT%H%M%SZ
}

autosave_files() { ls -1 "$AUTOSAVE_DIR"/config-*.json 2>/dev/null | sort; }
autosave_latest() { printf '%s/latest.json' "$AUTOSAVE_DIR"; }

autosave_prune() {
    local count drop old
    count=$(autosave_files | wc -l | tr -d ' ')
    [[ "$count" -gt "$AUTOSAVE_KEEP" ]] || return 0
    drop=$((count - AUTOSAVE_KEEP))
    # macOS head takes no negative count, so the cut is worked out from the total.
    while IFS= read -r old; do
        [[ -n "$old" ]] && rm -f "$old"
    done < <(autosave_files | sed -n "1,${drop}p")
}

# latest.json always mirrors the config. config-<window>.json freezes what the
# config looked like when that 8-hour window opened, and is never rewritten -
# which is the whole point: eight checkpoints have to be eight *different*
# moments, not one slot overwritten all window long.
autosave_snapshot() {
    [[ -f "$CONFIG" ]] || return 0
    mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || return 0

    local latest; latest=$(autosave_latest)
    cmp -s "$CONFIG" "$latest" 2>/dev/null && return 0

    local win f made=""
    win=$(( $(date +%s) / AUTOSAVE_WINDOW * AUTOSAVE_WINDOW ))
    f="$AUTOSAVE_DIR/config-$(autosave_stamp "$win").json"
    if [[ ! -f "$f" ]]; then
        # Carry the pre-change state into the checkpoint; on a first ever run
        # there is nothing older, so the current config stands in.
        if [[ -s "$latest" ]]; then cp "$latest" "$f.tmp"; else cp "$CONFIG" "$f.tmp"; fi
        mv "$f.tmp" "$f"
        made="$f"
        autosave_prune
    fi
    cp "$CONFIG" "$latest.tmp" && mv "$latest.tmp" "$latest"
    printf '%s\n' "${made:-$latest}"
}

# The PATH a launchd job of hatter's runs with.
launchd_path() {
    local extra d
    # launchd starts from a bare PATH, and cmux lives inside its .app bundle
    # rather than anywhere standard - so the directories are taken from where
    # the tools actually are on this machine, not guessed.
    extra=""
    for d in "$(command -v cmux || true)" "$(command -v jq || true)"; do
        # dirname of an empty string is "." - a tool that is not installed must
        # contribute nothing rather than putting the working directory on the
        # PATH of a job that runs every minute.
        [[ -n "$d" ]] || continue
        d=$(dirname "$d")
        case ":$extra:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" in
            *":$d:"*) ;;
            *) extra="$extra$d:" ;;
        esac
    done
    printf '%s' "$extra$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

autosave_install() {
    mkdir -p "$(dirname "$AUTOSAVE_PLIST")" "$AUTOSAVE_DIR"
    local self path
    self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
    path=$(launchd_path)
    # launchd starts with a bare environment, so PATH has to carry jq, cmux and
    # ssh explicitly. SSH_AUTH_SOCK is inherited from the user's launchd
    # session, which is where the agent socket already lives.
    cat > "$AUTOSAVE_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AUTOSAVE_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>autosave</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$path</string>
    <key>HOME</key><string>$HOME</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$AUTOSAVE_DIR/autosave.log</string>
  <key>StandardErrorPath</key><string>$AUTOSAVE_DIR/autosave.log</string>
</dict>
</plist>
PLIST
    launchctl bootout "gui/$(id -u)/$AUTOSAVE_LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$AUTOSAVE_PLIST"
    info "Autosave timer installed: every 60s, $AUTOSAVE_PLIST"
    info "Log: $AUTOSAVE_DIR/autosave.log"

    # The watcher: always running, restarted by launchd whenever it exits
    # (cmux quit, or hatter was reinstalled and it stood down to pick that up).
    cat > "$WATCH_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$WATCH_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>autosave</string>
    <string>watch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$path</string>
    <key>HOME</key><string>$HOME</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$AUTOSAVE_DIR/watch.log</string>
  <key>StandardErrorPath</key><string>$AUTOSAVE_DIR/watch.log</string>
</dict>
</plist>
PLIST
    launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$WATCH_PLIST"
    info "Watcher installed: follows cmux events, $WATCH_PLIST"
    info "Log: $AUTOSAVE_DIR/watch.log"
}

autosave_uninstall() {
    launchctl bootout "gui/$(id -u)/$AUTOSAVE_LABEL" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null || true
    rm -f "$AUTOSAVE_PLIST" "$WATCH_PLIST"
    info "Autosave timer and watcher removed (existing snapshots kept)"
}

# autosave_heal <who> [window surface] - the drag healer, its lines logged.
# A subshell, for the same reason as the sync below.
autosave_heal() {
    local who="$1"
    CMUX_ALIVE=""
    ( heal_dragged_tabs "" once "${2:-}" "${3:-}" ) 2>&1 | while IFS= read -r line; do
        echo "$(date '+%Y-%m-%d %H:%M:%S') $who: $line"
    done || true
    # Closing a healed tab can move focus. Put it back now rather than after
    # the sync: the user may have gone somewhere else by then.
    focus_restore
    return 0
}

# autosave_sync <who> [note] - pick up anything changed inside cmux. A subshell:
# cmd_sync dies on a dead socket, and the caller has to carry on. Its error
# goes to the log once, when it first appears or changes, rather than every
# time. The timer and the watcher share the record, so neither repeats what
# the other already said.
autosave_sync() {
    local who="$1" note="${2:-}" err state="$AUTOSAVE_DIR/sync-state"
    CMUX_ALIVE=""
    if err=$( ( cmd_sync ) 2>&1 >/dev/null ); then
        if [[ "$(sed -n 1p "$state" 2>/dev/null)" != ok ]]; then
            [[ -s "$state" ]] && echo "$(date '+%Y-%m-%d %H:%M:%S') $who: sync ok again"
        fi
        printf 'ok\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" > "$state" 2>/dev/null || true
    else
        err=$(printf '%s\n' "$err" | sed -n 's/^error: //p; s/^  !! //p' | head -n 1)
        [[ -n "$err" ]] || err="sync exited non-zero with no message"
        if [[ "$(sed -n 3p "$state" 2>/dev/null)" != "$err" ]]; then
            warn "$who: sync failed${note:+, $note}: $err"
        fi
        printf 'failed\n%s\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$err" > "$state" 2>/dev/null || true
    fi
    # Settling a window into its groups can move focus as well: making or
    # moving a group is not a change cmux_change knows to be safe.
    focus_restore
    return 0
}

cmd_autosave() {
    local sub="${1:-run}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
        run|"")
            # What the timer runs: pick up anything renamed inside cmux, then
            # snapshot. Sync failures must not stop the snapshot.
            # sync takes the config lock itself, only for its final write; the
            # lock is held below just for the snapshot.
            mkdir -p "$AUTOSAVE_DIR" 2>/dev/null || true
            # Tabs dragged between workspaces first, so the sync records where
            # they were dropped.
            autosave_heal autosave
            autosave_sync autosave "snapshotting anyway"
            hatter_lock 0 || return 0          # a command is mid-write; try next minute
            local f
            f=$(autosave_snapshot) || true
            [[ -n "$f" ]] && echo "$(date '+%Y-%m-%d %H:%M:%S') autosave -> $(basename "$f")"
            # Still under the lock, so nothing writes the config mid-commit.
            backup_auto || true
            return 0 ;;
        now|snapshot)
            local f; f=$(autosave_snapshot) || true
            if [[ -n "$f" ]]; then info "Snapshot: $f"; else info "No change since the last snapshot"; fi ;;
        list|ls)
            local i=0 f age latest
            echo "Checkpoints - the config as each 8h window opened (max $AUTOSAVE_KEEP):"
            while IFS= read -r f; do
                [[ -z "$f" ]] && continue
                i=$((i+1))
                age=$(basename "$f" | sed 's/^config-//; s/\.json$//')
                printf '  %d  %s  %s bytes%s\n' "$i" "$age" \
                    "$(wc -c < "$f" | tr -d ' ')" \
                    "$(cmp -s "$CONFIG" "$f" && echo '   = config as it stands' || true)"
            done < <(autosave_files)
            [[ $i -eq 0 ]] && echo "  (none yet)"
            latest=$(autosave_latest)
            echo
            if [[ -f "$latest" ]]; then
                printf '  latest  %s  %s bytes%s\n' \
                    "$(date -r "$latest" '+%Y-%m-%d %H:%M:%S')" \
                    "$(wc -c < "$latest" | tr -d ' ')" \
                    "$(cmp -s "$CONFIG" "$latest" && echo '   = config as it stands' || true)"
                echo "  (the rolling save - rewritten whenever the config changes)"
            fi
            echo
            echo "Roll back with: hatter autosave restore <n|latest>"
            echo "Permanent, unlimited history lives in git: hatter backup [message]" ;;
        restore)
            local n="${1:-}"
            [[ -n "$n" ]] || die "usage: hatter autosave restore <n|latest>   (see: hatter autosave list)"
            local f
            if [[ "$n" == "latest" ]]; then
                f=$(autosave_latest)
            else
                [[ "$n" =~ ^[0-9]+$ ]] || die "restore takes a number or 'latest' - see: hatter autosave list"
                f=$(autosave_files | sed -n "${n}p")
            fi
            [[ -n "$f" && -f "$f" ]] || die "no autosave '$n' - see: hatter autosave list"
            jq -e . < "$f" >/dev/null 2>&1 || die "autosave #$n is not valid JSON: $f"
            # The config being replaced is itself worth keeping.
            autosave_snapshot >/dev/null || true
            backup_config
            cp "$f" "$CONFIG"
            info "Config rolled back to $(basename "$f")  (previous saved as $CONFIG.bak)"
            info "Apply it to the client with: hatter restore" ;;
        watch)     watch_run ;;
        install)   autosave_install ;;
        uninstall) autosave_uninstall ;;
        status)
            if launchctl print "gui/$(id -u)/$AUTOSAVE_LABEL" >/dev/null 2>&1; then
                info "Timer: loaded, every 60s"
            else
                info "Timer: not installed  (install with: hatter autosave install)"
            fi
            local wpid
            wpid=$(launchctl print "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null | awk '$1 == "pid" { print $3; exit }')
            if [[ -n "$wpid" ]]; then
                info "Watcher: running (pid $wpid), follows cmux events"
            elif launchctl print "gui/$(id -u)/$WATCH_LABEL" >/dev/null 2>&1; then
                info "Watcher: loaded but not running  (log: $AUTOSAVE_DIR/watch.log)"
            else
                info "Watcher: not installed  (install with: hatter autosave install)"
            fi
            local st="$AUTOSAVE_DIR/sync-state"
            if [[ -s "$st" ]]; then
                printf '  last sync: %s at %s\n' "$(sed -n 1p "$st")" "$(sed -n 2p "$st")"
                [[ -n "$(sed -n 3p "$st")" ]] && printf '      error: %s\n' "$(sed -n 3p "$st")"
            else
                printf '  last sync: none recorded yet\n'
            fi
            local bst="$AUTOSAVE_DIR/backup-state"
            if [[ "$(cfg '.prefs.auto_backup // "on"')" == off ]]; then
                printf '  auto backup: off  (prefs.auto_backup)\n'
            elif [[ -s "$bst" ]]; then
                printf '  auto backup: %s at %s, %s\n' "$(sed -n 1p "$bst")" "$(sed -n 3p "$bst")" "$(sed -n 4p "$bst")"
            else
                printf '  auto backup: none yet (pushes past %s%% drift, or a week)\n' "$AUTO_BACKUP_PCT"
            fi
            printf '  snapshots: %s of %s\n' "$(autosave_files | wc -l | tr -d ' ')" "$AUTOSAVE_KEEP"
            printf '  directory: %s\n' "$AUTOSAVE_DIR" ;;
        *) die "unknown autosave subcommand: $sub (run|watch|now|list|restore|install|uninstall|status)" ;;
    esac
}

# -------------------------------------------------------------- credentials
#
# A credential is one Claude login. They live on this Mac only - in the macOS
# Keychain, managed by cswap - and are pushed to a hat over ssh when that hat
# needs to run Claude Code. Nothing here ever asks a shell server to log in.
#
# One credential per hat is the recommended arrangement. Sharing one account
# across several machines is allowed by Claude Code, but each machine refreshes
# the OAuth token independently and a refresh may rotate the refresh token, so
# a shared account can be logged out from under whoever refreshed last. Pushing
# again fixes it, but assigning a different account to each hat avoids it.

CSWAP_BIN="${HATTER_CSWAP:-cswap}"

# The letter column in `hatter creds` and in edit mode. 'q' is left out because
# it quits the interactive browser.
CRED_LETTERS='abcdefghijklmnoprstuvwxyz'

have_cswap() { command -v "$CSWAP_BIN" >/dev/null 2>&1; }

need_cswap() {
    have_cswap || die "cswap is not installed - credentials come from it.
  Install with: uv tool install claude-swap"
}

# One TSV row per credential:
#   letter  slot  email  label  5h-used%  7d-used%  open|limited  active|''
# One TSV row per credential. pct from cswap is percent *used*, so everything
# downstream works in remaining = 100 - pct. resetsAt carries fractional seconds
# and a +00:00 offset, neither of which fromdateiso8601 accepts.
#   letter  slot  email  label  rem5  rem7  reset5s  reset7s  active
creds_rows() {
    have_cswap || return 0
    "$CSWAP_BIN" list --json 2>/dev/null | jq -r --arg L "$CRED_LETTERS" '
        def eta: if . == null then -1
                 else (sub("\\.[0-9]+"; "") | sub("\\+00:00"; "Z")
                       | fromdateiso8601) - (now | floor) end;
        [.accounts[]?] | to_entries[]
        | .key as $i | .value as $a
        | (100 - (($a.usage.fiveHour.pct // 0) | floor)) as $r5
        | (100 - (($a.usage.sevenDay.pct  // 0) | floor)) as $r7
        | [ $L[$i:$i+1], ($a.number | tostring), $a.email,
            ($a.alias // $a.organizationName // ""),
            ($r5 | tostring), ($r7 | tostring),
            (($a.usage.fiveHour.resetsAt | eta) | floor | tostring),
            (($a.usage.sevenDay.resetsAt  | eta) | floor | tostring),
            (if $a.active then "active" else "" end) ]
        | map(. // "" | tostring) | join("\u001f")' 2>/dev/null || true
}

# Neither Anthropic nor OpenAI publishes a colour convention for these windows,
# so this is hatter's own and it is the one already used by the dot: green above
# half a window, amber below it, red once it is spent. Dot and bar agreeing
# matters more than matching some other tool.
creds_colour() {
    if   [[ "$1" -le 0 ]];  then printf '%s' "$C_RD"
    elif [[ "$1" -lt 50 ]]; then printf '%s' "$C_YL"
    else                         printf '%s' "$C_GR"
    fi
}

# Everything before the tail is fixed width: 8 columns of marker, label and
# icon, 28 of email, a space, and 41 of gauges.
CREDS_TAIL_COL=78

# What follows the gauges, cut to fit. A wrapped row would push every row under
# it out of alignment, which is worse than losing the end of a hat list. The
# "active" marker is reserved first when it fits at all, because which login
# this Mac is using matters more than the tail of the list.
creds_tail() {
    local avail="$1" holders="$2" active="$3" act="" hold=""
    [[ -n "$active" ]] && act="  <- active on this Mac"
    if [[ ${#act} -gt $avail ]]; then act=""; else avail=$((avail - ${#act})); fi
    if [[ -n "$holders" && $avail -gt 4 ]]; then
        hold="  -> $holders"
        [[ ${#hold} -gt $avail ]] && hold="${hold:0:$((avail-1))}…"
    fi
    printf '%s%s' \
        "${hold:+${C_DIM}${hold}${C_R}}" \
        "${act:+${C_CY}${act}${C_R}}"
}

# A short bar of remaining capacity, filled in that colour.
creds_bar() {
    local pct="$1" w="${2:-6}" filled i out=""
    filled=$(( (pct * w + 50) / 100 ))
    [[ $filled -gt $w ]] && filled=$w
    [[ $filled -lt 0 ]] && filled=0
    for (( i = 0; i < w; i++ )); do
        # braces required: bash would otherwise read the block character as
        # part of the variable name
        if [[ $i -lt $filled ]]; then out="${out}█"; else out="${out}░"; fi
    done
    printf '%s%s%s' "$(creds_colour "$pct")" "$out" "$C_R"
}

# Time until a window resets, at one significant unit: minutes under an hour,
# hours under a day, days beyond that.
creds_eta() {
    local sec="$1"
    [[ -z "$sec" || "$sec" -lt 0 ]] 2>/dev/null && { printf '   -'; return 0; }
    if   [[ "$sec" -lt 60 ]];    then printf 'now'
    elif [[ "$sec" -lt 3600 ]];  then printf '%dm' $(( (sec + 30) / 60 ))
    elif [[ "$sec" -lt 86400 ]]; then printf '%dh' $(( (sec + 1800) / 3600 ))
    else                              printf '%dd' $(( (sec + 43200) / 86400 ))
    fi
}

# Red when a window is spent, amber under half a 5-hour session, green above it.
creds_dot() {
    local r5="$1" r7="$2" worst="$1"
    [[ "$r7" -lt "$worst" ]] && worst="$r7"
    printf '%s●%s' "$(creds_colour "$worst")" "$C_R"
}

# 5h and 7d remaining, as bar + percent + time to reset.
creds_gauges() {
    local r5="$1" r7="$2" e5="$3" e7="$4"
    printf '5h %s %3s%% %4s   7d %s %3s%% %4s' \
        "$(creds_bar "$r5")" "$r5" "$(creds_eta "$e5")" \
        "$(creds_bar "$r7")" "$r7" "$(creds_eta "$e7")"
}

# Accept a letter, a cswap slot number, or any unique substring of an email.
creds_resolve() {
    local sel="$1" letter slot email rest hit="" n=0
    while IFS=$'\x1f' read -r letter slot email rest; do
        [[ -z "$email" ]] && continue
        if [[ "$sel" == "$letter" || "$sel" == "$slot" || "$sel" == "$email" ]]; then
            printf '%s' "$email"; return 0
        fi
        case "$email" in *"$sel"*) hit="$email"; n=$((n+1)) ;; esac
    done < <(creds_rows)
    [[ $n -eq 1 ]] && { printf '%s' "$hit"; return 0; }
    [[ $n -gt 1 ]] && { warn "'$sel' matches $n credentials - be more specific"; return 1; }
    return 1
}

hat_credential() { cfg --arg l "$1" '.hats[$l].credential // empty'; }

set_hat_credential() {
    jq_write --arg l "$1" --arg e "$2" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.hats[$l].credential = $e | .hats[$l].credential_pushed_at = $t'
}

# Which hats hold this credential, per the config, comma separated.
creds_hats_holding() {
    cfg --arg e "$1" '[.hats | to_entries[] | select(.value.credential == $e) | .key] | join(", ")'
}

creds_push_to() {
    local email="$1" hat="$2" host out
    hat_exists "$hat" || { warn "unknown hat: $hat"; return 1; }
    host=$(hat_ssh "$hat")
    info "Pushing $email -> $hat ($host)"
    # The export carries a live refresh token, so it goes straight down the ssh
    # pipe: it is never written to disk on either side.
    if out=$("$CSWAP_BIN" export - --account "$email" \
             | ssh "${SSH_OPTS[@]}" -o ConnectTimeout=15 "$host" \
                   "$(posix_sh 'python3 "$HOME/.local/bin/hat-creds" install')" 2>&1); then
        echo "    ${out##*$'\n'}"
        set_hat_credential "$hat" "$email"
        return 0
    fi
    warn "push to $hat failed: ${out:-no output}"
    case "$out" in
        *"No such file"*|*"can't open file"*)
            warn "run: hatter provision $hat   (installs hat-creds on the server)" ;;
    esac
    return 1
}

creds_probe_hat() {
    ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$(hat_ssh "$1")" \
        "$(posix_sh 'python3 "$HOME/.local/bin/hat-creds" status')" 2>/dev/null || true
}

cmd_creds() {
    local sub="${1:-list}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
        list|ls|"")
            need_cswap
            colour_setup
            local letter slot email label r5 r7 e5 e7 active holders
            echo "Credentials (on this Mac, in the Keychain via cswap):"
            echo "  bars are capacity left, then time to the window reset"
            while IFS=$'\x1f' read -r letter slot email label r5 r7 e5 e7 active; do
                [[ -z "$email" ]] && continue
                holders=$(creds_hats_holding "$email")
                printf '  %s %s %-28s %s%s%s\n' \
                    "$letter" "$(creds_dot "$r5" "$r7")" "$email" \
                    "$(creds_gauges "$r5" "$r7" "$e5" "$e7")" \
                    "${active:+  ${C_CY}<- active here${C_R}}" \
                    "${holders:+  ${C_DIM}-> $holders${C_R}}"
            done < <(creds_rows)
            echo
            echo "Hats and the credential each one holds:"
            local hat cred
            while IFS= read -r hat; do
                [[ -z "$hat" ]] && continue
                cred=$(hat_credential "$hat")
                printf '  %-11s %-26s %s\n' "$hat" "$(hat_ssh "$hat")" \
                    "${cred:-(none pushed)}"
            done < <(hat_names)
            echo
            echo "Push one with: hatter creds push <letter> <hat>"
            ;;
        push)
            need_cswap
            local sel="${1:-}"; shift || true
            [[ -n "$sel" ]] || die "usage: hatter creds push <letter|slot|email> <hat...|--all>"
            local email
            email=$(creds_resolve "$sel") || die "no credential matches '$sel' - see: hatter creds"
            local targets=() hat rc=0
            if [[ "${1:-}" == "--all" ]]; then
                while IFS= read -r hat; do [[ -n "$hat" ]] && targets+=("$hat"); done < <(hat_names)
            else
                [[ $# -gt 0 ]] || die "which hat? usage: hatter creds push $sel <hat...|--all>"
                targets=("$@")
            fi
            for hat in "${targets[@]}"; do
                creds_push_to "$email" "$hat" || rc=1
            done
            return $rc
            ;;
        status)
            local hat js
            local want="${1:-}"
            while IFS= read -r hat; do
                [[ -z "$hat" ]] && continue
                [[ -n "$want" && "$hat" != "$want" ]] && continue
                js=$(creds_probe_hat "$hat")
                if [[ -z "$js" ]]; then
                    printf '  %-11s %s\n' "$hat" "unreachable, or hat-creds not installed"
                    continue
                fi
                printf '  %-11s %s\n' "$hat" "$(printf '%s' "$js" | jq -r '
                    if .kind == "none" then "no credential installed"
                    elif .kind == "api_key" then "API key installed"
                    elif .expired == true and (.hasRefreshToken | not) then
                        "\(.email // "?") - dead, push it again"
                    elif .expired == true then
                        "\(.email // "?")  stale, refreshes itself on next run"
                    else "\(.email // "?")  token ok for \(((.expiresInSeconds // 0) / 60) | floor)m"
                    end')"
            done < <(hat_names)
            ;;
        clear)
            local hat="${1:-}"
            [[ -n "$hat" ]] || die "usage: hatter creds clear <hat>"
            hat_exists "$hat" || die "unknown hat: $hat"
            remote_sh "$(hat_ssh "$hat")" 'python3 "$HOME/.local/bin/hat-creds" clear' || true
            jq_write --arg l "$hat" 'del(.hats[$l].credential, .hats[$l].credential_pushed_at)'
            info "Cleared the credential on '$hat'"
            ;;
        *) die "unknown creds subcommand: $sub (list|push|status|clear)" ;;
    esac
}

# ----------------------------------------------------------------- edit mode
#
# An interactive walk down hat > group > workspace > tab. Every screen names
# the level and says what it is, so the vocabulary is learned by browsing.
#
# Up/Down move the highlight, Enter or Right descends, Left/Esc/Backspace goes
# back, digits jump straight to an item. Written for bash 3.2 (macOS system
# bash): indexed arrays only, no associative arrays, no mapfile.

EDIT_CACHE=""
KEY=""

# Row icons, kept together so the set can be changed in one place. The hat is a
# plain caret - at one character a silhouette reads better than a detailed
# emoji, and ^ needs no font support anywhere.
ICON_HAT="/_\\"   # replaced per row by hat_icon, which colours it
ICON_GROUP="📂"
ICON_WORKSPACE="📁"
ICON_TAB="⌨️"

colour_setup() {
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_R=$'\033[0m'; C_SEL=$'\033[7m'
        C_CY=$'\033[36m'; C_GR=$'\033[32m'; C_YL=$'\033[33m'; C_RD=$'\033[31m'
    else
        C_DIM=""; C_B=""; C_R=""; C_SEL=""
        C_CY=""; C_GR=""; C_YL=""; C_RD=""
    fi
}

edit_cleanup() {
    [[ -n "$EDIT_CACHE" ]] && rm -rf "$EDIT_CACHE"
    printf '\033[?25h'                       # cursor back on
}

# The rack's EXIT trap. Not folded into hatter_on_exit: the rack's subshells
# (a sync) set that one as their own trap, and must not clear the rack's cache.
edit_on_exit() {
    local rc="$1"
    edit_cleanup || true
    hatter_on_exit "$rc"
}

# Read one keypress. Arrow keys arrive as ESC [ A..D, so a bare ESC has to be
# told apart from the start of a sequence by a short timeout. bash 3.2's read
# only takes whole-second timeouts, hence -t 1.
# Whatever is already in the tty buffer, up to <n> bytes, giving up after about
# a tenth of a second. bash 3.2 - which is the bash macOS ships - has no
# fractional read timeout, so `read -t 1` is the shortest wait it can offer and
# a bare Esc sat there for a full second. VTIME is in tenths, and a 0-byte read
# ends dd, so this returns the moment the terminal has nothing more to say.
EDIT_TTY_MODE=""
edit_read_pending() {
    local out
    # bash restores the tty itself after each `read -s -n1`, so the mode to go
    # back to is the same every time and is worth asking for only once.
    [[ -n "$EDIT_TTY_MODE" ]] || EDIT_TTY_MODE=$(stty -g < /dev/tty)
    stty -icanon min 0 time 1 < /dev/tty
    out=$(dd bs=1 count="$1" 2>/dev/null < /dev/tty)
    stty "$EDIT_TTY_MODE" < /dev/tty
    printf '%s' "$out"
}

edit_readkey() {
    local k rest
    # The rack runs for as long as it is open. Each action it ran is over by the
    # time it waits for a key, so focus goes back now, not when the rack closes:
    # the rack's own terminal has to have it for the key to arrive at all.
    focus_restore
    IFS= read -rsn1 k < /dev/tty || { KEY=quit; return; }
    case "$k" in
        $'\e')
            rest=$(edit_read_pending 2)
            if [[ -n "$rest" ]]; then
                case "$rest" in
                    '[A') KEY=up ;;    '[B') KEY=down ;;
                    '[C') KEY=right ;; '[D') KEY=left ;;
                    '[H') KEY=home ;;  '[F') KEY=end ;;
                    *)    KEY=esc ;;
                esac
            else
                KEY=esc
            fi ;;
        '')             KEY=enter ;;
        $'\x7f'|$'\b')  KEY=back ;;
        *)              KEY="$k" ;;
    esac
}

# One line of input from the terminal, into EDIT_REPLY. Esc cancels: it
# returns 1 with EDIT_REPLY empty, so a caller drops the whole action with
# `|| continue`. A blank answer is a normal reply and returns 0. A lone Esc is
# told from an arrow key or other escape sequence by edit_read_pending; those
# are ignored rather than typed in.
ask_line() {
    local k rest rc=0
    EDIT_REPLY=""
    printf '\033[?25h  %s: ' "$1" >&2
    while true; do
        IFS= read -rsn1 k < /dev/tty || { rc=1; break; }
        case "$k" in
            '') break ;;
            $'\e')
                rest=$(edit_read_pending 2)
                [[ -z "$rest" ]] && { rc=1; break; }
                # A sequence can arrive in pieces over a slow link: take the
                # rest of it, up to its final letter or ~, so none is typed in.
                local n=0
                while [[ "$rest" == '['* && "$rest" != *[A-Za-z~] && $n -lt 6 ]]; do
                    rest+=$(edit_read_pending 1); n=$((n+1))
                done
                continue ;;
            $'\x04') rc=1; break ;;
            $'\x7f'|$'\b')
                if [[ -n "$EDIT_REPLY" ]]; then
                    EDIT_REPLY="${EDIT_REPLY%?}"; printf '\b \b' >&2
                fi ;;
            [[:cntrl:]]) ;;
            *) EDIT_REPLY+="$k"; printf '%s' "$k" >&2 ;;
        esac
    done
    printf '\033[?25l' >&2
    if [[ $rc -ne 0 ]]; then
        EDIT_REPLY=""
        printf ' %s(cancelled)%s\n' "${C_DIM:-}" "${C_R:-}" >&2
    else
        printf '\n' >&2
    fi
    return $rc
}
edit_ask() { focus_restore; ask_line "$1"; }
edit_pause() { printf '\n  %spress any key%s ' "$C_DIM" "$C_R" >&2; edit_readkey; }
edit_confirm() {
    printf '  %s%s%s [y/N] ' "$C_YL" "$1" "$C_R" >&2
    edit_readkey
    case "$KEY" in y|Y) printf 'yes\n' >&2; return 0 ;; *) printf 'no\n' >&2; return 1 ;; esac
}

# --- cached remote reads ----------------------------------------------------

edit_sessions_file() { printf '%s/sessions.%s' "$EDIT_CACHE" "$1"; }

# One ssh trip per hat brings back both the session list and the credential
# installed there, split on a sentinel line.
edit_fetch_hat() {
    local hat="$1" host f
    host=$(hat_ssh "$hat"); f=$(edit_sessions_file "$hat")
    : > "$f"; : > "$f.cred"
    ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$host" \
        "$(posix_sh "tmux list-sessions -F '#{session_name}	#{session_windows}	#{session_attached}' 2>/dev/null; printf '@@@\n'; python3 \"\$HOME/.local/bin/hat-creds\" status 2>/dev/null || true")" \
        > "$f.raw" 2>/dev/null || : > "$f.raw"
    awk -v sf="$f" -v cf="$f.cred" \
        '/^@@@$/ { seen = 1; next } seen { print > cf; next } { print > sf }' \
        "$f.raw" 2>/dev/null || true
    rm -f "$f.raw"
}

edit_hat_cred() {
    local f="$(edit_sessions_file "$1").cred"
    [[ -s "$f" ]] || return 0
    jq -r '.email // ""' < "$f" 2>/dev/null || true
}

# "" when the hat could not be read at all, so the row can stay silent instead
# of claiming there is no credential.
edit_hat_cred_state() {
    local f="$(edit_sessions_file "$1").cred"
    [[ -s "$f" ]] || return 0
    jq -r 'if .kind == "none" then "none"
           elif .expired == true and (.hasRefreshToken | not) then "dead"
           elif .expired == true then "stale"
           else "ok" end' < "$f" 2>/dev/null || true
}

edit_refresh_all() {
    local hat
    printf '  %sprobing hats...%s\n' "$C_DIM" "$C_R" >&2
    while IFS= read -r hat; do
        [[ -z "$hat" ]] && continue
        edit_fetch_hat "$hat" &
    done < <(hat_names)
    wait
}

edit_session_field() {
    AWK_S="$2" awk -F'\t' -v c="$3" '($1 "")==(ENVIRON["AWK_S"] "") {print $c; exit}' "$(edit_sessions_file "$1")" 2>/dev/null
}

edit_windows() {
    local hat="$1" session="$2" host
    host=$(hat_ssh "$hat")
    ssh -n "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$host" \
        "$(posix_sh "tmux list-windows -t $(sq "=$session") -F '#{window_index}$HT#{window_name}$HT#{window_active}$HT#{window_panes}$HT#{pane_current_command}$HT#{pane_current_path}$HT#{pane_dead}$HT#{@hatter-pinned}' 2>/dev/null")" \
        2>/dev/null | tmux_fields
}

# --- chrome -----------------------------------------------------------------

edit_trunc() {
    local v="$1" w="$2"
    if [[ ${#v} -le $w ]]; then printf '%s' "$v"; else printf '%s…' "${v:0:$((w-1))}"; fi
}

edit_trunc_left() {
    local v="$1" w="$2"
    if [[ ${#v} -le $w ]]; then printf '%s' "$v"; else printf '…%s' "${v:$(( ${#v} - w + 1 ))}"; fi
}

edit_short_path() {
    local v="$1"
    case "$v" in
        /home/*/*)  v="~/${v#/home/*/}" ;;
        /home/*)    v="~" ;;
        /Users/*/*) v="~/${v#/Users/*/}" ;;
        /Users/*)   v="~" ;;
    esac
    printf '%s' "$v"
}

# edit_header <where> <title> <caption> [line] [line] [banner]: the banner is
# a warning that belongs above everything else on the screen.
edit_header() {
    printf '\033[?25l\033[H\033[2J'
    printf '%s──── hatter rack ──────────────────────────────────────────%s\n' "$C_DIM" "$C_R"
    printf '  %s%s%s\n' "$C_CY" "${1:-all hats}" "$C_R"
    [[ -n "${6:-}" ]] && printf '  %s%s%s\n' "$C_YL" "$6" "$C_R"
    printf '%s──────────────────────────────────────────────────────────%s\n' "$C_DIM" "$C_R"
    printf '  %s%s%s  %s·  %s%s\n' "$C_B" "$2" "$C_R" "$C_DIM" "$3" "$C_R"
    [[ -n "${4:-}" ]] && printf '     %s%s%s\n' "$C_DIM" "$4" "$C_R"
    [[ -n "${5:-}" ]] && printf '     %s%s%s\n' "$C_DIM" "$5" "$C_R"
    printf '\n'
}

# edit_row <index> <selected-index> <name> <width> <meta...>
#
# ROW_LABEL overrides the number in the left column (the credential list is
# lettered); ROW_ICON is the level's icon. Both are set per screen rather than
# passed, so the four call sites stay readable.
ROW_LABEL=""
ROW_ICON=""

edit_row() {
    local i="$1" sel="$2" name="$3" w="$4"; shift 4
    local marker="  " open="" close="" label
    label=$(printf '%2s' "${ROW_LABEL:-$i}")
    if [[ "$i" == "$sel" ]]; then
        marker="${C_CY}▸${C_R} "; open="$C_SEL"; close="$C_R"
    fi
    printf ' %s%s%s%s %s%s%-*s%s %s\n' \
        "$marker" "$C_B" "$label" "$C_R" "$ROW_ICON " \
        "$open" "$w" "$(edit_trunc "$name" "$w")" "$close" "$*"
}

edit_keys() {
    printf '\n  %s↑↓ move   → enter open   ← esc back   1-9 jump   %s%s\n' \
        "$C_DIM" "$1" "$C_R"
}

# Move the highlight. Returns 0 if the key was a navigation key.
edit_nav() {
    local n="$2"
    case "$1" in
        up)    SEL=$((SEL-1)); [[ $SEL -lt 1 ]] && SEL=$n ;;
        down)  SEL=$((SEL+1)); [[ $SEL -gt $n ]] && SEL=1 ;;
        home)  SEL=1 ;;
        end)   SEL=$n ;;
        [1-9]) [[ "$1" -le $n && "$1" -ge 1 ]] && SEL=$1 ;;
        *) return 1 ;;
    esac
    return 0
}

# The recorded sessions that run on their server but that cmux shows nowhere
# in their hat's window, one per line, for the top screen's banner. A
# workspace cmux closed by itself leaves one (the watcher says so as it
# happens; this is for whoever opens the rack later). Works from the rack's
# session cache and a cmux snapshot the caller holds, so it costs no call of
# its own. Says nothing without a snapshot, and nothing for a hat whose server
# was not read: unknown is not "running".
edit_detached() {
    local hat win shown s
    [[ "$CMUX_SNAP" == 1 ]] || return 0
    while IFS= read -r hat; do
        [[ -n "$hat" && -s "$(edit_sessions_file "$hat")" ]] || continue
        win=$(find_hat_window "$hat"); shown=""
        [[ -z "$win" ]] || shown=$(window_titles "$win")
        while IFS= read -r s; do
            [[ -n "$s" && -n "$(edit_session_field "$hat" "$s" 2)" ]] || continue
            if [[ "$(session_place "$s" "$s" "$shown" "")" == "running, not in cmux" ]]; then
                printf '%s\n' "$s"
            fi
        done < <(cfg --arg l "$hat" '.groups[] | select(.hat == $l) | .sessions | keys_unsorted[]?')
    done < <(hat_names)
    return 0
}

# The banner line for edit_detached's sessions, cut to the screen's width.
edit_detached_banner() {
    local list
    [[ -n "$1" ]] || return 0
    list=$(printf '%s' "$1" | awk 'NF && !seen[$0]++' | paste -sd ',' - | sed 's/,/, /g')
    edit_trunc "! running, not in cmux: $list  (S restores them)" "$(( $2 - 4 ))"
}

# --- level 1: credentials and hats ------------------------------------------
#
# The top screen holds two lists at once: the Claude logins on this Mac
# (lettered) and the hats they can be pushed to (numbered). Up/Down runs
# through both; a letter or a digit jumps straight into either one.

edit_top() {
    local SEL=1 nc nh nt i idx hat host state scol sess cred credstate dot dirty=1
    local preselect=1 ch=""
    local cols lastcols="" hdrtail
    local letter slot email label r5 r7 e5 e7 active holders detached=""
    while :; do
        # Gathering is what costs: `cswap list --json` alone is ~300ms, and
        # every hat row is several more jq reads on top. It happens only when
        # something has actually changed, so moving the highlight re-renders
        # from arrays already in hand - which is what makes the arrows instant.
        # `tput cols` reads the size off its own stdout, which inside $( ) is a
        # pipe - it answers 80 no matter how wide the terminal is. stty asks
        # the tty itself. Output is "<rows> <cols>".
        cols=$(stty size < /dev/tty 2>/dev/null); cols="${cols##* }"
        [[ "$cols" =~ ^[0-9]+$ ]] || cols=100
        [[ "$cols" != "$lastcols" ]] && { dirty=1; lastcols="$cols"; }
        if [[ "$dirty" == 1 ]]; then
            CLETTER=(); CEMAIL=(); CMETA=(); CICON=(); nc=0
            while IFS=$'\x1f' read -r letter slot email label r5 r7 e5 e7 active; do
                [[ -z "$email" ]] && continue
                CLETTER[$nc]="$letter"; CEMAIL[$nc]="$email"
                CICON[$nc]=$(creds_dot "$r5" "$r7")
                # Which hats hold this login. A login is not tied to one hat -
                # push it to as many as you want - and this is the only place
                # the many side of that is visible.
                holders=$(creds_hats_holding "$email")
                CMETA[$nc]=$(printf '%s%s' \
                    "$(creds_gauges "$r5" "$r7" "$e5" "$e7")" \
                    "$(creds_tail $((cols - CREDS_TAIL_COL)) "$holders" "$active")")
                nc=$((nc+1))
            done < <(creds_rows)

            HATS=(); HICON=(); HMETA=(); nh=0
            while IFS= read -r hat; do
                [[ -z "$hat" ]] && continue
                host=$(hat_ssh "$hat")
                # Plain text and its colour kept apart: %-14s counts bytes, and
                # padding a string that already has escapes in it pads the
                # escapes too, so one down hat knocked every column out.
                if [[ -s "$(edit_sessions_file "$hat")" ]]; then
                    sess=$(wc -l < "$(edit_sessions_file "$hat")" | tr -d ' ')
                    state="● up $sess ws"; scol="$C_GR"
                elif [[ -f "$(edit_sessions_file "$hat")" ]]; then
                    state="○ no tmux"; scol="$C_YL"
                else
                    state="?  unprobed"; scol="$C_DIM"
                fi
                cred=$(edit_hat_cred "$hat"); credstate=$(edit_hat_cred_state "$hat")
                # Reuse the credential's own dot so a hat shows the health of
                # the account it is actually holding.
                dot=""
                idx=0
                while [[ $idx -lt $nc ]]; do
                    [[ "${CEMAIL[$idx]}" == "$cred" ]] && { dot="${CICON[$idx]} "; break; }
                    idx=$((idx+1))
                done
                case "$credstate" in
                    ok|stale) cred=$(printf '%s%s%s%s' "$dot" "$C_DIM" "${cred%%@*}" "$C_R") ;;
                    dead)     cred=$(printf '%s%s%s dead%s' "$dot" "$C_RD" "${cred%%@*}" "$C_R") ;;
                    none)     cred=$(printf '%sno credential%s' "$C_DIM" "$C_R") ;;
                    *)        cred=$(printf '%snot provisioned%s' "$C_YL" "$C_R") ;;
                esac
                HATS[$nh]="$hat"
                HICON[$nh]=$(printf '%b' "$(hat_icon "$hat")")
                HMETA[$nh]=$(printf '%s%-24s%s %s%-11s%s %s' \
                    "$C_DIM" "$host" "$C_R" "$scol" "$state" "$C_R" "$cred")
                nh=$((nh+1))
            done < <(hat_names)
            dirty=0

            # One snapshot for the banner and the preselect below, dropped
            # before any key can change cmux.
            detached=""
            if cmux_alive; then
                cmux_snapshot
                detached=$(edit_detached)
            fi

            # The rack's question is "which hat am I wearing", so when it can
            # be answered from the launch window, open on that row. Once only:
            # after the first render the highlight belongs to the user.
            if [[ "$preselect" == 1 ]]; then
                preselect=0
                ch=$(current_hat || true)
                if [[ -n "$ch" ]]; then
                    i=0
                    while [[ $i -lt $nh ]]; do
                        [[ "${HATS[$i]}" == "$ch" ]] && { SEL=$((i+1)); break; }
                        i=$((i+1))
                    done
                fi
            fi
            cmux_snapshot_drop
        fi

        nt=$((nc+nh))
        [[ $SEL -gt $nt ]] && SEL=$nt
        [[ $SEL -lt 1 ]] && SEL=1

        # Hats first: the tool is named for them, and a login only matters
        # because some hat is wearing it.
        edit_header "" "HATS" \
            "a hat is a login (user@host): one ssh connection," \
            "one tmux server, one cmux window." "" \
            "$(edit_detached_banner "$detached" "$cols")"

        i=0
        while [[ $i -lt $nh ]]; do
            ROW_LABEL="$((i+1))"; ROW_ICON="${HICON[$i]}"
            edit_row $((i+1)) "$SEL" "${HATS[$i]}" 11 "${HMETA[$i]}"
            i=$((i+1))
        done
        ROW_LABEL=""; ROW_ICON=""
        [[ $nh -eq 0 ]] && printf '   %s(no hats yet - press A to add one)%s\n' "$C_DIM" "$C_R"

        printf '\n  %sCREDENTIALS%s  %s·  one Claude login each. Bars are capacity left,%s\n' \
            "$C_B" "$C_R" "$C_DIM" "$C_R"
        printf '     %sthen time to reset; red is spent, amber under half a session.%s\n\n' \
            "$C_DIM" "$C_R"
        # The header is 78 columns before "HELD BY", which is exactly where the
        # tail starts - so it only earns its place when the tail can show.
        hdrtail=""
        [[ $cols -ge $((CREDS_TAIL_COL + 9)) ]] && hdrtail="  HELD BY"
        printf '        %s%-28s %-19s   %-19s%s%s\n' \
            "$C_DIM" "LOGIN" "5H WINDOW" "7D WINDOW" "$hdrtail" "$C_R"

        i=0
        while [[ $i -lt $nc ]]; do
            ROW_LABEL="${CLETTER[$i]}"; ROW_ICON="${CICON[$i]}"
            edit_row $((nh+i+1)) "$SEL" "${CEMAIL[$i]}" 28 "${CMETA[$i]}"
            i=$((i+1))
        done
        ROW_LABEL=""; ROW_ICON=""
        [[ $nc -eq 0 ]] && \
            printf '   %s(no credentials - is cswap installed?)%s\n' "$C_DIM" "$C_R"

        printf '\n  %s↑↓ move   1-9 hat   a-z credential   → enter open   q quit%s\n' \
            "$C_DIM" "$C_R"
        printf '  %sA add hat   R rename   D forget   P provision   ! refresh%s\n' \
            "$C_DIM" "$C_R"
        printf '  %sS sync / restore%s\n' "$C_DIM" "$C_R"

        edit_readkey

        # Digits and letters are absolute jumps into their own list, so they are
        # read before edit_nav, whose digit handling counts from the top of the
        # combined one. This is also why the vim h/l aliases are not bound here:
        # with enough logins they would be credential letters.
        case "$KEY" in
            q|Q|quit) return 0 ;;
            [1-9])
                [[ "$KEY" -le $nh ]] && SEL=$KEY
                continue ;;
            esc|left|back) continue ;;      # nothing above this level
            [a-z])
                # Only a letter that is actually in the credential column is a
                # jump; anything else falls through to the action keys below.
                i=0
                while [[ $i -lt $nc ]]; do
                    if [[ "${CLETTER[$i]}" == "$KEY" ]]; then SEL=$((nh+i+1)); break; fi
                    i=$((i+1))
                done
                [[ $i -lt $nc ]] && continue ;;
        esac
        edit_nav "$KEY" "$nt" && continue

        # Past here the key is an action, and an action can change anything.
        dirty=1
        idx=$((SEL-1))
        if [[ $idx -lt $nh ]]; then hat="${HATS[$idx]:-}"; else hat=""; fi

        case "$KEY" in
            q|Q|quit) return 0 ;;
            enter|right)
                if [[ -n "$hat" ]]; then
                    edit_groups "$hat" || return 0
                elif [[ $nc -gt 0 ]]; then
                    edit_credential "${CEMAIL[$((idx-nh))]}" || return 0
                fi
                : ;;
            !) edit_refresh_all ;;
            A)
                edit_ask "new hat name (the session prefix)" || continue
                local nh_name="$EDIT_REPLY"
                [[ -z "$nh_name" ]] && continue
                edit_ask "ssh destination (user@host)" || continue; local nhost="$EDIT_REPLY"
                edit_ask "remote dir [\$HOME]" || continue; local dir="${EDIT_REPLY:-\$HOME}"
                edit_ask "default group for new workspaces" || continue; local g="$EDIT_REPLY"
                if [[ -n "$g" ]] && group_name_reserved "$g"; then
                    warn "'$UNASSIGNED' is hatter's own group - pick another default group"; edit_pause; continue
                fi
                register_hat "$nh_name" "$nhost" "$dir" "$g"
                [[ -n "$g" ]] && { group_exists "$g" || register_group "$g" "$nh_name"; }
                edit_fetch_hat "$nh_name"; edit_pause ;;
            R)
                [[ -z "$hat" ]] && continue
                edit_ask "new name for hat '$hat'" || continue
                [[ -n "$EDIT_REPLY" ]] && { cmd_hat rename "$hat" "$EDIT_REPLY" || true; edit_refresh_all; }
                edit_pause ;;
            D)
                [[ -z "$hat" ]] && continue
                if edit_confirm "forget hat '$hat'? (config only - the server is untouched)"; then
                    cmd_hat rm "$hat" || true; edit_pause
                fi ;;
            P)
                [[ -z "$hat" ]] && continue
                cmd_provision "$hat" || true; edit_pause ;;
            S)
                # No hat row selected (the highlight is on a credential) means
                # every hat, which is what bare `hatter sync`/`restore` do.
                edit_sync_restore "$hat" || return 0 ;;
        esac
    done
}

# --- level 2 (from a hat, or from the top): sync and restore -----------------
#
# The two commands that move state between the config and the live layout, put
# where that layout is already in front of you. The screen leads with what is
# actually missing, because that is the question you open this with; the
# commands underneath are then an obvious yes or no.
#
# Restore defaults to --missing. From a menu the safe reading of "restore" is
# "fill the gaps", and re-applying everything to a hat that is already whole -
# reopening its window, re-mirroring, restyling - is a deliberate extra key.
#
# Every command runs in a subshell: cmd_sync and cmd_restore both die on a dead
# cmux socket, and a die inside the rack would drop the whole UI mid-screen.
edit_sync_restore() {
    local hat="${1:-}" gaps="" probed=0 h line what why n
    while :; do
        edit_header "${hat:-all hats}" "SYNC / RESTORE" \
            "sync records the live layout into the config;" \
            "restore rebuilds the live layout from the config."

        if [[ "$probed" == 0 ]]; then
            printf '   %sprobing...%s' "$C_DIM" "$C_R"
            gaps=""
            # hat_missing finds each hat's window, which reads every window:
            # one snapshot for the whole probe, gone before anything restores.
            cmux_snapshot
            for h in ${hat:-$(hat_names)}; do
                while IFS= read -r line; do
                    [[ -z "$line" ]] && continue
                    gaps+="$h$US$line"$'\n'
                done < <(hat_missing "$h")
            done
            cmux_snapshot_drop
            probed=1
            printf '\r\033[K'
        fi

        n=0
        if [[ -n "$gaps" ]]; then
            printf '  %sMISSING%s\n' "$C_YL" "$C_R"
            while IFS=$'\x1f' read -r h what why; do
                [[ -z "$h" ]] && continue
                n=$((n+1))
                printf '     %s%-11s%s %-22s %s%s%s\n' \
                    "$C_DIM" "$h" "$C_R" "${what:-(the hat itself)}" "$C_YL" "$why" "$C_R"
            done <<<"$gaps"
        else
            printf '  %s● nothing missing - every recorded session is running and mirrored%s\n' \
                "$C_GR" "$C_R"
        fi

        printf '\n  %ss%s  sync      write the live layout into the config\n' "$C_B" "$C_R"
        if [[ $n -gt 0 ]]; then
            printf '  %sr%s  restore   rebuild just the %s%s missing%s\n' \
                "$C_B" "$C_R" "$C_YL" "$n" "$C_R"
        else
            printf '  %s%sr%s  restore   nothing missing to rebuild%s\n' \
                "$C_DIM" "$C_B" "$C_R" "$C_DIM$C_R"
        fi
        printf '  %sf%s  force     re-apply everything: sessions, mirror, groups, styling\n' \
            "$C_B" "$C_R"

        edit_keys "s sync   r restore   f force   ! re-probe   q back"
        edit_readkey
        case "$KEY" in
            q|Q|quit|left|esc|back|h) return 0 ;;
            !) probed=0 ;;
            s|S)
                if ! ( cmd_sync ); then
                    warn "sync did not finish"
                elif backup_ask_wanted; then
                    printf '  %sback up the config to git now?%s [Y]es / [n]o / ne[v]er ask ' \
                        "$C_YL" "$C_R" >&2
                    edit_readkey
                    case "$KEY" in
                        enter|y|Y) printf 'yes\n' >&2; ( backup_commit_push ) || warn "backup did not finish" ;;
                        v|V)       printf 'never\n' >&2; ( backup_never_ask ) || true ;;
                        *)         printf 'no\n' >&2 ;;
                    esac
                fi
                probed=0; edit_pause ;;
            r|R)
                if [[ $n -eq 0 ]]; then
                    printf '  %snothing missing - use f to re-apply anyway%s\n' "$C_DIM" "$C_R"
                    edit_pause
                else
                    ( cmd_restore --missing ${hat:+"$hat"} ) || warn "restore did not finish"
                    probed=0; edit_pause
                fi ;;
            f|F)
                if edit_confirm "force restore ${hat:-every hat}? reopens the window, re-mirrors and restyles even where nothing is missing"; then
                    ( cmd_restore ${hat:+"$hat"} ) || warn "restore did not finish"
                    probed=0; edit_pause
                fi ;;
        esac
    done
}

# --- level 2 (from a credential): push it to a hat ---------------------------

edit_credential() {
    local email="$1" SEL=1 n i hat host cred credstate held
    while :; do
        HATS=(); n=0
        while IFS= read -r hat; do
            [[ -z "$hat" ]] && continue
            HATS[$n]="$hat"; n=$((n+1))
        done < <(hat_names)
        [[ $SEL -gt $n ]] && SEL=$n; [[ $SEL -lt 1 ]] && SEL=1

        edit_header "$email" "PUSH TO A HAT" \
            "the login travels down the ssh pipe and is written 0600 on the server." \
            "One credential per hat is safest: a shared account can log itself out."

        i=0
        while [[ $i -lt $n ]]; do
            hat="${HATS[$i]}"; host=$(hat_ssh "$hat")
            cred=$(edit_hat_cred "$hat"); credstate=$(edit_hat_cred_state "$hat")
            if [[ -z "$credstate" ]]; then
                held=$(printf '%snot provisioned - press P on the hats screen%s' "$C_YL" "$C_R")
            elif [[ "$cred" == "$email" ]]; then
                held=$(printf '%s✓ holds this one%s' "$C_GR" "$C_R")
            elif [[ "$credstate" == "none" ]]; then
                held=$(printf '%sno credential%s' "$C_DIM" "$C_R")
            else
                held=$(printf '%sholds %s%s' "$C_DIM" "$cred" "$C_R")
            fi
            ROW_LABEL=""; ROW_ICON=$(printf '%b' "$(hat_icon "$hat")")
            edit_row $((i+1)) "$SEL" "$hat" 11 \
                "$(printf '%s%-24s%s %s' "$C_DIM" "$host" "$C_R" "$held")"
            i=$((i+1))
        done
        ROW_ICON=""

        printf '\n  %s↑↓ move   1-9 jump   → enter push here   ← esc back%s\n' "$C_DIM" "$C_R"
        printf '  %sA push to every hat   X clear this hat   q quit%s\n' "$C_DIM" "$C_R"
        edit_readkey
        edit_nav "$KEY" "$n" && continue
        hat="${HATS[$((SEL-1))]:-}"
        case "$KEY" in
            q|Q|quit) return 1 ;;
            left|esc|back|h) return 0 ;;
            enter|right|l)
                [[ -z "$hat" ]] && continue
                printf '\n'
                creds_push_to "$email" "$hat" || true
                edit_fetch_hat "$hat"; edit_pause ;;
            A)
                if edit_confirm "push $email to every hat?"; then
                    printf '\n'
                    for hat in "${HATS[@]:-}"; do
                        [[ -z "$hat" ]] && continue
                        creds_push_to "$email" "$hat" || true
                    done
                    edit_refresh_all; edit_pause
                fi ;;
            X)
                [[ -z "$hat" ]] && continue
                if edit_confirm "remove the credential from '$hat'?"; then
                    printf '\n'
                    cmd_creds clear "$hat" || true
                    edit_fetch_hat "$hat"; edit_pause
                fi ;;
        esac
    done
}

# --- level 2: groups --------------------------------------------------------

# The rack reads a hat's layout on the way into it, so it settles Unassigned
# there too, quietly: from the probe's session list and one look at cmux.
edit_settle_unassigned() {
    local hat="$1" live win
    live=$(cut -f1 "$(edit_sessions_file "$hat")" 2>/dev/null || true)
    [[ -n "$live" ]] || return 0
    cmux_alive || return 0
    cmux_snapshot
    win=$(find_hat_window "$hat")
    cmux_snapshot_drop
    [[ -n "$win" ]] || return 0
    # A subshell: nothing in it may take the rack down.
    ( settle_ungrouped "$hat" "$win" "$live" ) >/dev/null 2>&1 || true
    return 0
}

edit_groups() {
    local hat="$1" SEL=1 n g count i dg
    edit_settle_unassigned "$hat"
    while :; do
        GRPS=(); n=0
        while IFS= read -r g; do
            [[ -z "$g" ]] && continue
            GRPS[$n]="$g"; n=$((n+1))
        done < <(groups_of_hat "$hat")
        [[ $SEL -gt $n ]] && SEL=$n; [[ $SEL -lt 1 ]] && SEL=1

        edit_header "$hat" "GROUPS" \
            "a group is a project or area inside one hat. Group names are free" \
            "text and take no prefix; the workspaces inside them do."

        i=0
        while [[ $i -lt $n ]]; do
            g="${GRPS[$i]}"
            count=$(cfg --arg g "$g" '.groups[$g].sessions | length')
            dg=""
            [[ "$(hat_default_group "$hat")" == "$g" ]] && dg="  ${C_CY}(default)${C_R}"
            group_managed "$g" && dg="$dg  ${C_DIM}(hatter's own: workspaces in no group)${C_R}"
            ROW_LABEL=""; ROW_ICON="$ICON_GROUP"
            edit_row $((i+1)) "$SEL" "$(group_display "$g")" 28 \
                "$(printf '%s%s workspace(s)%s%s' "$C_DIM" "$count" "$C_R" "$dg")"
            i=$((i+1))
        done
        [[ $n -eq 0 ]] && printf '   %s(no groups in this hat yet - press a)%s\n' "$C_DIM" "$C_R"

        # Running sessions no group records would otherwise show nowhere.
        local un
        un=$(hat_unrecorded "$hat" "$(cut -f1 "$(edit_sessions_file "$hat")" 2>/dev/null || true)")
        if [[ -n "$un" ]]; then
            printf '\n  %srunning, in no group:%s %s\n' "$C_YL" "$C_R" "$(paste -sd ' ' - <<<"$un")"
            printf '     %sto keep one, hatter new <session> --group <name>; to end it, hatter rm%s\n' \
                "$C_DIM" "$C_R"
        fi

        edit_keys "a add   r rename   d forget   q quit"
        edit_readkey
        edit_nav "$KEY" "$n" && continue
        g="${GRPS[$((SEL-1))]:-}"
        case "$KEY" in
            q|Q|quit) return 1 ;;
            left|esc|back|h) return 0 ;;
            enter|right|l)
                [[ $n -gt 0 ]] && { edit_workspaces "$hat" "$g" || return 1; }
                : ;;
            a|A)
                edit_ask "new group name" || continue
                if group_name_reserved "$EDIT_REPLY"; then
                    warn "'$UNASSIGNED' is hatter's own group - pick another name"
                elif [[ -n "$EDIT_REPLY" ]]; then
                    register_group "$EDIT_REPLY" "$hat"
                    local w; w=$(ensure_hat_window "$hat")
                    ensure_cmux_group "$EDIT_REPLY" "$w" >/dev/null
                fi
                edit_pause ;;
            r|R)
                [[ $n -eq 0 ]] && continue
                if group_managed "$g"; then
                    warn "'$(group_display "$g")' is hatter's own group and keeps its name"; edit_pause; continue
                fi
                edit_ask "new name for group '$g'" || continue
                # A subshell: rename dies on a name it refuses.
                [[ -n "$EDIT_REPLY" ]] && { ( cmd_group rename "$g" "$EDIT_REPLY" ) || true; edit_pause; } ;;
            d|D)
                [[ $n -eq 0 ]] && continue
                if group_managed "$g"; then
                    warn "'$(group_display "$g")' is hatter's own group: it goes once it is empty"; edit_pause; continue
                fi
                if edit_confirm "forget group '$g'? (config only - workspaces keep running)"; then
                    ( cmd_group rm "$g" ) || true; edit_pause
                fi ;;
        esac
    done
}

# --- level 3: workspaces ----------------------------------------------------

# What cmux shows in a hat's window, for session_place: EDIT_SHOWN, every
# title, and EDIT_GROUPED, those in a group. EDIT_SHOWN is "?" when cmux
# cannot say, and then nothing is marked.
EDIT_SHOWN="?"
EDIT_GROUPED=""
edit_cmux_places() {
    local win
    EDIT_SHOWN="?" EDIT_GROUPED=""
    cmux_alive || return 0
    cmux_snapshot
    win=$(find_hat_window "$1")
    EDIT_SHOWN=""
    if [[ -n "$win" ]]; then
        EDIT_SHOWN=$(window_titles "$win"); EDIT_GROUPED=$(window_titles "$win" grouped)
    fi
    cmux_snapshot_drop
    return 0
}

edit_workspaces() {
    local hat="$1" group="$2" SEL=1 n ws i tabs att state place
    edit_cmux_places "$hat"
    while :; do
        WSS=(); n=0
        while IFS= read -r ws; do
            [[ -z "$ws" ]] && continue
            WSS[$n]="$ws"; n=$((n+1))
        done < <(cfg --arg g "$group" '.groups[$g].sessions | keys_unsorted[]?')
        [[ $SEL -gt $n ]] && SEL=$n; [[ $SEL -lt 1 ]] && SEL=1

        edit_header "$hat › $(group_display "$group")" "WORKSPACES" \
            "a workspace is a tmux session named <hat>-<subproject>, shown as one" \
            "entry in the cmux sidebar. Its tabs are the tmux windows inside it."

        i=0
        while [[ $i -lt $n ]]; do
            ws="${WSS[$i]}"
            tabs=$(edit_session_field "$hat" "$ws" 2)
            att=$(edit_session_field "$hat" "$ws" 3)
            if [[ -n "$tabs" ]]; then
                state=$(printf '%s● running%s  %s tab(s)' "$C_GR" "$C_R" "$tabs")
                [[ "$att" == "1" ]] && state="$state  ${C_DIM}attached${C_R}"
                place=$(session_place "$ws" "$ws" "$EDIT_SHOWN" "$EDIT_GROUPED")
                case "$place" in
                    "running, not in cmux")
                        state="$state  ${C_YL}not in cmux${C_R} ${C_DIM}restore --missing mirrors it${C_R}" ;;
                    "running, in no cmux group")
                        state="$state  ${C_YL}in no cmux group${C_R} ${C_DIM}sync puts it back${C_R}" ;;
                esac
            else
                state=$(printf '%s✗ not running%s  %sre-create with restore%s' \
                        "$C_RD" "$C_R" "$C_DIM" "$C_R")
            fi
            ROW_LABEL=""; ROW_ICON="$ICON_WORKSPACE"
            edit_row $((i+1)) "$SEL" "$ws" 26 "$state"
            i=$((i+1))
        done
        [[ $n -eq 0 ]] && printf '   %s(no workspaces in this group yet - press a)%s\n' "$C_DIM" "$C_R"

        edit_keys "a add   r rename   f fix blank   d delete   ! refresh   q quit"
        edit_readkey
        edit_nav "$KEY" "$n" && continue
        ws="${WSS[$((SEL-1))]:-}"
        case "$KEY" in
            q|Q|quit) return 1 ;;
            left|esc|back|h) return 0 ;;
            enter|right|l)
                [[ $n -gt 0 ]] && { edit_tabs "$hat" "$group" "$ws" || return 1; }
                : ;;
            !) edit_fetch_hat "$hat"; edit_cmux_places "$hat" ;;
            a|A)
                edit_ask "new workspace name (a bare name gets the '$hat-' prefix)" || continue
                if [[ -n "$EDIT_REPLY" ]]; then
                    cmd_new "$EDIT_REPLY" --group "$group" --hat "$hat" || true
                    edit_fetch_hat "$hat"
                fi
                edit_pause ;;
            r|R)
                [[ $n -eq 0 ]] && continue
                edit_ask "new name for workspace '$ws'" || continue
                if [[ -n "$EDIT_REPLY" ]]; then
                    ( cmd_rename "$ws" "$EDIT_REPLY" --hat "$hat" ) || true; edit_fetch_hat "$hat"
                fi
                edit_pause ;;
            f|F)
                [[ $n -eq 0 ]] && continue
                # A subshell: repair dies on anything it cannot fix.
                ( cmd_repair "$ws" --hat "$hat" ) || warn "repair did not finish"
                edit_fetch_hat "$hat"; edit_pause ;;
            d|D)
                [[ $n -eq 0 ]] && continue
                # Ending it is the usual case; forgetting only is for an entry
                # whose server is gone, or a session to keep but stop tracking.
                printf '  %sremove %s:%s [k]ill it and forget it / [f]orget only, leave it running / [N]o ' \
                    "$C_YL" "$ws" "$C_R" >&2
                edit_readkey
                # A subshell: rm dies on whatever it could not do, and says what
                # that was - including when it ended the session but could not
                # finish.
                case "$KEY" in
                    k|K) printf 'kill\n' >&2
                         ( cmd_rm "$ws" --hat "$hat" ) || warn "rm did not finish - see above"
                         edit_fetch_hat "$hat"; edit_pause ;;
                    f|F) printf 'forget only\n' >&2
                         ( cmd_rm "$ws" --hat "$hat" --keep-running ) || warn "rm did not finish - see above"
                         edit_fetch_hat "$hat"; edit_pause ;;
                    *)   printf 'no\n' >&2 ;;
                esac ;;
        esac
    done
}

# --- level 4: tabs ----------------------------------------------------------

edit_tabs() {
    local hat="$1" group="$2" ws="$3" SEL=1 n i
    local idx nm active panes cmd cwd dead pin mark short plural
    while :; do
        IDXS=(); NAMES=(); METAS=(); PINS=(); n=0
        while IFS=$'\x1f' read -r idx nm active panes cmd cwd dead pin; do
            [[ -z "$idx" ]] && continue
            if [[ "$dead" == "1" ]]; then mark="${C_RD}✗ dead${C_R}   "
            elif [[ "$active" == "1" ]]; then mark="${C_GR}● active${C_R} "
            else mark="${C_DIM}○${C_R}        "
            fi
            short=$(edit_trunc_left "$(edit_short_path "$cwd")" 30)
            plural=" "; [[ "$panes" != "1" ]] && plural="s"
            IDXS[$n]="$idx"
            PINS[$n]="${pin:-}"
            NAMES[$n]="${nm:-(unnamed)}"
            [[ "$pin" == "1" ]] && NAMES[$n]="📌 ${NAMES[$n]}"
            METAS[$n]=$(printf '%s %s%-10s%s %s%s pane%s  %s%s' \
                "$mark" "$C_CY" "$(edit_trunc "$cmd" 10)" "$C_R" \
                "$C_DIM" "$panes" "$plural" "$short" "$C_R")
            n=$((n+1))
        done < <(edit_windows "$hat" "$ws")
        [[ $SEL -gt $n ]] && SEL=$n; [[ $SEL -lt 1 ]] && SEL=1

        edit_header "$hat › $(group_display "$group") › $ws" "TABS" \
            "a tab is a tmux window inside the workspace. It survives losing the" \
            "client, and closing it here closes it everywhere." \
            "A pinned tab 📌 comes back first on restore, even if it was closed."

        i=0
        while [[ $i -lt $n ]]; do
            ROW_LABEL=""; ROW_ICON="$ICON_TAB"
            edit_row $((i+1)) "$SEL" "${NAMES[$i]}" 22 "${METAS[$i]}"
            i=$((i+1))
        done
        [[ $n -eq 0 ]] && \
            printf '   %s(workspace is not running - go back and use restore)%s\n' "$C_YL" "$C_R"

        edit_keys "a add   r rename   p pin/unpin   d close   ! refresh   q quit"
        edit_readkey
        edit_nav "$KEY" "$n" && continue
        idx="${IDXS[$((SEL-1))]:-}"
        case "$KEY" in
            q|Q|quit) return 1 ;;
            left|esc|back|h) return 0 ;;
            enter|right|l) : ;;                       # tabs are the leaf level
            !) : ;;
            a|A)
                edit_ask "name for the new tab (blank for the shell default)" || continue
                # A subshell: tab dies on a session it cannot add to.
                ( cmd_tab --hat "$hat" -- "$ws" "$EDIT_REPLY" ) || true; edit_pause ;;
            r|R)
                [[ $n -eq 0 ]] && continue
                edit_ask "new name for tab '${NAMES[$((SEL-1))]}'" || continue
                [[ -n "$EDIT_REPLY" ]] && remote_sh "$(hat_ssh "$hat")" \
                    "tmux rename-window -t $(sq "=$ws:$idx") $(sq "$EDIT_REPLY")" >/dev/null 2>&1 || true ;;
            p|P)
                [[ $n -eq 0 ]] && continue
                # A subshell: cmd_tab_pin dies on a tab it cannot pin.
                if [[ "${PINS[$((SEL-1))]}" == "1" ]]; then
                    ( cmd_tab_pin unpin "$ws" "$idx" "$hat" ) || edit_pause
                else
                    ( cmd_tab_pin pin "$ws" "$idx" "$hat" ) || edit_pause
                fi ;;
            d|D)
                [[ $n -eq 0 ]] && continue
                if edit_confirm "close tab '${NAMES[$((SEL-1))]}'? whatever is running in it is killed"; then
                    remote_sh "$(hat_ssh "$hat")" \
                        "tmux kill-window -t $(sq "=$ws:$idx")" >/dev/null 2>&1 || true
                fi ;;
        esac
    done
}

cmd_rack() {
    [[ -t 0 && -t 1 ]] || die "the rack needs an interactive terminal"
    colour_setup
    EDIT_CACHE=$(mktemp -d "${TMPDIR:-/tmp}/hatter-edit.XXXXXX")
    trap edit_cleanup INT TERM
    trap 'edit_on_exit $?' EXIT
    edit_refresh_all
    edit_top
    printf '\033[H\033[2J\033[?25h'
    edit_cleanup
}

usage_main() {
    cat <<'USAGE'
hatter - cmux windows, groups and workspaces backed by remote tmux

  hat        a login (user@host): one ssh connection, one tmux server, one window
  group      a project or area within a hat
  workspace  a tmux session named <hat>-<subproject>
  tab        a tmux window inside that session
  credential a Claude login, held on this Mac by cswap and pushed to a hat

Commands:
  new <session>          Create or reattach a workspace  ("new" is optional)
  tab <session> [name]   Add a tab to a workspace
  attach [hat|session]   Open a workspace in this terminal, over plain ssh
  find <terms>...        Find the Claude session working on something, and go to it
  key add <key> <hat>... Authorise another machine's ssh key on hats
  rename <old> <new>     Rename a session on its server, in cmux and in config
  rm <session>           End a workspace and forget it (--keep-running: forget only)
  repair <session>       Bring back a workspace cmux shows blank, in its place
  resize <hat|session>   Bring tabs stuck at 80x24 up to the window's size
  hat <subcommand>       Manage hats (shell servers)
  group <subcommand>     Manage groups (projects)
  rack                   The hat rack: browse and edit every level
  creds <subcommand>     Push a Claude login from this Mac to a hat
  autosave <subcommand>  Rolling config snapshots, and the timer that takes them
  list                   Show the whole hat / group / workspace tree
  sync                   Record the live layout into the config
  restore [hat|group]    Rebuild the layout from the config
  provision <hat>        Set up tmux persistence and boot recovery on a server
  backup [message]       sync, then commit and push the config to git
  shortcuts              Write Termux home-screen widget shortcuts (Android)

Run `hatter` with no arguments to open the rack, or without cmux, to attach.
Run `hatter <command>` or `hatter help <command>` for a command's options.
A command that changes cmux puts focus back where it found it when it is done.

Config: ~/.config/hatter/config.json
USAGE
}

usage_cmd() {
    case "$1" in
    creds|cred|credential|credentials) cat <<'USAGE'
hatter creds [subcommand]

A credential is one Claude login. They live on this Mac only - in the macOS
Keychain, managed by cswap - and are pushed to a hat over ssh when Claude Code
on that server needs to run as an account. No shell server is ever asked to log
in, and nothing is written to disk on either side: the export goes straight down
the ssh pipe and lands 0600 on the server.

  list                   Credentials (lettered) and the hat each one is on
  push <sel> <hat>...    Push a credential to one or more hats
  push <sel> --all       ...to every hat
  status [hat]           Ask each hat which credential it is holding
  clear <hat>            Remove the credential from a hat

<sel> is the letter from `hatter creds`, the cswap slot number, or enough of
the email address to be unique.

One credential per hat is the arrangement to aim for. Sharing one account
across machines works, but each machine refreshes the OAuth token on its own
and a refresh can rotate the refresh token, so a shared account may get logged
out from under whichever machine refreshed last. Pushing again fixes it;
different accounts per hat avoid it.

An *expired* access token is not a problem - Claude Code trades the refresh
token for a new one by itself. Only a credential reported as "dead" (expired
with no refresh token) needs pushing again.

Requires cswap on this Mac and `hatter provision <hat>` on the server.
USAGE
    ;;
    autosave) cat <<'USAGE'
hatter autosave [subcommand]

Snapshots of config.json, kept separately from git.

  run                Move dragged tabs (see: hatter help repair), sync from the
                     live client, snapshot, then back up if due (what the
                     timer runs)
  watch              Follow cmux events: move a dragged tab the moment it is
                     dropped, sync a second after any layout change, and say
                     when a closed workspace's tmux session still runs
                     (what the watcher runs; stays in the foreground)
  now                Snapshot only, no sync
  list               Show the checkpoints and the rolling save
  restore <n|latest> Roll the config back to one of them
  install            Install the launchd timer (every 60s) and the watcher
                     (always running)
  uninstall          Remove both, keeping the snapshots
  status             Are the timer and watcher loaded, how many snapshots
                     exist, and the last auto backup

The watcher reacts at once but only to what cmux reports: renames and group
changes send no event, so the timer still catches those within a minute, and
anything that happened while the watcher was down. It restarts itself when
hatter is reinstalled. Log: ~/.config/hatter/autosave/watch.log

When cmux closes the workspace of a recorded session and the tmux session
still runs on its server, the watcher looks at who closed it. cmux closes a
mirror by itself when the ssh connection under it drops, as can happen after
the Mac sleeps. A workspace nobody was on, closed that way, is reattached
into its group, as `hatter new <session>` would, and the log says so. A
workspace someone closed (the one selected in its window) is left closed:
the watcher logs "'<session>' closed in cmux while its tmux session still
runs" and posts a macOS notification naming `hatter new <session>`, which
brings it back. A close from a script, or from the sidebar of a workspace
that is not selected, looks like cmux's own. So a session is reattached at
most once in 30 minutes: closing it again keeps it closed, with the notice.
A server that does not answer gets nothing. The rack lists such sessions at
the top.

Two layers, on purpose:

  latest.json            rewritten whenever the config changes - after every
                         hatter run, and once a minute from the timer, which is
                         how renames done inside cmux get picked up.

  config-<window>.json   the config as each 8-hour window opened. Frozen once
                         written, so eight checkpoints are eight different
                         moments - roughly the last two and a half days. The
                         oldest is dropped past eight.

Neither touches git. `hatter backup [message]` is the deliberate checkpoint:
a real commit, pushed to the dotfiles remote, kept forever. Autosaves are for
"undo the last hour"; backups are for "what did this look like last month".

The timer also takes a backup by itself, without asking, when one is due:

  - the config differs from the last pushed copy by more than 10% of its
    lines (added plus removed), or
  - anything is unpushed and the last push is more than 7 days old.

Nothing is pushed when nothing changed. ssh runs in batch mode, so a remote
that wants a password is skipped, not waited on; after a failed push it tries
again an hour later. Turn it off with "prefs": {"auto_backup": "off"} in the
config.

After rolling back, `hatter restore` applies the config to the client.
USAGE
    ;;
    new) cat <<'USAGE'
hatter new <session> [options]        ("new" is optional: `hatter <session>`)

Create or reattach a tmux session and surface it as a workspace, in the right
group, in the right hat's window. Creates the group and the hat's window if
they do not exist yet.

Options:
  --group <name>     Project/area to put it in. Created if new. Defaults to the
                     group already recording the session, then the hat's
                     default_group, then its first group. A session in the
                     hat's Unassigned group moves to the default or first
                     real group (see: hatter help group).
  --hat <hat>        Which shell server. Needed only when the session name has
                     no <hat>- prefix and the group is also new.
  --ssh user@host    Register an unknown hat's destination without prompting.
  --dir <path>       Remote working directory for a newly registered hat.
  --focus, --go      Stay on the new workspace when done. Without it, cmux
                     focus goes back to the window and workspace you were in.

A bare name is auto-prefixed once the hat is known:
  hatter dev-atlas --group "Atlas"
  hatter atlas --group "Atlas"                # -> dev-atlas, hat from group
  hatter atlas --group "New Project" --hat dev

An existing session is matched before the prefix is added: if the config
records the name as given under that hat, or a session by that exact name is
running on the hat's server (one made by `hatter rename` or by tmux itself),
that session is reattached and nothing new is created. Only a name that
matches neither takes the prefix.

Run from a terminal inside a cmux window, a bare name with nothing else to go
on takes that window's hat, so `hatter atlas` while wearing dev means
dev-atlas. An explicit --hat, a known prefix, or the group's hat all still win.
Off the Mac - in a mirrored pane on a shell server - there is no window to read
and the name must say which hat it belongs to.
USAGE
    ;;
    tab) cat <<'USAGE'
hatter tab <session> [tab-name] [--hat <hat>]
hatter tab pin|unpin <session> <tab> [--hat <hat>]

Add a tab to a workspace. A tab is a tmux window, so this creates one on the
server and the mirror picks it up. Inside the session, tmux's own `prefix + c`
does the same thing.

  hatter tab dev-atlas
  hatter tab dev-atlas notes

Pin a tab, by index or name, and hatter keeps it: `restore` creates pinned
tabs first and brings one back if it was closed. Only a named tab can be
pinned. cmux cannot pin a mirrored tab itself, so this is hatter's pin.

  hatter tab pin dev-atlas notes
  hatter tab unpin dev-atlas 0

Inside a cmux window, a bare name is resolved against that window's hat, so
`hatter tab atlas` means dev-atlas while wearing dev - but only when that
workspace already exists.

A name need not carry a hat's prefix, so hats on two servers can each record
one called notes. Then the window's hat decides, when it is one of them.
Typed anywhere else, tab refuses rather than guess; --hat says which. new,
attach, resize, repair and rename resolve such a name the same way. rm never takes
it from the window: ending a session needs --hat.
USAGE
    ;;
    resize) cat <<'USAGE'
hatter resize <hat|session> [--size WxH]

Bring tmux windows stuck at 80x24 up to the size cmux uses, on every session
of a hat or on one session.

  hatter resize dev
  hatter resize dev-atlas --size 200x60

A window made with no client attached comes up at tmux's 80x24, and cmux does
not size every window it shows, so after a restore an agent can sit at 80x24
in a much larger cmux window. Provisioned servers avoid this: the save timer
records the size cmux uses, and the tmux server starts from it. resize is for
windows that are already wrong. The size is that record unless --size says
otherwise.

tmux then holds each resized window at that size, even when cmux resizes. To
let one follow cmux again, in that tab:

  tmux set-window-option -u -t "$TMUX_PANE" window-size

An agent already running picks up the new size at once, but what it printed
before stays wrapped at 80 columns until it restarts.
USAGE
    ;;
    repair) cat <<'USAGE'
hatter repair <session> [--hat <hat>]

Bring back a workspace that cmux shows blank. Dragging a tab between cmux
workspaces can leave it like that, in one of two ways.

  hatter repair dev-atlas

The usual way: cmux moves the tab but never tells tmux, so the window stays
in its old session. The dropped tab has nothing behind it, and the old
workspace no longer shows the window. repair moves the tmux window into the
session the tab was dropped on and closes the blank tab, and cmux shows the
window there as a new tab, at the end. Nothing is re-mirrored. When cmux
refuses to close the blank tab (it may be pinned, or taken for a busy one),
it is unpinned and closed by force; nothing runs behind it. The new tab is
never pinned in cmux, and cmux does not say whether the old one was, so
re-pin it with hatter tab pin. The autosave watcher does the same the moment
a tab is dropped (see: hatter help autosave), so a dragged tab is usually
fixed before you ask. A tab is only moved when its window is certain: the blank tab's
title names exactly one window that cmux no longer shows anywhere, and the
tab really is blank, or has no terminal behind it at all. A local shell
sitting in a mirrored workspace is never taken for one. A session's last tab
is left where it is, since moving it would end that session. Whenever a
dragged tab is left alone, repair says why and gives the tmux command that
moves it, and does not go on to re-mirror: that would lose the blank tab, and
the window would show nowhere. The timer logs it once.

A tab dropped into a workspace that is not a tmux session (a local one) has
no session to move its window into. Its window is still in the session it
came from, which no longer shows it. cmux draws a window as a new tab when it
enters a mirrored session, so the window hops out to a temporary session and
straight back, and then the blank tab is closed. Nothing is closed or
mirrored again. Only a tab cmux has no terminal for is taken: a local shell,
even a quiet one, is left alone, with a note on how to do it by hand. A
session's last window is left alone too, since moving it out would end it.

The other way: the window did move, but cmux has stopped painting it, and
nothing on the tmux side helps. For that, repair checks the session has
content on its server - if it does not, this is not the fault and nothing is
touched - then detaches the workspace from cmux, mirrors the hat again, and
puts the workspace back in its group, in its old place.

Either way the tmux session, and everything running in it, keeps running.
Finally repair syncs the config and refreshes the server's pane registry.

In the rack, press f on a workspace.
USAGE
    ;;
    key) cat <<'USAGE'
hatter key add <public-key | file> <hat>... | --all

Authorise another machine's ssh key on your hats, using the access this machine
already has. A brand-new key cannot do this for itself on a server that only
accepts keys, so this is how a new laptop - or a Windows box set up with
tools/install-windows.ps1 - gets in.

  hatter key add ~/new-laptop.pub --all
  hatter key add 'ssh-ed25519 AAAAC3Nz... me@windows' dev ops

The key is checked with ssh-keygen first, and each hat reports "added",
"present" (already there, whatever its comment) or "unreachable".
USAGE
    ;;
    find) cat <<'USAGE'
hatter find [--all] [--days N] [--hat <hat>] [--limit N] <term>...

Search the Claude sessions on every hat and list the matches, best first. At a
terminal, pick one to go to its tab in cmux (or, without cmux, to attach to it
over ssh).

A running session matches when every term, case-insensitive, appears in its
title, its last prompt, its tab name or the last 10k characters of its
conversation (what you and Claude wrote, not tool output). Sessions whose title,
prompt or tab name has every term come first.

  --all        Also search closed sessions changed in the last 7 days, matching
               anywhere in the transcript. Subagent transcripts are skipped.
               Picking one resumes it in a new tab: choose the workspace, with
               the one it last ran in (or one with a tab in its directory)
               offered as the default. The tab runs through hat-launch, so the
               session is recorded and starts with the hat's claude arguments.
  --days N     With --all, look back N days instead (implies --all)
  --hat <hat>  Search only this hat
  --limit N    List the best N (default 20; 0 lists every match)

Running sessions are the ones in a hat's pane registry (see provision) whose
tmux window is still open.
USAGE
    ;;
    attach) cat <<'USAGE'
hatter attach [hat | session]

Open a workspace in this terminal: ssh to its hat and attach to the tmux
session, creating it if it is not running. Nothing else is touched - no cmux,
no config writes - so this works from any terminal with bash and ssh,
Termux on Android included.

  hatter attach dev-atlas     that workspace
  hatter attach dev           pick one of dev's workspaces, or a new one
  hatter attach               pick the hat, then the workspace

Given a hat, the choice is every workspace the config records for it plus any
running on its server. Detach with the tmux prefix then d; the session keeps
running. On a machine without cmux, bare `hatter` does the same as
`hatter attach`.

A hat added with `hatter hat add <hat> --mosh` attaches over mosh when mosh
is installed here, and over ssh otherwise. mosh rides out a phone sleeping
or changing networks; the server needs mosh-server too.

On Windows without bash, the WezTerm plugin (plugin/init.lua) does the same
- see docs/install-wezterm.md.
USAGE
    ;;
    shortcuts) cat <<'USAGE'
hatter shortcuts [--dir <path>]

Write shortcuts for the Termux home-screen widget on Android: one per hat,
which opens that hat's workspace picker, and one per workspace the config
records, which attaches straight to it. Which widget each Termux build has:
https://github.com/smcd-personal/hatter/blob/main/docs/install-android.md#shortcuts

A workspace's shortcut is named
"<hat> <rest of its name>", so each hat's workspaces sort right after it.

The shortcuts go in ~/.shortcuts/hatter (or --dir). Run this again after
pulling a newer config; it replaces the shortcuts it wrote before and leaves
any other file there alone.
USAGE
    ;;
    rename) cat <<'USAGE'
hatter rename <old-session> <new-session> [--hat <hat>]

Rename a session in all three places at once: the tmux session on its server,
the cmux workspace title, and the config. Renaming in the cmux sidebar also
renames the tmux session, so after doing it by hand just run `hatter sync`.

  hatter rename dev-website-parser dev-website-grid
USAGE
    ;;
    rm|remove) cat <<'USAGE'
hatter rm <session> [--hat <hat>] [--keep-running]

End a workspace on purpose: kill its tmux session on the server and drop it
from the config. Closing a workspace in cmux is not enough: sync keeps a
session that is still running (see: hatter help sync).

A server brings sessions back after a reboot two ways, and rm closes both:
tmux-resurrect's last snapshot (it takes a new one, and takes the session out
of the snapshot `last` points at, which matters for the last session on a
server), and hat-restore's list of what the config records (it tells the
server the new list).

A running session that no group records is ended the same way; its name's
prefix says which hat it is on. If the server cannot be reached, or its tmux
cannot be read, nothing is changed.

  --hat <hat>      The hat whose session it is. Needed only when hats on more
                   than one server record the name and its prefix names none
                   of them: those are different sessions, and rm will not
                   pick one. Entries on other servers are never touched.
  --keep-running   Forget the config entry only, and leave the server exactly
                   as it is: the session runs on, and tmux-resurrect may bring
                   it back after a reboot. Use it for an entry whose server is
                   gone, or a session you want to keep but stop tracking.
                   While it runs, the next sync records it again: in its
                   group while cmux shows it in one, otherwise in its hat's
                   Unassigned group (see: hatter help group).

The rack's workspace screen does both with d: k ends and forgets, f forgets
only.

  hatter rm dev-website-parser
USAGE
    ;;
    hat) cat <<'USAGE'
hatter hat <subcommand>

A hat is a login: one user@host, one ssh connection, one tmux server, and one
cmux window. The hat name is the prefix on every session that belongs to it.

Subcommands:
  list                                    Hats and their destinations
  status                                  Live probe: reachable, tmux, sessions
  add <hat> --ssh user@host [--dir path] [--group <name>] [--mosh]
                                          Register or update a hat. --group sets
                                          the default group new workspaces land
                                          in when you omit --group. --mosh makes
                                          `hatter attach` use mosh where it is
                                          installed (--no-mosh turns it off).
                [--kind <kind>] [--args <kind>=<args>]
                                          How hat-launch starts agents on the
                                          hat's server: --args gives the extra
                                          arguments for every launch of a kind
                                          (claude, codex or shell), including
                                          each agent restored at boot. --kind
                                          is what a bare `hat-launch` starts.
                                          An empty value clears it. Takes
                                          effect on the server at the next
                                          `hatter provision`.
  rename <old> <new>                      Rename a hat and re-prefix its sessions
  rm <hat>                                Forget a hat (server untouched)

  hatter hat add cloud --ssh you@shell.example.com
  hatter hat set cloud --kind claude --args claude='--permission-mode auto'
  hatter hat status

Hats that share an ssh destination share one tmux server, so they must agree
on --kind and on each kind's --args; provision refuses if they do not.
USAGE
    ;;
    group) cat <<'USAGE'
hatter group <subcommand>

A group is a project or area inside one hat. Group names are free text and do
not take the hat prefix; the workspaces inside them do.

No workspace runs outside a group. sync, restore, the autosave timer and the
rack each settle a hat's window: a workspace cmux shows loose goes back into
the group the config records it in, and a running session that no group
records goes into Unassigned. Each hat has an Unassigned group, which hatter
manages itself, shown at the top of the hat's window (below any group pinned
there). It holds sessions created on the server directly, mirrored in loose,
or forgotten while still running. It is removed, from cmux and the config,
once it is empty: at once when `hatter rm` or `hatter new` takes its last
session out, otherwise at the next sync. An entry in it is dropped like any
other once its session stops. Move a workspace out of it as out of any
group: drag it in cmux and sync, or `hatter new <session> --group <name>`;
with no --group, `hatter new` takes it to the hat's default or first real
group, since making or attaching a workspace on purpose places it. A new workspace goes to
Unassigned only when its hat has no other group, and a cmux Unassigned that
cmux will not remove is left until what is in it changes.

Group names are config keys, unique across hats, while every hat's window has
its own Unassigned; so its key is Unassigned@<hat>, the hat's Unassigned, and
the entry is marked managed. `group rm` and `group rename` refuse it, and no
other group may be called Unassigned; a group already called that, from before
hatter kept its own, is folded into its hat's Unassigned on the next run.

Subcommands:
  list                          Groups, their hats, and their sessions
  add <name> --hat <hat>        Create a group (also creates the hat's window)
  rename <old> <new>            Rename it in cmux and in the config together
  rm <name>                     Forget a group (cmux group left alone)

  hatter group add "Atlas" --hat dev
USAGE
    ;;
    rack|edit) cat <<'USAGE'
hatter rack     (or just: hatter)

The hat rack - where every hat hangs. An interactive walk down the whole
structure:

  hat  >  group  >  workspace  >  tab

Every screen names the level it is showing and says what that level is, so the
vocabulary is learned by looking around. Add, rename and remove are available at
each one, and live status is shown where it exists:

  hats        up / no tmux server, and how many workspaces
  groups      running sessions that no group records
  workspaces  running / not running, tab count, whether a client is attached,
              and running but not in cmux
  tabs        active, dead, running command, pane count, working directory

Keys are shown at the bottom of each screen. `!` re-probes the servers, `b`
goes back a level, `q` quits from anywhere. Esc at a question cancels the whole
action. Takes no options.

`hatter` on its own opens the rack. `hatter edit` is the old name and still
works.
USAGE
    ;;
    list) cat <<'USAGE'
hatter list

Show the whole tree from the config - every hat, its groups, and each group's
workspaces with tab counts - followed by the cmux windows that are actually
open. Takes no options.

Each server is asked which sessions are running, so nothing can hide:

  not running                recorded, but its tmux session is gone
  running, not in cmux       recorded and running, but no workspace shows it
  running, in no cmux group  recorded and running, shown loose in cmux
  running, in no group       running on the server, but no group records it

A hat whose server cannot be reached says so, and its sessions go unmarked.
For a per-hat summary, use `hatter hat status`.
USAGE
    ;;
    sync) cat <<'USAGE'
hatter sync

Record the live layout into the config: group membership, titles, colors,
pin/collapse, and every session's tabs and working directories. Run it after
renaming or rearranging anything in the cmux sidebar.

Groups, workspaces and tabs are saved in the order the sidebar shows them, and
list, edit, the pickers and restore all use that order.

Only hats with an open window and a reachable server are touched; the rest are
left as they are rather than being emptied.

Not being in cmux is not the same as being gone. Closing a mirrored workspace
only detaches it, and its tmux session runs on. So a recorded session that cmux
no longer shows in a group, but that is still running on its server, keeps its
entry. sync says where it is: "kept (running, not in cmux)", which `hatter
restore --missing` mirrors again, or "kept (running, in no cmux group)", which
sync then puts back in its group in cmux. An entry is dropped only when its
session is no longer running on the server: "dropped (not running)". To close
a workspace for good, use `hatter rm`.

A session that is not running is dropped only if sync saw it running on the
tmux server running now: then it ended, rather than being lost when the server
restarted. One that ran only on an earlier server is kept, "never ran on this
tmux server", until a restore brings it back or `hatter rm` forgets it. With a
tmux too old to say which server it is, or no record yet, sync falls back to
counting.

A server still coming back from a reboot may run only some of its sessions.
So when none of a hat's recorded sessions is running, or more than half of
them would be dropped at once, sync drops none of them that pass and says so.
`hatter rm` forgets one that is gone for good.

A session running on a server that no group records is put into its hat's
Unassigned group, and an empty Unassigned is removed (see: hatter help group).

Each server reached is also told which sessions the config records for it, and
forgets the tabs that have closed. Its boot-time rebuild (hat-restore) then
brings back only those, so a workspace closed before a reboot stays closed.

Then, at a terminal, it offers to back up: commit and push the config as
`hatter backup` does, without syncing twice. Enter means yes; n skips it this
time; v (never) stops the question, on every machine the config is cloned to.
It is not asked when there is nothing to back up, when the config is not a git
repo, or when sync is not run at a terminal.

  --ask-backup    ask again after saying never
USAGE
    ;;
    restore) cat <<'USAGE'
hatter restore [hat|group ...]

Rebuild from the config after a Mac or shell-server reboot: recreate missing
tmux sessions and their tabs, find or open each hat's window, re-mirror, put the
workspaces back in their groups in their saved order, and re-apply styling.
Idempotent. Groups it creates follow the saved order; a group already in the
window keeps its place.

With no arguments, every hat. Hats with nothing recorded, or whose server is
unreachable, are skipped rather than failing the run.

Options:
  --missing      Only touch hats that are actually incomplete: a recorded
                 session not running on the server, one running but not
                 mirrored, or a hat with no window. A hat that is already whole
                 is left alone entirely - no window, no re-mirror, no restyle.

  hatter restore
  hatter restore dev
  hatter restore --missing
USAGE
    ;;
    backup) cat <<'USAGE'
hatter backup [message]

Run `sync`, then commit and push ~/.config/hatter to git. The config is a small
JSON file - hostnames and usernames, no secrets - but it maps your
infrastructure, so keep the remote private.

Nothing here is product-specific; any git remote reachable over ssh works. A
bare repo on a box you already own is enough:

  you@shell.example.com:git/dotfiles.git

On a new Mac:
  git clone <remote> ~/.config/hatter
  hatter restore

The bootstrap secret is your ssh key, not this repo - keep that in a password
manager so a bare machine can reach the remote in the first place.
USAGE
    ;;
    provision) cat <<'USAGE'
hatter provision <hat|user@host>

Set up a shell server so its state survives both a reboot and a stray logout:

  - tpm, tmux-resurrect and tmux-continuum, autosaving every 15 minutes.
    continuum does not restore on its own: hat-restore (below) owns that, and
    the two would race. hat-restore rebuilds every window its registry holds,
    agents and shells alike (every pane records itself through hat-launch).
    A snapshot, splits and scrollback included, can still be restored by hand
    (prefix + ctrl-r).
  - the hat's launch settings (see: hatter help hat), as the tmux options
    hat-launch reads, in ~/.local/state/hatter/launch.tmux.conf on the
    server. A hat provisioned as user@host that no hat in the config names
    keeps the file it has.
    An option set on the running server by hand but not in the config is
    reported, not removed.
  - every pane's login shell wrapped in a loop, so `exit` and ctrl-D hand back
    a fresh prompt instead of closing the tab by accident
  - a `bye` command on the server for closing one deliberately:
      bye            close this pane / tab
      bye window     close the whole tmux window
      bye session    close the session, and the cmux workspace with it
    `exit 99` does the same thing without the script. 99 rather than 1 because
    bare `exit` returns the last command's status, so 1 would fire by accident.

It also installs boot recovery, which rebuilds the server's own tmux without
the Mac being involved at all:

  - hat-launch   what every pane runs, and so what records each window, shells
                 included. For an agent it mints the session id BEFORE
                 starting it, so which conversation a tab held is something the
                 tab wrote down rather than something anyone has to infer.
  - hat-record   a SessionStart/SessionEnd hook, appended as its own entry so
                 existing hooks are untouched. This is what catches a session
                 started by hand, which is most of them.
  - hat-restore  replays the registry at boot: sessions, windows, names, working
                 directories, and `claude --resume <id>` in each pane.
                 --dry-run prints the plan; --no-agents rebuilds plain shells;
                 --backfill records the agents running right now, which
                 provision does for you so an already-busy box is covered
                 before its first reboot rather than after it; --prune settles
                 the registry against the windows there are (see
                 hat-registry). --backfill prunes afterwards unless given
                 --no-prune. Pruning refuses to run when tmux has no windows,
                 since at boot the registry is the only truth there is.
                 An agent's entry is never simply lost: when prune drops it, or
                 a new launch in the same window writes over it, it moves to
                 panes/closed/<session id>.json. That history is what
                 `hatter find` uses to say where an old conversation ran; it is
                 never restored, and is kept for 90 days.
  - hat-registry the registry itself: one entry per tmux window, filed under
                 the window's id, so it follows the window through closes,
                 moves and renumbering, and a Claude session id in one entry
                 only. tmux hooks keep it current; `hat-registry prune`
                 settles entries from before the server started and records
                 any window without one as a shell.
  - a systemd user unit for the above, and a timer that snapshots tmux-resurrect
    every 15 minutes - continuum's own autosave never fires, because it hangs
    off a status line that a control-mode client like cmux never draws.

Boot recovery needs lingering (`sudo loginctl enable-linger <user>`); provision
says so if it is off.

Rewrites its managed block in ~/.tmux.conf on every run, then self-tests that a
shell which exits comes back usable. Takes no options.
USAGE
    ;;
    *) usage_main ;;
    esac
}

usage_exit() { usage_main; exit 1; }

cmd_help() {
    if [[ -n "${1:-}" ]]; then
        usage_cmd "$1"
    else
        usage_main
    fi
}

# -------------------------------------------------------------------- main

# Everything from here to the end is one brace group that ends in `exit`. bash
# reads a script as it runs it, keeping a byte offset into the file; if the file
# is rewritten while a hatter is open - an editor saving over it - the running
# one would resume at that offset in the new file and die on a bogus syntax
# error. A brace group is parsed whole before any of it runs, and the `exit`
# means bash never reads past it.
{

need jq
seed_config

cmd="${1:-}"
shift || true

# cmux is the client half, and it is macOS-only. The server half - provisioning
# a shell server, pushing a login to it, adding a tab, backups - is bash, ssh
# and jq, which run anywhere, WSL included. So cmux is required by the commands
# that actually drive it rather than by the script itself.
#
# Without cmux, bare `hatter` has no rack to open, but attaching still works:
# so on a phone, or any machine that only reaches its hats, it opens the
# attach picker instead.
case "$cmd" in
    provision|creds|cred|credential|credentials|backup|autosave|tab|hat|login|attach|find|key|resize|shortcuts|rm|remove|help|-h|--help|_drag-plan) ;;
    "") if ! command -v cmux >/dev/null 2>&1; then
            if [[ -t 0 && -t 1 ]]; then cmd=attach; else usage_main; exit 0; fi
        fi ;;
    *) need cmux ;;
esac

# Unlocks the config and puts cmux focus back, however the run ends.
trap 'hatter_on_exit $?' EXIT

case "$cmd" in
    # attach ends in exec, which skips the EXIT trap that would unlock.
    # sync takes the lock itself, only for its final write.
    rack|edit|list|ls|help|""|-h|--help|autosave|attach|find|resize|shortcuts|sync|_drag-plan|_drag-heal) ;;
    *) hatter_lock 20 || die "another hatter is writing the config - try again in a moment" ;;
esac

# `hatter <command> --help` always explains the command.
for a in "$@"; do
    case "$a" in
        -h|--help) usage_cmd "$cmd"; exit 0 ;;
    esac
done

# Not for help, which changes nothing; for everything else, before it reads
# the config.
case "$cmd" in help|-h|--help) ;; *) migrate_unassigned ;; esac

case "$cmd" in
    -h|--help)     usage_main; exit 0 ;;
    # The front door. A tool whose question is "which hat are you wearing?"
    # should answer it when you type its name - but only at a terminal, so a
    # script that runs bare `hatter` still gets usage rather than a UI.
    "")            if [[ -t 0 && -t 1 ]]; then cmd_rack; else usage_main; exit 0; fi ;;
    help)          cmd_help "${1:-}" ;;

    # These need arguments, so bare invocation shows the command's options.
    new)       [[ $# -gt 0 ]] || { usage_cmd new; exit 1; };       cmd_new "$@" ;;
    tab)       [[ $# -gt 0 ]] || { usage_cmd tab; exit 1; };       cmd_tab "$@" ;;
    attach)    [[ $# -le 1 ]] || { usage_cmd attach; exit 1; }
               if [[ $# -eq 1 ]]; then cmd_attach "$1"; else cmd_attach_pick; fi ;;
    find)      cmd_find "$@" ;;
    key)       cmd_key "$@" ;;
    rename)    [[ $# -gt 0 ]] || { usage_cmd rename; exit 1; };    cmd_rename "$@" ;;
    rm|remove) [[ $# -gt 0 ]] || { usage_cmd rm; exit 1; };        cmd_rm "$@" ;;
    repair)    [[ $# -ge 1 ]] || { usage_cmd repair; exit 1; };    cmd_repair "$@" ;;
    resize)    [[ $# -gt 0 ]] || { usage_cmd resize; exit 1; };    cmd_resize "$@" ;;
    provision) [[ $# -gt 0 ]] || { usage_cmd provision; exit 1; }; cmd_provision "$@" ;;
    backup)    cmd_backup "$@" ;;
    hat|login) [[ $# -gt 0 ]] || { usage_cmd hat; exit 1; };       cmd_hat "$@" ;;
    group)     [[ $# -gt 0 ]] || { usage_cmd group; exit 1; };     cmd_group "$@" ;;

    # These are meaningful with no arguments, so they just run.
    rack|edit) cmd_rack "$@" ;;
    creds|cred|credential|credentials) cmd_creds "$@" ;;
    autosave)  cmd_autosave "$@" ;;
    list|ls)   cmd_list "$@" ;;
    sync)      case "${1:-}" in
                   "") ;;
                   --ask-backup)
                       jq_write 'del(.prefs.backup_after_sync) | if .prefs == {} then del(.prefs) else . end'
                       info "Will ask to back up after each sync" ;;
                   *) die "unknown argument: $1  (try: hatter help sync)" ;;
               esac
               cmd_sync
               backup_offer ;;
    shortcuts) cmd_shortcuts "$@" ;;
    # Not for people: the dragged-tab planner, and the healer, for the tests.
    _drag-plan) drag_plan ;;
    _drag-heal) heal_dragged_tabs "${1:-}" "${2:-report}" "${3:-}" "${4:-}" ;;
    restore)   cmd_restore "$@" ;;

    -*)        die "unknown option: $cmd  (try: hatter --help)" ;;
    *)         cmd_new "$cmd" "$@" ;;
esac

# A snapshot after every run. This is only a cmp plus, at most, a file copy -
# the expensive sync belongs to the timer, not to every command.
autosave_snapshot >/dev/null 2>&1 || true

exit
}
