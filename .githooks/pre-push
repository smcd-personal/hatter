#!/usr/bin/env bash
# Refuse a push whose commits - diffs, messages, author or committer - carry
# private details. This is the last stop before GitHub.
set -euo pipefail
check="$(git rev-parse --show-toplevel)/tools/leakcheck"
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ _; do
    [[ "$local_sha" == "$zero" ]] && continue          # a branch deletion
    # Check what the branch adds on top of main. Commits already on main are
    # public whatever happens here, and a merge of main into the branch would
    # otherwise drag them all back in.
    git fetch -q origin main 2>/dev/null || true
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo origin/main)
    "$check" --range "$base..$local_sha" || status=1
done
exit $status
